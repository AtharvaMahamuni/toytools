---
// Category Tool List — compact sectioned rows replacing the old tile grid.
// Tools group into titled sections by pattern (src/data/category-sections.ts);
// headers render only when the category has more than one section. Tool-group
// members (src/data/tool-groups.ts) collapse into a single row with one mode
// chip per member, so e.g. seven case converters read as one entry.
import type { ToolConfig, Category } from '@data/types';
import { sectionsByPattern } from '@data/category-sections';
import { toolGroups } from '@data/tool-groups';
import { withBase } from '@lib/paths';

interface Props {
  category: Category;
  tools: ToolConfig[];
}

const { category, tools: categoryTools } = Astro.props;

interface Row {
  label: string;
  description: string;
  href: string;
  chips?: { label: string; href: string }[];
}

interface Section {
  title: string;
  order: number;
  rows: Row[];
}

const groupById = new Map(toolGroups.map(g => [g.id, g]));
const toolHref = (slug: string) => withBase(`/tool/${category.segment}/${slug}/`);

const sections = new Map<string, Section>();
const seenGroups = new Set<string>();

for (const t of categoryTools) {
  const meta = (t.pattern && sectionsByPattern[t.pattern]) || { title: 'Other', order: 99 };
  let section = sections.get(meta.title);
  if (!section) {
    section = { title: meta.title, order: meta.order, rows: [] };
    sections.set(meta.title, section);
  }

  const group = t.toolGroup ? groupById.get(t.toolGroup) : undefined;
  if (group) {
    if (seenGroups.has(group.id)) continue;
    seenGroups.add(group.id);
    section.rows.push({
      label: group.name,
      description: 'One workspace, every mode — input carries across.',
      href: toolHref(group.members[0]!.slug),
      chips: group.members.map(m => ({ label: m.label, href: toolHref(m.slug) })),
    });
  } else {
    section.rows.push({ label: t.name, description: t.description, href: toolHref(t.slug) });
  }
}

const ordered = [...sections.values()].sort((a, b) => a.order - b.order);
const showHeadings = ordered.length > 1;
---

<div class="category-list">
  {ordered.map(section => (
    <section class="cat-section">
      {showHeadings && <h2 class="cat-section-heading">{section.title}</h2>}
      <ul class="cat-rows">
        {section.rows.map(row => (
          <li class="cat-row">
            <div class="cat-row-main">
              <a class="cat-row-link" href={row.href}>{row.label}</a>
              <span class="cat-row-desc">{row.description}</span>
            </div>
            {row.chips && (
              <div class="cat-chips">
                {row.chips.map(chip => (
                  <a class="cat-chip" href={chip.href}>{chip.label}</a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .category-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .cat-section-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-2);
  }

  .cat-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cat-row {
    border-bottom: var(--border);
    padding-block: var(--space-3);
  }

  .cat-row-main {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: var(--space-6);
  }

  .cat-row-link {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .cat-row-link:hover {
    color: var(--color-text-muted);
    text-decoration: underline;
  }

  .cat-row-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .cat-row-main {
      flex-direction: column;
      gap: var(--space-1);
    }

    .cat-row-link,
    .cat-row-desc {
      white-space: normal;
    }
  }

  /* ── Mode chips (tool-group rows) ─────────────────────────── */

  .cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .cat-chip:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    text-decoration: none;
  }
</style>
