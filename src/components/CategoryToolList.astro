---
// Category tool listing — store-style AppTile grid, sectioned by pattern.
// Tool-group members collapse into one tile with mode chips (same as before).
// Tiles link to the tool page only; Install lives on the tool page (InstallButton).
import type { ToolConfig, Category } from '@data/types';
import { sectionsByPattern } from '@data/category-sections';
import { toolGroups } from '@data/tool-groups';
import { toolPath } from '@lib/paths';
import { freshUntil } from '@lib/tools/freshness';
import AppTile from '@components/AppTile.astro';
import type { LocaleCode } from '@data/locales';
import { hasLocalizedTool, localizeTool } from '@lib/i18n/registry';

interface Props {
  category: Category;
  tools: ToolConfig[];
  lang?: LocaleCode;
}

const { category, tools: categoryTools, lang = 'en' } = Astro.props;

interface Chip {
  label: string;
  href: string;
}

interface TileRow {
  slug: string;
  name: string;
  tagline: string;
  newUntil?: string;
  chips?: Chip[];
}

interface Section {
  title: string;
  order: number;
  rows: TileRow[];
}

function untilFor(members: ToolConfig[]): string | undefined {
  let latest: string | undefined;
  for (const member of members) {
    const until = freshUntil(member.addedOn);
    if (until && (!latest || until > latest)) latest = until;
  }
  return latest;
}

const groupById = new Map(toolGroups.map(g => [g.id, g]));
const toolsBySlug = new Map(categoryTools.map(t => [t.slug, t]));
const toolHref = (slug: string) => toolPath({ slug, segment: category.segment }, hasLocalizedTool(slug, lang) ? lang : 'en');

const sections = new Map<string, Section>();
const seenGroups = new Set<string>();

for (const rawTool of categoryTools) {
  const t = hasLocalizedTool(rawTool.slug, lang) ? localizeTool(rawTool, lang) : rawTool;
  const meta = (t.pattern && sectionsByPattern[t.pattern]) || { title: 'Other', order: 99 };
  let section = sections.get(meta.title);
  if (!section) {
    section = { title: meta.title, order: meta.order, rows: [] };
    sections.set(meta.title, section);
  }

  const group = t.toolGroup ? groupById.get(t.toolGroup) : undefined;
  if (group) {
    if (seenGroups.has(group.id)) continue;
    seenGroups.add(group.id);
    const members = group.members
      .map(m => toolsBySlug.get(m.slug))
      .filter((m): m is ToolConfig => Boolean(m));
    const primary = members[0] ?? t;
    const primaryLoc = hasLocalizedTool(primary.slug, lang) ? localizeTool(primary, lang) : primary;
    const groupTaglines: Record<LocaleCode, string> = {
      en: 'One workspace, every mode, and your input carries across.',
      es: 'Un solo espacio de trabajo para cada modo sin perder tu entrada.',
      de: 'Ein gemeinsamer Arbeitsbereich für alle Modi, Eingaben bleiben erhalten.',
      fr: 'Un espace unifié pour chaque mode, votre saisie reste conservée.',
      ja: '1つの画面で全モードを切り替え、入力もそのまま引き継げます。',
      pt: 'Um único espaço com todos os modos preservando sua entrada.',
      hi: 'एक ही स्थान पर सभी मोड और आपका इनपुट भी सुरक्षित रहता है।',
    };
    section.rows.push({
      slug: primaryLoc.slug,
      name: group.name,
      tagline: groupTaglines[lang],
      newUntil: untilFor(members),
      chips: group.members.map(m => {
        const lm = hasLocalizedTool(m.slug, lang) ? localizeTool(toolsBySlug.get(m.slug) ?? primary, lang) : null;
        return { label: lm ? lm.name : m.label, href: toolHref(m.slug) };
      }),
    });
  } else {
    section.rows.push({
      slug: t.slug,
      name: t.name,
      tagline: t.tagline || t.description,
      newUntil: freshUntil(t.addedOn),
    });
  }
}

const ordered = [...sections.values()].sort((a, b) => a.order - b.order);
const showHeadings = ordered.length > 1;
---

<div class="category-list">
  {ordered.map(section => (
    <section class="cat-section">
      {showHeadings && <h2 class="cat-section-heading">{section.title}</h2>}
      <ul class="app-tile-grid">
        {section.rows.map(row => (
          <li class="app-tile-item">
            <AppTile
              slug={row.slug}
              name={row.name}
              tagline={row.tagline}
              segment={category.segment}
              newUntil={row.newUntil}
              lang={lang}
            />
            {row.chips && (
              <div class="cat-chips">
                {row.chips.map(chip => (
                  <a class="cat-chip" href={chip.href}>{chip.label}</a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .category-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .cat-section-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .app-tile-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: var(--space-4);
  }

  .app-tile-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* Mode chips under a grouped tile — every member stays crawlable. */
  .cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .cat-chip:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    text-decoration: none;
  }
</style>
