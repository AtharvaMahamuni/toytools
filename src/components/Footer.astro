---
import MadeInIndia from '@components/MadeInIndia.astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      &copy; {year} ToyTools
      <span class="gold-dot" aria-hidden="true"></span>
      Lightweight
      <span class="gold-dot" aria-hidden="true"></span>
      Private
      <span class="gold-dot" aria-hidden="true"></span>
      Free
      <span class="gold-dot" aria-hidden="true"></span>
      <MadeInIndia />
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border);
    padding: var(--space-6) var(--space-4);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 639px) {
    .footer-inner {
      font-size: var(--text-xs);
    }

    .footer-brand {
      gap: var(--space-2);
    }
  }

</style>
