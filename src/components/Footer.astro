---
import MadeInIndia from '@components/MadeInIndia.astro';
import { withBase } from '@lib/paths';
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      &copy; {year} ToyTools
      <span class="gold-dot" aria-hidden="true"></span>
      <span
        class="footer-hint"
        data-tooltip="Loads fast. No unnecessary complexity. Built for getting things done."
        data-toast="Loads fast. No unnecessary complexity. Built for getting things done."
      >Lightweight</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span
        class="footer-hint"
        data-tooltip="Most tools run entirely in your browser. Your data stays on your device."
        data-toast="Most tools run entirely in your browser. Your data stays on your device."
      >Private</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <MadeInIndia />
    </div>
    <a class="footer-link" href={withBase('/feedback/')}>Suggest a tool</a>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border);
    padding: var(--space-6) var(--space-4);
    margin-top: auto;
  }

  @media (min-width: 1024px) {
    footer {
      padding-inline: var(--space-6);
    }
  }

  .footer-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Sitewide, so every page carries one path to the feedback form. Pushed to the far end on
     desktop; on a phone it wraps to its own line rather than crowding the brand row. */
  .footer-link {
    margin-left: auto;
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    color: var(--color-accent);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .footer-link:hover {
    text-decoration: underline;
  }

  .footer-link:active {
    color: var(--color-accent-strong);
  }

  @media (max-width: 640px) {
    .footer-link {
      margin-left: 0;
    }
  }

  /* ── Hint words with tooltip ─────────────────────────────── */

  .footer-hint {
    position: relative;
    cursor: default;
  }

  /* Desktop: CSS tooltip via ::after */
  @media (hover: hover) and (pointer: fine) {
    .footer-hint::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: calc(100% + var(--space-2));
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      background: var(--color-text);
      color: var(--color-bg);
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      pointer-events: none;
      opacity: 0;
      transition: opacity 150ms ease;
      z-index: 10;
      max-width: 260px;
      white-space: normal;
      text-align: center;
    }

    .footer-hint:hover::after {
      opacity: 1;
    }
  }

  @media (max-width: 639px) {
    .footer-inner {
      font-size: var(--text-xs);
    }

    .footer-brand {
      gap: var(--space-2);
    }
  }
</style>

<script is:inline>
  (function () {
    /* Mobile tap toast — only for touch-primary devices */
    if (!window.matchMedia('(hover: none)').matches) return;
    document.querySelectorAll('.footer-hint[data-toast]').forEach(function (el) {
      el.addEventListener('click', function () {
        if (window.ToyTools && ToyTools.toast) {
          ToyTools.toast(el.getAttribute('data-toast'));
        }
      });
    });
  })();
</script>
