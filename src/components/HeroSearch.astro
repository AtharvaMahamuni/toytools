---
import { withBase } from '../lib/paths';
---

<form class="hero-search" action={withBase('/search/')} method="get" role="search">
  <label class="sr-only" for="hero-q">Search tools</label>
  <div class="hero-search-inner">
    <span class="hero-search-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
    <input
      type="search"
      id="hero-q"
      name="q"
      class="hero-search-input"
      placeholder="Search tools…"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit" class="hero-search-btn">Search</button>
  </div>
</form>

<style>
  .hero-search {
    width: 100%;
    max-width: 580px;
  }

  .hero-search-inner {
    display: flex;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: var(--transition-color);
    overflow: hidden;
    padding-right: 6px;
  }

  .hero-search-inner:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-subtle), var(--shadow-hover);
  }

  .hero-search-icon {
    display: flex;
    align-items: center;
    padding: 0 var(--space-3) 0 var(--space-4);
    color: var(--color-text-subtle);
    flex-shrink: 0;
    pointer-events: none;
  }

  .hero-search-input {
    flex: 1;
    min-width: 0;
    height: 52px;
    border: none;
    background: transparent;
    font-size: var(--text-base);
    color: var(--color-text);
    font-family: var(--font-sans);
    outline: none;
  }

  .hero-search-input::placeholder {
    color: var(--color-text-subtle);
  }

  .hero-search-btn {
    height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
    flex-shrink: 0;
  }

  .hero-search-btn:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  @media (max-width: 480px) {
    .hero-search-btn {
      padding: 0 var(--space-3);
      font-size: var(--text-xs);
    }
  }
</style>
