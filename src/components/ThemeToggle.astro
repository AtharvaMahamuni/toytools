---
// Light/dark toggle. Extracted from Nav.astro so the tool pages' own header can carry it too:
// tool pages render ToolBar instead of Nav, and the toggle's behaviour lived inside Nav's inline
// script, so without this the theme button would have rendered on tool pages and done nothing.
//
// The pre-paint theme application still happens in BaseLayout's <head>; this is only the control.
//
// `compact` is for the tool bar, where this is one of four icon controls on a 393px row. It
// narrows the button and hides it below 640px entirely. Both rules live HERE rather than in
// ToolBar, because Astro compiles a component's scoped styles to `.theme-toggle[data-astro-cid-x]`
// and an outside `.tool-bar .theme-toggle` ties that on specificity and loses on source order:
// the override silently did nothing for a day. A component owns its own variants.
//
// Hiding it on phones is a deliberate trade, not an oversight. A fourth control costs the tool's
// title 44px of a 393px bar, which pushed 17 pages onto a taller bar and 2 onto a 97px one. The
// star, install and search are all about the tool; the theme is not. The site already follows
// prefers-color-scheme, so a phone in dark mode is dark without touching anything, and /settings/
// carries a full Light/Dark/System control on the same key, linked from every footer.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<button class:list={['theme-toggle', { 'theme-toggle--compact': compact }]} aria-label="Toggle theme" type="button" data-theme-toggle>
  <span class="theme-icon theme-icon-moon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </span>
  <span class="theme-icon theme-icon-sun">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: background-color 150ms ease;
    color: var(--color-text-muted);
  }

  .theme-toggle:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* Tool bar variant: narrower, and gone below 640px. See the note in the frontmatter. */
  .theme-toggle--compact {
    width: 44px;
  }

  @media (max-width: 640px) {
    .theme-toggle--compact {
      display: none;
    }
  }

  /* Show moon in light mode (click → go dark), sun in dark mode (click → go light) */
  .theme-icon { display: flex; align-items: center; justify-content: center; }
  .theme-icon-moon { display: flex; }
  .theme-icon-sun  { display: none; }

  :root[data-theme="dark"] .theme-icon-moon { display: none; }
  :root[data-theme="dark"] .theme-icon-sun  { display: flex; }

  /* When system preference is dark and no override is set */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-icon-moon { display: none; }
    :root:not([data-theme="light"]) .theme-icon-sun  { display: flex; }
  }
</style>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var mq = matchMedia('(prefers-color-scheme: dark)');

    function applyTheme(mode) {
      if (mode === 'dark' || mode === 'light') html.dataset.theme = mode;
      else delete html.dataset.theme;
    }

    applyTheme(localStorage.getItem('toytools.theme') || 'system');

    var toggleBtn = document.querySelector('[data-theme-toggle]');
    if (!toggleBtn) return;
    toggleBtn.addEventListener('click', function () {
      var current = localStorage.getItem('toytools.theme') || 'system';
      var isDark = current === 'dark' || (current === 'system' && mq.matches);
      var next = isDark ? 'light' : 'dark';
      localStorage.setItem('toytools.theme', next);
      applyTheme(next);
      if (window.ToyTools) ToyTools.toast(next === 'dark' ? 'Dark theme' : 'Light theme');
    });
  })();
</script>
