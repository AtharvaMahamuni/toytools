---
// Store-style tool tile for category listings (and later shelves).
// Whole tile opens the tool; Install is a sibling control that deep-links with ?install=1.
// Do NOT embed InstallButton here — listing pages must not ship multi-instance fixed IDs.
import { withBase } from '@lib/paths';

interface Props {
  /** Tool slug — drives icon path and (for groups) the primary member. */
  slug: string;
  name: string;
  tagline: string;
  /** Category URL segment, e.g. "text". */
  segment: string;
  isNew?: boolean;
  /** Accessible name for the Install control; defaults to `Install ${name}`. */
  installLabel?: string;
}

const { slug, name, tagline, segment, isNew = false, installLabel } = Astro.props;
const href = withBase(`/tool/${segment}/${slug}/`);
const installHref = withBase(`/tool/${segment}/${slug}/?install=1`);
const iconSrc = withBase(`/icons/tool/${slug}.svg`);
const installAria = installLabel ?? `Install ${name}`;
---

<div class="app-tile">
  <a class="app-tile-main" href={href} data-slug={slug}>
    <img class="app-tile-icon" src={iconSrc} width="56" height="56" alt="" loading="lazy" decoding="async" />
    <span class="app-tile-name">
      {name}
      {isNew && <span class="app-tile-badge">New</span>}
    </span>
    <span class="app-tile-tagline">{tagline}</span>
  </a>
  <a
    class="app-tile-install"
    href={installHref}
    data-app-tile-install
    aria-label={installAria}
  >Install</a>
</div>

<style>
  .app-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: var(--transition-color);
  }

  .app-tile:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .app-tile-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    color: var(--color-text);
  }

  .app-tile-main:hover {
    text-decoration: none;
    color: var(--color-text);
  }

  .app-tile-icon {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .app-tile-name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }

  .app-tile-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }

  .app-tile-tagline {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .app-tile-install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .app-tile-install:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
    text-decoration: none;
  }

  /* Hidden by the category-list script when standalone / Firefox — same honesty as InstallButton. */
  .app-tile-install.is-hidden {
    display: none;
  }
</style>
