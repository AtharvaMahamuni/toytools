---
// Shared client-side runtime — inlined once in BaseLayout.
// Exposes window.ToyTools global so all Widget inline scripts can call
// ToyTools.toast(), ToyTools.storage.get/set/clear(), ToyTools.copy(),
// ToyTools.analyze(), ToyTools.formatMetric().
---

<!-- Bundled: attaches text engine to the ToyTools global (single source of truth) -->
<script>
  import { analyzeText } from '@lib/text/analysis';
  import { formatMetric } from '@lib/text/formatters';
  import { runProcessor } from '@lib/text/processors/registry';
  import { runEncoding, encodingProvider } from '@lib/engines/encoding/registry';
  import { runHash, hashingProvider } from '@lib/engines/hashing/registry';
  import { runStructuredData } from '@lib/engines/structured-data/registry';
  import { runCsv } from '@lib/engines/csv/registry';
  import { runJwt } from '@lib/engines/jwt/registry';
  import { runFinance } from '@lib/engines/finance/registry';
  import { runDateTime } from '@lib/engines/datetime/registry';
  import { runMath } from '@lib/engines/math/registry';
  import { runWellness } from '@lib/engines/wellness/registry';
  import { tracker } from '@lib/engines/tracker/registry';
  import { runGeneration } from '@lib/generation/registry';
  import { renderExperience } from '@lib/experience/render';
  import { diffLines, diffStats } from '@lib/text/compare';
  import { jsonExplorer } from '@lib/json/explorer';
  import { yamlSerializer } from '@lib/json/yaml';
  import { csvSerializer } from '@lib/csv/csv';
  import { analyticsEnabled, GA_MEASUREMENT_ID } from '@lib/analytics/guard';
  const TT = ((window as any).ToyTools ??= {});

  // Google Analytics — loaded here (not in BaseLayout) so it can be fully gated
  // by the analytics guard. For real users it injects gtag.js and wires
  // ToyTools.track(name, params); for tests/dev/localhost/automation it stays a
  // no-op and never makes a network request. All custom events must go through
  // ToyTools.track — never call gtag() directly.
  if (analyticsEnabled) {
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.gtag = w.gtag || function () { w.dataLayer.push(arguments); };
    w.gtag('js', new Date());
    w.gtag('config', GA_MEASUREMENT_ID);
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
    document.head.appendChild(s);
    TT.track = function (name: string, params?: Record<string, unknown>) {
      try { w.gtag('event', name, params); } catch (_) { /* never break the UI */ }
    };
  } else {
    TT.track = function () { /* analytics disabled for this session */ };
  }

  // Progressive Web App — register the service worker so tools work offline and
  // can be installed to the home screen. Gated exactly like analytics (real
  // production users only: never in dev, E2E, automation, or localhost), so test
  // runs and local previews are never controlled by a caching worker.
  if (analyticsEnabled && 'serviceWorker' in navigator) {
    const swUrl = (import.meta.env.BASE_URL || '/') + 'sw.js';
    const swScope = import.meta.env.BASE_URL || '/';
    window.addEventListener('load', () => {
      navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => { /* never break the UI */ });
    });
  }

  TT.analyze = analyzeText;
  TT.formatMetric = formatMetric;
  TT.process = runProcessor; // ToyTools.process(processorId, text) → transformed text
  TT.runEncoding = runEncoding; // ToyTools.runEncoding(id, mode, text) → { ok, output, error }

  // Generic transform facade — engine-agnostic surface the ConverterWidget speaks.
  // Dispatches by `kind` to a registered provider; encoding is the first. New kinds
  // (hashing, rot13, base32, …) register here without touching the widget. Every verb
  // degrades to a safe neutral default when a kind has no provider yet.
  const TRANSFORM_PROVIDERS: Record<string, typeof encodingProvider> = {
    encoding: encodingProvider,
    hashing: hashingProvider,
  };
  TT.transform = {
    run: (kind: string, id: string, mode: string, input: string) => {
      const p = TRANSFORM_PROVIDERS[kind];
      return p ? p.run(id, mode, input) : { ok: true, output: input };
    },
    detect: (kind: string, id: string, input: string) => {
      const p = TRANSFORM_PROVIDERS[kind];
      return p ? p.detect(id, input) : { mode: 'encode', confidence: 'low' };
    },
    validate: (kind: string, id: string, mode: string, input: string) => {
      const p = TRANSFORM_PROVIDERS[kind];
      return p ? p.validate(id, mode, input) : { ok: true };
    },
    meta: (kind: string, id: string, input: string, output: string, mode: string) => {
      const p = TRANSFORM_PROVIDERS[kind];
      return p ? p.meta(id, input, output, mode) : [];
    },
    info: (kind: string, id: string) => {
      const p = TRANSFORM_PROVIDERS[kind];
      return p
        ? p.info(id)
        : { displayName: id, reversible: true, modes: { forward: 'encode', inverse: 'decode' } };
    },
  };
  TT.runHash = runHash; // ToyTools.runHash(id, text) → Promise<string> (hex digest)
  TT.runStructuredData = runStructuredData; // ToyTools.runStructuredData(id, input) → { ok, output, error }
  TT.runCsv = runCsv; // ToyTools.runCsv(id, input, second?) → { ok, output, error, summary }
  TT.runJwt = runJwt; // ToyTools.runJwt(id, token) → { ok, decoded, error }
  TT.runFinance = runFinance; // ToyTools.runFinance(id, input, { currency }) → InteractiveResult
  TT.runDateTime = runDateTime; // ToyTools.runDateTime(id, input, { timezone?, locale? }) → InteractiveResult
  TT.runMath = runMath; // ToyTools.runMath(id, input, { locale? }) → InteractiveResult
  TT.runWellness = runWellness; // ToyTools.runWellness(id, input, { locale? }) → InteractiveResult
  TT.tracker = tracker; // ToyTools.tracker.* — stateful tracker model + streaks + inline-SVG charts
  TT.runGeneration = runGeneration; // ToyTools.runGeneration(id, options) → GenerationResult
  TT.experience = { render: renderExperience }; // ToyTools.experience.render(root, result) → fills the experience shell
  TT.diff = diffLines; // ToyTools.diff(a, b) → DiffResult[]
  TT.diffStats = diffStats; // ToyTools.diffStats(result) → { added, removed, unchanged, similarity }
  TT.json = jsonExplorer; // ToyTools.json.parse/stats/search — reusable JSON Explorer Core
  TT.yaml = yamlSerializer; // ToyTools.yaml.serialize(value, opts) → YAML string
  TT.csv = csvSerializer; // ToyTools.csv.parse(text, opts) / .serialize(rows, headers) — CSV core

  // These engine fns attach via this *deferred module*, but widget inline scripts run
  // during parse — so a widget's first render can't call them yet. Flush onReady() now.
  TT.ready = true;
  if (TT._readyCbs) {
    TT._readyCbs.forEach((fn: () => void) => { try { fn(); } catch (_) { /* ignore */ } });
    TT._readyCbs = [];
  }
</script>

<script is:inline>
(function (TT) {
  var _toastTimer;

  // Engine readiness: this inline script runs during parse (so state/toast/copy are
  // available immediately), but analyze/formatMetric/runEncoding/etc. attach via a
  // deferred module. Widgets that compute on load schedule via onReady() so their
  // first render waits for the engine functions instead of throwing.
  TT.ready = TT.ready || false;
  TT._readyCbs = TT._readyCbs || [];

  // Safe stub until the deferred module wires the real (guarded) tracker.
  TT.track = TT.track || function () {};
  TT.onReady = function (fn) {
    if (TT.ready) { try { fn(); } catch (_) {} return; }
    TT._readyCbs.push(fn);
  };

  TT.toast = function (msg, ms) {
    var el = document.getElementById('tt-toast');
    if (!el) {
      el = document.createElement('div');
      el.id = 'tt-toast';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      document.body.appendChild(el);
    }
    el.textContent = msg;
    clearTimeout(_toastTimer);
    el.classList.add('tt-visible');
    _toastTimer = setTimeout(function () { el.classList.remove('tt-visible'); }, ms || 2000);
  };

  TT.storage = {
    MAX: 50000,
    get: function (key) {
      try { return localStorage.getItem(key) || ''; } catch (_) { return ''; }
    },
    set: function (key, val, max) {
      try {
        if (val.length < (max || TT.storage.MAX)) localStorage.setItem(key, val);
      } catch (_) {}
    },
    clear: function (key) {
      try { localStorage.removeItem(key); } catch (_) {}
    }
  };

  // Versioned per-tool state: one JSON envelope per tool under "toytools:{toolId}".
  // Never throws; corruption yields null (caller uses defaults).
  //
  // Durability rules, because some of this data is irreplaceable (a year of weight
  // logs cannot be recomputed the way a converter's last input can):
  //  - a write that exceeds the cap or the browser quota TELLS the user instead of
  //    failing silently, which is how a tracker could quietly stop saving,
  //  - an older envelope is MIGRATED rather than discarded, so bumping VERSION no
  //    longer means wiping everyone's history.
  TT.state = {
    PREFIX: 'toytools:',
    VERSION: 1,
    // v -> fn(data) returning the next version's shape. Register a step per bump; load()
    // walks them in order. A missing step means that version is unmigratable, so the
    // caller falls back to defaults (the pre-existing behaviour) rather than crashing.
    MIGRATIONS: {},
    save: function (toolId, data) {
      var payload;
      try { payload = JSON.stringify({ v: TT.state.VERSION, data: data }); } catch (_) { return false; }
      if (payload.length > TT.storage.MAX) {
        TT.toast('That is too much data to save in this browser.');
        return false;
      }
      try {
        localStorage.setItem(TT.state.PREFIX + toolId, payload);
        return true;
      } catch (_) {
        // Quota exhausted, or storage blocked (private mode, disabled cookies).
        TT.toast('Could not save: this browser is out of storage space.');
        return false;
      }
    },
    load: function (toolId) {
      try {
        var raw = localStorage.getItem(TT.state.PREFIX + toolId);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed.v !== 'number') return null;
        var v = parsed.v;
        var data = parsed.data;
        while (v < TT.state.VERSION) {
          var step = TT.state.MIGRATIONS[v];
          if (!step) return null;
          data = step(data);
          v++;
        }
        return v === TT.state.VERSION ? data : null;
      } catch (_) { return null; }
    },
    clear: function (toolId) {
      try { localStorage.removeItem(TT.state.PREFIX + toolId); } catch (_) {}
    }
  };

  // Portability — the escape hatch behind the "never leaves your device" promise. Every
  // tracker's log and every saved profile lives only in this browser, so without an export
  // clearing site data is permanent loss. Covers every toytools:* key, so one file is a full
  // backup and restoring it on a new device carries the whole account across.
  TT.data = {
    KEY_PREFIX: 'toytools:',
    FORMAT: 'toytools.backup.v1',
    collect: function () {
      var out = {};
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf(TT.data.KEY_PREFIX) === 0) out[k] = localStorage.getItem(k);
        }
      } catch (_) {}
      return out;
    },
    /** A JSON backup string of every toytools:* key. */
    serialize: function () {
      return JSON.stringify({ format: TT.data.FORMAT, exported: new Date().toISOString(), keys: TT.data.collect() }, null, 2);
    },
    /** Trigger a download of the backup. Returns the number of keys written. */
    download: function () {
      var payload = TT.data.serialize();
      var count = Object.keys(TT.data.collect()).length;
      try {
        var blob = new Blob([payload], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'toytools-backup-' + new Date().toISOString().slice(0, 10) + '.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      } catch (_) {
        TT.toast('Could not export in this browser.');
        return 0;
      }
      return count;
    },
    /**
     * Restore a backup string. Merges (never wipes keys the file does not mention) so importing
     * a tracker backup cannot destroy an unrelated tool's data. Returns { ok, restored, error }.
     */
    restore: function (text) {
      var parsed;
      try { parsed = JSON.parse(text); } catch (_) { return { ok: false, restored: 0, error: 'That file is not valid JSON.' }; }
      if (!parsed || parsed.format !== TT.data.FORMAT || !parsed.keys || typeof parsed.keys !== 'object') {
        return { ok: false, restored: 0, error: 'That is not a ToyTools backup file.' };
      }
      var restored = 0;
      for (var k in parsed.keys) {
        if (k.indexOf(TT.data.KEY_PREFIX) !== 0) continue; // never write outside our namespace
        var val = parsed.keys[k];
        if (typeof val !== 'string') continue;
        try { localStorage.setItem(k, val); restored++; } catch (_) {
          return { ok: false, restored: restored, error: 'Ran out of storage part-way through.' };
        }
      }
      return { ok: true, restored: restored };
    },
    /**
     * Ask the browser to exempt this origin from storage eviction. Safari caps script-writable
     * storage for origins without recent first-party interaction, which is exactly the pattern of
     * someone who logs a weight once a week. Best-effort and silent: never blocks or prompts.
     */
    persist: function () {
      try {
        if (navigator.storage && navigator.storage.persist) navigator.storage.persist();
      } catch (_) {}
    },
    /** Remaining share of the storage budget, 0..1, or null when the browser will not say. */
    pressure: function () {
      try {
        if (!(navigator.storage && navigator.storage.estimate)) return Promise.resolve(null);
        return navigator.storage.estimate().then(function (e) {
          if (!e || !e.quota) return null;
          return (e.usage || 0) / e.quota;
        }).catch(function () { return null; });
      } catch (_) { return Promise.resolve(null); }
    }
  };

  // Body profile — the facts about YOU that several health tools each need. Deliberately its own
  // key rather than a field of any tool's state, so it survives one tool's schema change and exports
  // on its own. Without it a user walking BMI -> TDEE -> body fat retypes height four times, units
  // four times, sex three times and weight three times, on a phone.
  //
  // Only ever holds what a health calculator already asks for on screen. Nothing is inferred, and
  // the widget always shows what it filled in, so this is a convenience, never a hidden dossier.
  TT.profile = {
    KEY: 'toytools:profile:body',
    FIELDS: ['unit', 'sex', 'age', 'height', 'weight'],
    get: function () {
      try { return JSON.parse(localStorage.getItem(TT.profile.KEY)) || {}; } catch (_) { return {}; }
    },
    /** Merge in the recognised fields of `values`; blank/absent values never overwrite a good one. */
    merge: function (values) {
      var all = TT.profile.get();
      var changed = false;
      for (var i = 0; i < TT.profile.FIELDS.length; i++) {
        var k = TT.profile.FIELDS[i];
        var v = values[k];
        if (v === undefined || v === null || v === '') continue;
        if (String(all[k]) === String(v)) continue;
        all[k] = v;
        changed = true;
      }
      if (!changed) return all;
      try { localStorage.setItem(TT.profile.KEY, JSON.stringify(all)); } catch (_) {}
      return all;
    },
    clear: function () {
      try { localStorage.removeItem(TT.profile.KEY); } catch (_) {}
    },
    /**
     * A derived number one tool produced that another needs as INPUT (TDEE's maintenance calories
     * are the macro calculator's starting point). Kept beside the profile rather than in either
     * tool's state, since it belongs to neither.
     */
    setDerived: function (name, value) {
      var all = TT.profile.get();
      if (!all.derived) all.derived = {};
      if (String(all.derived[name]) === String(value)) return;
      all.derived[name] = value;
      try { localStorage.setItem(TT.profile.KEY, JSON.stringify(all)); } catch (_) {}
    },
    getDerived: function (name) {
      var d = TT.profile.get().derived;
      return d ? d[name] : undefined;
    },

    /** Human summary for the "using your saved details" line, e.g. "male, 30, 175 cm, 70 kg". */
    summary: function () {
      var p = TT.profile.get();
      var metric = p.unit !== 'imperial';
      var bits = [];
      if (p.sex) bits.push(p.sex);
      if (p.age) bits.push(p.age);
      if (p.height) bits.push(p.height + (metric ? ' cm' : ' in'));
      if (p.weight) bits.push(p.weight + (metric ? ' kg' : ' lb'));
      return bits.join(', ');
    }
  };

  // Interaction memory — cross-tool UI preferences (how the user likes to interact), distinct from
  // per-tool entered values (TT.state). One JSON blob under "toytools:prefs". Never throws. Engine-
  // agnostic: preferred currency, number format, expanded sections, timeline granularity, etc., so
  // every interactive engine inherits the same memory.
  TT.prefs = {
    KEY: 'toytools:prefs',
    all: function () {
      try { return JSON.parse(localStorage.getItem(TT.prefs.KEY)) || {}; } catch (_) { return {}; }
    },
    get: function (name, fallback) {
      var v = TT.prefs.all()[name];
      return v === undefined ? fallback : v;
    },
    set: function (name, value) {
      try {
        var all = TT.prefs.all();
        all[name] = value;
        localStorage.setItem(TT.prefs.KEY, JSON.stringify(all));
      } catch (_) {}
    }
  };

  // Session history — last few conversions per tool, sessionStorage only (cleared when
  // the tab closes; never written to localStorage). Privacy-first: deduped on input,
  // most-recent-first, capped at 5. Never throws.
  TT.history = {
    PREFIX: 'toytools:hist:',
    MAX: 5,
    get: function (key) {
      try {
        var raw = sessionStorage.getItem(TT.history.PREFIX + key);
        var arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr : [];
      } catch (_) { return []; }
    },
    push: function (key, item) {
      try {
        var arr = TT.history.get(key).filter(function (e) { return e && e.input !== item.input; });
        arr.unshift(item);
        if (arr.length > TT.history.MAX) arr = arr.slice(0, TT.history.MAX);
        sessionStorage.setItem(TT.history.PREFIX + key, JSON.stringify(arr));
        return arr;
      } catch (_) { return TT.history.get(key); }
    },
    clear: function (key) {
      try { sessionStorage.removeItem(TT.history.PREFIX + key); } catch (_) {}
    }
  };

  // Recent tools — deduped, most-recent-first, capped at 10.
  TT.recordRecent = function (slug, category) {
    try {
      var KEY = 'toytools:recent-tools';
      var list = [];
      try { list = JSON.parse(localStorage.getItem(KEY)) || []; } catch (_) {}
      if (!Array.isArray(list)) list = [];
      list = list.filter(function (e) { return e && e.slug !== slug; });
      list.unshift({ slug: slug, category: category, lastUsed: Date.now() });
      if (list.length > 10) list = list.slice(0, 10);
      localStorage.setItem(KEY, JSON.stringify(list));
    } catch (_) {}
  };
  TT.getRecent = function () {
    try {
      var list = JSON.parse(localStorage.getItem('toytools:recent-tools')) || [];
      return Array.isArray(list) ? list : [];
    } catch (_) { return []; }
  };

  // Focus controls — Full Screen, Remove Distractions, Keep Awake (Wake Lock).
  // Shared by notepad, todo-list. Promotes the existing .tool-panel in place via
  // the .tt-focus class so the live tool stays interactive.
  TT.focus = (function () {
    var wakeSupported = ('wakeLock' in navigator);

    function nativeRequest(el) {
      var r = el.requestFullscreen || el.webkitRequestFullscreen ||
              el.mozRequestFullScreen || el.msRequestFullscreen;
      return r ? r.call(el) : null;
    }
    function nativeExit() {
      var x = document.exitFullscreen || document.webkitExitFullscreen ||
              document.mozCancelFullScreen || document.msExitFullscreen;
      if (x && (document.fullscreenElement || document.webkitFullscreenElement)) x.call(document);
    }
    function inNativeFs() {
      return !!(document.fullscreenElement || document.webkitFullscreenElement);
    }

    function attach(opts) {
      var panel = opts.panel;
      if (!panel) return null;
      var active = false, usedNative = false;
      var wakeLock = null, wakeOn = false;

      function setPressed(btn, on) { if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false'); }

      function enter(useNative) {
        if (active) return;
        active = true; usedNative = !!useNative;
        panel.classList.add('tt-focus');
        document.body.classList.add('tt-focus-lock');
        setPressed(opts.fsBtn, useNative);
        setPressed(opts.rdBtn, !useNative);
        if (opts.exitBtn) opts.exitBtn.hidden = false;
        if (useNative) { var p = nativeRequest(document.documentElement); if (p && p.catch) p.catch(function () {}); }
        if (typeof opts.onEnter === 'function') opts.onEnter();
      }

      function exit() {
        if (!active) return;
        active = false;
        panel.classList.remove('tt-focus');
        document.body.classList.remove('tt-focus-lock');
        setPressed(opts.fsBtn, false);
        setPressed(opts.rdBtn, false);
        if (opts.exitBtn) opts.exitBtn.hidden = true;
        if (usedNative) nativeExit();
        usedNative = false;
      }

      // Wake Lock — independent of focus mode.
      function reacquire() {
        if (document.visibilityState === 'visible' && wakeOn && wakeLock === null) {
          document.removeEventListener('visibilitychange', reacquire);
          requestWake();
        }
      }
      function requestWake() {
        navigator.wakeLock.request('screen').then(function (lock) {
          wakeLock = lock;
          lock.addEventListener('release', function () {
            wakeLock = null;
            if (wakeOn) document.addEventListener('visibilitychange', reacquire);
          });
        }).catch(function () { wakeOn = false; setPressed(opts.wakeBtn, false); });
      }
      function toggleWake() {
        if (wakeOn) {
          wakeOn = false; setPressed(opts.wakeBtn, false);
          document.removeEventListener('visibilitychange', reacquire);
          if (wakeLock) { wakeLock.release(); wakeLock = null; }
          TT.toast('Screen wake released');
        } else {
          wakeOn = true; setPressed(opts.wakeBtn, true);
          requestWake();
          TT.toast('Keeping screen awake');
        }
      }

      if (opts.fsBtn) opts.fsBtn.addEventListener('click', function () { active ? exit() : enter(true); });
      if (opts.rdBtn) opts.rdBtn.addEventListener('click', function () { active ? exit() : enter(false); });
      if (opts.exitBtn) opts.exitBtn.addEventListener('click', exit);
      if (opts.wakeBtn) {
        if (!wakeSupported) opts.wakeBtn.hidden = true;
        else opts.wakeBtn.addEventListener('click', toggleWake);
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && active && !inNativeFs()) exit();
      });
      function onFsChange() { if (active && usedNative && !inNativeFs()) exit(); }
      document.addEventListener('fullscreenchange', onFsChange);
      document.addEventListener('webkitfullscreenchange', onFsChange);

      return { enter: enter, exit: exit, isActive: function () { return active; } };
    }

    return { attach: attach, wakeSupported: wakeSupported };
  })();
  TT.mobileTooltip = function (triggerEl, message) {
    triggerEl.addEventListener('click', function (e) {
      if (window.matchMedia('(hover: hover)').matches) return;
      e.preventDefault();
      e.stopPropagation();
      TT.toast(message);
    });
  };

  TT.copy = function (text, emptyMsg) {
    if (!text || !text.trim()) { TT.toast(emptyMsg || 'Nothing to copy!'); return; }
    function legacy(t) {
      try {
        var ta = document.createElement('textarea');
        ta.value = t;
        ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      } catch (_) {}
    }
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).catch(function () { legacy(text); });
    } else {
      legacy(text);
    }
    TT.toast('Copied!');
  };

  // ── Global keyboard shortcuts ─────────────────────────────────────────
  // "/" focuses search; Esc blurs an active field; Ctrl/Cmd+Shift+C/X drive the
  // primary Copy/Clear actions. Never hijacks normal typing (except Esc-to-blur).
  function isTyping(el) {
    if (!el) return false;
    var tag = el.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable;
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === '/' && !isTyping(document.activeElement) && !e.metaKey && !e.ctrlKey && !e.altKey) {
      var q = document.getElementById('q');
      if (q) { e.preventDefault(); q.focus(); }
      return;
    }
    if (e.key === 'Escape' && isTyping(document.activeElement)) {
      document.activeElement.blur();
      return;
    }
    if ((e.metaKey || e.ctrlKey) && e.shiftKey) {
      var k = (e.key || '').toLowerCase();
      if (k === 'c') {
        var copyBtn = document.querySelector('[data-action="copy"], #pct-copy');
        if (copyBtn) { e.preventDefault(); copyBtn.click(); }
      } else if (k === 'x') {
        var clearBtn = document.querySelector('[data-action="clear"], #pct-clear');
        if (clearBtn) { e.preventDefault(); clearBtn.click(); clearBtn.click(); }
      }
    }
  });

  // ── Clickable stat rows ───────────────────────────────────────────────
  // Any .tm-stat-row copies "Label: Value" on click/Enter/Space. Wired once
  // here (delegated) so every metric widget gets it without duplicating logic.
  function copyStatRow(row) {
    var label = row.querySelector('.tm-stat-label');
    var value = row.querySelector('.tm-stat-value');
    if (!label || !value) return;
    TT.copy(label.textContent.trim() + ': ' + value.textContent.trim());
    row.classList.add('is-copied');
    setTimeout(function () { row.classList.remove('is-copied'); }, 800);
  }
  document.addEventListener('click', function (e) {
    var row = e.target.closest && e.target.closest('.tm-stat-row');
    if (row) copyStatRow(row);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var row = e.target.closest && e.target.closest('.tm-stat-row');
    if (row) { e.preventDefault(); copyStatRow(row); }
  });
  function wireStatRows() {
    var rows = document.querySelectorAll('.tm-stat-row');
    for (var i = 0; i < rows.length; i++) {
      rows[i].setAttribute('role', 'button');
      rows[i].setAttribute('tabindex', '0');
      rows[i].setAttribute('title', 'Click to copy');
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', wireStatRows);
  } else {
    wireStatRows();
  }

})(window.ToyTools = window.ToyTools || {});
</script>
