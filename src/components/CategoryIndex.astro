---
// Category Index — store-style home shelves.
//
// One horizontal AppTile shelf per category (title, count, See all → /category/{slug}/).
// Tiles prefer category.highlights; fallback is the first N tools in the category so a new
// category still renders before anyone authors examples. Cap stays at 3 to match
// validate-registry and keep the homepage HTML budget honest — do not dump the catalog here.
// The closed ToolDirectory below remains the SEO / power-user full list.
import type { Category, ToolConfig } from '@data/types';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { withBase } from '@lib/paths';
import AppTile from '@components/AppTile.astro';

/** Hard cap per shelf — matches category.highlights validation and home HTML budget. */
const TILES_PER_SHELF = 3;

interface ShelfTile {
  slug: string;
  name: string;
  tagline: string;
  isNew: boolean;
}

function labelFor(category: Category): string {
  if (category.tagline) return category.tagline;
  const [first] = category.description.split('. ');
  return first?.endsWith('.') ? first : `${first}.`;
}

function tilesFor(category: Category): ShelfTile[] {
  const categoryTools = tools.filter(t => t.categorySlug === category.slug);
  const bySlug = new Map(categoryTools.map(t => [t.slug, t]));
  const chosen = (category.highlights ?? [])
    .map(slug => bySlug.get(slug))
    .filter((t): t is ToolConfig => Boolean(t));
  const picked = chosen.length > 0 ? chosen : categoryTools.slice(0, TILES_PER_SHELF);
  return picked.slice(0, TILES_PER_SHELF).map(t => ({
    slug: t.slug,
    name: t.name,
    tagline: t.tagline || t.description,
    isNew: Boolean(t.isNew),
  }));
}

const shelves = categories.map(category => ({
  slug: category.slug,
  name: category.name,
  href: withBase(`/category/${category.slug}/`),
  tagline: labelFor(category),
  count: category.toolCount,
  accent: category.accent,
  segment: category.segment,
  tiles: tilesFor(category),
}));
---

<div class="category-shelves" aria-label="Browse tools by category">
  {shelves.map(shelf => (
    <section
      class="shelf"
      style={shelf.accent ? `--cat-accent: ${shelf.accent}` : ''}
      aria-labelledby={`shelf-${shelf.slug}`}
    >
      <div class="shelf-head">
        <h2 class="shelf-title" id={`shelf-${shelf.slug}`}>
          <a class="shelf-name" href={shelf.href}>
            <span class="shelf-dot" aria-hidden="true"></span>
            <span class="shelf-name-text">{shelf.name}</span>
            <span class="shelf-count">{shelf.count}</span>
          </a>
        </h2>
        <a class="shelf-see-all" href={shelf.href}>See all</a>
      </div>
      <p class="shelf-tagline">{shelf.tagline}</p>
      <ul class="shelf-track">
        {shelf.tiles.map(tile => (
          <li class="shelf-item">
            <AppTile
              slug={tile.slug}
              name={tile.name}
              tagline={tile.tagline}
              segment={shelf.segment}
              isNew={tile.isNew}
            />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

{/* Same honesty as category listings: hide Install when standalone or Firefox. */}
<script is:inline>
  (function () {
    function hideInstalls() {
      try {
        var standalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        var firefox = /firefox|fxios/i.test(navigator.userAgent || '');
        if (!standalone && !firefox) return;
        var nodes = document.querySelectorAll('[data-app-tile-install]');
        for (var i = 0; i < nodes.length; i++) nodes[i].classList.add('is-hidden');
      } catch (e) {}
    }
    hideInstalls();
  })();
</script>

<style>
  .category-shelves {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .shelf {
    min-width: 0;
  }

  .shelf-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .shelf-title {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    margin: 0;
    min-width: 0;
  }

  .shelf-name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .shelf-name:hover,
  .shelf-name:active {
    color: var(--color-accent);
    text-decoration: none;
  }

  .shelf-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat-accent, var(--color-accent));
  }

  .shelf-name-text {
    flex: 1;
    min-width: 0;
  }

  .shelf-count {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .shelf-see-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .shelf-see-all:hover,
  .shelf-see-all:active {
    color: var(--color-accent);
    text-decoration: none;
  }

  .shelf-tagline {
    margin: 0 0 var(--space-4);
    max-width: unset;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  /* Horizontal store shelf. Scroll lives on the track so body overflow-x:hidden stays intact. */
  .shelf-track {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    /* Fade the trailing edge so a sliced tile reads as "more" rather than broken. */
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
  }

  .shelf-item {
    flex: 0 0 auto;
    width: 168px;
    min-width: 0;
  }

  @media (max-width: 480px) {
    .shelf-item {
      width: 148px;
    }
  }
</style>
