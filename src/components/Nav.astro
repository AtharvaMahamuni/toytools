---
import { withBase } from '../lib/paths';
import { APP_VERSION } from '../lib/version';
---

<header role="banner">
  <nav class="nav-inner" aria-label="Main">
    <span class="nav-brand">
      {/* The site mark replaces the trailing gold dot rather than joining it: two brand
          marks in one nav is noise, and the dot lives inside the mark now. Carrying the
          mark lets the wordmark drop a size and still read as the brand. */}
      <a href={withBase('/')} class="nav-logo">
        <img class="nav-mark" src={withBase('/favicon.svg')} width="20" height="20" alt="" />
        <span>ToyTools</span>
      </a>
      {/* The badge advertised a version with nothing to click through to; it links to the changelog now. */}
      <a href={withBase('/changelog/')} class="nav-version" aria-label={`ToyTools ${APP_VERSION}, see changelog`}>{APP_VERSION}<span class="nav-version-tooltip tt-tooltip" role="tooltip"><strong>Alpha Version</strong>Major UI revamp under progress.<br/>See what has changed.</span></a>
    </span>
    {/*
      A real link to the working search page, upgraded by JS into the command palette. Without it
      there is no way to reach another tool from a tool page except going home, and the "/" shortcut
      had nothing to focus anywhere but the home page.
    */}
    <a href={withBase('/search/')} class="nav-search" data-palette-open aria-label="Search tools">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span class="nav-search-label">Search tools</span>
      {/* Ctrl K rather than "/", because most tool pages autofocus their input and "/" correctly
          yields to whatever you are typing. Cmd K works too (the handler checks both). */}
      <kbd class="nav-search-kbd" aria-hidden="true">Ctrl K</kbd>
    </a>
    <button class="theme-toggle" aria-label="Toggle theme" type="button" data-theme-toggle>
      <span class="theme-icon theme-icon-moon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </span>
      <span class="theme-icon theme-icon-sun">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </span>
    </button>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: var(--border);
  }

  .nav-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    min-height: calc(var(--touch-target) + var(--space-4));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Down from --text-lg bold. The mark now carries the recognition, so the wordmark
     does not have to shout: the brand reads at a glance while taking less of the eye
     than the tool the visitor actually came for. */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .nav-logo:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-mark {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
  }

  .nav-version {
    position: relative;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-subtle);
    margin-left: 8px;
    white-space: nowrap;
    text-decoration: none;
    transition: var(--transition-color);
  }

  .nav-version:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .nav-version {
      font-size: 11px;
    }
  }

  .nav-version-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: calc(var(--z-nav) + 1);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-version-tooltip strong {
    display: block;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .nav-version:hover .nav-version-tooltip,
  .nav-version:focus-within .nav-version-tooltip {
    display: block;
    opacity: 1;
  }

  /* ── Theme toggle ─────────────────────────────────────────── */

  /* Reads as a search field but is a link, so it works with JS off and keeps the palette
     purely an enhancement. Sits between the logo and the theme toggle. */
  .nav-search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    color: var(--color-text-subtle);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .nav-search:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-search:active {
    background: var(--color-bg-tertiary);
  }

  .nav-search-label {
    white-space: nowrap;
  }

  .nav-search-kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 2px 6px;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  /* Phones: icon only, still a full 48px target. The label and hint would crowd the logo,
     and a physical keyboard hint is meaningless on a touch device. */
  @media (max-width: 640px) {
    .nav-search {
      min-width: var(--touch-target);
      justify-content: center;
      padding: 0;
    }

    .nav-search-label,
    .nav-search-kbd {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: background-color 150ms ease;
    color: var(--color-text-muted);
  }

  .theme-toggle:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* Show moon in light mode (click → go dark), sun in dark mode (click → go light) */
  .theme-icon { display: flex; align-items: center; justify-content: center; }
  .theme-icon-moon { display: flex; }
  .theme-icon-sun  { display: none; }

  :root[data-theme="dark"] .theme-icon-moon { display: none; }
  :root[data-theme="dark"] .theme-icon-sun  { display: flex; }

  /* When system preference is dark and no override is set */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-icon-moon { display: none; }
    :root:not([data-theme="light"]) .theme-icon-sun  { display: flex; }
  }
</style>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var mq = matchMedia('(prefers-color-scheme: dark)');
    var mqListener = null;

    function applyTheme(mode) {
      if (mode === 'dark') {
        html.dataset.theme = 'dark';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else if (mode === 'light') {
        html.dataset.theme = 'light';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else {
        delete html.dataset.theme;
        if (!mqListener) {
          mqListener = function () {};
          mq.addEventListener('change', mqListener);
        }
      }
    }

    var stored = localStorage.getItem('toytools.theme') || 'system';
    applyTheme(stored);

    // No mobileTooltip on the version badge any more: it is a link to the changelog now, and
    // mobileTooltip preventDefaults on touch devices, so it would swallow the tap and show a
    // toast instead of navigating. The changelog says what the toast said, and more.

    var toggleBtn = document.querySelector('[data-theme-toggle]');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function () {
        var current = localStorage.getItem('toytools.theme') || 'system';
        var isDark = current === 'dark' || (current === 'system' && mq.matches);
        var next = isDark ? 'light' : 'dark';
        localStorage.setItem('toytools.theme', next);
        applyTheme(next);
        if (window.ToyTools) ToyTools.toast(next === 'dark' ? 'Dark theme' : 'Light theme');
      });
    }
  })();
</script>
