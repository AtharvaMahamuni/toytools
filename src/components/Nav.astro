---
import SearchBar from './SearchBar.astro';
import { withBase } from '../lib/paths';
---

<header role="banner">
  <div class="nav-inner">
    <a href={withBase('/')} class="nav-logo">ToyTools</a>
    <div class="nav-search">
      <SearchBar />
    </div>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
      <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="m4.93 4.93 1.41 1.41" />
        <path d="m17.66 17.66 1.41 1.41" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="m6.34 17.66-1.41 1.41" />
        <path d="m19.07 4.93-1.41 1.41" />
      </svg>
      <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.9 13.5A8 8 0 1 1 10.5 3.1 6 6 0 0 0 20.9 13.5Z" />
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: var(--border);
  }

  .nav-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    min-height: calc(var(--touch-target) + var(--space-4));
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-logo {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .nav-logo:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-search {
    flex: 1;
    min-width: 0;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--touch-target);
    height: var(--touch-target);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: var(--transition-color);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-bg-tertiary);
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var html = document.documentElement;
    var current = html.dataset.theme ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = current === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
