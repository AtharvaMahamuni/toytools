---
import SearchBar from './SearchBar.astro';
import { withBase } from '../lib/paths';
import { APP_VERSION } from '../lib/version';
---

<header role="banner">
  <div class="nav-inner">
    <a href={withBase('/')} class="nav-logo">ToyTools<span class="gold-dot nav-dot" aria-hidden="true"></span><span class="nav-version" aria-label={`ToyTools alpha version 2.0`}>{APP_VERSION}<span class="nav-version-tooltip tt-tooltip" role="tooltip"><strong>Alpha Version</strong>Major UI revamp under progress.<br/>Try out the new developer tools!</span></span></a>
    <div class="nav-search">
      <SearchBar />
    </div>
    <div class="theme-segmented" role="group" aria-label="Theme">
      <button class="theme-seg-btn" data-theme-btn="light" type="button">Light</button>
      <button class="theme-seg-btn" data-theme-btn="dark" type="button">Dark</button>
      <button class="theme-seg-btn" data-theme-btn="system" type="button">System</button>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: var(--border);
  }

  @supports not (backdrop-filter: blur(8px)) {
    header { background: var(--color-bg); }
  }

  .nav-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    min-height: calc(var(--touch-target) + var(--space-4));
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-logo {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .nav-logo:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-dot {
    margin-left: 5px;
  }

  .nav-version {
    position: relative;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-subtle);
    margin-left: 8px;
    white-space: nowrap;
    cursor: default;
  }

  @media (max-width: 640px) {
    .nav-version {
      font-size: 11px;
    }
  }

  .nav-version-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: calc(var(--z-nav) + 1);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-version-tooltip strong {
    display: block;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .nav-version:hover .nav-version-tooltip,
  .nav-version:focus-within .nav-version-tooltip {
    display: block;
    opacity: 1;
  }

  .nav-search {
    flex: 1;
    min-width: 0;
  }

  .theme-segmented {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border: var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg);
  }

  .theme-seg-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--touch-target);
    padding: 0 var(--space-3);
    border: none;
    border-left: var(--border);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: var(--transition-color);
    white-space: nowrap;
  }

  .theme-seg-btn:first-child {
    border-left: none;
  }

  .theme-seg-btn:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }

  .theme-seg-btn[data-active] {
    color: var(--color-brand);
    background: var(--color-surface);
    font-weight: var(--font-weight-medium);
  }

  @media (max-width: 480px) {
    .theme-seg-btn {
      padding: 0 var(--space-2);
      font-size: var(--text-xs);
    }
  }
</style>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var mq = matchMedia('(prefers-color-scheme: dark)');
    var mqListener = null;

    function applyTheme(mode) {
      if (mode === 'dark') {
        html.dataset.theme = 'dark';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else if (mode === 'light') {
        html.dataset.theme = 'light';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else {
        delete html.dataset.theme;
        if (!mqListener) {
          mqListener = function () { markActive('system'); };
          mq.addEventListener('change', mqListener);
        }
      }
      markActive(mode);
    }

    function markActive(mode) {
      document.querySelectorAll('[data-theme-btn]').forEach(function (btn) {
        if (btn.dataset.themeBtn === mode) {
          btn.dataset.active = '';
        } else {
          delete btn.dataset.active;
        }
      });
    }

    var stored = localStorage.getItem('toytools.theme') || 'system';
    applyTheme(stored);

    var versionEl = document.querySelector('.nav-version');
    if (versionEl && window.ToyTools) ToyTools.mobileTooltip(versionEl, 'Alpha version — features may change');

    document.querySelectorAll('[data-theme-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.dataset.themeBtn;
        localStorage.setItem('toytools.theme', mode);
        applyTheme(mode);
        var labels = { light: 'Light theme', dark: 'Dark theme', system: 'Using system appearance' };
        if (window.ToyTools) ToyTools.toast(labels[mode] || 'Theme updated');
      });
    });
  })();
</script>
