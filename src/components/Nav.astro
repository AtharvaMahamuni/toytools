---
import { withBase } from '../lib/paths';
import { APP_VERSION } from '../lib/version';
---

<header role="banner">
  <div class="nav-inner">
    <a href={withBase('/')} class="nav-logo">ToyTools<span class="gold-dot nav-dot" aria-hidden="true"></span><span class="nav-version" aria-label={`ToyTools alpha version 2.0`}>{APP_VERSION}<span class="nav-version-tooltip tt-tooltip" role="tooltip"><strong>Alpha Version</strong>Major UI revamp under progress.<br/>Try out the new developer utilities!</span></span></a>
    <button class="theme-toggle" aria-label="Toggle theme" type="button" data-theme-toggle>
      <span class="theme-icon theme-icon-moon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </span>
      <span class="theme-icon theme-icon-sun">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </span>
    </button>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: var(--border);
  }

  .nav-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    min-height: calc(var(--touch-target) + var(--space-4));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .nav-logo {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .nav-logo:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-dot {
    margin-left: 5px;
  }

  .nav-version {
    position: relative;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-subtle);
    margin-left: 8px;
    white-space: nowrap;
    cursor: default;
  }

  @media (max-width: 640px) {
    .nav-version {
      font-size: 11px;
    }
  }

  .nav-version-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: calc(var(--z-nav) + 1);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-version-tooltip strong {
    display: block;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .nav-version:hover .nav-version-tooltip,
  .nav-version:focus-within .nav-version-tooltip {
    display: block;
    opacity: 1;
  }

  /* ── Theme toggle ─────────────────────────────────────────── */

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: background-color 150ms ease;
    color: var(--color-text-muted);
  }

  .theme-toggle:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* Show moon in light mode (click → go dark), sun in dark mode (click → go light) */
  .theme-icon { display: flex; align-items: center; justify-content: center; }
  .theme-icon-moon { display: flex; }
  .theme-icon-sun  { display: none; }

  :root[data-theme="dark"] .theme-icon-moon { display: none; }
  :root[data-theme="dark"] .theme-icon-sun  { display: flex; }

  /* When system preference is dark and no override is set */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-icon-moon { display: none; }
    :root:not([data-theme="light"]) .theme-icon-sun  { display: flex; }
  }
</style>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var mq = matchMedia('(prefers-color-scheme: dark)');
    var mqListener = null;

    function applyTheme(mode) {
      if (mode === 'dark') {
        html.dataset.theme = 'dark';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else if (mode === 'light') {
        html.dataset.theme = 'light';
        if (mqListener) { mq.removeEventListener('change', mqListener); mqListener = null; }
      } else {
        delete html.dataset.theme;
        if (!mqListener) {
          mqListener = function () {};
          mq.addEventListener('change', mqListener);
        }
      }
    }

    var stored = localStorage.getItem('toytools.theme') || 'system';
    applyTheme(stored);

    var versionEl = document.querySelector('.nav-version');
    if (versionEl && window.ToyTools) ToyTools.mobileTooltip(versionEl, 'Alpha version — features may change');

    var toggleBtn = document.querySelector('[data-theme-toggle]');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function () {
        var current = localStorage.getItem('toytools.theme') || 'system';
        var isDark = current === 'dark' || (current === 'system' && mq.matches);
        var next = isDark ? 'light' : 'dark';
        localStorage.setItem('toytools.theme', next);
        applyTheme(next);
        if (window.ToyTools) ToyTools.toast(next === 'dark' ? 'Dark theme' : 'Light theme');
      });
    }
  })();
</script>
