---
import SearchBar from './SearchBar.astro';
import { withBase } from '../lib/paths';
import { APP_VERSION } from '../lib/version';
---

<header role="banner">
  <div class="nav-inner">
    <a href={withBase('/')} class="nav-logo">ToyTools<span class="gold-dot nav-dot" aria-hidden="true"></span><span class="nav-version" aria-label={`ToyTools alpha version 0.02`}>{APP_VERSION}<span class="nav-version-tooltip" role="tooltip"><strong>Alpha Version</strong>ToyTools is under active development.<br/>Features may change as the platform evolves.</span></span></a>
    <div class="nav-search">
      <SearchBar />
    </div>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
      <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="m4.93 4.93 1.41 1.41" />
        <path d="m17.66 17.66 1.41 1.41" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="m6.34 17.66-1.41 1.41" />
        <path d="m19.07 4.93-1.41 1.41" />
      </svg>
      <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.9 13.5A8 8 0 1 1 10.5 3.1 6 6 0 0 0 20.9 13.5Z" />
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: var(--border);
  }

  .nav-inner {
    max-width: var(--width-nav);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    min-height: calc(var(--touch-target) + var(--space-4));
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-logo {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .nav-logo:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-dot {
    margin-left: 5px;
  }

  .nav-version {
    position: relative;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: rgba(17, 17, 17, 0.5);
    margin-left: 8px;
    white-space: nowrap;
    cursor: default;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .nav-version {
      color: rgba(244, 244, 244, 0.5);
    }
  }

  :root[data-theme="dark"] .nav-version {
    color: rgba(244, 244, 244, 0.5);
  }

  :root[data-theme="light"] .nav-version {
    color: rgba(17, 17, 17, 0.5);
  }

  @media (max-width: 640px) {
    .nav-version {
      font-size: 11px;
    }
  }

  .nav-version-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: calc(var(--z-nav) + 1);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-version-tooltip strong {
    display: block;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .nav-version:hover .nav-version-tooltip,
  .nav-version:focus-within .nav-version-tooltip {
    display: block;
    opacity: 1;
  }

  .nav-search {
    flex: 1;
    min-width: 0;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--touch-target);
    height: var(--touch-target);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: var(--transition-color);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-bg-tertiary);
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var html = document.documentElement;
    var current = html.dataset.theme ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = current === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
