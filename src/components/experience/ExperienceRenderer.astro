---
// ExperienceRenderer — the engine-agnostic result experience. It renders a STATIC shell (one node per
// section, in a flex column whose order is driven by the engine's `layout`) that the bundled
// `renderExperience` (ToyTools.experience.render) fills from an InteractiveResult at runtime.
//
// It renders the whole experience, not just numbers: hero -> visualization -> metrics -> timeline ->
// milestones -> insights -> comparison -> assumptions -> explanation -> next questions -> decisions.
// Verbose sections use native <details>. Density `ledger` is the platform default for every
// calculator engine: the number, ledger rows, chart and one insight stay open; the rest folds
// into a single "How this was worked out" disclosure. `panel` is the labelled chrome for
// text-window tools that do not use this renderer.
import IoPanel from '@tools/_shared/IoPanel.astro';
import { DEFAULT_LAYOUT, DEFAULT_CAPABILITIES } from '@lib/results/types';
import type { SectionId, Capabilities } from '@lib/results/types';
import type { LocaleCode } from '@data/locales';

interface Props {
  idPrefix: string;
  /** Shown before there is enough input; explains what will appear. */
  emptyText: string;
  layout?: SectionId[];
  capabilities?: Partial<Capabilities>;
  /** Optional tool craft id. `craftOn` chooses which shell node carries it. */
  craftId?: string;
  /** Chart, the sentence under the hero, or the empty/error line. One node only. */
  craftOn?: 'visualization' | 'hero-note' | 'empty';
  /**
   * `ledger` is the calculator statement (platform default): the number, a few
   * rows and one insight stay open; workings fold into one disclosure.
   * `panel` keeps labelled result chrome. Text-window tools do not use this renderer.
   */
  density?: 'panel' | 'ledger';
  lang?: LocaleCode;
}

const {
  idPrefix,
  emptyText,
  layout = DEFAULT_LAYOUT,
  capabilities = {},
  craftId,
  craftOn = 'visualization',
  density = 'ledger',
  lang = 'en',
} = Astro.props;
const craftFor = (slot: 'visualization' | 'hero-note' | 'empty') =>
  craftId && craftOn === slot ? craftId : undefined;
const caps: Capabilities = { ...DEFAULT_CAPABILITIES, ...capabilities };
const heroId = `${idPrefix}-hero`;
const ledger = density === 'ledger';

const LABELS: Record<LocaleCode, {
  panelResult: string;
  comparison: string;
  workings: string;
  assumptions: string;
  timeline: string;
  milestones: string;
  nextQuestions: string;
  alsoTry: string;
  howCalculated: string;
  whatNext: string;
}> = {
  en: {
    panelResult: 'Result',
    comparison: 'Comparison',
    workings: 'How this was worked out',
    assumptions: 'Assumptions',
    timeline: 'Timeline',
    milestones: 'Milestones',
    nextQuestions: 'Questions to explore',
    alsoTry: 'Also try',
    howCalculated: 'How this is calculated',
    whatNext: 'What to do next',
  },
  es: {
    panelResult: 'Resultado',
    comparison: 'Comparación',
    workings: 'Cómo se calculó',
    assumptions: 'Supuestos',
    timeline: 'Cronología',
    milestones: 'Hitos',
    nextQuestions: 'Preguntas para explorar',
    alsoTry: 'Prueba también',
    howCalculated: 'Cómo se calcula',
    whatNext: 'Siguientes pasos',
  },
  de: {
    panelResult: 'Ergebnis',
    comparison: 'Vergleich',
    workings: 'Berechnungsweg',
    assumptions: 'Annahmen',
    timeline: 'Zeitverlauf',
    milestones: 'Meilensteine',
    nextQuestions: 'Weitere Fragen',
    alsoTry: 'Passend dazu',
    howCalculated: 'Berechnungsgrundlage',
    whatNext: 'Nächste Schritte',
  },
  fr: {
    panelResult: 'Résultat',
    comparison: 'Comparaison',
    workings: 'Détail du calcul',
    assumptions: 'Hypothèses',
    timeline: 'Chronologie',
    milestones: 'Jalons',
    nextQuestions: 'Questions associées',
    alsoTry: 'À essayer aussi',
    howCalculated: 'Méthode de calcul',
    whatNext: 'Aller plus loin',
  },
  ja: {
    panelResult: '結果',
    comparison: '比較',
    workings: '計算の詳細',
    assumptions: '前提条件',
    timeline: '推移',
    milestones: '目安',
    nextQuestions: '関連する疑問',
    alsoTry: '関連ツール',
    howCalculated: '計算方法',
    whatNext: '次のステップ',
  },
  pt: {
    panelResult: 'Resultado',
    comparison: 'Comparação',
    workings: 'Como foi calculado',
    assumptions: 'Premissas',
    timeline: 'Linha do tempo',
    milestones: 'Marcos',
    nextQuestions: 'Perguntas para explorar',
    alsoTry: 'Experimente também',
    howCalculated: 'Como funciona o cálculo',
    whatNext: 'Próximos passos',
  },
  hi: {
    panelResult: 'परिणाम',
    comparison: 'तुलना',
    workings: 'गणना कैसे हुई',
    assumptions: 'मान्यताएँ',
    timeline: 'समयरेखा',
    milestones: 'प्रमुख बिंदु',
    nextQuestions: 'अगले प्रश्न',
    alsoTry: 'इन्हें भी आज़माएँ',
    howCalculated: 'गणना का तरीका',
    whatNext: 'आगे क्या करें',
  },
};
const l = LABELS[lang];
---

<IoPanel label={l.panelResult} variant="prose" result copyTargetId={ledger ? undefined : heroId} bare={ledger}>
  <div
    class:list={['experience', { 'experience--ledger': ledger }]}
    id={`${idPrefix}-experience`}
    data-experience
    data-density={density}
    data-layout={JSON.stringify(layout)}
    data-empty-text={emptyText}
    data-cap-timeline={String(caps.timeline)}
    data-cap-comparison={String(caps.comparison)}
    data-cap-visualization={String(caps.visualization)}
  >
    <p class="experience-empty empty-hint" data-experience-empty data-craft={craftFor('empty')} role="status" aria-live="polite">{emptyText}</p>

    <div class="experience-sections" data-experience-sections hidden>
      <div class="tm-hero experience-section" data-section="hero" role="status" aria-live="polite" aria-atomic="true" hidden>
        <span class="hero-value" id={heroId} data-hero-value>0</span>
        <span class="hero-label" data-hero-label></span>
        <p class="hero-note" data-hero-note data-craft={craftFor('hero-note')} hidden></p>
        <p class="hero-delta" id={`${idPrefix}-delta`} hidden></p>
        <div class="hero-spark" id={`${idPrefix}-spark`} hidden></div>
      </div>

      <div class="experience-section" data-section="metrics" hidden>
        <dl class="tm-stats tm-secondary" aria-live="off"></dl>
      </div>

      <div class="experience-section experience-viz" data-section="visualization" data-craft={craftFor('visualization')} hidden>
        <div class="viz-mount" data-viz></div>
        <p class="viz-caption" data-viz-caption hidden></p>
      </div>

      <div class="experience-section" data-section="insights" hidden>
        <ul class="insight-list" data-list></ul>
      </div>

      <div class="experience-section experience-placeholder" data-section="comparison" hidden>
        <p class="experience-heading">{l.comparison}</p>
      </div>

      {ledger ? (
        <>
          <details class="experience-workings experience-disclosure">
            <summary>{l.workings}</summary>
            <div class="experience-section" data-section="explanation" hidden>
              <p class="experience-explanation" data-explanation></p>
            </div>
            <div class="experience-section" data-section="assumptions" hidden>
              <p class="experience-heading">{l.assumptions}</p>
              <dl class="tm-stats" data-list></dl>
            </div>
            <div class="experience-section" data-section="timeline" hidden>
              <p class="experience-heading">{l.timeline}</p>
              <dl class="tm-stats" data-list aria-live="off"></dl>
            </div>
            <div class="experience-section" data-section="milestones" hidden>
              <p class="experience-heading">{l.milestones}</p>
              <ul class="milestone-list" data-list></ul>
            </div>
            <div class="experience-section" data-section="nextQuestions" hidden>
              <p class="experience-heading">{l.nextQuestions}</p>
              <ul class="next-question-list" data-list></ul>
            </div>
            <div class="experience-section" data-section="decisions" hidden>
              <p class="experience-heading">{l.alsoTry}</p>
              <ul class="decision-list" data-list></ul>
            </div>
          </details>
        </>
      ) : (
        <>
          <details class="experience-section experience-disclosure" data-section="timeline" hidden>
            <summary>{l.timeline}</summary>
            <dl class="tm-stats" data-list aria-live="off"></dl>
          </details>

          <div class="experience-section" data-section="milestones" hidden>
            <p class="experience-heading">{l.milestones}</p>
            <ul class="milestone-list" data-list></ul>
          </div>

          <details class="experience-section experience-disclosure" data-section="assumptions" hidden>
            <summary>{l.assumptions}</summary>
            <dl class="tm-stats" data-list></dl>
          </details>

          <details class="experience-section experience-disclosure" data-section="explanation" hidden>
            <summary>{l.howCalculated}</summary>
            <p class="experience-explanation" data-explanation></p>
          </details>

          <details class="experience-section experience-disclosure" data-section="nextQuestions" hidden>
            <summary>{l.nextQuestions}</summary>
            <ul class="next-question-list" data-list></ul>
          </details>

          <div class="experience-section" data-section="decisions" hidden>
            <p class="experience-heading">{l.whatNext}</p>
            <ul class="decision-list" data-list></ul>
          </div>
        </>
      )}
    </div>
  </div>
</IoPanel>
