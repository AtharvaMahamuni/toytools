---
// ExperienceRenderer — the engine-agnostic result experience. It renders a STATIC shell (one node per
// section, in a flex column whose order is driven by the engine's `layout`) that the bundled
// `renderExperience` (ToyTools.experience.render) fills from an InteractiveResult at runtime.
//
// It renders the whole experience, not just numbers: hero -> visualization -> metrics -> timeline ->
// milestones -> insights -> comparison -> assumptions -> explanation -> next questions -> decisions.
// Verbose sections use native <details>. Density `ledger` (finance) keeps the number, the ledger
// rows and one insight sentence open, and folds the rest into a single "How this was worked out"
// disclosure so the result is a statement rather than a stack of cards.
import IoPanel from '@tools/_shared/IoPanel.astro';
import { DEFAULT_LAYOUT, DEFAULT_CAPABILITIES } from '@lib/results/types';
import type { SectionId, Capabilities } from '@lib/results/types';

interface Props {
  idPrefix: string;
  /** Shown before there is enough input; explains what will appear. */
  emptyText: string;
  layout?: SectionId[];
  capabilities?: Partial<Capabilities>;
  /** Optional tool craft id, attached to the visualization section when present. */
  craftId?: string;
  /**
   * `ledger` is the finance statement: the number and a few rows stay open, the
   * workings fold into one disclosure, and related tools are a quiet link row.
   * Default keeps the labelled result panel other engines already use.
   */
  density?: 'panel' | 'ledger';
}

const {
  idPrefix,
  emptyText,
  layout = DEFAULT_LAYOUT,
  capabilities = {},
  craftId,
  density = 'panel',
} = Astro.props;
const caps: Capabilities = { ...DEFAULT_CAPABILITIES, ...capabilities };
const heroId = `${idPrefix}-hero`;
const ledger = density === 'ledger';
---

<IoPanel label="Result" variant="prose" result copyTargetId={ledger ? undefined : heroId} bare={ledger}>
  <div
    class:list={['experience', { 'experience--ledger': ledger }]}
    id={`${idPrefix}-experience`}
    data-experience
    data-density={density}
    data-layout={JSON.stringify(layout)}
    data-empty-text={emptyText}
    data-cap-timeline={String(caps.timeline)}
    data-cap-comparison={String(caps.comparison)}
    data-cap-visualization={String(caps.visualization)}
  >
    <p class="experience-empty empty-hint" data-experience-empty role="status" aria-live="polite">{emptyText}</p>

    <div class="experience-sections" data-experience-sections hidden>
      <div class="tm-hero experience-section" data-section="hero" role="status" aria-live="polite" aria-atomic="true" hidden>
        <span class="hero-value" id={heroId} data-hero-value>0</span>
        <span class="hero-label" data-hero-label></span>
        <p class="hero-note" data-hero-note hidden></p>
        <p class="hero-delta" id={`${idPrefix}-delta`} hidden></p>
        <div class="hero-spark" id={`${idPrefix}-spark`} hidden></div>
      </div>

      <div class="experience-section" data-section="metrics" hidden>
        <dl class="tm-stats tm-secondary" aria-live="off"></dl>
      </div>

      <div class="experience-section experience-viz" data-section="visualization" data-craft={craftId} hidden>
        <div class="viz-mount" data-viz></div>
        <p class="viz-caption" data-viz-caption hidden></p>
      </div>

      <div class="experience-section" data-section="insights" hidden>
        <ul class="insight-list" data-list></ul>
      </div>

      <div class="experience-section experience-placeholder" data-section="comparison" hidden>
        <p class="experience-heading">Comparison</p>
      </div>

      {ledger ? (
        <>
          <details class="experience-workings experience-disclosure">
            <summary>How this was worked out</summary>
            <div class="experience-section" data-section="explanation" hidden>
              <p class="experience-explanation" data-explanation></p>
            </div>
            <div class="experience-section" data-section="assumptions" hidden>
              <p class="experience-heading">Assumptions</p>
              <dl class="tm-stats" data-list></dl>
            </div>
            <div class="experience-section" data-section="timeline" hidden>
              <p class="experience-heading">Timeline</p>
              <dl class="tm-stats" data-list aria-live="off"></dl>
            </div>
            <div class="experience-section" data-section="milestones" hidden>
              <p class="experience-heading">Milestones</p>
              <ul class="milestone-list" data-list></ul>
            </div>
            <div class="experience-section" data-section="nextQuestions" hidden>
              <p class="experience-heading">Questions to explore</p>
              <ul class="next-question-list" data-list></ul>
            </div>
            <div class="experience-section" data-section="decisions" hidden>
              <p class="experience-heading">Also try</p>
              <ul class="decision-list" data-list></ul>
            </div>
          </details>
        </>
      ) : (
        <>
          <details class="experience-section experience-disclosure" data-section="timeline" hidden>
            <summary>Timeline</summary>
            <dl class="tm-stats" data-list aria-live="off"></dl>
          </details>

          <div class="experience-section" data-section="milestones" hidden>
            <p class="experience-heading">Milestones</p>
            <ul class="milestone-list" data-list></ul>
          </div>

          <details class="experience-section experience-disclosure" data-section="assumptions" hidden>
            <summary>Assumptions</summary>
            <dl class="tm-stats" data-list></dl>
          </details>

          <details class="experience-section experience-disclosure" data-section="explanation" hidden>
            <summary>How this is calculated</summary>
            <p class="experience-explanation" data-explanation></p>
          </details>

          <details class="experience-section experience-disclosure" data-section="nextQuestions" hidden>
            <summary>Questions to explore</summary>
            <ul class="next-question-list" data-list></ul>
          </details>

          <div class="experience-section" data-section="decisions" hidden>
            <p class="experience-heading">What to do next</p>
            <ul class="decision-list" data-list></ul>
          </div>
        </>
      )}
    </div>
  </div>
</IoPanel>
