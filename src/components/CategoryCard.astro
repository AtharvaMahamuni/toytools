---
import type { Category } from '@data/types';
import { categoryPath } from '../lib/paths';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<a
  href={categoryPath(category)}
  class="category-card"
  style={category.accent ? `--card-accent: ${category.accent}` : ''}
>
  <div class="category-body">
    <span class="category-name">{category.name}</span>
    <span class="category-description">{category.description}</span>
    <span class="category-count">
      <span class="count-number">{category.toolCount}</span>
      <span class="count-label"> tools</span>
    </span>
  </div>
</a>

<style>
  .category-card {
    display: block;
    padding: var(--space-5);
    border: var(--border);
    border-top: 3px solid var(--card-accent, var(--color-accent));
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    min-height: var(--touch-target);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: var(--transition-color), transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .category-card:hover {
    background-color: var(--color-surface);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .category-card:hover .category-name {
    color: var(--color-accent);
  }


  .category-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
    min-width: 0;
  }

  .category-name {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
  }

  .category-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: unset;
    overflow-wrap: break-word;
  }

  .category-count {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin-top: var(--space-2);
  }

  .count-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
