---
// SmartInput — the engine-agnostic input dispatcher. Given a SmartFieldDef it renders the right
// accessible control: a select, or a numeric control with −/+ buttons, a suffix, help text, and
// optional preset chips. Behaviour (natural parsing, grouped formatting, adaptive stepping, keyboard
// + touch) is added by the bundled `smartInput.client.ts`, imported once below.
//
// FinanceWidget (and any future interactive widget) loops a field schema and renders one SmartInput
// per field. The canonical numeric value lives in `data-raw`; consumers read that, not the display.
import type { SmartFieldDef } from '@lib/inputs/field';
import { DEFAULT_CURRENCY, groupingFor } from '@lib/inputs/currency';
import { formatGrouped } from '@lib/inputs/format';

interface Props {
  field: SmartFieldDef;
  /** Prefix for element ids so multiple widgets on a page never collide. */
  idPrefix: string;
}

const { field, idPrefix } = Astro.props;
const inputId = `${idPrefix}-f-${field.id}`;
const helpId = field.help ? `${inputId}-help` : undefined;
const isSelect = field.type === 'select';
const isSegmented = field.type === 'segmented';
const isSlider = field.type === 'slider';
const isCurrency = field.type === 'currency';
// Native string controls (date picker, datetime-local, free text) skip the numeric −/+ machinery.
const isPlain = field.type === 'date' || field.type === 'datetime' || field.type === 'text';
const nativeType = field.type === 'date' ? 'date' : field.type === 'datetime' ? 'datetime-local' : 'text';
const inputMode = field.type === 'integer' ? 'numeric' : 'decimal';
const initialDisplay = String(field.default ?? '');
// These tools recalculate on every keystroke, so the return key's real job is to put the phone
// keyboard away and reveal the result underneath it — never to submit. "done" is the label that
// says so. Left unset until 2026-08-17, when enterkeyhint reached 2 of 121 pages.
const enterKeyHint = 'done';

/**
 * Currency-preset chip label — symbol + compact magnitude (e.g. "$2K"). Derived from the value so it
 * follows the display currency; the client (FinanceWidget) relabels these on currency change. SSR
 * uses the default currency.
 */
function compactCurrency(value: number, code: string): string {
  return formatGrouped(value, {
    style: 'currency',
    currency: code,
    grouping: groupingFor(code),
    compact: true,
    maximumFractionDigits: 1,
  });
}
---

<div class="smart-input" data-smart-input>
  <label class="widget-label" for={inputId}>{field.label}</label>

  {isSegmented ? (
    /* A pill row instead of a native dropdown: every option is readable and one tap away. The
       hidden input stays the single source of truth, so consumers read `.value` exactly as they
       do for a select and nothing downstream had to learn a new control. */
    <div class="smart-segmented" role="radiogroup" aria-label={field.label}>
      <input
        type="hidden"
        id={inputId}
        data-field-id={field.id}
        data-field-type="segmented"
        data-required={field.optional ? 'false' : 'true'}
        value={String(field.default ?? '')}
      />
      {(field.options ?? []).map((o) => (
        <button
          type="button"
          class="smart-segment"
          role="radio"
          data-segment-for={field.id}
          data-segment-value={o.value}
          aria-checked={String(field.default) === o.value ? 'true' : 'false'}
        >{o.label}</button>
      ))}
    </div>
  ) : isSelect ? (
    <select
      id={inputId}
      class="widget-select"
      data-field-id={field.id}
      data-field-type="select"
      data-required={field.optional ? 'false' : 'true'}
      aria-describedby={helpId}
    >
      {(field.options ?? []).map((o) => (
        <option value={o.value} selected={String(field.default) === o.value}>{o.label}</option>
      ))}
    </select>
  ) : isPlain ? (
    <input
      id={inputId}
      class="widget-input"
      type={nativeType}
      autocomplete="off"
      enterkeyhint={field.type === 'text' ? enterKeyHint : undefined}
      value={initialDisplay}
      placeholder={field.type === 'text' ? String(field.default ?? '') : undefined}
      data-field-id={field.id}
      data-field-type={field.type}
      data-required={field.optional ? 'false' : 'true'}
      data-raw={initialDisplay}
      aria-describedby={helpId}
    />
  ) : (
    <div class="smart-input-row">
      <button
        type="button"
        class="smart-step"
        data-step-dir="down"
        aria-label={`Decrease ${field.label}`}
        tabindex="-1"
      >−</button>
      <input
        id={inputId}
        class="widget-input smart-input-field"
        type="text"
        inputmode={inputMode}
        enterkeyhint={enterKeyHint}
        autocomplete="off"
        value={field.default !== 0 ? initialDisplay : ''}
        placeholder={String(field.default ?? '')}
        data-field-id={field.id}
        data-field-type={field.type}
        data-required={field.optional ? 'false' : 'true'}
        data-raw={field.default !== 0 ? String(field.default) : ''}
        data-min={field.min}
        data-max={field.max}
        data-step={field.step}
        aria-describedby={helpId}
      />
      <button
        type="button"
        class="smart-step"
        data-step-dir="up"
        aria-label={`Increase ${field.label}`}
        tabindex="-1"
      >+</button>
      {field.suffix && <span class="smart-suffix" aria-hidden="true">{field.suffix}</span>}
    </div>
  )}

  {isSlider && (
    /* Paired with (never replacing) the numeric control above: dragging is faster on a phone,
       typing is exact, and the numeric input remains the source of truth for every consumer. */
    <input
      type="range"
      class="smart-slider"
      data-slider-for={field.id}
      min={field.min ?? 0}
      max={field.max ?? 100}
      step={field.step ?? 1}
      value={String(field.default ?? field.min ?? 0)}
      aria-label={`${field.label} slider`}
      tabindex="-1"
    />
  )}

  {field.help && <p class="widget-help" id={helpId}>{field.help}</p>}

  {field.presets && field.presets.length > 0 && (
    <div class="smart-presets" role="group" aria-label={`${field.label} presets`}>
      {field.presets.map((p) =>
        isCurrency ? (
          <button
            type="button"
            class="smart-preset"
            data-preset-for={field.id}
            data-preset-currency
            data-preset-base={String(p.value)}
            data-preset-value={String(p.value)}
          >
            {compactCurrency(Number(p.value), DEFAULT_CURRENCY)}
          </button>
        ) : (
          <button type="button" class="smart-preset" data-preset-for={field.id} data-preset-value={String(p.value)}>
            {p.label}
          </button>
        ),
      )}
    </div>
  )}
</div>

<script>
  // Enhances every [data-smart-input] on the page exactly once (idempotent, deduped via WeakSet).
  import '@components/inputs/smartInput.client';
</script>
