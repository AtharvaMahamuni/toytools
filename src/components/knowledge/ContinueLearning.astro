---
// Continue Learning — derived related GUIDES (reading material), distinct from
// RelatedContent (tools) and YouMayAlsoNeed (workflow actions). Improves crawl depth
// between guide pages. Renders nothing when there's no related reading.
import { getRelatedGuides } from '@lib/knowledge/queries';
import { withBase } from '@lib/paths';

interface Props {
  toolSlug: string;
  max?: number;
}

const { toolSlug, max = 4 } = Astro.props;
const guides = getRelatedGuides(toolSlug, max);
---

{guides.length > 0 && (
  <section class="kg-section" aria-labelledby="kg-continue-learning">
    <h2 id="kg-continue-learning" class="kg-heading">
      Continue Learning <span class="gold-dot" aria-hidden="true"></span>
    </h2>
    <div class="kg-block">
      <h3 class="kg-subheading">Related Guides</h3>
      <ul class="kg-list">
        {guides.map(r => (
          <li><a class="kg-link" href={withBase(r.node.url)}>{r.node.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .kg-section {
    padding-block: var(--space-8);
    border-top: var(--border);
  }
  .kg-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-5);
  }
  .kg-block {
    margin-bottom: var(--space-6);
  }
  .kg-block:last-child {
    margin-bottom: 0;
  }
  .kg-subheading {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .kg-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .kg-link {
    color: var(--color-text-accent);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }
  .kg-link:hover {
    text-decoration: underline;
  }
</style>
