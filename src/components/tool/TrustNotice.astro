---
import { PRIVACY_BADGE, PRIVACY_LINE, privacyStatement } from '@lib/privacy';
import type { LocaleCode } from '@data/locales';
import { getUiStrings } from '@data/i18n/index';

interface Props {
  variant?: 'private' | 'offline' | 'local' | 'lookup';
  /** A private work-in-progress tool (config `keepInput`): its typed input is kept on this device. */
  keepInput?: boolean;
  lang?: LocaleCode;
}

const { variant = 'private', keepInput = false, lang = 'en' } = Astro.props;
const t = getUiStrings(lang);

const KEEP_LINE_BY_LOCALE: Record<LocaleCode, string> = {
  en: 'Your input stays on this device (never uploaded).',
  es: 'Tu entrada permanece en este dispositivo (nunca se sube).',
  de: 'Ihre Eingabe bleibt auf diesem Gerät (kein Upload).',
  fr: 'Votre saisie reste sur cet appareil (aucun envoi).',
  ja: '入力内容は端末内に保持されます（外部送信なし）。',
  pt: 'O que você digita fica neste aparelho (nunca enviado).',
  hi: 'आपका इनपुट इसी डिवाइस पर रहता है (कभी अपलोड नहीं होता)।',
};
const CLEAR_LINE_BY_LOCALE: Record<LocaleCode, string> = {
  en: 'Clear saved input removes it.',
  es: 'Borrar entrada guardada la elimina.',
  de: 'Gespeicherte Eingabe löschen entfernt sie.',
  fr: 'Effacer la saisie enregistrée la supprime.',
  ja: '保存された入力を消去すると削除されます。',
  pt: 'Limpar entrada salva remove os dados.',
  hi: 'सहेजा गया इनपुट साफ़ करने पर यह हट जाता है।',
};

const keep = keepInput && variant === 'private';
const localizedPrivacyLine = lang === 'en' ? PRIVACY_LINE : t.footer.privacyByVariant.private;
const statement = keep ? `${localizedPrivacyLine} ${KEEP_LINE_BY_LOCALE[lang]}` : (lang === 'en' ? privacyStatement(variant) : t.footer.privacyByVariant[variant]);

const badgesByLocale: Record<LocaleCode, Record<'private' | 'offline' | 'local' | 'lookup', string>> = {
  en: {
    private: PRIVACY_BADGE,
    offline: 'Offline ● Works without internet after loading',
    local: 'Local ● Data stored only on this device',
    lookup: 'Lookup ● Your browser asks an IP echo',
  },
  es: {
    private: `Privado ● ${t.footer.privacyByVariant.private.replace(/\.$/, '')}`,
    offline: 'Sin conexión ● Funciona sin internet tras cargar',
    local: 'Local ● Datos guardados solo en este dispositivo',
    lookup: 'Consulta ● Tu navegador consulta un eco de IP',
  },
  de: {
    private: `Privat ● ${t.footer.privacyByVariant.private.replace(/\.$/, '')}`,
    offline: 'Offline ● Funktioniert nach dem Laden ohne Internet',
    local: 'Lokal ● Daten nur auf diesem Gerät gespeichert',
    lookup: 'Abfrage ● Ihr Browser fragt einen IP-Echo-Dienst ab',
  },
  fr: {
    private: `Privé ● ${t.footer.privacyByVariant.private.replace(/\.$/, '')}`,
    offline: 'Hors ligne ● Fonctionne sans internet après chargement',
    local: 'Local ● Données conservées sur cet appareil uniquement',
    lookup: 'Requête ● Votre navigateur interroge un écho IP',
  },
  ja: {
    private: `プライベート ● ${t.footer.privacyByVariant.private.replace(/。$/, '')}`,
    offline: 'オフライン ● 読み込み後は通信なしで動作',
    local: 'ローカル ● データはこの端末のみに保存',
    lookup: '照会 ● ブラウザがIP確認サービスへ直接接続',
  },
  pt: {
    private: `Privado ● ${t.footer.privacyByVariant.private.replace(/\.$/, '')}`,
    offline: 'Offline ● Funciona sem internet após carregar',
    local: 'Local ● Dados salvos apenas neste aparelho',
    lookup: 'Consulta ● Seu navegador consulta um serviço IP',
  },
  hi: {
    private: `निजी ● ${t.footer.privacyByVariant.private.replace(/।$/, '')}`,
    offline: 'ऑफ़लाइन ● लोड होने के बाद बिना इंटरनेट चलता है',
    local: 'लोकल ● डेटा केवल इसी डिवाइस पर सहेजा जाता है',
    lookup: 'लुकअप ● आपका ब्राउज़र सीधे IP जांच करता है',
  },
};

const tooltipsByLocale: Record<LocaleCode, Record<'private' | 'offline' | 'local' | 'lookup', string[]>> = {
  en: {
    private: [PRIVACY_LINE, 'No account required.', 'Nothing stored unless you choose to save it.'],
    offline: ['After the first page load, no network connection is needed.'],
    local: ['No sync, no cloud. Your data stays on this device.'],
    lookup: ['Your browser asks an IP echo for the address the internet already sees.', 'ToyTools never sees the reply, and nothing is stored here.'],
  },
  es: {
    private: [t.footer.privacyByVariant.private, 'Sin cuenta ni registro.', 'Nada se guarda salvo que decidas conservarlo.'],
    offline: ['Tras la primera carga, no necesita conexión a internet.'],
    local: ['Sin sincronización ni nube. Tus datos permanecen en este dispositivo.'],
    lookup: ['Tu navegador consulta un servicio eco para ver la IP pública.', 'ToyTools nunca ve la respuesta y nada se almacena aquí.'],
  },
  de: {
    private: [t.footer.privacyByVariant.private, 'Kein Konto erforderlich.', 'Nichts wird gespeichert, außer Sie wählen es bewusst.'],
    offline: ['Nach dem ersten Laden ist keine Internetverbindung nötig.'],
    local: ['Keine Synchronisierung, keine Cloud. Ihre Daten bleiben auf diesem Gerät.'],
    lookup: ['Ihr Browser fragt einen IP-Echo-Dienst nach Ihrer öffentlichen Adresse.', 'ToyTools sieht die Antwort nie und speichert nichts.'],
  },
  fr: {
    private: [t.footer.privacyByVariant.private, 'Aucun compte requis.', 'Rien n\'est enregistré sauf choix explicite.'],
    offline: ['Après le premier chargement, aucune connexion n\'est requise.'],
    local: ['Aucune synchronisation, aucun cloud. Vos données restent sur cet appareil.'],
    lookup: ['Votre navigateur interroge un service écho IP pour lire votre adresse publique.', 'ToyTools ne voit jamais la réponse et rien n\'est conservé.'],
  },
  ja: {
    private: [t.footer.privacyByVariant.private, 'アカウント登録は不要です。', '明示的に保存しない限りデータは残りません。'],
    offline: ['最初の読み込み後はインターネット接続なしで動作します。'],
    local: ['クラウド同期なし。データはこの端末内のみに保存されます。'],
    lookup: ['ブラウザが外部IP確認サービスへ直接公開アドレスを問い合わせます。', 'ToyToolsが応答を見たり保存したりすることはありません。'],
  },
  pt: {
    private: [t.footer.privacyByVariant.private, 'Sem conta ou cadastro.', 'Nada fica salvo a menos que você escolha guardar.'],
    offline: ['Após o primeiro carregamento, não precisa de internet.'],
    local: ['Sem sincronização nem nuvem. Seus dados ficam neste aparelho.'],
    lookup: ['Seu navegador consulta um serviço IP para exibir o endereço público.', 'O ToyTools nunca vê a resposta e nada é armazenado aqui.'],
  },
  hi: {
    private: [t.footer.privacyByVariant.private, 'खाते की कोई आवश्यकता नहीं है।', 'जब तक आप स्वयं न सहेजें, कुछ भी संग्रहीत नहीं होता।'],
    offline: ['पहली बार पेज खुलने के बाद इंटरनेट की आवश्यकता नहीं होती।'],
    local: ['कोई क्लाउड सिंक नहीं। आपका डेटा इसी डिवाइस पर रहता है।'],
    lookup: ['आपका ब्राउज़र सार्वजनिक पता देखने के लिए IP सेवा से पूछता है।', 'ToyTools उत्तर नहीं देखता और कुछ भी सहेजा नहीं जाता।'],
  },
};

const noAccountByLocale: Record<LocaleCode, string> = {
  en: 'No account required.',
  es: 'Sin cuenta ni registro.',
  de: 'Kein Konto erforderlich.',
  fr: 'Aucun compte requis.',
  ja: 'アカウント登録不要。',
  pt: 'Sem necessidade de conta.',
  hi: 'खाते की आवश्यकता नहीं।',
};

const noticeBadge = badgesByLocale[lang][variant];
const lines = keep
  ? [localizedPrivacyLine, noAccountByLocale[lang], KEEP_LINE_BY_LOCALE[lang], CLEAR_LINE_BY_LOCALE[lang]]
  : tooltipsByLocale[lang][variant];
---

<span class="trust-wrap" data-toast={statement} tabindex="0" role="note" aria-label={noticeBadge}>
  <span class="trust-badge">{noticeBadge}</span>
  <span class="trust-tooltip" role="tooltip">
    {lines.map(l => <span class="trust-tooltip-line">{l}</span>)}
  </span>
</span>

<style>
  .trust-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-1);
    cursor: default;
    outline: none;
  }

  .trust-wrap:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 2px;
  }

  .trust-badge {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .trust-tooltip {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: var(--z-raised);
    width: max-content;
    max-width: min(280px, 90vw);
    padding: 8px 12px;
    background: var(--color-bg);
    border: var(--border);
    border-radius: var(--radius-md);
    font-size: 12px;
    color: var(--color-text);
    line-height: 1.5;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-default);
    white-space: normal;
  }

  .trust-tooltip-line {
    display: block;
  }

  /* Only reveal the card on true pointer devices. Touch devices get the
     toast instead (via ToyTools.mobileTooltip) — this prevents the CSS
     :hover state from sticking open after a tap on mobile. */
  @media (hover: hover) and (pointer: fine) {
    .trust-wrap:hover .trust-tooltip,
    .trust-wrap:focus-visible .trust-tooltip {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  (function () {
    if (!window.ToyTools) return;
    document.querySelectorAll('.trust-wrap').forEach(function (wrap) {
      ToyTools.mobileTooltip(wrap, wrap.dataset.toast);
    });
  })();
</script>
