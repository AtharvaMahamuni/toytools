---
// The category hub link at the end of a guide. Sibling tools are not repeated here: the guide
// already lists them in RelatedContent, from the same ranking.
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { categoryPath } from '@lib/paths';

interface Props {
  toolSlug: string;
}

const { toolSlug } = Astro.props;

const tool = tools.find(t => t.slug === toolSlug);
const category = tool ? categories.find(c => c.slug === tool.categorySlug) : undefined;
const count = category ? tools.filter(t => t.categorySlug === category.slug).length : 0;

const categoryHref = category ? categoryPath(category) : null;
---

{category && count > 1 && (
  <aside class="category-discovery" aria-label={`More ${category.name}`}>
    <span class="cd-dot" aria-hidden="true" style={`--cd-accent: ${category.accent ?? 'var(--color-gold)'}`}></span>
    <span class="cd-text">
      Looking for more?
      <a class="cd-link" href={categoryHref}>Browse all {`${count} ${category.name}`} →</a>
    </span>
  </aside>
)}

<style>
  /* Boundary recipe: lower section draws margin-top / border-top / padding-top */
  .category-discovery {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-8);
    border-top: var(--border);
    padding-top: var(--space-8);
    padding-bottom: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cd-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cd-accent, var(--color-gold));
    flex-shrink: 0;
  }

  .cd-link {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .cd-link:hover {
    text-decoration: underline;
  }
</style>
