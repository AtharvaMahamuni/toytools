---
// Contextual cross-tool discovery — a subtle "more in this category" prompt rendered
// near a tool's output (and at the end of guide/FAQ content). Fully data-driven from the
// registry, so every category gets the right name, count, accent, and sibling links.
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { getRelatedTools } from '@lib/tools/related';
import { withBase } from '@lib/paths';

interface Props {
  toolSlug: string;
}

const { toolSlug } = Astro.props;

const tool = tools.find(t => t.slug === toolSlug);
const category = tool ? categories.find(c => c.slug === tool.categorySlug) : undefined;
const count = category ? tools.filter(t => t.categorySlug === category.slug).length : 0;

// Nearest siblings (already excludes the current tool); cap at 3 for an inline row.
const siblings = tool ? getRelatedTools(tool, tools, 3) : [];

const categoryHref = category ? withBase(`/category/${category.slug}/`) : null;
const segmentOf = (slug: string) => categories.find(c => c.slug === slug)?.segment ?? '';
---

{category && count > 1 && (
  <aside class="category-discovery" aria-label={`More ${category.name}`}>
    <span class="cd-dot" aria-hidden="true" style={`--cd-accent: ${category.accent ?? 'var(--color-gold)'}`}></span>
    <span class="cd-text">
      Looking for more?
      <a class="cd-link" href={categoryHref}>Browse all {count} {category.name} →</a>
    </span>
    {siblings.length > 0 && (
      <span class="cd-siblings">
        {siblings.map((s, i) => (
          <>
            {i > 0 && <span class="cd-sep" aria-hidden="true">·</span>}
            <a class="cd-sibling" href={withBase(`/tool/${segmentOf(s.categorySlug)}/${s.slug}/`)}>{s.name}</a>
          </>
        ))}
      </span>
    )}
  </aside>
)}

<style>
  .category-discovery {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-5);
    margin-top: var(--space-6);
    border-top: var(--border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cd-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cd-accent, var(--color-gold));
    flex-shrink: 0;
  }

  .cd-link {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .cd-link:hover {
    text-decoration: underline;
  }

  .cd-siblings {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-subtle);
  }

  .cd-sibling {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .cd-sibling:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .cd-sep {
    color: var(--color-text-subtle);
  }
</style>
