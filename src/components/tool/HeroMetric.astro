---
// Hero block at the top of a result IoPanel: big numeral, label, empty-state hint.
// Always rendered inside an <IoPanel result> — it owns no frame of its own.
import type { MetricFormatter } from '@data/types';

interface Props {
  metric: string;
  label: string;
  formatter?: MetricFormatter;
  initialValue?: string;
}

const { metric, label, formatter = 'integer', initialValue = '0' } = Astro.props;
---

<div class="tm-hero">
  <span class="hero-value" data-metric={metric} data-formatter={formatter}>{initialValue}</span>
  <span class="hero-label">{label}</span>
  <p class="empty-hint">Paste or type text to begin.</p>
</div>
