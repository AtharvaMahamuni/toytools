---
// Zone B: one line under the tool. Trust, installation, and the platform's signature.
//
// The install button moved out of this row and into ToolBar on 2026-08-09, beside the favourite
// star: "keep this tool" and "install this tool" are the same intent and belong together, and the
// bar is the one part of the page that is always reachable.
//
// Rendered by ToolPage rather than ToolLayout, and that placement is the whole point. ToolLayout
// only has `<slot />`, and the slot holds the widget AND the nav row AND the knowledge drawers,
// so anything ToolLayout renders after the slot lands at the very bottom of the page. Putting
// this row there buried the install button below the FAQ and separated "runs entirely in your
// browser" from the tool it describes. It belongs immediately under the tool it is about.
//
// See docs/analysis/2026-08-08-tool-identity-architecture.md (D2, Zone B).
import TrustNotice from '@components/tool/TrustNotice.astro';
import { withBase } from '@lib/paths';
import type { Tool } from '@data/types';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div class="tool-signature">
  <TrustNotice variant={tool.trustVariant ?? 'private'} />
  {/* The published method the numbers come from, where the engine implements a named one. One row,
      not a section: it belongs beside the privacy badge because it answers the same question a
      person asks at the same moment, which is whether to believe the result. */}
  {tool.methodology && (
    <span class="tool-method" title={tool.methodology.detail}>
      Method<span class="gold-dot" aria-hidden="true"></span>{tool.methodology.name}
    </span>
  )}
  {/* The platform signs the tool rather than owning it, in the micro-label voice already used by
      .io-label and the ToolNavRow "Related" label. Above the title it would compete with the h1
      for the first fixation, which is what the header rebuild spent its effort removing.

      It used to point at the homepage, which reads as a catalog: following it taught a visitor
      that ToyTools has many tools, not that one platform is underneath them. /platform/ is the
      other half of the sentence this line starts. */}
  <a class="tool-attribution" href={withBase('/platform/')} title="What powers this tool">
    Powered by ToyTools<span class="gold-dot" aria-hidden="true"></span>
  </a>
</div>

<style>
  .tool-signature {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }

  .tool-method {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }

  /* Pushed to the far end on desktop; on a phone the row wraps and it simply follows. */
  .tool-attribution {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .tool-attribution:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .tool-attribution {
      margin-left: 0;
    }
  }
</style>
