---
// One ledger row: muted label left, tabular-nums mono value right.
import type { MetricFormatter } from '@data/types';

interface Props {
  metric: string;
  label: string;
  formatter?: MetricFormatter;
  initialValue?: string;
}

const { metric, label, formatter = 'integer', initialValue = '0' } = Astro.props;
---

<div class="tm-stat-row">
  <dt class="tm-stat-label">{label}</dt>
  <dd class="tm-stat-value" data-metric={metric} data-formatter={formatter}>{initialValue}</dd>
</div>
