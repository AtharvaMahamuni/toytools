---
// FAQ Drawer — FAQ content is rendered in the initial HTML (required for FAQPage schema
// and Googlebot), but visually hidden until the user opens the drawer.
// Desktop: slides in from the right. Mobile: slides up as a bottom sheet.
import FaqAccordion from './FaqAccordion.astro';
import type { FAQItem } from '@data/types';

interface Props {
  items: FAQItem[];
  toolName: string;
  drawerId?: string;
}

const { items, toolName, drawerId = 'faq-drawer' } = Astro.props;
---

<!-- Backdrop -->
<div class="faq-backdrop" id={`${drawerId}-backdrop`} aria-hidden="true"></div>

<!-- Drawer (content in DOM for SEO) -->
<div
  class="faq-drawer"
  id={drawerId}
  role="dialog"
  aria-modal="true"
  aria-label={`Common questions about ${toolName}`}
>
  <div class="faq-drawer-header">
    <h2 class="faq-drawer-title">Common Questions</h2>
    <button
      class="faq-drawer-close"
      aria-label="Close FAQ"
      data-faq-close={drawerId}
      type="button"
    >×</button>
  </div>
  <div class="faq-drawer-body">
    <FaqAccordion items={items} />
  </div>
</div>

<style>
  /* ── Backdrop ────────────────────────────────────────────── */

  .faq-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: calc(var(--z-overlay) - 1);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .faq-backdrop.is-open {
    display: block;
    opacity: 1;
  }

  /* ── Drawer base ─────────────────────────────────────────── */

  .faq-drawer {
    position: fixed;
    z-index: var(--z-overlay);
    background: var(--color-bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Hidden state */
    visibility: hidden;
    pointer-events: none;
  }

  .faq-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  /* ── Desktop: right-side panel ───────────────────────────── */

  @media (min-width: 641px) {
    .faq-drawer {
      top: 0;
      right: 0;
      bottom: 0;
      width: min(420px, 90vw);
      border-left: var(--border);
      transform: translateX(100%);
      transition: transform 200ms ease, visibility 0s 200ms;
    }

    .faq-drawer.is-open {
      transform: translateX(0);
      transition: transform 200ms ease, visibility 0s 0s;
    }
  }

  /* ── Mobile: bottom sheet ───────────────────────────────── */

  @media (max-width: 640px) {
    .faq-drawer {
      bottom: 0;
      left: 0;
      right: 0;
      max-height: 82vh;
      border-top: var(--border);
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      transform: translateY(100%);
      transition: transform 250ms ease, visibility 0s 250ms;
    }

    .faq-drawer.is-open {
      transform: translateY(0);
      transition: transform 250ms ease, visibility 0s 0s;
    }
  }

  /* ── Header ──────────────────────────────────────────────── */

  .faq-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--border);
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 1;
  }

  .faq-drawer-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .faq-drawer-close {
    width: var(--touch-target);
    height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-xl);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color 150ms ease, color 150ms ease;
    flex-shrink: 0;
    line-height: 1;
  }

  .faq-drawer-close:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* ── Body ───────────────────────────────────────────────── */

  .faq-drawer-body {
    padding: var(--space-2) var(--space-5) var(--space-8);
  }
</style>

<script is:inline define:vars={{ drawerId }}>
  (function () {
    var drawer = document.getElementById(drawerId);
    var backdrop = document.getElementById(drawerId + '-backdrop');
    if (!drawer || !backdrop) return;

    function open() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      var closeBtn = drawer.querySelector('[data-faq-close]');
      if (closeBtn) closeBtn.focus();
    }

    function close() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      document.body.style.overflow = '';
      var trigger = document.querySelector('[data-faq-open="' + drawerId + '"]');
      if (trigger) trigger.focus();
    }

    // Open triggers
    document.querySelectorAll('[data-faq-open="' + drawerId + '"]').forEach(function (btn) {
      btn.addEventListener('click', open);
    });

    // Close triggers
    drawer.querySelectorAll('[data-faq-close]').forEach(function (btn) {
      btn.addEventListener('click', close);
    });

    backdrop.addEventListener('click', close);

    // Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
    });
  })();
</script>
