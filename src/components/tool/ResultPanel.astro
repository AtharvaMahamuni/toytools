---
// Shared output scaffold: a labelled "Result" area with an optional actions slot in the
// header (e.g. a Copy button). Standardises output markup/a11y across tools. Not mandatory
// for highly custom outputs (timer ring, todo list).
interface Props {
  label?: string;
}

const { label = 'Result' } = Astro.props;
---

<div class="result-shared">
  <div class="result-shared-head">
    <span class="widget-label">{label}</span>
    <slot name="actions" />
  </div>
  <slot />
</div>

<style>
  .result-shared {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .result-shared-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--touch-target);
  }
</style>
