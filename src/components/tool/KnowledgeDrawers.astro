---
// Zone C, entire. One row of triggers under the page's only hairline.
//
// This replaced four stacked blocks totalling 682px, which was 31% of the document, and most of
// that bulk was repetition rather than content:
//
//   ToolNavRow          "Questions (9) · Guide" links pointing at drawers 100px below themselves,
//                       a two-line guide teaser, and a "Related:" list
//   KnowledgeDrawers    the drawers those links pointed at
//   CategoryDiscovery   "Browse all N X" plus a SECOND related-tools list from the same source
//   FeedbackLink        a copy of the footer's own feedback link
//
// So the fix was deletion, not compression. Related tools collapse into the category link (the
// catalog is one click away either way), feedback moved to the footer where its twin already lived,
// and the links that pointed at content directly below them are gone because the content is right
// there.
//
// Two things are load-bearing and must survive any future tidying:
//
//   0. RELATED TOOLS CAME BACK, 2026-08-18, and became three named links on 2026-09-08. A category
//      link hands authority to a hub that splits it across up to eighteen tools; a tool-to-tool
//      link is a topical signal between two specific pages. They used to sit in a closed <details>.
//      Crawlers can read that, extractors often do not, so the three nearest siblings are now
//      visible in the row. Group members are excluded because GroupSwitcher already shows them.
//
//   1. Each <summary> contains a real <h2>. <h2> is one of four slots
//      scripts/check-query-coverage.ts scores query targeting against, and THRESHOLDS
//      .conceptHeadings requires every tool page to carry one that names a concept rather than a
//      page part. Headings are built from knowledge.primaryConcepts[0], which is why that field is
//      load-bearing for search and not just metadata.
//   2. id="faq" on the questions drawer, opened by a matching hash. 32 retired /faq/... URLs are
//      redirect stubs pointing at it and those URLs were indexed once.
//
// The guide is linked, never inlined: guides are separate indexable URLs with Article schema and
// their own knowledge-graph nodes. The category link is also what replaces the breadcrumb removed
// from the header on 2026-08-09, so the internal link to the category hub is preserved.
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import { getKnowledge } from '@lib/knowledge/registry';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { getRelatedTools } from '@lib/tools/related';
import { withBase } from '@lib/paths';
import type { FAQItem, Tool } from '@data/types';

interface Props {
  tool: Tool;
  faqItems: FAQItem[];
  guideHref: string | null;
}

const { tool, faqItems, guideHref } = Astro.props;

const knowledge = getKnowledge(tool.slug);

/** Keeps the page from turning into an essay, and keeps 119 pages inside their byte budget. */
const MAX_ITEMS = 5;

const useCases = (knowledge?.realWorldUseCases ?? []).slice(0, MAX_ITEMS);
const mistakes = (knowledge?.commonMistakes ?? []).slice(0, MAX_ITEMS);

// Concepts are authored to read naturally inside these patterns. Shorter than the sentences these
// replaced ("What X is used for"), because a row of three has to fit, but each still names the
// concept, which is the part targeting scores.
const concept = knowledge?.primaryConcepts?.[0] || tool.name;

const category = categories.find((c) => c.slug === tool.categorySlug);

// Derived, never authored: engine → pattern → family → category, with one slot guaranteed to a
// different family (src/lib/tools/related.ts). Three named siblings, not a category dump.
// Group members are dropped because GroupSwitcher renders them as pills at the top of the page.
const RELATED_COUNT = 3;
// Fetch well past the largest tool group (body-metrics is 11) so that after dropping
// GroupSwitcher members we still have three named out-of-group siblings to show.
const related = getRelatedTools(tool, tools, 24)
  .filter((t) => !tool.toolGroup || t.toolGroup !== tool.toolGroup)
  .slice(0, RELATED_COUNT);

const drawers = [
  { id: 'uses', heading: `Uses of ${concept}`, items: useCases },
  { id: 'pitfalls', heading: `${concept} pitfalls`, items: mistakes },
].filter((d) => d.items.length > 0);

const hasFaq = faqItems.length > 0;
---

{(drawers.length > 0 || hasFaq || related.length > 0 || guideHref || category) && (
  <section class="knowledge-drawers" aria-label={`More about ${tool.name}`}>
    <div class="kd-row">
      {drawers.map((d) => (
        <details class="kd" id={`kd-${d.id}`}>
          <summary class="kd-summary">
            <span class="kd-chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </span>
            <h2 class="kd-heading">{d.heading}</h2>
          </summary>
          <ul class="kd-list">
            {d.items.map((item) => <li>{item}</li>)}
          </ul>
        </details>
      ))}

      {hasFaq && (
        <details class="kd" id="faq">
          <summary class="kd-summary">
            <span class="kd-chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </span>
            <h2 class="kd-heading">{concept} questions <span class="kd-count">({faqItems.length})</span></h2>
          </summary>
          <div class="kd-faq">
            <FaqAccordion items={faqItems} />
          </div>
        </details>
      )}

      {related.length > 0 && (
        <nav class="kd-related-nav" aria-labelledby="kd-related-heading">
          <h2 id="kd-related-heading" class="kd-heading">Tools related to {concept}</h2>
          <span class="kd-related-links">
            {related.map((r, i) => {
              const cat = categories.find((c) => c.slug === r.categorySlug);
              return (
                <>
                  {i > 0 && <span class="kd-sep" aria-hidden="true">·</span>}
                  <a
                    class="kd-sibling"
                    href={withBase(`/tool/${cat?.segment ?? r.categorySlug}/${r.slug}/`)}
                  >{r.name}</a>
                </>
              );
            })}
          </span>
        </nav>
      )}

      {guideHref && (
        <a class="kd-link" href={guideHref}>
          {tool.guide?.title ?? 'Guide'}
          <span class="kd-out" aria-hidden="true">↗</span>
        </a>
      )}

      {category && (
        <a class="kd-link" href={withBase(`/category/${category.slug}/`)}>
          All {category.name}
          <span class="kd-out" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </section>
)}

<script is:inline>
  (function () {
    // Open the drawer the URL points at, including in-page navigation from a redirect stub.
    function openFromHash() {
      var id = location.hash.slice(1);
      if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === 'DETAILS') el.open = true;
    }
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  })();
</script>

<style>
  /* Zone C opens with the page's one hairline, drawn by the lower section per the
     section-boundary recipe. Above it is "do", below it is "understand". */
  .knowledge-drawers {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border);
  }

  .kd-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  /* Closed, a drawer is just another item on the row. Open, it claims a full row of its own so its
     content has somewhere to go without shoving the other triggers around. */
  .kd {
    flex: 0 0 auto;
    /* A closed drawer sizes to its trigger, so a long concept name would push it past the
       screen edge instead of wrapping. */
    max-width: 100%;
  }

  .kd[open] {
    flex: 1 0 100%;
  }

  .kd-summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    cursor: pointer;
    list-style: none;
    color: var(--color-text-muted);
    transition: var(--transition-color);
  }

  .kd-summary:hover {
    color: var(--color-text);
  }

  .kd-summary::-webkit-details-marker {
    display: none;
  }

  .kd-chevron {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-text-subtle);
    transition: transform 200ms ease;
  }

  .kd[open] > .kd-summary .kd-chevron {
    transform: rotate(90deg);
  }

  .kd[open] > .kd-summary {
    color: var(--color-text);
  }

  /* A trigger on a row, not a section title, so it takes the body size. It is still a real heading
     where it counts, which is in the markup. */
  .kd-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    margin: 0;
    /* Lets the heading shrink below its content width so it wraps rather than overflowing. */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .kd-count {
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-normal);
  }

  .kd-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .kd-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .kd-out {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .kd-list {
    margin: 0 0 var(--space-4);
    padding-left: calc(14px + var(--space-2));
    list-style: none;
  }

  .kd-list li {
    position: relative;
    padding-left: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
  }

  .kd-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .kd-faq {
    padding-left: calc(14px + var(--space-2));
    padding-bottom: var(--space-2);
  }
</style>

<style>
  /* Three named siblings in the existing Zone C row, always visible. Not a second section. */
  .kd-related-nav {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    max-width: 100%;
  }

  .kd-related-nav .kd-heading {
    color: var(--color-text-muted);
  }

  .kd-related-links {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .kd-sibling {
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong, var(--color-border));
    text-underline-offset: 3px;
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
  }

  .kd-sibling:hover,
  .kd-sibling:focus-visible {
    color: var(--color-accent-strong, var(--color-accent));
    text-decoration-color: currentColor;
  }

  .kd-sep {
    color: var(--color-text-subtle);
  }
</style>
