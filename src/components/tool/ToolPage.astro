---
// The tool page body, shared by every per-segment route in src/pages/tool/<segment>/[slug].astro.
//
// Why this is a component and not the route itself: a single catch-all route had to resolve any
// tool's Widget.astro via `import.meta.glob('../../../tools/*/*/Widget.astro')`, which makes EVERY
// widget part of that route's module graph. Astro collects page CSS from the whole graph, so every
// tool page linked every bespoke widget's stylesheet — 11 render-blocking sheets, ~53 KB of it
// unused on any given page, on the critical path. The per-segment routes each glob only their own
// segment, so a page now ships its own segment's widget CSS and nothing else (and the sim segments,
// which have no Widget.astro at all, ship none).
//
// The widget itself arrives through the default slot: the route decides whether that is a
// SimulationWidget or the tool's own Widget.astro, so this component never imports either and
// therefore never drags sim CSS onto a text page (or vice versa).
import ToolLayout from '@layouts/ToolLayout.astro';
import KnowledgeDrawers from '@components/tool/KnowledgeDrawers.astro';
import ToolSignature from '@components/tool/ToolSignature.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import GroupSwitcher from '@components/tool/GroupSwitcher.astro';
import ToolNavRow from '@components/tool/ToolNavRow.astro';
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { faqsByToolSlug } from '@data/faq-registry';
import { getToolGroup } from '@data/tool-groups';
import { getRelatedTools } from '@lib/tools/related';
import { withBase } from '@lib/paths';
import type { Tool, Category } from '@data/types';

interface Props {
  tool: Tool;
  category: Category;
  /** Extra JSON-LD blocks (sims add LearningResource + HowTo on top of the generic schema). */
  extraSchemas?: unknown[];
}

const { tool, category, extraSchemas = [] } = Astro.props;

// Group siblings are already linked by the GroupSwitcher above the widget —
// exclude them from the Related strip so it surfaces other tools instead.
const groupSlugs = new Set(
  (tool.toolGroup ? getToolGroup(tool.toolGroup)?.members ?? [] : []).map(m => m.slug),
);
const relatedTools = getRelatedTools(tool, tools, 9)
  .filter(t => !groupSlugs.has(t.slug))
  .map(t => {
    const cat = categories.find(c => c.slug === t.categorySlug);
    return { slug: t.slug, name: t.name, segment: cat?.segment ?? t.categorySlug };
  });

const faqItems = faqsByToolSlug[tool.slug] ?? [];
const guideHref = tool.guide
  ? withBase(`/guide/${tool.guide.categorySlug}/${tool.guide.slug}/`)
  : null;

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

<ToolLayout tool={tool} category={category}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {extraSchemas.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

  {tool.toolGroup && <GroupSwitcher tool={tool} />}

  <slot />

  {/* Zone B: immediately under the tool, before anything that is about other pages. */}
  <ToolSignature tool={tool} />

  <ToolNavRow
    faqItems={faqItems}
    guideHref={guideHref}
    guideTitle={tool.guide?.title}
    guideReadMinutes={tool.guide?.readMinutes}
    relatedTools={relatedTools}
    toolName={tool.name}
  />

  <KnowledgeDrawers tool={tool} faqItems={faqItems} />

  {/* Rendered once, here, instead of by each of 32 widget files. A widget renders the tool; the
      catalog is the platform's business. validate-architecture forbids the import under
      src/tools/ so this cannot creep back the next time a widget is copied as a template. */}
  <CategoryDiscovery toolSlug={tool.slug} />
</ToolLayout>

{/* No styles: Zone C is KnowledgeDrawers' own, and it draws the section boundary itself. */}
