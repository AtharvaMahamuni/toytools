---
interface Props {
  href: string;
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
}

const { href, title, description, readMinutes, updatedAt } = Astro.props;
---

<a class="guide-teaser" href={href}>
  <p class="guide-teaser-label"><span class="gold-dot" aria-hidden="true"></span> Reference Guide</p>
  <h3 class="guide-teaser-title">{title}</h3>
  <p class="guide-teaser-desc">{description}</p>
  <p class="guide-teaser-meta">
    {readMinutes} min read
    <span class="gold-dot" aria-hidden="true"></span>
    Updated {updatedAt}
    <span class="guide-teaser-cta">Read the full guide →</span>
  </p>
</a>

<style>
  .guide-teaser {
    display: block;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-color);
  }

  .guide-teaser:hover {
    border-color: var(--color-text-accent);
  }

  .guide-teaser-label {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .guide-teaser-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .guide-teaser-desc {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
    margin-bottom: var(--space-4);
  }

  .guide-teaser-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .guide-teaser-cta {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-medium);
    margin-left: auto;
  }
</style>
