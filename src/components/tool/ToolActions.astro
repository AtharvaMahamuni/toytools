---
import { allowsUrlState } from '@lib/url-state';

interface Props {
  copyTarget?: string;
  clearTarget?: string;
  pasteTarget?: string;
  downloadFilename?: string;
  // Element to read the download content from. Defaults to clearTarget for
  // single-textarea tools (input doubles as the editable content); engine
  // widgets with a separate output element should pass it explicitly.
  downloadTarget?: string;
  // Render the "Copy link" / "Share" action. Pass the tool's engine and pattern and the
  // build-time policy decides; never pass a hardcoded true. On a tool whose input may be a
  // secret the button is not rendered at all — not disabled, absent.
  shareEngine?: string;
  sharePattern?: string;
}

const {
  copyTarget, clearTarget, pasteTarget, downloadFilename, downloadTarget,
  shareEngine, sharePattern,
} = Astro.props;
const resolvedDownloadTarget = downloadTarget || clearTarget;
const canShare = (shareEngine || sharePattern) ? allowsUrlState(shareEngine, sharePattern) : false;
const hasAny = copyTarget || clearTarget || pasteTarget || canShare;
---

{hasAny && (
  <div class="tool-actions">
    {pasteTarget && (
      <button
        class="action-btn action-btn--paste"
        data-action="paste"
        data-target={pasteTarget}
        data-label="Paste"
        aria-label="Paste from clipboard"
      >
        Paste
      </button>
    )}
    {copyTarget && (
      <button
        class="action-btn action-btn--copy"
        data-action="copy"
        data-target={copyTarget}
        data-label="Copy"
        aria-label="Copy text to clipboard"
      >
        Copy
      </button>
    )}
    {clearTarget && (
      <button
        class="action-btn action-btn--clear"
        data-action="clear"
        data-target={clearTarget}
        data-label="Clear"
        aria-label="Clear text"
      >
        Clear
      </button>
    )}
    {canShare && (
      <button
        class="action-btn action-btn--share"
        data-action="share"
        data-label="Copy link"
        aria-label="Copy a link to this result"
      >
        Copy link
      </button>
    )}
    {downloadFilename && resolvedDownloadTarget && (
      <button
        class="action-btn action-btn--download"
        data-action="download"
        data-target={resolvedDownloadTarget}
        data-filename={downloadFilename}
        data-label="Download"
        aria-label={`Download as ${downloadFilename}`}
      >
        Download
      </button>
    )}
    <slot />
  </div>
)}

<script>
  const timers = new WeakMap<HTMLElement, number>();

  function resetButton(btn: HTMLElement) {
    const existing = timers.get(btn);
    if (existing) { clearTimeout(existing); timers.delete(btn); }
    btn.classList.remove('is-success', 'is-confirming');
    const label = btn.dataset.label;
    if (label) btn.textContent = label;
  }

  function arm(btn: HTMLElement, cls: string, text: string, ms: number) {
    const existing = timers.get(btn);
    if (existing) clearTimeout(existing);
    btn.classList.add(cls);
    btn.textContent = text;
    timers.set(btn, window.setTimeout(() => resetButton(btn), ms));
  }

  document.addEventListener('click', (e: MouseEvent) => {
    const btn = (e.target as Element)?.closest<HTMLElement>('[data-action]');
    if (!btn) return;

    const action = btn.dataset.action;
    const targetId = btn.dataset.target;
    const target = targetId
      ? (document.getElementById(targetId) as HTMLTextAreaElement | null)
      : null;
    const TT = (window as any).ToyTools;

    if (action === 'clear') {
      if (!btn.classList.contains('is-confirming')) {
        arm(btn, 'is-confirming', 'Confirm Clear', 3000);
        return;
      }
      resetButton(btn);
      if (target) {
        target.value = '';
        target.dispatchEvent(new Event('input'));
        target.focus();
      }
      return;
    }

    if (action === 'copy' && target) {
      if (!target.value.trim()) { TT?.toast('Nothing to copy!'); return; }
      TT?.copy(target.value);
      arm(btn, 'is-success', '✓ Copied', 2000);
      return;
    }

    // The values come from the widget, not the DOM: only the widget knows which of its fields
    // are worth sharing. It registers ToyTools.url.provider; without one there is nothing to share.
    if (action === 'share') {
      const provider = TT?.url?.provider;
      const values = typeof provider === 'function' ? provider() : null;
      if (!values || !Object.keys(values).length) { TT?.toast('Nothing to link to yet.'); return; }
      TT.url.share(values, document.title);
      // navigator.share opens the OS sheet and says so itself; the clipboard path needs feedback.
      if (!navigator.share) arm(btn, 'is-success', '✓ Link copied', 2000);
      return;
    }

    if (action === 'paste' && target) {
      if (!navigator.clipboard?.readText) { TT?.toast('Paste not supported here'); return; }
      navigator.clipboard.readText().then((text) => {
        target.value = text;
        target.dispatchEvent(new Event('input'));
        target.focus();
      }).catch(() => TT?.toast('Paste failed — check clipboard permissions'));
      return;
    }

    if (action === 'download' && target) {
      const text = target.value;
      if (!text.trim()) { TT?.toast('Nothing to download!'); return; }
      const blob = new Blob([text], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = btn.dataset.filename ?? 'text.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  });

  // Disarm a confirming Clear button when clicking elsewhere
  document.addEventListener('click', (e: MouseEvent) => {
    const armed = document.querySelector<HTMLElement>('.action-btn--clear.is-confirming');
    if (!armed) return;
    if (!(e.target as Element)?.closest('.action-btn--clear')) resetButton(armed);
  });
</script>
