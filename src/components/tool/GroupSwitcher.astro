---
// GroupSwitcher — mode pills for tools that belong to a tool group (src/data/tool-groups.ts).
// Each pill is a real link to the sibling tool's own page: crawlable internal links, works
// without JS. Sibling pages are prefetched so switching feels instant; input text survives
// via the shared group state key in TextProcessorWidget.
import type { ToolConfig } from '@data/types';
import { getToolGroup } from '@data/tool-groups';
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { withBase } from '@lib/paths';

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;

const group = tool.toolGroup ? getToolGroup(tool.toolGroup) : undefined;

const members = (group?.members ?? []).map(member => {
  const memberTool = tools.find(t => t.slug === member.slug);
  const segment = categories.find(c => c.slug === memberTool?.categorySlug)?.segment;
  return {
    ...member,
    href: segment ? withBase(`/tool/${segment}/${member.slug}/`) : null,
    active: member.slug === tool.slug,
  };
}).filter(m => m.href !== null);

const siblings = members.filter(m => !m.active);
---

{group && members.length > 1 && (
  <>
    <nav class="group-switcher" aria-label={`${group.name} modes`}>
      {members.map(m => (
        <a
          class="group-pill"
          href={m.href}
          aria-current={m.active ? 'page' : undefined}
        >{m.label}</a>
      ))}
    </nav>
    {siblings.map(m => <link rel="prefetch" href={m.href} />)}
  </>
)}

<style>
  .group-switcher {
    display: flex;
    gap: var(--space-2);
    /* A control strip, not a section: it sits closer to the tool it switches than a section gap
       would put it, and the reclaimed height is what keeps the answer above the fold on the
       calculator pages (tests/e2e/health.spec.ts pins that). */
    margin-bottom: var(--space-5);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* The largest group is 11 pills, which cannot fit a 393px screen and cannot wrap either: four
       rows would push the answer past the fold that health.spec.ts pins. So the row scrolls, and
       with the scrollbar hidden it gave no sign of that on 61 of 121 tools -- the pill at the edge
       was simply sliced off, which reads as the page being broken rather than as "there is more".
       The trailing edge now fades instead, so the strip reads as continuing.

       This is a mask rather than a background gradient because the pills are opaque and would
       paint straight over a background layer. A mask cannot be made conditional on scroll position
       in CSS, so the fade is always drawn: scrolled fully right, the last pill keeps a soft edge.
       That is the accepted trade for costing no height and no JavaScript on 74 pages.

       #000 is not a colour here: a mask reads only the alpha channel, so the value is opaque-vs-
       transparent and never paints. A token would imply a palette decision that does not exist. */
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
  }

  .group-switcher::-webkit-scrollbar {
    display: none;
  }

  .group-pill {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: var(--transition-color);
  }

  .group-pill:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
    text-decoration: none;
  }

  .group-pill[aria-current='page'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
    cursor: default;
  }
</style>
