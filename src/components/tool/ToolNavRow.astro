---
// Inline navigation row — Layer 2 (FAQ + Guide) and Layer 3 (Related Tools).
// Replaces the old GuideTeaser card, inline FAQ accordion, EcosystemLinks, and RelatedTools block.
import type { FAQItem } from '@data/types';
import { withBase } from '@lib/paths';

interface RelatedTool {
  slug: string;
  name: string;
  categorySlug: string;
}

interface Props {
  faqItems: FAQItem[];
  guideHref: string | null;
  guideTitle?: string;
  guideReadMinutes?: number;
  relatedTools: RelatedTool[];
  toolName: string;
}

const {
  faqItems,
  guideHref,
  guideTitle,
  guideReadMinutes,
  relatedTools,
  toolName,
} = Astro.props;

const hasFaq = faqItems.length > 0;
const hasGuide = !!guideHref;
const topRelated = relatedTools.slice(0, 3);

// Build guide teaser label
const guideTeaser = guideTitle
  ? `Learn how ${toolName.toLowerCase()} works`
  : null;
---

<div class="tool-nav-row">
  {/* Layer 2: FAQ + Guide links */}
  {(hasFaq || hasGuide) && (
    <div class="nav-links">
      {hasFaq && (
        <a class="nav-link" href="#faq">
          Common Questions <span class="faq-count">({faqItems.length})</span>
        </a>
      )}
      {hasFaq && hasGuide && <span class="nav-sep" aria-hidden="true">·</span>}
      {hasGuide && (
        <a class="nav-link" href={guideHref}>Guide</a>
      )}
    </div>
  )}

  {/* Compact guide teaser — one line */}
  {hasGuide && guideTeaser && (
    <p class="guide-teaser-line">
      <a href={guideHref} class="guide-teaser-link">
        {guideTeaser} →
        {guideReadMinutes && <span class="guide-teaser-meta">{guideReadMinutes} min read</span>}
      </a>
    </p>
  )}

  {/* Layer 3: Related tools strip */}
  {topRelated.length > 0 && (
    <p class="related-strip">
      <span class="related-label">Related:</span>
      {topRelated.map((tool, i) => (
        <>
          {i > 0 && <span class="related-sep" aria-hidden="true">·</span>}
          <a class="related-link" href={withBase(`/tool/${tool.categorySlug}/${tool.slug}/`)}>{tool.name}</a>
        </>
      ))}
    </p>
  )}
</div>

<style>
  .tool-nav-row {
    padding-top: var(--space-8);
    border-top: var(--border);
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ── Layer 2: nav links row ──────────────────────────────── */

  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-accent);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  .faq-count {
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-normal);
    font-size: var(--text-xs);
  }

  .nav-sep {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    user-select: none;
  }

  /* ── Guide teaser line ───────────────────────────────────── */

  .guide-teaser-line {
    max-width: unset;
    margin: 0;
  }

  .guide-teaser-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: var(--transition-color);
  }

  .guide-teaser-link:hover {
    color: var(--color-text);
  }

  .guide-teaser-meta {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  /* ── Layer 3: related tools strip ───────────────────────── */

  .related-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-2);
    font-size: var(--text-sm);
    max-width: unset;
    margin: 0;
  }

  .related-label {
    color: var(--color-text-subtle);
    flex-shrink: 0;
  }

  .related-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .related-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .related-sep {
    color: var(--color-text-subtle);
    user-select: none;
  }
</style>
