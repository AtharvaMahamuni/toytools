---
// Secondary metrics ledger: hairline-separated label/value rows below the hero,
// inside the same result IoPanel. Starts hidden — the metric script reveals it
// (.tm-secondary) once there is text to analyze.
import type { MetricFormatter } from '@data/types';
import StatCard from './StatCard.astro';

interface StatDef {
  metric: string;
  label: string;
  formatter?: MetricFormatter;
}

interface Props {
  stats: StatDef[];
}

const { stats } = Astro.props;
---

<dl class="tm-stats tm-secondary" aria-live="polite" hidden>
  {stats.map(s => (
    <StatCard metric={s.metric} label={s.label} formatter={s.formatter} />
  ))}
</dl>
