---
// Accessible, zero-CLS language switcher styled to ToyTools / DESIGN.md tokens.
// Uses native <details> with real <a hreflang> links so crawlers and no-JS environments navigate
// reliably, enhanced progressively with Escape/outside-click and arrow-key handling.
import { SUPPORTED_LOCALES, type LocaleCode } from '@data/locales';
import { getUiStrings } from '@data/i18n/index';

interface AlternateRoute {
  code: LocaleCode;
  href: string;
}

interface Props {
  lang?: LocaleCode;
  alternates?: AlternateRoute[];
  variant?: 'header' | 'footer';
}

const { lang = 'en', alternates = [], variant = 'header' } = Astro.props;
const t = getUiStrings(lang);
const current = SUPPORTED_LOCALES[lang];
const show = alternates.length > 1;
---

{show && (
  <details
    class:list={['lang-switcher', `lang-switcher--${variant}`]}
    data-lang-switcher
  >
    <summary
      class="lang-trigger"
      aria-label={`${t.nav.languageAria}: ${current.nativeName}`}
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <line x1="2" y1="12" x2="22" y2="12" />
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
      </svg>
      <span class="lang-code">{current.code.toUpperCase()}</span>
      <svg
        class="lang-chevron"
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </summary>
    <div class="lang-menu" role="menu" aria-label={t.nav.languageLabel}>
      {alternates.map((alt) => {
        const cfg = SUPPORTED_LOCALES[alt.code];
        const active = alt.code === lang;
        return (
          <a
            href={alt.href}
            hreflang={cfg.hreflang}
            lang={cfg.code}
            role="menuitemradio"
            aria-checked={active ? 'true' : 'false'}
            class:list={['lang-option', { 'is-active': active }]}
          >
            <span class="lang-native">{cfg.nativeName}</span>
            <span class="lang-short">{cfg.code.toUpperCase()}</span>
          </a>
        );
      })}
    </div>
  </details>
)}

{show && variant === 'header' && (
<style is:inline>
.lang-switcher{position:relative;display:inline-block}
.lang-trigger{list-style:none;display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:4px 10px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text-muted);font-size:var(--text-xs);font-weight:var(--font-weight-medium);cursor:pointer;user-select:none;transition:border-color var(--duration-fast) var(--ease-default),color var(--duration-fast) var(--ease-default)}
.lang-trigger::-webkit-details-marker{display:none}
.lang-trigger:hover{border-color:var(--color-border-strong);color:var(--color-text)}
.lang-trigger:focus-visible{outline:var(--focus-ring);outline-offset:var(--focus-ring-offset)}
.lang-switcher[open] .lang-trigger{border-color:var(--color-accent);color:var(--color-text)}
.lang-chevron{transition:transform var(--duration-fast) var(--ease-default)}
.lang-switcher[open] .lang-chevron{transform:rotate(180deg)}
.lang-menu{position:absolute;right:0;top:calc(100% + 6px);min-width:156px;padding:4px;background:var(--color-surface);border:1px solid var(--color-border-strong);border-radius:var(--radius-md);z-index:var(--z-raised);display:flex;flex-direction:column;gap:2px}
.lang-switcher--footer .lang-menu{top:auto;bottom:calc(100% + 6px);right:auto;left:0}
.lang-option{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:36px;padding:6px 10px;border-radius:var(--radius-sm);font-size:var(--text-sm);color:var(--color-text);text-decoration:none;transition:background var(--duration-fast) var(--ease-default)}
.lang-option:hover,.lang-option:focus-visible{background:var(--color-surface-hover);outline:none}
.lang-option.is-active{background:var(--color-accent-subtle);color:var(--color-accent-strong);font-weight:var(--font-weight-semibold)}
.lang-short{font-family:var(--font-mono);font-size:var(--text-xs);color:var(--color-text-subtle)}
.lang-option.is-active .lang-short{color:var(--color-accent-strong)}
</style>
)}

<script is:inline>
  (function () {
    if (window.__ttLangInit) return;
    window.__ttLangInit = true;
    document.addEventListener('click', function (e) {
      document.querySelectorAll('details[data-lang-switcher][open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('details[data-lang-switcher][open]').forEach(function (d) {
        d.removeAttribute('open');
        var s = d.querySelector('summary');
        if (s) s.focus();
      });
    });
  })();
</script>
