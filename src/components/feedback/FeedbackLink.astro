---
// The only feedback entry point on a tool page: one quiet line under everything else.
//
// Rendered by ToolLayout after the slot, so it sits below the widget, the nav row, and the
// FAQ on every tool without a single per-tool edit. There is nothing to click by accident and
// nothing to score: no thumbs, no rating, no counter. Someone who has a real problem will
// scroll to the bottom looking for a way to say so, and this is what they find.
import { withBase } from '@lib/paths';
import { allowsInputCapture, MAX_CAPTURED_INPUT } from '@lib/feedback/config';
import type { Tool } from '@data/types';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const href = withBase(`/feedback/?tool=${encodeURIComponent(tool.slug)}`);

// Whether we may stash what the visitor typed so the feedback page can offer to attach it to a
// bug report. On a JWT decoder or a hash generator that value could be a live secret, so those
// tools never capture at all — the branch is decided at build time from registry metadata, so
// the capturing script is simply not emitted on them.
const canCapture = allowsInputCapture(tool.engine, tool.pattern);
---

<aside class="feedback-invite">
  <p class="feedback-invite-text">
    Something wrong here, or a tool you wish existed?
  </p>
  <a class="feedback-invite-link" href={href} data-feedback-link>Send feedback →</a>
</aside>

{canCapture && (
  <script is:inline define:vars={{ slug: tool.slug, limit: MAX_CAPTURED_INPUT }}>
    // Stash the visitor's current input as they leave for the feedback page, so a bug report can
    // offer "include what I typed" without them retyping it. sessionStorage, not localStorage:
    // it belongs to this tab and this trip, and it is read once and cleared.
    (function () {
      var link = document.querySelector('[data-feedback-link]');
      if (!link) return;

      link.addEventListener('click', function () {
        try {
          var key = 'toytools.feedback.capture';
          var fields = document.querySelectorAll(
            'main textarea, main input[type="text"], main input[type="search"]',
          );
          for (var i = 0; i < fields.length; i++) {
            var value = (fields[i].value || '').trim();
            if (value) {
              sessionStorage.setItem(
                key,
                JSON.stringify({ slug: slug, value: value.slice(0, limit) }),
              );
              return;
            }
          }
          // Nothing typed: clear any stale capture so the next page cannot offer someone
          // else's leftovers.
          sessionStorage.removeItem(key);
        } catch (e) {
          // Private browsing denies sessionStorage. Attaching the input is a convenience,
          // so losing it must never block the navigation.
        }
      });
    })();
  </script>
)}

<style>
  /* Last section on the page, so it draws the boundary itself — one hairline, symmetric
     breathing room. See the section-boundary recipe in tool-widget.css. */
  .feedback-invite {
    margin-top: var(--space-8);
    border-top: var(--border);
    padding-top: var(--space-8);
  }

  .feedback-invite-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .feedback-invite-link {
    /* inline-block so the tap area reaches the 48px target without the link looking
       like a button. Phones have no hover, hence the explicit pressed state below. */
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .feedback-invite-link:hover {
    text-decoration: underline;
  }

  .feedback-invite-link:active {
    color: var(--color-accent-strong);
  }
</style>
