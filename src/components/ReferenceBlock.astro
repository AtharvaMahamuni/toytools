---
interface Props {
  type: 'key-idea' | 'common-mistake' | 'note';
  heading?: string;
}

const defaultHeadings: Record<Props['type'], string> = {
  'key-idea': 'Key Idea',
  'common-mistake': 'Common Mistake',
  'note': 'Note',
};

const { type, heading } = Astro.props;
const label = heading ?? defaultHeadings[type];
---

<aside class="ref-block" data-type={type}>
  <p class="ref-heading">{label}</p>
  <slot />
</aside>

<style>
  .ref-block {
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-border-strong);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-bg-tertiary);
    margin-block: var(--space-4);
  }

  .ref-block[data-type="key-idea"] {
    border-left-color: var(--color-text);
  }

  .ref-block[data-type="common-mistake"] {
    border-left-color: var(--color-danger);
  }

  .ref-heading {
    font-weight: var(--font-weight-semibold);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
    max-width: unset;
  }

  :global(.ref-block p:not(.ref-heading)) {
    font-size: var(--text-base);
    max-width: unset;
    color: var(--color-text);
  }
</style>
