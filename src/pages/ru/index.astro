---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Русский')}
  description="ToyTools — бесплатные, конфиденциальные, браузерные инструменты для повседневных задач. Без регистрации, без слежки."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Бесплатные, конфиденциальные, браузерные инструменты для повседневных задач.</p>
    <a href={withBase('/')}>Смотреть все инструменты →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
