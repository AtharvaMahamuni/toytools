---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import HeroSearch from '@components/HeroSearch.astro';
import CategoryIndex from '@components/CategoryIndex.astro';
import ToolDirectory from '@components/ToolDirectory.astro';
import { tools } from '@data/registry';

// Named once and used for both the meta description and the WebSite schema, which
// carried two copies of the same sentence and could drift apart. It names the three
// things a visitor gets before it makes any claim about privacy: trust lands after
// someone knows what the thing is, not before.
const SITE_DESCRIPTION =
  'Over a hundred browser-based calculators, converters and text tools. ' +
  'Nothing uploads, nothing is stored, no account needed.';
---

<BaseLayout
  title={generatePageTitle('home')}
  description={SITE_DESCRIPTION}
  maxWidth="content"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        description: SITE_DESCRIPTION,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${Astro.site?.href ?? 'https://toytoolsapp.com/'}search?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
      {
        '@type': 'Organization',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        // A raster well above Google's 112px minimum for an Organization logo; the SVG
        // it pointed at has no intrinsic size, which Google treats as ineligible.
        logo: new URL('/favicon-512.png', Astro.site ?? 'https://toytoolsapp.com/').href,
      },
    ],
  })} />

  <section class="hero">
    {/* The h1 was the word "ToyTools", which spent the page's strongest heading on a
        brand nobody searches for yet. The brand still owns the nav, the title, the
        WebSite schema and the footer; the h1 now says what you can do here. */}
    <h1>Convert, calculate, encode.<br class="h1-break" /> In your browser.</h1>
    {/* The line that says what this is meant to feel like, rather than what it contains: a
        toolbox you open, use one thing from, and close. Everything below it (one job per tool,
        no account, no upload, opens instantly) is that sentence being kept. */}
    <p class="hero-tagline">The internet's little toolbox.</p>
    <HeroSearch />
    <p class="hero-sub">
      <span>{tools.length} tools</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span>Everything runs in your browser</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span>No sign-up, nothing uploaded</span>
    </p>
  </section>

  <p class="recent-row" id="favorite-row" hidden>
    <span class="recent-label">Favourites:</span>
    <span id="favorite-chips"></span>
  </p>

  <p class="recent-row" id="recent-row" hidden>
    <span class="recent-label">Recent:</span>
    <span id="recent-chips"></span>
  </p>

  <section class="section">
    <CategoryIndex />
  </section>

  {/* The full directory still ships in the HTML, closed. It is the power-user path and it
      keeps every tool one internal link from the homepage; what it is not, any more, is the
      first thing a visitor has to read. */}
  <details class="all-tools">
    <summary class="all-tools-summary">
      Browse all {tools.length} tools
    </summary>
    <div class="all-tools-body">
      <ToolDirectory />
    </div>
  </details>

  <script is:inline>
    (function () {
      function findLink(slug) {
        var direct = document.querySelector('.dir-link[data-slug="' + slug + '"]');
        if (direct) return direct;
        // Group entries cover their members via data-group-slugs="a,b,c".
        var groups = document.querySelectorAll('.dir-link[data-group-slugs]');
        for (var i = 0; i < groups.length; i++) {
          var slugs = (groups[i].getAttribute('data-group-slugs') || '').split(',');
          if (slugs.indexOf(slug) !== -1) return groups[i];
        }
        return null;
      }

      // Both rows are the same chip strip over a list of slugs, so they share one renderer.
      // The directory below is already rendered server-side, so a chip is a clone of the real
      // link: no URLs to rebuild and no second source of truth for a tool's name.
      function renderRow(slugs, chipsId, rowId, limit) {
        var chips = document.getElementById(chipsId);
        var row = document.getElementById(rowId);
        if (!chips || !row || !slugs.length) return;

        var added = 0;
        var seen = {};
        slugs.forEach(function (slug) {
          if (added >= limit || !slug) return;
          var link = findLink(slug);
          if (!link || seen[link.getAttribute('href')]) return;
          seen[link.getAttribute('href')] = true;
          if (added > 0) {
            var sep = document.createElement('span');
            sep.className = 'recent-sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '·';
            chips.appendChild(sep);
          }
          var a = link.cloneNode(true);
          a.className = 'recent-chip';
          chips.appendChild(a);
          added++;
        });
        if (added > 0) row.hidden = false;
      }

      var TT = window.ToyTools;
      var favorites = (TT && TT.favorites) ? TT.favorites.list() : [];
      var recent = (TT && TT.getRecent) ? TT.getRecent() : [];

      renderRow(favorites, 'favorite-chips', 'favorite-row', 6);
      // A tool that is already pinned above does not need repeating as "recent".
      renderRow(
        recent.map(function (e) { return e && e.slug; }).filter(function (slug) {
          return slug && favorites.indexOf(slug) === -1;
        }),
        'recent-chips', 'recent-row', 5
      );
    })();
  </script>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-12) 0;
  }

  /* Sized down from the old clamp(3xl, 5vw, 5xl): that ceiling was set for the single
     word "ToyTools" and turns a sentence into three lines of shouting on a phone. */
  .hero h1 {
    font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl));
    font-weight: var(--font-weight-bold);
    margin: 0;
    line-height: var(--leading-tight);
    max-width: 20ch;
  }

  /* Phones wrap the sentence wherever it falls; above 640px the break is placed so the
     two clauses stack cleanly instead of splitting mid-clause. */
  .h1-break {
    display: none;
  }

  @media (min-width: 640px) {
    .h1-break {
      display: inline;
    }
  }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--color-text-muted);
    max-width: 44ch;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .hero-sub {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin: 0;
  }

  /* ── Recent chips ─────────────────────────────────────────── */

  /* display:flex would defeat the hidden attribute — keep it explicit */
  .recent-row[hidden] {
    display: none;
  }

  .recent-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-8);
    max-width: unset;
  }

  .recent-label {
    color: var(--color-text-subtle);
  }

  .recent-row :global(.recent-chip) {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .recent-row :global(.recent-chip:hover) {
    color: var(--color-text);
  }

  .recent-row :global(.recent-sep) {
    color: var(--color-text-subtle);
    margin-inline: var(--space-1);
    user-select: none;
  }

  /* ── Sections ─────────────────────────────────────────────── */

  .section {
    padding-bottom: var(--space-8);
  }

  /* ── All-tools disclosure ─────────────────────────────────── */

  .all-tools {
    padding-top: var(--space-8);
    border-top: var(--border);
  }

  .all-tools-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    transition: var(--transition-color);
  }

  /* Safari draws its own disclosure triangle through `list-style: none`. */
  .all-tools-summary::-webkit-details-marker {
    display: none;
  }

  .all-tools-summary::before {
    content: '+';
    font-size: var(--text-base);
    line-height: 1;
    color: var(--color-text-subtle);
  }

  .all-tools[open] .all-tools-summary::before {
    content: '−';
  }

  .all-tools-summary:hover,
  .all-tools-summary:active {
    color: var(--color-text);
  }

  .all-tools-body {
    padding-top: var(--space-6);
  }
</style>
