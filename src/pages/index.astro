---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import HeroSearch from '@components/HeroSearch.astro';
import CategoryIndex from '@components/CategoryIndex.astro';
import ToolDirectory from '@components/ToolDirectory.astro';
import { tools } from '@data/registry';
import { engineRegistry, knownPatterns } from '@data/engines';
import { withBase } from '@lib/paths';

// Named once and used for both the meta description and the WebSite schema, which
// carried two copies of the same sentence and could drift apart. It names the three
// things a visitor gets before it makes any claim about privacy: trust lands after
// someone knows what the thing is, not before.
// Quality Guardian holds every meta description at 160 characters, which is the real
// constraint on this sentence: the platform frame and the retrieval terms both have to fit.
const SITE_DESCRIPTION =
  'ToyTools is one platform behind a hundred-plus browser-based calculators, ' +
  'converters and text tools. Every one runs on your device: nothing uploads.';

// The platform strip below is registry-derived for the same reason /platform/ is: a claim about
// how the site is built should stop being made the moment the build stops supporting it.
const engineCount = engineRegistry.length;
const patternCount = knownPatterns.size;
---

<BaseLayout
  title={generatePageTitle('home')}
  description={SITE_DESCRIPTION}
  maxWidth="content"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        description: SITE_DESCRIPTION,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${Astro.site?.href ?? 'https://toytoolsapp.com/'}search?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
      {
        '@type': 'Organization',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        // A raster well above Google's 112px minimum for an Organization logo; the SVG
        // it pointed at has no intrinsic size, which Google treats as ineligible.
        logo: new URL('/favicon-512.png', Astro.site ?? 'https://toytoolsapp.com/').href,
      },
    ],
  })} />

  <section class="hero">
    {/* The h1 was the word "ToyTools", which spent the page's strongest heading on a
        brand nobody searches for yet. The brand still owns the nav, the title, the
        WebSite schema and the footer; the h1 now says what you can do here. */}
    <h1>Convert, calculate, encode.<br class="h1-break" /> In your browser.</h1>
    {/* The line that says what this is meant to feel like, rather than what it contains, and
        then the sentence that pays it off. A bare "little toolbox" makes a claim and stops,
        which leaves the reader to supply the meaning; the second sentence supplies it. The
        wrench lives in the README instead: the gold dot is this site's mark, and an emoji
        beside it in the hero competes with the thing it is supposed to reinforce. */}
    <p class="hero-tagline">
      The internet's little toolbox. Open it, take out the one thing that does the job, and
      close the tab.
    </p>
    <HeroSearch />
    {/* "Everything runs in your browser" was here and in the h1 above it, which spent the
        strongest line on the page saying one thing twice. The slot now carries the offline
        claim, bounded: the service worker precaches only / and /offline/ and caches pages as
        you visit them, so an unqualified "works offline" would promise a catalog a first-time
        visitor with no network does not have. */}
    <p class="hero-sub">
      <span>{tools.length} tools</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span>Nothing uploaded</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span>Works offline once opened</span>
    </p>
  </section>

  {/* The line that names the thing behind the catalog. A visitor who reads only this should
      come away with "one system, many doors" rather than "a big list", which is the sense the
      tool pages already give with their "Powered by ToyTools" signature. */}
  <p class="hero-intro">
    One platform, {tools.length} doors into it. Every tool runs on the same engines, the same
    browser runtime and the same rules: it opens instantly, computes on your device, and behaves
    the way the last one did. Nothing is uploaded and there is no account to make.
  </p>

  <p class="recent-row" id="favorite-row" hidden>
    <span class="recent-label">Favourites:</span>
    <span id="favorite-chips"></span>
  </p>

  <p class="recent-row" id="recent-row" hidden>
    <span class="recent-label">Recent:</span>
    <span id="recent-chips"></span>
  </p>

  <section class="section">
    <CategoryIndex />
  </section>

  {/* Placed after the categories on purpose: it answers the question browsing them raises, which
      is what holds a hundred unrelated-looking utilities together. Four claims, no boxes, and
      every number comes from the registry the build validates. */}
  <section class="platform-strip" aria-labelledby="platform-heading">
    <p class="strip-eyebrow">Powered by ToyTools<span class="gold-dot" aria-hidden="true"></span></p>
    <h2 id="platform-heading">These are not {tools.length} separate tools</h2>
    <p class="strip-lede">
      They are one platform with {tools.length} faces. The computation lives in {engineCount}
      shared engines, the interface and the privacy contract belong to the platform, and a tool
      is mostly a declaration of which engine it runs on.
    </p>
    <ul class="strip-facts">
      <li>
        <strong>{engineCount} engines, {patternCount} patterns</strong>
        <span>The maths lives in a tested engine, not in a page, so a fix lands for every tool on it at once.</span>
      </li>
      <li>
        <strong>One runtime, loaded once</strong>
        <span>Copy, saved state, search, shortcuts and dark mode are the platform's. Each page then loads only its own engine.</span>
      </li>
      <li>
        <strong>No server to send anything to</strong>
        <span>There is no application server and no database behind any of it. The engines run in your browser.</span>
      </li>
      <li>
        <strong>Budgets enforced by the build</strong>
        <span>Every page has a byte budget. A change that makes one heavier than its budget fails the build.</span>
      </li>
    </ul>
    <p class="strip-links">
      <a href={withBase('/platform/')}>How the platform is built</a>
      <span class="gold-dot" aria-hidden="true"></span>
      <a href={withBase('/architecture/')}>See the map</a>
    </p>
  </section>

  {/* The full directory still ships in the HTML, closed. It is the power-user path and it
      keeps every tool one internal link from the homepage; what it is not, any more, is the
      first thing a visitor has to read. */}
  <details class="all-tools">
    <summary class="all-tools-summary">
      Browse all {tools.length} tools
    </summary>
    <div class="all-tools-body">
      <ToolDirectory />
    </div>
  </details>

  <script is:inline>
    (function () {
      function findLink(slug) {
        var direct = document.querySelector('.dir-link[data-slug="' + slug + '"]');
        if (direct) return direct;
        // Group entries cover their members via data-group-slugs="a,b,c".
        var groups = document.querySelectorAll('.dir-link[data-group-slugs]');
        for (var i = 0; i < groups.length; i++) {
          var slugs = (groups[i].getAttribute('data-group-slugs') || '').split(',');
          if (slugs.indexOf(slug) !== -1) return groups[i];
        }
        return null;
      }

      // Both rows are the same chip strip over a list of slugs, so they share one renderer.
      // The directory below is already rendered server-side, so a chip is a clone of the real
      // link: no URLs to rebuild and no second source of truth for a tool's name.
      function renderRow(slugs, chipsId, rowId, limit) {
        var chips = document.getElementById(chipsId);
        var row = document.getElementById(rowId);
        if (!chips || !row || !slugs.length) return;

        var added = 0;
        var seen = {};
        slugs.forEach(function (slug) {
          if (added >= limit || !slug) return;
          var link = findLink(slug);
          if (!link || seen[link.getAttribute('href')]) return;
          seen[link.getAttribute('href')] = true;
          if (added > 0) {
            var sep = document.createElement('span');
            sep.className = 'recent-sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '·';
            chips.appendChild(sep);
          }
          var a = link.cloneNode(true);
          a.className = 'recent-chip';
          chips.appendChild(a);
          added++;
        });
        if (added > 0) row.hidden = false;
      }

      var TT = window.ToyTools;
      var favorites = (TT && TT.favorites) ? TT.favorites.list() : [];
      var recent = (TT && TT.getRecent) ? TT.getRecent() : [];

      renderRow(favorites, 'favorite-chips', 'favorite-row', 6);
      // A tool that is already pinned above does not need repeating as "recent".
      renderRow(
        recent.map(function (e) { return e && e.slug; }).filter(function (slug) {
          return slug && favorites.indexOf(slug) === -1;
        }),
        'recent-chips', 'recent-row', 5
      );
    })();
  </script>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-12) 0;
  }

  /* Sized down from the old clamp(3xl, 5vw, 5xl): that ceiling was set for the single
     word "ToyTools" and turns a sentence into three lines of shouting on a phone. */
  .hero h1 {
    font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl));
    font-weight: var(--font-weight-bold);
    margin: 0;
    line-height: var(--leading-tight);
    max-width: 20ch;
  }

  /* Phones wrap the sentence wherever it falls; above 640px the break is placed so the
     two clauses stack cleanly instead of splitting mid-clause. */
  .h1-break {
    display: none;
  }

  @media (min-width: 640px) {
    .h1-break {
      display: inline;
    }
  }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--color-text-muted);
    max-width: 44ch;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Sits below the fold-line stats rather than above the search, so the thing most visitors
     came for stays where their thumb already is. */
  .hero-intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8);
  }

  .hero-sub {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin: 0;
  }

  /* ── Recent chips ─────────────────────────────────────────── */

  /* display:flex would defeat the hidden attribute — keep it explicit */
  .recent-row[hidden] {
    display: none;
  }

  .recent-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-8);
    max-width: unset;
  }

  .recent-label {
    color: var(--color-text-subtle);
  }

  .recent-row :global(.recent-chip) {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .recent-row :global(.recent-chip:hover) {
    color: var(--color-text);
  }

  .recent-row :global(.recent-sep) {
    color: var(--color-text-subtle);
    margin-inline: var(--space-1);
    user-select: none;
  }

  /* ── Platform strip ───────────────────────────────────────── */

  .platform-strip {
    padding-bottom: var(--space-12);
  }

  .strip-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-2);
  }

  .platform-strip h2 {
    margin: 0;
  }

  .strip-lede {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* No cards. The claims are separated by space, and the gap between them (--space-6) clearly
     beats the gap inside one (--space-1), which is what marks each as a single unit. */
  .strip-facts {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .strip-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-8);
    }
  }

  /* min-width: 0 so a long claim wraps inside its track instead of widening it. */
  .strip-facts li {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .strip-facts strong {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .strip-facts span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .strip-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    max-width: unset;
  }

  /* ── Sections ─────────────────────────────────────────────── */

  .section {
    padding-bottom: var(--space-8);
  }

  /* ── All-tools disclosure ─────────────────────────────────── */

  .all-tools {
    padding-top: var(--space-8);
    border-top: var(--border);
  }

  .all-tools-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    transition: var(--transition-color);
  }

  /* Safari draws its own disclosure triangle through `list-style: none`. */
  .all-tools-summary::-webkit-details-marker {
    display: none;
  }

  .all-tools-summary::before {
    content: '+';
    font-size: var(--text-base);
    line-height: 1;
    color: var(--color-text-subtle);
  }

  .all-tools[open] .all-tools-summary::before {
    content: '−';
  }

  .all-tools-summary:hover,
  .all-tools-summary:active {
    color: var(--color-text);
  }

  .all-tools-body {
    padding-top: var(--space-6);
  }
</style>
