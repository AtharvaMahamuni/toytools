---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import HeroSearch from '@components/HeroSearch.astro';
import ToolDirectory from '@components/ToolDirectory.astro';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
---

<BaseLayout
  title={generatePageTitle('home')}
  description="Free, private, browser-based tools for everyday tasks. No sign-up, no tracking."
  maxWidth="category"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        description: 'Free, private, browser-based tools for everyday tasks. No sign-up, no tracking.',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${Astro.site?.href ?? 'https://toytoolsapp.com/'}search?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
      {
        '@type': 'Organization',
        name: 'ToyTools',
        url: Astro.site?.href ?? 'https://toytoolsapp.com/',
        logo: new URL('/favicon.svg', Astro.site ?? 'https://toytoolsapp.com/').href,
      },
    ],
  })} />

  <section class="hero">
    <h1>ToyTools<span class="gold-dot hero-dot" aria-hidden="true"></span></h1>
    <p class="hero-tagline">The simplest place on the internet to get things done.</p>
    <HeroSearch />
    <p class="hero-sub">
      <span>Lightweight</span>
      <span class="gold-dot" aria-hidden="true"></span>
      <span>Private</span>
    </p>
  </section>

  <p class="recent-row" id="recent-row" hidden>
    <span class="recent-label">Recent:</span>
    <span id="recent-chips"></span>
  </p>

  <section class="section">
    <ToolDirectory />
  </section>

  <p class="ecosystem-row">
    <span>{categories.length} Categories</span>
    <span class="gold-dot" aria-hidden="true"></span>
    <span>{tools.length} Tools</span>
  </p>

  <script is:inline>
    (function () {
      var recent = (window.ToyTools && ToyTools.getRecent) ? ToyTools.getRecent() : [];
      if (!recent.length) return;
      var chips = document.getElementById('recent-chips');
      var row = document.getElementById('recent-row');
      if (!chips || !row) return;

      function findLink(slug) {
        var direct = document.querySelector('.dir-link[data-slug="' + slug + '"]');
        if (direct) return direct;
        // Group entries cover their members via data-group-slugs="a,b,c".
        var groups = document.querySelectorAll('.dir-link[data-group-slugs]');
        for (var i = 0; i < groups.length; i++) {
          var slugs = (groups[i].getAttribute('data-group-slugs') || '').split(',');
          if (slugs.indexOf(slug) !== -1) return groups[i];
        }
        return null;
      }

      var added = 0;
      var seen = {};
      recent.forEach(function (entry) {
        if (added >= 5 || !entry || !entry.slug) return;
        var link = findLink(entry.slug);
        if (!link || seen[link.getAttribute('href')]) return;
        seen[link.getAttribute('href')] = true;
        if (added > 0) {
          var sep = document.createElement('span');
          sep.className = 'recent-sep';
          sep.setAttribute('aria-hidden', 'true');
          sep.textContent = '·';
          chips.appendChild(sep);
        }
        var a = link.cloneNode(true);
        a.className = 'recent-chip';
        chips.appendChild(a);
        added++;
      });
      if (added > 0) row.hidden = false;
    })();
  </script>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-16) 0 var(--space-12);
  }

  .hero h1 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: var(--font-weight-bold);
    margin: 0;
    line-height: 1;
  }

  .hero-dot {
    margin-left: 6px;
  }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--color-text-muted);
    max-width: 44ch;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .hero-sub {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin: 0;
  }

  /* ── Recent chips ─────────────────────────────────────────── */

  .recent-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-8);
    max-width: unset;
  }

  .recent-label {
    color: var(--color-text-subtle);
  }

  .recent-row :global(.recent-chip) {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .recent-row :global(.recent-chip:hover) {
    color: var(--color-text);
  }

  .recent-row :global(.recent-sep) {
    color: var(--color-text-subtle);
    margin-inline: var(--space-1);
    user-select: none;
  }

  /* ── Sections ─────────────────────────────────────────────── */

  .section {
    padding-bottom: var(--space-12);
  }

  .ecosystem-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    padding-top: var(--space-8);
    border-top: var(--border);
    max-width: unset;
  }
</style>
