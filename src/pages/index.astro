---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryCard from '@components/CategoryCard.astro';
import ToolCard from '@components/ToolCard.astro';
import { categories } from '@data/categories';
import { tools } from '@data/tools';

function getCategoryName(slug: string): string {
  return categories.find(c => c.slug === slug)?.name ?? slug;
}
---

<BaseLayout
  title="ToyTools"
  description="Simple tools for everyday work. Lightweight, private, and free."
  maxWidth="category"
>
  <section class="hero">
    <h1>Find the right tool in seconds.</h1>
    <p>Simple tools for everyday work. Lightweight, private, and free.</p>
  </section>

  <section class="section">
    <h2 class="section-heading">Popular tools</h2>
    <div class="tool-grid">
      {tools.map(tool => (
        <ToolCard tool={tool} categoryName={getCategoryName(tool.categorySlug)} />
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-heading">Browse by category</h2>
    <div class="category-grid">
      {categories.map(category => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <p class="ecosystem-row">
    <span>{categories.length} Categories</span>
    <span class="gold-dot" aria-hidden="true"></span>
    <span>{tools.length} Tools</span>
  </p>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
  }

  .hero h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    margin-bottom: var(--space-4);
  }

  .hero p {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: unset;
  }

  .section {
    padding-bottom: var(--space-12);
    border-bottom: var(--border);
    margin-bottom: var(--space-12);
  }

  .section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
  }

  .section-heading {
    margin-bottom: var(--space-6);
  }

  .category-grid,
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .ecosystem-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    padding-top: var(--space-8);
    max-width: unset;
  }
</style>
