---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryCard from '@components/CategoryCard.astro';
import ToolCard from '@components/ToolCard.astro';
import { categories } from '@data/categories';
import { tools } from '@data/tools';

const newTools = tools.filter(t => t.isNew);

function getCategoryName(slug: string): string {
  return categories.find(c => c.slug === slug)?.name ?? slug;
}
---

<BaseLayout
  title="ToyTools"
  description="Free, fast utility tools for everyday tasks. No login required."
  maxWidth="category"
>
  <section class="hero">
    <h1>Fast, free utility tools</h1>
    <p>No login. No ads. Just tools that work.</p>
  </section>

  <section class="section">
    <h2 class="section-heading">Browse by category</h2>
    <div class="category-grid">
      {categories.map(category => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  {newTools.length > 0 && (
    <section class="section">
      <h2 class="section-heading">Recently added</h2>
      <div class="tool-grid">
        {newTools.map(tool => (
          <ToolCard tool={tool} categoryName={getCategoryName(tool.categorySlug)} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
  }

  .hero h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    margin-bottom: var(--space-4);
  }

  .hero p {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: unset;
  }

  .section {
    padding-bottom: var(--space-12);
    border-bottom: var(--border);
    margin-bottom: var(--space-12);
  }

  .section:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .section-heading {
    margin-bottom: var(--space-6);
  }

  .category-grid,
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
