---
import type { GetStaticPaths } from 'astro';
import { toolsWithGuide } from '@data/registry';
import { categories }     from '@data/categories';
import SimulationGuide from '@tools/_shared/SimulationGuide.astro';
import { manifestBySlug } from '@lib/simulation/manifests';

// Guide components are DISCOVERED from the filesystem, mirroring guide-registry.generated.ts:
// authoring src/tools/<segment>/<slug>/Guide.astro is what wires a guide into this route. The
// glob and the generated registry both derive from Guide.astro presence on disk, so the route map
// and the slug list cannot drift apart. (import.meta.glob is Vite-only, which is fine here — this
// .astro file is never imported by tsx scripts; those read guide-registry.ts instead.)
const guideModules = import.meta.glob<{ default: any }>('../../tools/*/*/Guide.astro', {
  eager: true,
});
const guidesBySlug: Record<string, any> = {};
for (const [path, mod] of Object.entries(guideModules)) {
  const slug = path.split('/').at(-2)!;
  guidesBySlug[slug] = mod.default;
}

export const getStaticPaths = (() => {
  return toolsWithGuide.map(tool => {
    const guide    = tool.guide!;
    const category = categories.find(c => c.slug === tool.categorySlug)!;
    return {
      params: { slug: `${guide.categorySlug}/${guide.slug}` },
      props:  { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool } = Astro.props;
// Simulation guides render generically from their manifest; everything else uses its discovered
// Guide.astro component from the glob map above.
const simManifest = manifestBySlug.get(tool.slug);
const GuideComp = guidesBySlug[tool.slug];
---

{simManifest ? (
  <SimulationGuide
    manifest={simManifest}
    title={tool.guide!.title}
    description={tool.guide!.description}
    readMinutes={tool.guide!.readMinutes}
    updatedAt={tool.guide!.updatedAt}
    entry={tool}
  />
) : GuideComp && (
  <GuideComp
    title={tool.guide!.title}
    description={tool.guide!.description}
    readMinutes={tool.guide!.readMinutes}
    updatedAt={tool.guide!.updatedAt}
    entry={tool}
  />
)}
