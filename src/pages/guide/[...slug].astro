---
import type { GetStaticPaths } from 'astro';
import { toolsWithGuide } from '@data/registry';
import { categories }     from '@data/categories';
import type { RegisteredGuideSlug } from '@data/guide-registry';

// Static imports — one per tool with a guide
import TodoListGuide           from '../../tools/productivity/todo-list/Guide.astro';
import NotepadGuide            from '../../tools/productivity/notepad/Guide.astro';
import KeepScreenAwakeGuide    from '../../tools/productivity/keep-screen-awake/Guide.astro';
import Base64Guide             from '../../tools/developer/base64-encoder-decoder/Guide.astro';
import UrlEncoderDecoderGuide  from '../../tools/developer/url-encoder-decoder/Guide.astro';
import HtmlEntityEncoderDecoderGuide from '../../tools/developer/html-entity-encoder-decoder/Guide.astro';
// Developer tools — hashing engine
import Md5HashGeneratorGuide    from '../../tools/developer/md5-hash-generator/Guide.astro';
import Sha1HashGeneratorGuide   from '../../tools/developer/sha1-hash-generator/Guide.astro';
import Sha256HashGeneratorGuide from '../../tools/developer/sha256-hash-generator/Guide.astro';
// Developer tools — structured-data engine
import JsonFormatterGuide  from '../../tools/developer/json-formatter/Guide.astro';
import JsonMinifierGuide   from '../../tools/developer/json-minifier/Guide.astro';
import JsonValidatorGuide  from '../../tools/developer/json-validator/Guide.astro';
import PercentageCalculatorGuide from '../../tools/number/percentage-calculator/Guide.astro';
import WordCounterGuide        from '../../tools/text/word-counter/Guide.astro';
import PomodoroTimerGuide      from '../../tools/productivity/pomodoro-timer/Guide.astro';
// Text processor engine — transform family
import UppercaseConverterGuide    from '../../tools/text/uppercase-converter/Guide.astro';
import LowercaseConverterGuide    from '../../tools/text/lowercase-converter/Guide.astro';
import TitleCaseConverterGuide    from '../../tools/text/title-case-converter/Guide.astro';
import SentenceCaseConverterGuide from '../../tools/text/sentence-case-converter/Guide.astro';
import CamelCaseConverterGuide    from '../../tools/text/camel-case-converter/Guide.astro';
import SnakeCaseConverterGuide    from '../../tools/text/snake-case-converter/Guide.astro';
import KebabCaseConverterGuide    from '../../tools/text/kebab-case-converter/Guide.astro';
// Text processor engine — cleanup family
import RemoveExtraSpacesGuide     from '../../tools/text/remove-extra-spaces/Guide.astro';
import RemoveBlankLinesGuide      from '../../tools/text/remove-blank-lines/Guide.astro';
import RemoveDuplicateLinesGuide  from '../../tools/text/remove-duplicate-lines/Guide.astro';
import TrimTextGuide              from '../../tools/text/trim-text/Guide.astro';
import NormalizeWhitespaceGuide   from '../../tools/text/normalize-whitespace/Guide.astro';
import RemoveTabsGuide            from '../../tools/text/remove-tabs/Guide.astro';
// Text analysis tools
import CharacterCounterGuide      from '../../tools/text/character-counter/Guide.astro';
import ReadingTimeCalculatorGuide from '../../tools/text/reading-time-calculator/Guide.astro';
import SentenceCounterGuide       from '../../tools/text/sentence-counter/Guide.astro';
import ParagraphCounterGuide      from '../../tools/text/paragraph-counter/Guide.astro';

// Typed against the registry's slug union — TS fails the build if this map and
// `registeredGuideSlugs` (src/data/guide-registry.ts) ever drift apart.
const guidesBySlug: Record<RegisteredGuideSlug, any> = {
  'todo-list':              TodoListGuide,
  'notepad':                NotepadGuide,
  'keep-screen-awake':      KeepScreenAwakeGuide,
  'base64-encoder-decoder': Base64Guide,
  'url-encoder-decoder':    UrlEncoderDecoderGuide,
  'html-entity-encoder-decoder': HtmlEntityEncoderDecoderGuide,
  'md5-hash-generator':          Md5HashGeneratorGuide,
  'sha1-hash-generator':         Sha1HashGeneratorGuide,
  'sha256-hash-generator':       Sha256HashGeneratorGuide,
  'json-formatter':              JsonFormatterGuide,
  'json-minifier':               JsonMinifierGuide,
  'json-validator':              JsonValidatorGuide,
  'percentage-calculator':  PercentageCalculatorGuide,
  'word-counter':           WordCounterGuide,
  'pomodoro-timer':         PomodoroTimerGuide,
  'uppercase-converter':    UppercaseConverterGuide,
  'lowercase-converter':    LowercaseConverterGuide,
  'title-case-converter':   TitleCaseConverterGuide,
  'sentence-case-converter': SentenceCaseConverterGuide,
  'camel-case-converter':   CamelCaseConverterGuide,
  'snake-case-converter':   SnakeCaseConverterGuide,
  'kebab-case-converter':   KebabCaseConverterGuide,
  'remove-extra-spaces':    RemoveExtraSpacesGuide,
  'remove-blank-lines':     RemoveBlankLinesGuide,
  'remove-duplicate-lines': RemoveDuplicateLinesGuide,
  'trim-text':              TrimTextGuide,
  'normalize-whitespace':   NormalizeWhitespaceGuide,
  'remove-tabs':            RemoveTabsGuide,
  'character-counter':      CharacterCounterGuide,
  'reading-time-calculator': ReadingTimeCalculatorGuide,
  'sentence-counter':       SentenceCounterGuide,
  'paragraph-counter':      ParagraphCounterGuide,
};

export const getStaticPaths = (() => {
  return toolsWithGuide.map(tool => {
    const guide    = tool.guide!;
    const category = categories.find(c => c.slug === tool.categorySlug)!;
    return {
      params: { slug: `${guide.categorySlug}/${guide.slug}` },
      props:  { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool } = Astro.props;
const GuideComp = guidesBySlug[tool.slug];
---

{GuideComp && (
  <GuideComp
    title={tool.guide!.title}
    description={tool.guide!.description}
    readMinutes={tool.guide!.readMinutes}
    updatedAt={tool.guide!.updatedAt}
    entry={tool}
  />
)}
