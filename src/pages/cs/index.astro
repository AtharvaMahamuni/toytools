---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Čeština')}
  description="ToyTools — zdarma, soukromé, prohlížečové nástroje pro každodenní úkoly. Bez registrace, bez sledování."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Zdarma, soukromé, prohlížečové nástroje pro každodenní úkoly.</p>
    <a href={withBase('/')}>Procházet všechny nástroje →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
