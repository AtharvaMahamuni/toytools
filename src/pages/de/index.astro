---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Deutsch')}
  description="ToyTools — kostenlose, private, browserbasierte Tools für den Alltag. Keine Anmeldung, kein Tracking."
  maxWidth="tool"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Kostenlose, private, browserbasierte Tools für den Alltag.</p>
    <a href={withBase('/')}>Alle Tools durchsuchen →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
