---
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@layouts/ToolLayout.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import ToolNavRow from '@components/tool/ToolNavRow.astro';
import { tools }      from '@data/registry';
import { categories } from '@data/categories';
import { faqsByToolSlug } from '@data/faq-registry';
import { getRelatedTools } from '@lib/tools/related';
import { withBase } from '@lib/paths';

export const getStaticPaths = (() => {
  return tools.map(tool => {
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`Category "${tool.categorySlug}" not found for tool "${tool.slug}"`);
    return {
      params: { category: category.segment, slug: tool.slug },
      props:  { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category } = Astro.props;

const relatedTools = getRelatedTools(tool, tools);

const faqItems = faqsByToolSlug[tool.slug] ?? [];
const guideHref = tool.guide
  ? withBase(`/guide/${tool.guide.categorySlug}/${tool.guide.slug}/`)
  : null;

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

// Discover all Widget.astro files — glob resolves at build time, key lookup picks the right one
const widgets = import.meta.glob<{ default: unknown }>('../../../tools/*/*/Widget.astro');
const widgetPath = `../../../tools/${category.segment}/${tool.slug}/Widget.astro`;
const WidgetModule = await widgets[widgetPath]?.();
const Widget = WidgetModule?.default as any;
if (!Widget) throw new Error(`No Widget.astro found for tool slug "${tool.slug}"`);
---

<ToolLayout tool={tool} category={category}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <Widget />

  <ToolNavRow
    faqItems={faqItems}
    guideHref={guideHref}
    guideTitle={tool.guide?.title}
    guideReadMinutes={tool.guide?.readMinutes}
    relatedTools={relatedTools}
    toolName={tool.name}
  />

  {faqItems.length > 0 && (
    <section class="faq-section" id="faq" aria-label="Common questions">
      <FaqAccordion items={faqItems} />
    </section>
  )}
</ToolLayout>

<style>
  /* No border here — ToolNavRow already draws the one separator after the widget.
     FAQ follows as a natural continuation of the secondary-info zone. */
  .faq-section {
    margin-top: var(--space-6);
  }
</style>
