---
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@layouts/ToolLayout.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import GroupSwitcher from '@components/tool/GroupSwitcher.astro';
import ToolNavRow from '@components/tool/ToolNavRow.astro';
import { tools }      from '@data/registry';
import { categories } from '@data/categories';
import { faqsByToolSlug } from '@data/faq-registry';
import { getToolGroup } from '@data/tool-groups';
import { getRelatedTools } from '@lib/tools/related';
import { withBase } from '@lib/paths';
import { manifestBySlug } from '@lib/simulation/manifests';
import { simulationSchemas } from '@lib/simulation/schema';
import SimulationWidget from '@tools/_shared/SimulationWidget.astro';

export const getStaticPaths = (() => {
  return tools.map(tool => {
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`Category "${tool.categorySlug}" not found for tool "${tool.slug}"`);
    return {
      params: { category: category.segment, slug: tool.slug },
      props:  { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category } = Astro.props;

// Group siblings are already linked by the GroupSwitcher above the widget —
// exclude them from the Related strip so it surfaces other tools instead.
const groupSlugs = new Set(
  (tool.toolGroup ? getToolGroup(tool.toolGroup)?.members ?? [] : []).map(m => m.slug),
);
const relatedTools = getRelatedTools(tool, tools, 9)
  .filter(t => !groupSlugs.has(t.slug))
  .map(t => {
    const cat = categories.find(c => c.slug === t.categorySlug);
    return { slug: t.slug, name: t.name, segment: cat?.segment ?? t.categorySlug };
  });

const faqItems = faqsByToolSlug[tool.slug] ?? [];
const guideHref = tool.guide
  ? withBase(`/guide/${tool.guide.categorySlug}/${tool.guide.slug}/`)
  : null;

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

// Simulation tools render the generic SimulationWidget from their manifest (no per-tool
// Widget.astro). Every other tool resolves its own Widget.astro via the build-time glob.
const simManifest = manifestBySlug.get(tool.slug);
// Sims also advertise sim-specific structured data (LearningResource + HowTo) derived from the
// manifest, on top of the generic SoftwareApplication/FAQPage schema every tool emits.
const simSchemas = simManifest ? simulationSchemas(simManifest, Astro.url.href) : [];
const widgets = import.meta.glob<{ default: unknown }>('../../../tools/*/*/Widget.astro');
const widgetPath = `../../../tools/${category.segment}/${tool.slug}/Widget.astro`;
const WidgetModule = simManifest ? null : await widgets[widgetPath]?.();
const Widget = WidgetModule?.default as any;
if (!simManifest && !Widget) throw new Error(`No Widget.astro found for tool slug "${tool.slug}"`);
---

<ToolLayout tool={tool} category={category}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {simSchemas.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

  {tool.toolGroup && <GroupSwitcher tool={tool} />}

  {simManifest
    ? <SimulationWidget config={tool} simulationId={simManifest.metadata.processorId} examples={simManifest.examples} />
    : <Widget />}

  <ToolNavRow
    faqItems={faqItems}
    guideHref={guideHref}
    guideTitle={tool.guide?.title}
    guideReadMinutes={tool.guide?.readMinutes}
    relatedTools={relatedTools}
    toolName={tool.name}
  />

  {faqItems.length > 0 && (
    <section class="faq-section" id="faq" aria-label="Common questions">
      <h2 class="faq-heading">Common Questions</h2>
      <FaqAccordion items={faqItems} />
    </section>
  )}
</ToolLayout>

<style>
  /* No border here — ToolNavRow already draws the one separator after the widget.
     FAQ follows as a natural continuation of the secondary-info zone. */
  .faq-section {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: var(--border);
  }

  .faq-heading {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-4);
  }
</style>
