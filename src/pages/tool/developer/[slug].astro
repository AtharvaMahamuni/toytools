---
// Redirect stubs for the deprecated `/tool/developer/{slug}/` URLs.
//
// The Developer category segment was renamed `developer` → `developer-utilities`, moving
// every developer tool to `/tool/developer-utilities/{slug}/`. Each previously-indexed
// old URL serves a minimal shell that immediately meta-refreshes to the current tool page
// and declares it canonical — preserving link equity instead of 404ing. These stubs are
// intentionally noindex and NOT in any sitemap. See src/data/tool-redirects.ts.
import type { GetStaticPaths } from 'astro';
import { toolRedirects } from '@data/tool-redirects';
import { tools }      from '@data/registry';
import { categories } from '@data/categories';
import { withBase } from '@lib/paths';

export const getStaticPaths = (() => {
  return toolRedirects.map(redirect => {
    const tool = tools.find(t => t.slug === redirect.toolSlug);
    if (!tool) throw new Error(`tool-redirects: unknown tool slug "${redirect.toolSlug}"`);
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`tool-redirects: unresolved category for "${tool.slug}"`);
    // oldPath is 'developer/{slug}'; this route owns the 'developer/' prefix, so the
    // dynamic param is just the trailing slug.
    return {
      params: { slug: redirect.toolSlug },
      props:  { toolName: tool.name, toolPath: `/tool/${category.segment}/${tool.slug}/` },
    };
  });
}) satisfies GetStaticPaths;

const { toolName, toolPath } = Astro.props;

const target = withBase(toolPath);
const canonical = Astro.site ? new URL(withBase(toolPath), Astro.site).href : withBase(toolPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{toolName} — moved</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This tool has moved. <a href={target}>Continue to {toolName}</a>.</p>
  </body>
</html>
