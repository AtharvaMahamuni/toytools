---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', '日本語')}
  description="ToyTools — 無料でプライベートなブラウザベースのツール。登録不要、トラッキングなし、すぐ使えます。"
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>無料でプライベートなブラウザベースの日常ツール。</p>
    <a href={withBase('/')}>すべてのツールを見る →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
