---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Italiano')}
  description="ToyTools — strumenti gratuiti, privati e basati sul browser per la vita quotidiana. Nessuna registrazione, nessun tracciamento."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Strumenti gratuiti, privati e basati sul browser per la vita quotidiana.</p>
    <a href={withBase('/')}>Sfoglia tutti gli strumenti →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
