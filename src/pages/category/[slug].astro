---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import Breadcrumb from '@components/Breadcrumb.astro';
import CategoryToolList from '@components/CategoryToolList.astro';
import CategoryGuideList from '@components/CategoryGuideList.astro';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { engineRegistry } from '@data/engines';
import { withBase } from '../../lib/paths';

export const getStaticPaths = (() => {
  return categories.map(category => {
    const categoryTools = tools.filter(t => t.categorySlug === category.slug);
    return { params: { slug: category.slug }, props: { category, tools: categoryTools } };
  });
}) satisfies GetStaticPaths;

const { category, tools: categoryTools } = Astro.props;

// The engines this category's tools actually run on. A category page is the one place a visitor
// sees a dozen tools side by side, so it is the natural place to say what they have in common:
// they are not a dozen separate programs, they are a few engines wearing different faces. Derived
// from the tools themselves, so a re-homed tool cannot leave a stale claim behind.
const engineNames = [...new Set(categoryTools.map(t => t.engine))]
  .map(id => engineRegistry.find(e => e.id === id)?.name.replace(/ Engine$/, ''))
  .filter((name): name is string => Boolean(name))
  .sort();
const engineList =
  engineNames.length <= 1
    ? engineNames.join('')
    : `${engineNames.slice(0, -1).join(', ')} and ${engineNames.at(-1)}`;
// The breadcrumb keeps the short name (it is a trail, not a description); the title and H1 use the
// headline when one is set, so "Physics" can stay the nav label while the page says what it holds.
const headline = category.headline ?? category.name;

const abs = (path: string): string =>
  Astro.site ? new URL(withBase(path), Astro.site).href : withBase(path);

// A category page listed up to thirty tools and carried no structured data at all, so nothing told
// a crawler the page was a listing or what it listed. Tool and guide pages have had schema since
// they were built; this was the gap. CollectionPage with an ItemList naming every tool, plus the
// BreadcrumbList the other page types already emit.
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: headline,
  description: category.description,
  url: Astro.url.href,
  isPartOf: { '@type': 'WebSite', name: 'ToyTools', url: abs('/') },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categoryTools.length,
    itemListElement: categoryTools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: abs(`/tool/${category.segment}/${t.slug}/`),
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: category.name },
  ],
};
---

<BaseLayout
  title={generatePageTitle('category', headline)}
  description={category.description}
  maxWidth="category"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="category-header">
    <Breadcrumb items={[
      { label: 'Home', href: withBase('/') },
      { label: category.name },
    ]} />
    <div class="category-title">
      <h1>{headline}</h1>
    </div>
    <p class="category-description">{category.description}</p>
    <p class="tool-count">
      {/* Number and noun stay one flex item, or the row's gap would open between "12" and
          "tools" as soon as the engine note turned this into a flex row. */}
      <span>
        <span class="count-number">{categoryTools.length}</span>
        {categoryTools.length === 1 ? ' tool' : ' tools'}
      </span>
      {engineList && (
        <>
          <span class="gold-dot" aria-hidden="true"></span>
          <a class="engine-note" href={withBase('/platform/')}>
            {engineNames.length === 1 ? 'Runs on the' : 'Run on the'} {engineList}
            {engineNames.length === 1 ? ' engine' : ' engines'}
          </a>
        </>
      )}
    </p>
  </div>

  <CategoryToolList category={category} tools={categoryTools} />

  {category.intro && category.intro.length > 0 && (
    <section class="category-intro" aria-labelledby="about-category">
      <h2 id="about-category">About {headline}</h2>
      {category.intro.map((para) => <p>{para}</p>)}
    </section>
  )}
  <CategoryGuideList category={category} tools={categoryTools} />
</BaseLayout>

<style>
  .category-header {
    margin-bottom: var(--space-10);
  }

  /* Below the tools, not above them: someone who came for a tool should reach it first, and a
     crawler reads the whole document either way. */
  .category-intro {
    margin-top: var(--space-12);
    max-width: var(--width-prose);
  }

  .category-intro h2 {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  .category-intro p {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .category-title {
    margin-bottom: var(--space-3);
  }

  .category-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-bottom: var(--space-3);
  }

  .tool-count {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
  }

  .count-number {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  /* Same weight as the count beside it: this is meta about the listing, not a call to action. */
  .engine-note {
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .engine-note:hover,
  .engine-note:active {
    color: var(--color-text-muted);
    text-decoration: underline;
  }
</style>
