---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Français')}
  description="ToyTools — outils en ligne gratuits, privés et légers pour les tâches quotidiennes. Sans inscription, sans tracking."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Outils en ligne gratuits, privés et légers pour les tâches quotidiennes.</p>
    <a href={withBase('/')}>Parcourir tous les outils →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
