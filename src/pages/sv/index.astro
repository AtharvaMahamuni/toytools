---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Svenska')}
  description="ToyTools — gratis, privata, webbläsarbaserade verktyg för vardagliga uppgifter. Ingen registrering, ingen spårning."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Gratis, privata, webbläsarbaserade verktyg för vardagliga uppgifter.</p>
    <a href={withBase('/')}>Bläddra bland alla verktyg →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
