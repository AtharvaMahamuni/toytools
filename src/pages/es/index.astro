---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Español')}
  description="ToyTools — herramientas gratuitas, privadas y basadas en el navegador para tareas cotidianas. Sin registro, sin rastreo."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Herramientas gratuitas, privadas y basadas en el navegador para tareas cotidianas.</p>
    <a href={withBase('/')}>Ver todas las herramientas →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
