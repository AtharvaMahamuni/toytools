---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Українська')}
  description="ToyTools — безкоштовні, приватні, браузерні інструменти для щоденних завдань. Без реєстрації, без стеження."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Безкоштовні, приватні, браузерні інструменти для щоденних завдань.</p>
    <a href={withBase('/')}>Переглянути всі інструменти →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
