---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Nederlands')}
  description="ToyTools — gratis, privé, browsergebaseerde tools voor dagelijkse taken. Geen registratie, geen tracking."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Gratis, privé, browsergebaseerde tools voor dagelijkse taken.</p>
    <a href={withBase('/')}>Alle tools bekijken →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
