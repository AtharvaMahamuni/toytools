---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'English')}
  description="ToyTools — free, private, browser-based tools for everyday tasks. No sign-up, no tracking."
  maxWidth="tool"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Free, private, browser-based tools for everyday tasks.</p>
    <a href={withBase('/')}>Browse all tools →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
