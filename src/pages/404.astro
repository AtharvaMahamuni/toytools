---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import { withBase } from '../lib/paths';

const homeUrl = withBase('/');
const feedbackUrl = withBase('/feedback/');
---

<BaseLayout
  title={generatePageTitle('notFound')}
  description="The page you're looking for doesn't exist."
  maxWidth="tool"
  robots="noindex,nofollow"
>
  <div class="not-found">
    <p class="code">
      4<span class="gold-dot" aria-hidden="true"></span>4
    </p>
    <h1>Page not found</h1>
    <p class="message">That page doesn't exist or has been moved.</p>
    <a href={homeUrl} class="home-link">Take me home</a>
    {/* Filled in from the attempted URL — a mistyped or dead tool link usually names the tool. */}
    <section class="nf-suggestions" id="nf-suggestions" hidden>
      <h2>Were you looking for one of these?</h2>
      <ul id="nf-suggestion-list"></ul>
    </section>
    <p class="suggest-notice">
      Looking for a tool that isn't here? <a href={feedbackUrl}>Suggest it</a>
    </p>
    <p class="redirect-notice">Redirecting in <span id="countdown">5</span>s…</p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: var(--space-20) 0 var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .code {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-subtle);
    line-height: 1;
    max-width: unset;
  }

  /* Override the global h1 size — smaller for 404 */
  h1 {
    font-size: var(--text-2xl);
    margin-top: calc(var(--space-4) * -1);
  }

  .message {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    height: var(--touch-target);
    padding-inline: var(--space-6);
    margin-top: var(--space-2);
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .home-link:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .nf-suggestions {
    margin-top: var(--space-8);
    width: 100%;
  }

  .nf-suggestions h2 {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .nf-suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nf-suggestions li a {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  /* A dead end is the moment someone is most sure of what they wanted and least likely to
     find it, so it is worth one line asking them to say so. */
  .suggest-notice {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .suggest-notice a {
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    color: var(--color-accent);
    text-decoration: none;
  }

  .suggest-notice a:hover {
    text-decoration: underline;
  }

  .suggest-notice a:active {
    color: var(--color-accent-strong);
  }

  .redirect-notice {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('countdown');
    var notice = document.querySelector('.redirect-notice');
    var n = 5;

    var iv = setInterval(function () {
      n -= 1;
      if (el) el.textContent = String(n);
      if (n <= 0) {
        clearInterval(iv);
        window.location.href = document.querySelector('.home-link').getAttribute('href');
      }
    }, 1000);

    // The page now offers a second thing to do, and yanking someone to the home page
    // mid-thought would be worse than leaving them here. Any sign of a live person cancels
    // the redirect; the automatic bounce is only for a tab nobody is looking at.
    function cancel() {
      clearInterval(iv);
      if (notice) notice.remove();
    }

    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (event) {
      window.addEventListener(event, cancel, { once: true, passive: true });
    });

    // Suggestions arriving is itself a reason to stay put, so the countdown stops for them too.
    window.addEventListener('tt:suggestions', cancel, { once: true });
  })();
</script>

{/*
  A 404 almost always carries the answer in its own URL: "/tool/text/word-countr/" is one edit from
  a real tool. Ranking the path against the catalog turns a dead end into a working link, using the
  same index and scoring as the palette.
*/}
<script>
  import { loadIndex, rankEntries, entryUrl } from '@lib/palette';

  const section = document.getElementById('nf-suggestions');
  const list = document.getElementById('nf-suggestion-list');

  if (section && list) {
    // The last meaningful path segment is the slug someone tried; hyphens become a normal query.
    const parts = window.location.pathname.split('/').filter(Boolean);
    const guess = (parts[parts.length - 1] ?? '').replace(/\.[a-z]+$/i, '').replace(/-/g, ' ');

    if (guess) {
      void loadIndex().then((index) => {
        if (!index) return;
        const hits = rankEntries(index.t, guess, 3);
        if (!hits.length) return;

        list.innerHTML = hits
          .map((e) => `<li><a href="${entryUrl(index, e)}">${e.n.replace(/[&<>"]/g, '')}</a></li>`)
          .join('');
        section.hidden = false;
        window.dispatchEvent(new Event('tt:suggestions'));
      });
    }
  }
</script>
