---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import { withBase } from '../lib/paths';

const homeUrl = withBase('/');
---

<BaseLayout
  title={generatePageTitle('notFound')}
  description="The page you're looking for doesn't exist."
  maxWidth="tool"
  robots="noindex,nofollow"
>
  <div class="not-found">
    <p class="code">
      4<span class="gold-dot" aria-hidden="true"></span>4
    </p>
    <h1>Page not found</h1>
    <p class="message">That page doesn't exist or has been moved.</p>
    <a href={homeUrl} class="home-link">Take me home</a>
    <p class="redirect-notice">Redirecting in <span id="countdown">5</span>s…</p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: var(--space-20) 0 var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .code {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-subtle);
    line-height: 1;
    max-width: unset;
  }

  /* Override the global h1 size — smaller for 404 */
  h1 {
    font-size: var(--text-2xl);
    margin-top: calc(var(--space-4) * -1);
  }

  .message {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    height: var(--touch-target);
    padding-inline: var(--space-6);
    margin-top: var(--space-2);
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .home-link:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .redirect-notice {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('countdown');
    var n = 5;
    var iv = setInterval(function () {
      n -= 1;
      if (el) el.textContent = String(n);
      if (n <= 0) {
        clearInterval(iv);
        window.location.href = document.querySelector('.home-link').getAttribute('href');
      }
    }, 1000);
  })();
</script>
