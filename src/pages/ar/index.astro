---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'العربية')}
  description="ToyTools — أدوات مجانية وخاصة تعمل في المتصفح للمهام اليومية. بدون تسجيل، بدون تتبع."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>أدوات مجانية وخاصة تعمل في المتصفح للمهام اليومية.</p>
    <a href={withBase('/')}>تصفح جميع الأدوات →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
