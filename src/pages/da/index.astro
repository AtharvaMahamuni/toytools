---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Dansk')}
  description="ToyTools — gratis, private, browserbaserede værktøjer til daglige opgaver. Ingen registrering, ingen sporing."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Gratis, private, browserbaserede værktøjer til daglige opgaver.</p>
    <a href={withBase('/')}>Se alle værktøjer →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
