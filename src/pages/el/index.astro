---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Ελληνικά')}
  description="ToyTools — δωρεάν, ιδιωτικά, εργαλεία browser για καθημερινές εργασίες. Χωρίς εγγραφή, χωρίς παρακολούθηση."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Δωρεάν, ιδιωτικά, εργαλεία browser για καθημερινές εργασίες.</p>
    <a href={withBase('/')}>Περιήγηση όλων των εργαλείων →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
