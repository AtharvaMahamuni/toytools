---
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@layouts/ToolLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import { tools }      from '@data/registry';
import { categories } from '@data/categories';
import { withBase }   from '../../../lib/paths';

export const getStaticPaths = (() => {
  return tools.map(tool => {
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`Category "${tool.categorySlug}" not found for tool "${tool.slug}"`);
    return {
      params: { category: category.segment, slug: tool.slug },
      props:  { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category } = Astro.props;

const relatedTools = tools
  .filter(t => t.categorySlug === tool.categorySlug && t.slug !== tool.slug)
  .slice(0, 3);

// Discover all Widget.astro files — glob resolves at build time, key lookup picks the right one
const widgets = import.meta.glob<{ default: unknown }>('../../../tools/*/Widget.astro');
const widgetPath = `../../../tools/${tool.slug}/Widget.astro`;
const WidgetModule = await widgets[widgetPath]?.();
const Widget = WidgetModule?.default as any;
if (!Widget) throw new Error(`No Widget.astro found for tool slug "${tool.slug}"`);
---

<ToolLayout tool={tool} category={category}>
  <Widget />

  {(tool.guide || tool.faq) && (
    <section class="content-section">
      <h2>Reference &amp; Learning <span class="gold-dot" aria-hidden="true"></span></h2>
      <EcosystemLinks
        currentType="tool"
        toolSlug={tool.slug}
        toolCategorySegment={category.segment}
        toolName={tool.name}
        entry={tool}
      />
    </section>
  )}

  {relatedTools.length > 0 && (
    <section class="content-section">
      <h2>Related tools <span class="gold-dot" aria-hidden="true"></span></h2>
      <div class="related-grid">
        {relatedTools.map(t => {
          const cat = categories.find(c => c.slug === t.categorySlug)!;
          return <ToolCard tool={t} categoryName={cat.name} categorySegment={cat.segment} />;
        })}
      </div>
    </section>
  )}
</ToolLayout>

<style>
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
