    background: none;
    border: none;
    padding: var(--space-2);
    color: #6b7280;
    font-size: var(--text-lg);
    cursor: pointer;
    transition: color var(--duration-fast) ease;
    line-height: 1;
  }

  .wl-fs-exit:hover { color: #F4F4F4; }
</style>

<script is:inline>
  /* ── Shared helpers ───────────────────────────────────────── */

  function textValue(id) {
    return document.getElementById(id)?.value || '';
  }

  function writeOutput(value) {
    var el = document.getElementById('tool-output');
    if (el) el.textContent = value;
  }

  function sentenceCase(text) {
    return text.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, function (m) { return m.toUpperCase(); });
  }

  function titleCase(text) {
    return text.toLowerCase().replace(/\b\w/g, function (m) { return m.toUpperCase(); });
  }

  /* ── Button-triggered tools ───────────────────────────────── */

  function runWordCounter() {
    var text = textValue('word-counter-input').trim();
    var words      = text ? text.split(/\s+/).filter(Boolean).length : 0;
    var characters = text.length;
    var sentences  = text ? (text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || []).length : 0;
    var paragraphs = text ? text.split(/\n\s*\n/).filter(Boolean).length : 0;
    var values = [words, characters, sentences, paragraphs];
    document.querySelectorAll('#word-counter-result .metric-value').forEach(function (node, i) {
      node.textContent = String(values[i]);
    });
  }

  function runCaseConverter() {
    var text = textValue('case-input');
    var mode = document.getElementById('case-mode')?.value;
    var result = mode === 'upper'    ? text.toUpperCase()  :
                 mode === 'title'    ? titleCase(text)      :
                 mode === 'sentence' ? sentenceCase(text)   :
                                      text.toLowerCase();
    writeOutput(result || 'Enter text to convert.');
  }

  function runPercentageCalculator() {
    var mode = document.getElementById('percentage-mode')?.value;
    var a = Number(textValue('percentage-a'));
    var b = Number(textValue('percentage-b'));
    if (!Number.isFinite(a) || !Number.isFinite(b)) { writeOutput('Enter valid numbers.'); return; }
    if (mode === 'change' && a === 0) { writeOutput('First value cannot be zero.'); return; }
    if (mode === 'is'     && b === 0) { writeOutput('Second value cannot be zero.'); return; }
    var result = mode === 'of'     ? (a / 100) * b :
                 mode === 'change' ? ((b - a) / a) * 100 :
                                     (a / b) * 100;
    writeOutput(Number(result.toFixed(6)).toString());
  }

  var runBtn = document.querySelector('[data-run-tool]');
  if (runBtn) {
    runBtn.addEventListener('click', function (event) {
      var slug = event.currentTarget.getAttribute('data-run-tool');
      if (slug === 'word-counter')          runWordCounter();
      if (slug === 'case-converter')        runCaseConverter();
      if (slug === 'percentage-calculator') runPercentageCalculator();
    });
  }

  /* ── Notepad — auto-save + toolbar actions ───────────────── */

  (function () {
    var textarea = document.getElementById('notepad-input');
    if (!textarea) return;

    var STORAGE_KEY = 'toytools.notepad.note';
    var MAX_STORE   = 50000;

    function updateStats() {
      var text    = textarea.value;
      var words   = text.trim() ? text.trim().split(/\s+/).filter(Boolean).length : 0;
      var wordsEl = document.getElementById('notepad-words');
      var charsEl = document.getElementById('notepad-chars');
      if (wordsEl) wordsEl.textContent = words + (words === 1 ? ' Word' : ' Words');
      if (charsEl) charsEl.textContent = text.length + (text.length === 1 ? ' Character' : ' Characters');
    }

    /* Restore from localStorage */
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) textarea.value = saved;
    } catch (_) {}
    updateStats();

    /* Auto-save on input */
    textarea.addEventListener('input', function () {
      updateStats();
      try {
        if (textarea.value.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, textarea.value);
        else if (!textarea.value)              localStorage.removeItem(STORAGE_KEY);
      } catch (_) {}
    });

    /* Paste — insert at cursor position */
    var pasteBtn = document.getElementById('notepad-paste');
    if (pasteBtn) {
      pasteBtn.addEventListener('click', function () {
        navigator.clipboard.readText().then(function (text) {
          var pos = textarea.selectionStart;
          textarea.value = textarea.value.slice(0, pos) + text + textarea.value.slice(textarea.selectionEnd);
          textarea.selectionStart = textarea.selectionEnd = pos + text.length;
          textarea.dispatchEvent(new Event('input'));
        }).catch(function () {
          pasteBtn.textContent = 'No permission';
          setTimeout(function () { pasteBtn.textContent = 'Paste'; }, 2000);
        });
      });
    }

    /* Copy */
    var copyBtn = document.getElementById('notepad-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (!textarea.value) return;
        navigator.clipboard.writeText(textarea.value).then(function () {
          copyBtn.textContent = 'Copied';
          setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
        }).catch(function () {});
      });
    }

    /* Download TXT */
    var dlBtn = document.getElementById('notepad-download');
    if (dlBtn) {
      dlBtn.addEventListener('click', function () {
        var blob = new Blob([textarea.value], { type: 'text/plain' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'note.txt'; a.click();
        URL.revokeObjectURL(url);
      });
    }

    /* Clear with inline confirmation */
    var clearBtn     = document.getElementById('notepad-clear');
    var clearConfirm = document.getElementById('notepad-clear-confirm');
    var cancelBtn    = document.getElementById('notepad-clear-cancel');
    var doBtn        = document.getElementById('notepad-clear-do');

    if (clearBtn && clearConfirm) {
      clearBtn.addEventListener('click', function () {
        clearConfirm.hidden = false;
        clearBtn.hidden = true;
      });
      cancelBtn.addEventListener('click', function () {
        clearConfirm.hidden = true;
        clearBtn.hidden = false;
      });
      doBtn.addEventListener('click', function () {
        textarea.value = '';
        try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
        clearConfirm.hidden = true;
        clearBtn.hidden = false;
        updateStats();
      });
    }
  })();

  /* ── Base64 — live updates + localStorage persistence ─────── */

  (function () {
    var input  = document.getElementById('base64-input');
    var modeEl = document.getElementById('base64-mode');
    var output = document.getElementById('base64-output');
    if (!input || !modeEl || !output) return;

    var STORAGE_KEY = 'toytools.base64.input';
    var MAX_STORE   = 50000; /* matches MAX_STORE_BYTES in src/lib/storage.ts */

    function setOutput(text, empty, error) {
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else       output.removeAttribute('data-empty');
      if (error) output.setAttribute('data-error', text);
      else       output.removeAttribute('data-error');
    }

    function convert() {
      var text = input.value;
      if (!text) { setOutput('Output will appear here', true, false); return; }
      var mode = modeEl.value;
      try {
        var result = mode === 'decode'
          ? decodeURIComponent(escape(atob(text.trim())))
          : btoa(unescape(encodeURIComponent(text)));
        setOutput(result, false, false);
      } catch (_) {
        var msg = mode === 'decode' ? 'Invalid Base64 input.' : 'Unable to encode.';
        setOutput(msg, false, true);
      }
    }

    function updateLabels() {
      var encode = modeEl.value === 'encode';
      var inputType  = document.getElementById('b64-input-type');
      var outputType = document.getElementById('b64-output-type');
      if (inputType)  inputType.textContent  = encode ? 'Text'   : 'Base64';
      if (outputType) outputType.textContent = encode ? 'Base64' : 'Text';
    }

    /* Restore from localStorage */
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) { input.value = saved; convert(); }
    } catch (_) {}

    updateLabels();

    /* Live update on input */
    input.addEventListener('input', function () {
      convert();
      try {
        if (input.value.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, input.value);
        else if (!input.value)              localStorage.removeItem(STORAGE_KEY);
      } catch (_) {}
    });

    modeEl.addEventListener('change', function () {
      convert();
      updateLabels();
    });
  })();

  /* ── Todo List — localStorage persistence + DOM rendering ─── */

  (function () {
    var newTaskInput = document.getElementById('todo-new-task');
    if (!newTaskInput) return;

    var STORAGE_KEY = 'toytools.todo.tasks';
    var MAX_STORE   = 50000;
    var tasks       = [];

    function loadTasks() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) tasks = JSON.parse(saved);
      } catch (_) { tasks = []; }
    }

    function saveTasks() {
      try {
        var str = JSON.stringify(tasks);
        if (str.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, str);
      } catch (_) {}
    }

    function uid() {
      return Date.now().toString(36) + Math.random().toString(36).slice(2);
    }

    function addTask(title) {
      tasks.unshift({ id: uid(), title: title, completed: false, createdAt: new Date().toISOString(), subtasks: [] });
      saveTasks();
      render();
    }

    function toggleTask(id) {
      var t = tasks.find(function (x) { return x.id === id; });
      if (t) { t.completed = !t.completed; saveTasks(); render(); }
    }

    function deleteTask(id) {
      tasks = tasks.filter(function (x) { return x.id !== id; });
      saveTasks();
      render();
    }

    function addSubtask(taskId, title) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        t.subtasks.push({ id: uid(), title: title, completed: false });
        saveTasks();
        render();
      }
    }

    function toggleSubtask(taskId, subId) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        var s = t.subtasks.find(function (x) { return x.id === subId; });
        if (s) { s.completed = !s.completed; saveTasks(); render(); }
      }
    }

    function deleteSubtask(taskId, subId) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        t.subtasks = t.subtasks.filter(function (x) { return x.id !== subId; });
        saveTasks();
        render();
      }
    }

    function createSubtaskEl(taskId, sub) {
      var row = document.createElement('div');
      row.className = 'todo-subtask-row' + (sub.completed ? ' todo-subtask--done' : '');

      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'todo-subtask-checkbox';
      cb.checked = sub.completed;
      cb.addEventListener('change', function () { toggleSubtask(taskId, sub.id); });

      var title = document.createElement('span');
      title.className = 'todo-subtask-title';
      title.textContent = sub.title;

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'todo-subtask-delete';
      del.textContent = 'Delete';
      del.addEventListener('click', function () { deleteSubtask(taskId, sub.id); });

      row.appendChild(cb);
      row.appendChild(title);
      row.appendChild(del);
      return row;
    }

    function createTaskEl(task) {
      var item = document.createElement('div');
      item.className = 'todo-task' + (task.completed ? ' todo-task--done' : '');

      var row = document.createElement('div');
      row.className = 'todo-task-row';

      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'todo-checkbox';
      cb.checked = task.completed;
      cb.addEventListener('change', function () { toggleTask(task.id); });

      var title = document.createElement('span');
      title.className = 'todo-title';
      title.textContent = task.title;

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'todo-delete';
      del.textContent = 'Delete';
      del.addEventListener('click', function () { deleteTask(task.id); });

      row.appendChild(cb);
      row.appendChild(title);
      row.appendChild(del);
      item.appendChild(row);

      if (task.subtasks.length > 0) {
        var subList = document.createElement('div');
        subList.className = 'todo-subtasks';
        task.subtasks.forEach(function (sub) {
          subList.appendChild(createSubtaskEl(task.id, sub));
        });
        item.appendChild(subList);
      }

      var addSub = document.createElement('div');
      addSub.className = 'todo-add-subtask';

      var subInput = document.createElement('input');
      subInput.type = 'text';
      subInput.placeholder = 'Add subtask...';
      subInput.autocomplete = 'off';
      subInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          var val = subInput.value.trim();
          if (val) { addSubtask(task.id, val); }
        }
      });

      var subBtn = document.createElement('button');
      subBtn.type = 'button';
      subBtn.className = 'todo-add-subtask-btn';
      subBtn.textContent = 'Add Subtask';
      subBtn.addEventListener('click', function () {
        var val = subInput.value.trim();
        if (val) { addSubtask(task.id, val); }
      });

      addSub.appendChild(subInput);
      addSub.appendChild(subBtn);
      item.appendChild(addSub);

      return item;
    }

    function updateProgress() {
      var el = document.getElementById('todo-progress');
      if (!el) return;
      var total = tasks.length;
      if (total === 0) { el.textContent = ''; return; }
      var done = tasks.filter(function (t) { return t.completed; }).length;
      var pct  = Math.round((done / total) * 100);
      el.textContent = done + ' of ' + total + ' completed ● ' + pct + '%';
    }

    function render() {
      var container = document.getElementById('todo-list-container');
      if (!container) return;
      var hideEl = document.getElementById('todo-hide-completed');
      var hideCompleted = hideEl ? hideEl.checked : false;

      container.innerHTML = '';

      if (tasks.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'todo-empty';
        empty.textContent = 'No tasks yet. Add your first task above.';
        container.appendChild(empty);
        updateProgress();
        return;
      }

      var visible = hideCompleted
        ? tasks.filter(function (t) { return !t.completed; })
        : tasks;

      visible.forEach(function (task) {
        container.appendChild(createTaskEl(task));
      });

      updateProgress();
    }

    var addBtn = document.getElementById('todo-add-btn');
    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var val = newTaskInput.value.trim();
        if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
      });
    }

    newTaskInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        var val = newTaskInput.value.trim();
        if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
      }
    });

    var hideToggle = document.getElementById('todo-hide-completed');
    if (hideToggle) {
      hideToggle.addEventListener('change', render);
    }

    loadTasks();
    render();
  })();

  /* ── Keep Screen Awake — Wake Lock API ──────────────────────── */

  (function () {
    var toggleBtn = document.getElementById('wl-toggle');
    if (!toggleBtn) return;

    var STORAGE_KEY    = 'toytools.keep-screen-awake.duration';
    var FORMAT_KEY     = 'toytools.keep-screen-awake.timeformat';
    var label        = document.getElementById('wl-label');
    var msg          = document.getElementById('wl-msg');
    var timerEl      = document.getElementById('wl-timer');
    var timerLabel   = document.getElementById('wl-timer-label');
    var timerValue   = document.getElementById('wl-timer-value');
    var endsLabel    = document.getElementById('wl-ends-label');
    var endsValue    = document.getElementById('wl-ends-value');
    var startedLabel = document.getElementById('wl-started-label');
    var startedValue = document.getElementById('wl-started-value');
    var metaBlock    = document.querySelector('.wl-meta-block');
    var timeToggle   = document.getElementById('wl-time-toggle');
    var timeOptions  = document.getElementById('wl-time-options');
    var customInput  = document.getElementById('wl-custom-min');
    var unsupported  = document.getElementById('wl-unsupported');
    var fsBtn        = document.getElementById('wl-fs-btn');
    var rdBtn        = document.getElementById('wl-rd-btn');
    var fsOverlay    = document.getElementById('wl-fullscreen');
    var fsExit       = document.getElementById('wl-fs-exit');
    var fsDot        = document.getElementById('wl-fs-dot');
    var fsLabel      = document.getElementById('wl-fs-label');
    var fsTimer      = document.getElementById('wl-fs-timer');
    var fsTimerLabel = document.getElementById('wl-fs-timer-label');
    var fsTimerValue = document.getElementById('wl-fs-timer-value');
    var fsStarted    = document.getElementById('wl-fs-started');
    var fsStartedVal = document.getElementById('wl-fs-started-value');
    var fsEnds       = document.getElementById('wl-fs-ends');
    var fsEndsVal    = document.getElementById('wl-fs-ends-value');

    /* Check browser support */
    if (!('wakeLock' in navigator)) {
      if (unsupported) unsupported.hidden = false;
      toggleBtn.disabled = true;
      return;
    }

    var wakeLock       = null;
    var tickInterval   = null;
    var startTime      = null;
    var endTime        = null;
    var sessionRunning = false;
    var selectedDuration = 0; /* seconds, 0 = no limit */
    var timeFormat = '12';

    var origTitle = document.title;

    /* ── Show / hide helpers (opacity, no layout shift) ─────── */

    function showEl(el) { if (el) el.classList.remove('wl-off'); }
    function hideEl(el) { if (el) el.classList.add('wl-off'); }

    function setLabelText(text) {
      if (!label) return;
      hideEl(label);
      setTimeout(function () {
        label.textContent = text;
        showEl(label);
      }, 150);
    }

    /* ── Duration selection ──────────────────────────────────── */

    function setSelectedDuration(dur) {
      selectedDuration = dur;
      document.querySelectorAll('.wl-dur').forEach(function (btn) {
        btn.classList.toggle('selected', btn.getAttribute('data-duration') === String(dur));
      });
      if (customInput) customInput.classList.remove('selected');
    }

    document.querySelectorAll('.wl-dur').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = btn.getAttribute('data-duration');
        setSelectedDuration(parseInt(val, 10));
        try { localStorage.setItem(STORAGE_KEY, val); } catch (_) {}
      });
    });

    if (customInput) {
      customInput.addEventListener('input', function () {
        var mins = parseInt(customInput.value, 10);
        if (mins > 0) {
          selectedDuration = mins * 60;
          document.querySelectorAll('.wl-dur').forEach(function (b) { b.classList.remove('selected'); });
          customInput.classList.add('selected');
          try { localStorage.setItem(STORAGE_KEY, String(selectedDuration)); } catch (_) {}
        }
      });
    }

    /* Time limit toggle */
    if (timeToggle && timeOptions) {
      timeToggle.addEventListener('click', function () {
        timeOptions.hidden = !timeOptions.hidden;
        timeToggle.textContent = timeOptions.hidden ? 'Tool Settings ▾' : 'Tool Settings ▴';
      });
    }

    /* Restore saved preferences */
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved !== null) {
        var savedNum = parseInt(saved, 10);
        if (!isNaN(savedNum)) setSelectedDuration(savedNum);
      }
    } catch (_) {}

    /* ── Time format selection ───────────────────────────────── */

    function setTimeFormat(fmt) {
      timeFormat = fmt;
      document.querySelectorAll('.wl-fmt').forEach(function (btn) {
        btn.classList.toggle('selected', btn.getAttribute('data-format') === fmt);
      });
      try { localStorage.setItem(FORMAT_KEY, fmt); } catch (_) {}
      /* Re-render timestamps if a session is already running */
      if (startTime) {
        var startedStr = formatTime(new Date(startTime));
        if (startedValue) startedValue.textContent = startedStr;
        if (fsStartedVal) fsStartedVal.textContent = startedStr;
      }
      if (endTime) {
        var endsStr = formatTime(new Date(endTime));
        if (endsValue)  endsValue.textContent  = endsStr;
        if (fsEndsVal)  fsEndsVal.textContent  = endsStr;
      }
    }

    document.querySelectorAll('.wl-fmt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setTimeFormat(btn.getAttribute('data-format'));
      });
    });

    /* Restore saved format preference */
    try {
      var savedFmt = localStorage.getItem(FORMAT_KEY);
      if (savedFmt === '12' || savedFmt === '24') setTimeFormat(savedFmt);
    } catch (_) {}

    /* ── Helpers ──────────────────────────────────────────────── */

    function pad(n) { return String(n).padStart(2, '0'); }

    function formatDuration(totalSeconds) {
      var h = Math.floor(totalSeconds / 3600);
      var m = Math.floor((totalSeconds % 3600) / 60);
      var s = totalSeconds % 60;
      return pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
    }

    function formatTime(date) {
      if (timeFormat === '24') {
        return pad(date.getHours()) + ':' + pad(date.getMinutes());
      }
      return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    }

    /* ── Duration lock ───────────────────────────────────────── */

    function lockDuration() {
      document.querySelectorAll('.wl-dur').forEach(function (btn) { btn.disabled = true; });
      if (customInput) customInput.disabled = true;
    }

    function unlockDuration() {
      document.querySelectorAll('.wl-dur').forEach(function (btn) { btn.disabled = false; });
      if (customInput) customInput.disabled = false;
    }

    /* ── Fullscreen sync ─────────────────────────────────────── */

    function syncFullscreen(state) {
      if (!fsOverlay) return;
      fsOverlay.dataset.state = state;
      if (fsDot)        fsDot.dataset.state = state;
      if (fsLabel)      fsLabel.textContent = state === 'active' ? 'Awake' : state === 'completed' ? 'Completed' : 'Sleeping';
      if (fsTimer)      fsTimer.hidden      = (state === 'inactive');
      if (fsTimerLabel) fsTimerLabel.textContent = state === 'active' ? (endTime ? 'Remaining' : 'Awake From') : 'Session Ended';
      if (fsTimerValue && state !== 'active') fsTimerValue.textContent = '';
      if (fsStarted)    fsStarted.hidden    = (state === 'inactive');
      if (fsEnds)       fsEnds.hidden       = !(state === 'active' && endTime);
    }

    /* ── State transitions ────────────────────────────────────── */

    function setInactiveState() {
      sessionRunning = false;
      toggleBtn.setAttribute('aria-checked', 'false');
      setLabelText('Sleeping');
      if (msg)   { msg.textContent = 'Ready when you are.'; showEl(msg); }
      hideEl(timerEl);
      hideEl(metaBlock);
      unlockDuration();
      document.title = origTitle;
      syncFullscreen('inactive');
    }

    function setActiveState() {
      lockDuration();
      toggleBtn.setAttribute('aria-checked', 'true');
      setLabelText('Awake');
      hideEl(msg);
      showEl(timerEl);
      if (timerLabel) timerLabel.textContent = endTime ? 'Remaining' : 'Awake From';
      showEl(metaBlock);
      var startedStr = formatTime(new Date(startTime));
      if (startedValue) startedValue.textContent = startedStr;
      if (endTime) {
        showEl(endsLabel);
        if (endsValue) { endsValue.textContent = formatTime(new Date(endTime)); showEl(endsValue); }
      } else {
        hideEl(endsLabel); hideEl(endsValue);
      }
      if (fsStartedVal) fsStartedVal.textContent = startedStr;
      if (fsEndsVal)    fsEndsVal.textContent    = endTime ? formatTime(new Date(endTime)) : '';
      document.title = '● Awake — Keep Screen Awake';
      syncFullscreen('active');
    }

    function setCompletedState() {
      sessionRunning = false;
      toggleBtn.setAttribute('aria-checked', 'false');
      setLabelText('Completed');
      showEl(timerEl);
      if (timerLabel) timerLabel.textContent = 'Session Ended';
      if (timerValue) timerValue.textContent = '';
      hideEl(endsLabel); hideEl(endsValue);
      if (msg) {
        if (endTime) {
          var mins = Math.round((endTime - startTime) / 60000);
          msg.textContent = 'Session completed after ' + mins + ' minute' + (mins === 1 ? '' : 's') + '.';
        } else {
          msg.textContent = 'Session ended.';
        }
        showEl(msg);
      }
      unlockDuration();
      document.title = origTitle;
      syncFullscreen('completed');
    }

    /* ── Timer tick ───────────────────────────────────────────── */

    function tick() {
      var now = Date.now();
      if (endTime && now >= endTime) {
        clearInterval(tickInterval);
        tickInterval = null;
        if (wakeLock) { wakeLock.release(); wakeLock = null; }
        setCompletedState();
        return;
      }
      if (!timerValue) return;
      var display;
      if (endTime) {
        display = formatDuration(Math.max(0, Math.floor((endTime - now) / 1000)));
      } else {
        display = formatDuration(Math.floor((now - startTime) / 1000));
      }
      timerValue.textContent = display;
      if (fsTimerValue) fsTimerValue.textContent = display;
    }

    /* ── Wake lock lifecycle ─────────────────────────────────── */

    function reacquireOnVisible() {
      if (document.visibilityState === 'visible' && sessionRunning && wakeLock === null) {
        document.removeEventListener('visibilitychange', reacquireOnVisible);
        requestWakeLock();
      }
    }

    function requestWakeLock() {
      navigator.wakeLock.request('screen').then(function (lock) {
        wakeLock = lock;
        lock.addEventListener('release', function () {
          wakeLock = null;
          if (sessionRunning) {
            document.addEventListener('visibilitychange', reacquireOnVisible);
          }
        });
      }).catch(function () {
        setInactiveState();
      });
    }

    function activate() {
      var dur = selectedDuration;
      /* Collapse the time-limit panel */
      if (timeOptions) timeOptions.hidden = true;
      if (timeToggle)  timeToggle.textContent = 'Tool Settings ▾';

      startTime      = Date.now();
      endTime        = dur > 0 ? startTime + dur * 1000 : null;
      sessionRunning = true;

      requestWakeLock();
      setActiveState();
      tick();
      tickInterval = setInterval(tick, 1000);
    }

    function deactivate() {
      sessionRunning = false;
      clearInterval(tickInterval);
      tickInterval = null;
      document.removeEventListener('visibilitychange', reacquireOnVisible);
      if (wakeLock) { wakeLock.release(); wakeLock = null; }
      setInactiveState();
    }

    /* ── Toggle button ────────────────────────────────────────── */

    toggleBtn.addEventListener('click', function () {
      if (sessionRunning) {
        deactivate();
      } else {
        activate();
      }
    });

    /* ── Fullscreen overlay ───────────────────────────────────── */

    function showOverlay() {
      if (!fsOverlay) return;
      fsOverlay.hidden = false;
      syncFullscreen(sessionRunning ? 'active' : label && label.textContent === 'Completed' ? 'completed' : 'inactive');
      if (sessionRunning && fsTimerValue && timerValue) {
        fsTimerValue.textContent = timerValue.textContent;
      }
    }

    function hideOverlay() {
      if (fsOverlay) fsOverlay.hidden = true;
    }

    function exitNativeFullscreen() {
      var exit = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
      if (exit && (document.fullscreenElement || document.webkitFullscreenElement)) {
        exit.call(document);
      }
    }

    if (fsBtn && fsOverlay) {
      fsBtn.addEventListener('click', function () {
        var el = document.documentElement;
        var req = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
        if (req) {
          req.call(el).then(showOverlay).catch(showOverlay);
        } else {
          showOverlay();
        }
      });
    }

    if (fsExit && fsOverlay) {
      fsExit.addEventListener('click', function () {
        hideOverlay();
        exitNativeFullscreen();
      });
    }

    if (rdBtn) {
      rdBtn.addEventListener('click', showOverlay);
    }

    /* Hide overlay when native fullscreen exits (ESC key or F11) */
    document.addEventListener('fullscreenchange', function () {
      if (!document.fullscreenElement) hideOverlay();
    });
    document.addEventListener('webkitfullscreenchange', function () {
      if (!document.webkitFullscreenElement) hideOverlay();
    });

    /* ESC closes overlay in Remove Distractions mode (no native fullscreen active) */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && fsOverlay && !fsOverlay.hidden &&
          !document.fullscreenElement && !document.webkitFullscreenElement) {
        hideOverlay();
      }
    });
  })();
</script>
