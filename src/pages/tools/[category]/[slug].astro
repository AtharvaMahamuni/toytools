---
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@layouts/ToolLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import CompareLayout from '@components/CompareLayout.astro';
import CopyButton from '@components/CopyButton.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { tools } from '@data/tools';
import { categories } from '@data/categories';
import { ecosystem } from '@data/ecosystem';
import { toolFAQs } from '@data/faqs';
import { withBase } from '../../../lib/paths';

export const getStaticPaths = (() => {
  return tools.map(tool => {
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`Category "${tool.categorySlug}" not found for tool "${tool.slug}"`);
    return {
      params: { category: category.segment, slug: tool.slug },
      props: { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category } = Astro.props;
const relatedTools = tools
  .filter(t => t.categorySlug === tool.categorySlug && t.slug !== tool.slug)
  .slice(0, 3);

const isBase64 = tool.slug === 'base64-encoder-decoder';
const isTodoList = tool.slug === 'todo-list';
const isNotepad = tool.slug === 'notepad';
const ecosystemEntry = ecosystem[tool.slug];

const actionLabels: Record<string, string> = {
  'word-counter': 'Count',
  'case-converter': 'Convert',
  'percentage-calculator': 'Calculate',
};
const actionLabel = actionLabels[tool.slug] ?? 'Run';

const guideHref = ecosystemEntry?.guide
  ? withBase(`/guide/${ecosystemEntry.guide.categorySlug}/${ecosystemEntry.guide.slug}/`)
  : null;
const faqHref = ecosystemEntry?.faq
  ? withBase(`/faq/${ecosystemEntry.faq.categorySlug}/${ecosystemEntry.faq.slug}/`)
  : null;
---

<ToolLayout tool={tool} category={category}>

  <!-- ── Inputs ─────────────────────────────────────────────── -->

  <Fragment slot="inputs">
    {tool.slug === 'word-counter' && (
      <section class="tool-panel" data-tool="word-counter">
        <label for="word-counter-input">Text</label>
        <textarea id="word-counter-input" rows="10" placeholder="Paste or type text here"></textarea>
      </section>
    )}

    {tool.slug === 'case-converter' && (
      <section class="tool-panel" data-tool="case-converter">
        <label for="case-input">Text</label>
        <textarea id="case-input" rows="8" placeholder="Paste or type text here"></textarea>
        <label for="case-mode">Conversion</label>
        <select id="case-mode">
          <option value="lower">lowercase</option>
          <option value="upper">UPPERCASE</option>
          <option value="title">Title Case</option>
          <option value="sentence">Sentence case</option>
        </select>
      </section>
    )}

    {tool.slug === 'percentage-calculator' && (
      <section class="tool-panel" data-tool="percentage-calculator">
        <label for="percentage-mode">Calculation</label>
        <select id="percentage-mode">
          <option value="of">What is A% of B?</option>
          <option value="change">Percentage change from A to B</option>
          <option value="is">A is what percent of B?</option>
        </select>
        <label for="percentage-a">A</label>
        <input id="percentage-a" type="number" inputmode="decimal" placeholder="Example: 20" />
        <label for="percentage-b">B</label>
        <input id="percentage-b" type="number" inputmode="decimal" placeholder="Example: 150" />
      </section>
    )}

    {isTodoList && (
      <section class="tool-panel" data-tool="todo-list">
        <p class="todo-storage-note">
          Stored locally <span class="gold-dot" aria-hidden="true"></span> Never leaves your device
        </p>
        <div class="todo-add">
          <input id="todo-new-task" type="text" placeholder="Add a task..." autocomplete="off" />
          <button id="todo-add-btn" type="button">Add</button>
        </div>
        <div id="todo-list-container" aria-live="polite"></div>
        <div class="todo-footer">
          <div id="todo-progress" class="todo-progress" aria-live="polite"></div>
          <label class="todo-hide-label">
            <input type="checkbox" id="todo-hide-completed" />
            Hide Completed
          </label>
        </div>
      </section>
    )}

    {isNotepad && (
      <section class="tool-panel notepad-panel" data-tool="notepad">
        <p class="notepad-storage-note">
          Stored locally <span class="gold-dot" aria-hidden="true"></span> Auto-saved
        </p>
        <div class="notepad-toolbar">
          <button id="notepad-paste" type="button">Paste</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-copy" type="button">Copy</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-download" type="button">Download TXT</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-clear" type="button">Clear</button>
          <span id="notepad-clear-confirm" hidden class="notepad-clear-confirm">
            Clear all notes?
            <button id="notepad-clear-cancel" type="button">Cancel</button>
            <span class="gold-dot" aria-hidden="true"></span>
            <button id="notepad-clear-do" type="button">Clear</button>
          </span>
        </div>
        <textarea
          id="notepad-input"
          placeholder={"Start typing...\nYour notes are automatically saved in this browser."}
          spellcheck="true"
          autocomplete="off"
        ></textarea>
        <div class="notepad-stats" aria-live="polite">
          <span id="notepad-words">0 Words</span>
          <span class="gold-dot" aria-hidden="true"></span>
          <span id="notepad-chars">0 Characters</span>
        </div>
      </section>
    )}

    {isBase64 && (
      <CompareLayout>
        <!-- Left: input panel -->
        <div slot="left" class="b64-panel">
          <div class="b64-header">
            <label class="b64-label" for="base64-input">
              Input <span id="b64-input-type" class="b64-type">Text</span>
            </label>
            <select id="base64-mode" aria-label="Conversion mode">
              <option value="encode">Encode → Base64</option>
              <option value="decode">Decode ← Base64</option>
            </select>
          </div>
          <textarea
            id="base64-input"
            placeholder="Enter text or Base64"
            spellcheck="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
          ></textarea>
        </div>

        <!-- Right: output panel -->
        <div slot="right" class="b64-panel">
          <div class="b64-header" data-copy-bar>
            <span class="b64-label">
              Output <span id="b64-output-type" class="b64-type">Base64</span>
            </span>
            <CopyButton targetId="base64-output" />
          </div>
          <output id="base64-output" aria-live="polite" data-empty>Output will appear here</output>
        </div>
      </CompareLayout>
    )}
  </Fragment>

  <!-- ── Action (not used for base64 — live updates replace the button) ── -->

  {!isBase64 && !isTodoList && !isNotepad && (
    <Fragment slot="action">
      <div class="tool-action">
        <button class="primary-action" type="button" data-run-tool={tool.slug}>{actionLabel}</button>
      </div>
    </Fragment>
  )}

  <!-- ── Result (not used for base64 — output is inline in the compare panel) ── -->

  {!isBase64 && !isTodoList && !isNotepad && (
    <Fragment slot="result">
      <section class="result-panel" aria-live="polite">
        {tool.slug === 'word-counter' && (
          <div class="metric-grid" id="word-counter-result">
            <div><span class="metric-value">0</span><span class="metric-label">Words</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Characters</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Sentences</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Paragraphs</span></div>
          </div>
        )}
        {tool.slug !== 'word-counter' && (
          <div>
            <h2>Result</h2>
            <output id="tool-output">Enter values and run the tool.</output>
          </div>
        )}
      </section>
    </Fragment>
  )}

  <!-- ── Explanation ────────────────────────────────────────── -->

  <Fragment slot="explanation">
    <section class="content-section">
      <h2>How it works <span class="gold-dot" aria-hidden="true"></span></h2>
      {isTodoList && (
        <>
          <p>Tasks are saved in your browser and restored automatically when you return. Nothing is sent to a server.</p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → How To Use A Todo List</a>
            </p>
          )}
        </>
      )}
      {isNotepad && (
        <>
          <p>Your notes are saved directly in this browser using localStorage. Nothing is sent to a server. Notes survive page refreshes and browser restarts.</p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → How To Take Better Notes</a>
            </p>
          )}
        </>
      )}
      {tool.slug === 'word-counter' && <p>The counter scans the text in your browser and reports common writing metrics without sending content anywhere.</p>}
      {tool.slug === 'case-converter' && <p>The converter transforms the provided text locally using the selected casing rule.</p>}
      {tool.slug === 'percentage-calculator' && <p>The calculator applies the selected percentage formula and shows the computed value immediately.</p>}
      {isBase64 && (
        <>
          <p>
            Base64 converts text or binary data into a text-safe format that can be transmitted
            through systems that primarily support text — such as email servers, URLs, and API
            payloads. The encoder and decoder run entirely in your browser. Nothing is sent to a server.
          </p>
          <p>
            Base64 is encoding, not encryption. Anyone who sees the encoded output can decode it
            instantly without a key.
          </p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → What Is Base64? Complete Reference Guide</a>
            </p>
          )}
        </>
      )}
    </section>
  </Fragment>

  <!-- ── FAQ ───────────────────────────────────────────────── -->

  <Fragment slot="faq">
    <section class="content-section">
      <h2>FAQ</h2>
      {isNotepad && faqHref ? (
        <FAQPreview
          items={toolFAQs['notepad']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : isTodoList && faqHref ? (
        <FAQPreview
          items={toolFAQs['todo-list']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : isBase64 && faqHref ? (
        <FAQPreview
          items={toolFAQs['base64-encoder-decoder']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : (
        <>
          <details>
            <summary>Does this tool upload my data?</summary>
            <p>No. Everything runs in your browser.</p>
          </details>
          <details>
            <summary>Can I use it on mobile?</summary>
            <p>Yes. Inputs are stacked and reachable on small screens.</p>
          </details>
        </>
      )}
    </section>
  </Fragment>

  <!-- ── Related ────────────────────────────────────────────── -->

  <Fragment slot="related">
    {(isBase64 || isTodoList || isNotepad) && ecosystemEntry && (
      <section class="content-section">
        <h2>Reference &amp; Learning</h2>
        <EcosystemLinks
          currentType="tool"
          toolSlug={tool.slug}
          toolCategorySegment={category.segment}
          toolName={tool.name}
          entry={ecosystemEntry}
        />
      </section>
    )}
    {relatedTools.length > 0 && (
      <section class="content-section">
        <h2>Related tools</h2>
        <div class="related-grid">
          {relatedTools.map(related => (
            <ToolCard tool={related} categorySegment={category.segment} />
          ))}
        </div>
      </section>
    )}
  </Fragment>

</ToolLayout>

<style>
  /* ── Shared panel / form styles ───────────────────────────── */

  .tool-panel,
  .result-panel,
  .content-section {
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }

  .tool-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  label {
    font-weight: var(--font-weight-medium);
  }

  textarea,
  input,
  select {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }

  textarea {
    resize: vertical;
    line-height: var(--leading-relaxed);
  }

  .tool-action {
    padding-block: var(--space-4) var(--space-8);
    border-bottom: var(--border);
  }

  .primary-action {
    width: 100%;
    min-height: 52px;
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .primary-action:hover {
    opacity: 0.9;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .metric-grid > div {
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
  }

  .metric-value,
  .metric-label {
    display: block;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
  }

  .metric-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  output {
    display: block;
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    min-height: 52px;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  details {
    border-top: var(--border);
    padding-block: var(--space-4);
  }

  details:last-child {
    border-bottom: var(--border);
  }

  summary {
    min-height: var(--touch-target);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .guide-callout {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .metric-grid,
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .tool-action {
      position: sticky;
      bottom: 0;
      z-index: var(--z-raised);
      margin-inline: calc(var(--space-4) * -1);
      padding: var(--space-3) var(--space-4);
      background: var(--color-bg);
      border-top: var(--border);
    }
  }

  /* ── Notepad ─────────────────────────────────────────────── */

  .notepad-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .notepad-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .notepad-toolbar button {
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    background: transparent;
    border: var(--border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .notepad-toolbar button:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .notepad-clear-confirm {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .notepad-clear-confirm[hidden] {
    display: none;
  }

  .notepad-panel textarea {
    min-height: 400px;
    line-height: 1.7;
    font-size: var(--text-base);
    padding: var(--space-4);
    resize: vertical;
  }

  .notepad-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-top: var(--space-2);
  }

  /* ── Todo List ────────────────────────────────────────────── */

  .todo-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .todo-add {
    display: flex;
    gap: var(--space-2);
  }

  .todo-add input {
    flex: 1;
    min-height: var(--touch-target);
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .todo-add button {
    min-height: var(--touch-target);
    padding-inline: var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .todo-add button:hover {
    opacity: 0.9;
  }

  #todo-list-container {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .todo-empty {
    padding: var(--space-8) 0;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .todo-task {
    border-top: var(--border);
    padding-block: var(--space-3);
  }

  .todo-task-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--touch-target);
  }

  .todo-checkbox {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: var(--space-1);
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .todo-title {
    flex: 1;
    align-self: center;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    transition: color var(--duration-fast) ease;
    word-break: break-word;
  }

  .todo-task--done .todo-title {
    text-decoration: line-through;
    opacity: 0.6;
    color: var(--color-text-subtle);
  }

  .todo-delete,
  .todo-subtask-delete {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    opacity: 0;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease;
    align-self: center;
  }

  .todo-task-row:hover .todo-delete,
  .todo-task:focus-within .todo-delete,
  .todo-subtask-row:hover .todo-subtask-delete,
  .todo-subtask-row:focus-within .todo-subtask-delete {
    opacity: 1;
  }

  .todo-delete:hover,
  .todo-subtask-delete:hover {
    color: var(--color-text);
  }

  .todo-subtasks {
    padding-left: var(--space-9);
    display: flex;
    flex-direction: column;
    margin-top: var(--space-1);
  }

  .todo-subtask-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: calc(var(--touch-target) * 0.75);
    border-top: var(--border);
    padding-block: var(--space-2);
  }

  .todo-subtask-checkbox {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .todo-subtask-title {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
    word-break: break-word;
  }

  .todo-subtask--done .todo-subtask-title {
    text-decoration: line-through;
    opacity: 0.6;
    color: var(--color-text-subtle);
  }

  .todo-add-subtask {
    display: flex;
    gap: var(--space-2);
    padding-left: var(--space-9);
    margin-top: var(--space-2);
  }

  .todo-add-subtask input {
    flex: 1;
    min-height: calc(var(--touch-target) * 0.75);
    padding: var(--space-2) var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .todo-add-subtask-btn {
    min-height: calc(var(--touch-target) * 0.75);
    padding-inline: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .todo-add-subtask-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .todo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .todo-progress {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .todo-hide-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    font-weight: var(--font-weight-normal);
  }

  .todo-hide-label input[type="checkbox"] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  /* ── Base64 compare layout ────────────────────────────────── */

  .b64-panel {
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    min-height: 320px;
    overflow: hidden;
  }

  .b64-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-bottom: var(--border);
    min-height: var(--touch-target);
    flex-shrink: 0;
  }

  .b64-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .b64-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-subtle);
  }

  /* Mode selector — compact, lives inside the panel header */
  #base64-mode {
    min-height: unset;
    width: auto;
    border: none;
    border-left: var(--border);
    border-radius: 0;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    align-self: stretch;
  }

  /* Input textarea — fills the panel, no redundant border */
  #base64-input {
    flex: 1;
    resize: none;
    width: 100%;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    background: var(--color-bg);
    color: var(--color-text);
    font-variant-ligatures: none;
  }

  /* Output element — same visual weight as the input */
  #base64-output {
    flex: 1;
    display: block;
    margin: 0;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow-y: auto;
    color: var(--color-text);
    font-variant-ligatures: none;
  }

  /* Empty state — muted placeholder colour */
  #base64-output[data-empty] {
    color: var(--color-text-subtle);
  }
</style>

<script is:inline>
  /* ── Shared helpers ───────────────────────────────────────── */

  function textValue(id) {
    return document.getElementById(id)?.value || '';
  }

  function writeOutput(value) {
    var el = document.getElementById('tool-output');
    if (el) el.textContent = value;
  }

  function sentenceCase(text) {
    return text.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, function (m) { return m.toUpperCase(); });
  }

  function titleCase(text) {
    return text.toLowerCase().replace(/\b\w/g, function (m) { return m.toUpperCase(); });
  }

  /* ── Button-triggered tools ───────────────────────────────── */

  function runWordCounter() {
    var text = textValue('word-counter-input').trim();
    var words      = text ? text.split(/\s+/).filter(Boolean).length : 0;
    var characters = text.length;
    var sentences  = text ? (text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || []).length : 0;
    var paragraphs = text ? text.split(/\n\s*\n/).filter(Boolean).length : 0;
    var values = [words, characters, sentences, paragraphs];
    document.querySelectorAll('#word-counter-result .metric-value').forEach(function (node, i) {
      node.textContent = String(values[i]);
    });
  }

  function runCaseConverter() {
    var text = textValue('case-input');
    var mode = document.getElementById('case-mode')?.value;
    var result = mode === 'upper'    ? text.toUpperCase()  :
                 mode === 'title'    ? titleCase(text)      :
                 mode === 'sentence' ? sentenceCase(text)   :
                                      text.toLowerCase();
    writeOutput(result || 'Enter text to convert.');
  }

  function runPercentageCalculator() {
    var mode = document.getElementById('percentage-mode')?.value;
    var a = Number(textValue('percentage-a'));
    var b = Number(textValue('percentage-b'));
    if (!Number.isFinite(a) || !Number.isFinite(b)) { writeOutput('Enter valid numbers.'); return; }
    if (mode === 'change' && a === 0) { writeOutput('First value cannot be zero.'); return; }
    if (mode === 'is'     && b === 0) { writeOutput('Second value cannot be zero.'); return; }
    var result = mode === 'of'     ? (a / 100) * b :
                 mode === 'change' ? ((b - a) / a) * 100 :
                                     (a / b) * 100;
    writeOutput(Number(result.toFixed(6)).toString());
  }

  var runBtn = document.querySelector('[data-run-tool]');
  if (runBtn) {
    runBtn.addEventListener('click', function (event) {
      var slug = event.currentTarget.getAttribute('data-run-tool');
      if (slug === 'word-counter')          runWordCounter();
      if (slug === 'case-converter')        runCaseConverter();
      if (slug === 'percentage-calculator') runPercentageCalculator();
    });
  }

  /* ── Notepad — auto-save + toolbar actions ───────────────── */

  (function () {
    var textarea = document.getElementById('notepad-input');
    if (!textarea) return;

    var STORAGE_KEY = 'toytools.notepad.note';
    var MAX_STORE   = 50000;

    function updateStats() {
      var text    = textarea.value;
      var words   = text.trim() ? text.trim().split(/\s+/).filter(Boolean).length : 0;
      var wordsEl = document.getElementById('notepad-words');
      var charsEl = document.getElementById('notepad-chars');
      if (wordsEl) wordsEl.textContent = words + (words === 1 ? ' Word' : ' Words');
      if (charsEl) charsEl.textContent = text.length + (text.length === 1 ? ' Character' : ' Characters');
    }

    /* Restore from localStorage */
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) textarea.value = saved;
    } catch (_) {}
    updateStats();

    /* Auto-save on input */
    textarea.addEventListener('input', function () {
      updateStats();
      try {
        if (textarea.value.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, textarea.value);
        else if (!textarea.value)              localStorage.removeItem(STORAGE_KEY);
      } catch (_) {}
    });

    /* Paste — insert at cursor position */
    var pasteBtn = document.getElementById('notepad-paste');
    if (pasteBtn) {
      pasteBtn.addEventListener('click', function () {
        navigator.clipboard.readText().then(function (text) {
          var pos = textarea.selectionStart;
          textarea.value = textarea.value.slice(0, pos) + text + textarea.value.slice(textarea.selectionEnd);
          textarea.selectionStart = textarea.selectionEnd = pos + text.length;
          textarea.dispatchEvent(new Event('input'));
        }).catch(function () {
          pasteBtn.textContent = 'No permission';
          setTimeout(function () { pasteBtn.textContent = 'Paste'; }, 2000);
        });
      });
    }

    /* Copy */
    var copyBtn = document.getElementById('notepad-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (!textarea.value) return;
        navigator.clipboard.writeText(textarea.value).then(function () {
          copyBtn.textContent = 'Copied';
          setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
        }).catch(function () {});
      });
    }

    /* Download TXT */
    var dlBtn = document.getElementById('notepad-download');
    if (dlBtn) {
      dlBtn.addEventListener('click', function () {
        var blob = new Blob([textarea.value], { type: 'text/plain' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'note.txt'; a.click();
        URL.revokeObjectURL(url);
      });
    }

    /* Clear with inline confirmation */
    var clearBtn     = document.getElementById('notepad-clear');
    var clearConfirm = document.getElementById('notepad-clear-confirm');
    var cancelBtn    = document.getElementById('notepad-clear-cancel');
    var doBtn        = document.getElementById('notepad-clear-do');

    if (clearBtn && clearConfirm) {
      clearBtn.addEventListener('click', function () {
        clearConfirm.hidden = false;
        clearBtn.hidden = true;
      });
      cancelBtn.addEventListener('click', function () {
        clearConfirm.hidden = true;
        clearBtn.hidden = false;
      });
      doBtn.addEventListener('click', function () {
        textarea.value = '';
        try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
        clearConfirm.hidden = true;
        clearBtn.hidden = false;
        updateStats();
      });
    }
  })();

  /* ── Base64 — live updates + localStorage persistence ─────── */

  (function () {
    var input  = document.getElementById('base64-input');
    var modeEl = document.getElementById('base64-mode');
    var output = document.getElementById('base64-output');
    if (!input || !modeEl || !output) return;

    var STORAGE_KEY = 'toytools.base64.input';
    var MAX_STORE   = 50000; /* matches MAX_STORE_BYTES in src/lib/storage.ts */

    function setOutput(text, empty, error) {
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else       output.removeAttribute('data-empty');
      if (error) output.setAttribute('data-error', text);
      else       output.removeAttribute('data-error');
    }

    function convert() {
      var text = input.value;
      if (!text) { setOutput('Output will appear here', true, false); return; }
      var mode = modeEl.value;
      try {
        var result = mode === 'decode'
          ? decodeURIComponent(escape(atob(text.trim())))
          : btoa(unescape(encodeURIComponent(text)));
        setOutput(result, false, false);
      } catch (_) {
        var msg = mode === 'decode' ? 'Invalid Base64 input.' : 'Unable to encode.';
        setOutput(msg, false, true);
      }
    }

    function updateLabels() {
      var encode = modeEl.value === 'encode';
      var inputType  = document.getElementById('b64-input-type');
      var outputType = document.getElementById('b64-output-type');
      if (inputType)  inputType.textContent  = encode ? 'Text'   : 'Base64';
      if (outputType) outputType.textContent = encode ? 'Base64' : 'Text';
    }

    /* Restore from localStorage */
    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) { input.value = saved; convert(); }
    } catch (_) {}

    updateLabels();

    /* Live update on input */
    input.addEventListener('input', function () {
      convert();
      try {
        if (input.value.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, input.value);
        else if (!input.value)              localStorage.removeItem(STORAGE_KEY);
      } catch (_) {}
    });

    modeEl.addEventListener('change', function () {
      convert();
      updateLabels();
    });
  })();

  /* ── Todo List — localStorage persistence + DOM rendering ─── */

  (function () {
    var newTaskInput = document.getElementById('todo-new-task');
    if (!newTaskInput) return;

    var STORAGE_KEY = 'toytools.todo.tasks';
    var MAX_STORE   = 50000;
    var tasks       = [];

    function loadTasks() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) tasks = JSON.parse(saved);
      } catch (_) { tasks = []; }
    }

    function saveTasks() {
      try {
        var str = JSON.stringify(tasks);
        if (str.length < MAX_STORE) localStorage.setItem(STORAGE_KEY, str);
      } catch (_) {}
    }

    function uid() {
      return Date.now().toString(36) + Math.random().toString(36).slice(2);
    }

    function addTask(title) {
      tasks.unshift({ id: uid(), title: title, completed: false, createdAt: new Date().toISOString(), subtasks: [] });
      saveTasks();
      render();
    }

    function toggleTask(id) {
      var t = tasks.find(function (x) { return x.id === id; });
      if (t) { t.completed = !t.completed; saveTasks(); render(); }
    }

    function deleteTask(id) {
      tasks = tasks.filter(function (x) { return x.id !== id; });
      saveTasks();
      render();
    }

    function addSubtask(taskId, title) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        t.subtasks.push({ id: uid(), title: title, completed: false });
        saveTasks();
        render();
      }
    }

    function toggleSubtask(taskId, subId) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        var s = t.subtasks.find(function (x) { return x.id === subId; });
        if (s) { s.completed = !s.completed; saveTasks(); render(); }
      }
    }

    function deleteSubtask(taskId, subId) {
      var t = tasks.find(function (x) { return x.id === taskId; });
      if (t) {
        t.subtasks = t.subtasks.filter(function (x) { return x.id !== subId; });
        saveTasks();
        render();
      }
    }

    function createSubtaskEl(taskId, sub) {
      var row = document.createElement('div');
      row.className = 'todo-subtask-row' + (sub.completed ? ' todo-subtask--done' : '');

      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'todo-subtask-checkbox';
      cb.checked = sub.completed;
      cb.addEventListener('change', function () { toggleSubtask(taskId, sub.id); });

      var title = document.createElement('span');
      title.className = 'todo-subtask-title';
      title.textContent = sub.title;

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'todo-subtask-delete';
      del.textContent = 'Delete';
      del.addEventListener('click', function () { deleteSubtask(taskId, sub.id); });

      row.appendChild(cb);
      row.appendChild(title);
      row.appendChild(del);
      return row;
    }

    function createTaskEl(task) {
      var item = document.createElement('div');
      item.className = 'todo-task' + (task.completed ? ' todo-task--done' : '');

      var row = document.createElement('div');
      row.className = 'todo-task-row';

      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'todo-checkbox';
      cb.checked = task.completed;
      cb.addEventListener('change', function () { toggleTask(task.id); });

      var title = document.createElement('span');
      title.className = 'todo-title';
      title.textContent = task.title;

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'todo-delete';
      del.textContent = 'Delete';
      del.addEventListener('click', function () { deleteTask(task.id); });

      row.appendChild(cb);
      row.appendChild(title);
      row.appendChild(del);
      item.appendChild(row);

      if (task.subtasks.length > 0) {
        var subList = document.createElement('div');
        subList.className = 'todo-subtasks';
        task.subtasks.forEach(function (sub) {
          subList.appendChild(createSubtaskEl(task.id, sub));
        });
        item.appendChild(subList);
      }

      var addSub = document.createElement('div');
      addSub.className = 'todo-add-subtask';

      var subInput = document.createElement('input');
      subInput.type = 'text';
      subInput.placeholder = 'Add subtask...';
      subInput.autocomplete = 'off';
      subInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          var val = subInput.value.trim();
          if (val) { addSubtask(task.id, val); }
        }
      });

      var subBtn = document.createElement('button');
      subBtn.type = 'button';
      subBtn.className = 'todo-add-subtask-btn';
      subBtn.textContent = 'Add Subtask';
      subBtn.addEventListener('click', function () {
        var val = subInput.value.trim();
        if (val) { addSubtask(task.id, val); }
      });

      addSub.appendChild(subInput);
      addSub.appendChild(subBtn);
      item.appendChild(addSub);

      return item;
    }

    function updateProgress() {
      var el = document.getElementById('todo-progress');
      if (!el) return;
      var total = tasks.length;
      if (total === 0) { el.textContent = ''; return; }
      var done = tasks.filter(function (t) { return t.completed; }).length;
      var pct  = Math.round((done / total) * 100);
      el.textContent = done + ' of ' + total + ' completed ● ' + pct + '%';
    }

    function render() {
      var container = document.getElementById('todo-list-container');
      if (!container) return;
      var hideEl = document.getElementById('todo-hide-completed');
      var hideCompleted = hideEl ? hideEl.checked : false;

      container.innerHTML = '';

      if (tasks.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'todo-empty';
        empty.textContent = 'No tasks yet. Add your first task above.';
        container.appendChild(empty);
        updateProgress();
        return;
      }

      var visible = hideCompleted
        ? tasks.filter(function (t) { return !t.completed; })
        : tasks;

      visible.forEach(function (task) {
        container.appendChild(createTaskEl(task));
      });

      updateProgress();
    }

    var addBtn = document.getElementById('todo-add-btn');
    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var val = newTaskInput.value.trim();
        if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
      });
    }

    newTaskInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        var val = newTaskInput.value.trim();
        if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
      }
    });

    var hideToggle = document.getElementById('todo-hide-completed');
    if (hideToggle) {
      hideToggle.addEventListener('change', render);
    }

    loadTasks();
    render();
  })();
</script>
