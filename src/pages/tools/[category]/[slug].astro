  .wl-fs-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) ease;
