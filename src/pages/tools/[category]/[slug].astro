  .wl-toggle-knob {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-text-subtle);
    flex-shrink: 0;
    transition: transform var(--duration-normal) ease, background-color var(--duration-normal) ease;
