---
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@layouts/ToolLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import CompareLayout from '@components/CompareLayout.astro';
import CopyButton from '@components/CopyButton.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { tools } from '@data/tools';
import { categories } from '@data/categories';
import { ecosystem } from '@data/ecosystem';
import { toolFAQs } from '@data/faqs';
import { withBase } from '../../../lib/paths';

export const getStaticPaths = (() => {
  return tools.map(tool => {
    const category = categories.find(c => c.slug === tool.categorySlug);
    if (!category) throw new Error(`Category "${tool.categorySlug}" not found for tool "${tool.slug}"`);
    return {
      params: { category: category.segment, slug: tool.slug },
      props: { tool, category },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category } = Astro.props;
const relatedTools = tools
  .filter(t => t.categorySlug === tool.categorySlug && t.slug !== tool.slug)
  .slice(0, 3);

const isBase64 = tool.slug === 'base64-encoder-decoder';
const isTodoList = tool.slug === 'todo-list';
const isNotepad = tool.slug === 'notepad';
const isKeepScreenAwake = tool.slug === 'keep-screen-awake';
const ecosystemEntry = ecosystem[tool.slug];

const actionLabels: Record<string, string> = {
  'word-counter': 'Count',
  'case-converter': 'Convert',
  'percentage-calculator': 'Calculate',
};
const actionLabel = actionLabels[tool.slug] ?? 'Run';

const guideHref = ecosystemEntry?.guide
  ? withBase(`/guide/${ecosystemEntry.guide.categorySlug}/${ecosystemEntry.guide.slug}/`)
  : null;
const faqHref = ecosystemEntry?.faq
  ? withBase(`/faq/${ecosystemEntry.faq.categorySlug}/${ecosystemEntry.faq.slug}/`)
  : null;
---

<ToolLayout tool={tool} category={category}>

  <!-- ── Inputs ─────────────────────────────────────────────── -->

  <Fragment slot="inputs">
    {tool.slug === 'word-counter' && (
      <section class="tool-panel" data-tool="word-counter">
        <label for="word-counter-input">Text</label>
        <textarea id="word-counter-input" rows="10" placeholder="Paste or type text here"></textarea>
      </section>
    )}

    {tool.slug === 'case-converter' && (
      <section class="tool-panel" data-tool="case-converter">
        <label for="case-input">Text</label>
        <textarea id="case-input" rows="8" placeholder="Paste or type text here"></textarea>
        <label for="case-mode">Conversion</label>
        <select id="case-mode">
          <option value="lower">lowercase</option>
          <option value="upper">UPPERCASE</option>
          <option value="title">Title Case</option>
          <option value="sentence">Sentence case</option>
        </select>
      </section>
    )}

    {tool.slug === 'percentage-calculator' && (
      <section class="tool-panel" data-tool="percentage-calculator">
        <label for="percentage-mode">Calculation</label>
        <select id="percentage-mode">
          <option value="of">What is A% of B?</option>
          <option value="change">Percentage change from A to B</option>
          <option value="is">A is what percent of B?</option>
        </select>
        <label for="percentage-a">A</label>
        <input id="percentage-a" type="number" inputmode="decimal" placeholder="Example: 20" />
        <label for="percentage-b">B</label>
        <input id="percentage-b" type="number" inputmode="decimal" placeholder="Example: 150" />
      </section>
    )}

    {isTodoList && (
      <section class="tool-panel" data-tool="todo-list">
        <p class="todo-storage-note">
          Stored locally <span class="gold-dot" aria-hidden="true"></span> Never leaves your device
        </p>
        <div class="todo-add">
          <input id="todo-new-task" type="text" placeholder="Add a task..." autocomplete="off" />
          <button id="todo-add-btn" type="button">Add</button>
        </div>
        <div id="todo-list-container" aria-live="polite"></div>
        <div class="todo-footer">
          <div id="todo-progress" class="todo-progress" aria-live="polite"></div>
          <label class="todo-hide-label">
            <input type="checkbox" id="todo-hide-completed" />
            Hide Completed
          </label>
        </div>
      </section>
    )}

    {isNotepad && (
      <section class="tool-panel notepad-panel" data-tool="notepad">
        <p class="notepad-storage-note">
          Stored locally <span class="gold-dot" aria-hidden="true"></span> Auto-saved
        </p>
        <div class="notepad-toolbar">
          <button id="notepad-paste" type="button">Paste</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-copy" type="button">Copy</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-download" type="button">Download TXT</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="notepad-clear" type="button">Clear</button>
          <span id="notepad-clear-confirm" hidden class="notepad-clear-confirm">
            Clear all notes?
            <button id="notepad-clear-cancel" type="button">Cancel</button>
            <span class="gold-dot" aria-hidden="true"></span>
            <button id="notepad-clear-do" type="button">Clear</button>
          </span>
        </div>
        <textarea
          id="notepad-input"
          placeholder={"Start typing...\nYour notes are automatically saved in this browser."}
          spellcheck="true"
          autocomplete="off"
        ></textarea>
        <div class="notepad-stats" aria-live="polite">
          <span id="notepad-words">0 Words</span>
          <span class="gold-dot" aria-hidden="true"></span>
          <span id="notepad-chars">0 Characters</span>
        </div>
      </section>
    )}

    {isKeepScreenAwake && (
      <div class="wl-inputs">
        <div id="wl-unsupported" hidden class="wl-unsupported">
          Screen Wake Lock is not supported in this browser.
          <span class="wl-unsupported-hint">You can still prevent sleep using your device settings.</span>
        </div>
        <button id="wl-time-toggle" type="button" class="wl-text-action">
          Tool Settings ▾
        </button>
        <div id="wl-time-options" hidden class="wl-time-options-panel">
          <div class="wl-duration-grid">
            <button data-duration="0"    class="wl-dur selected wl-dur-inf" type="button">∞</button>
            <button data-duration="900"  class="wl-dur" type="button">15 min</button>
            <button data-duration="1800" class="wl-dur" type="button">30 min</button>
            <button data-duration="3600" class="wl-dur" type="button">1 hour</button>
            <button data-duration="7200" class="wl-dur" type="button">2 hours</button>
            <input id="wl-custom-min" type="number" min="1" max="480" placeholder="Custom Time in Min" class="wl-custom-input" />
          </div>
          <div class="wl-format-row">
            <button data-format="12" class="wl-fmt selected" type="button">12h</button>
            <button data-format="24" class="wl-fmt" type="button">24h</button>
          </div>
        </div>
      </div>
    )}

    {isBase64 && (
      <CompareLayout>
        <!-- Left: input panel -->
        <div slot="left" class="b64-panel">
          <div class="b64-header">
            <label class="b64-label" for="base64-input">
              Input <span id="b64-input-type" class="b64-type">Text</span>
            </label>
            <select id="base64-mode" aria-label="Conversion mode">
              <option value="encode">Encode → Base64</option>
              <option value="decode">Decode ← Base64</option>
            </select>
          </div>
          <textarea
            id="base64-input"
            placeholder="Enter text or Base64"
            spellcheck="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
          ></textarea>
        </div>

        <!-- Right: output panel -->
        <div slot="right" class="b64-panel">
          <div class="b64-header" data-copy-bar>
            <span class="b64-label">
              Output <span id="b64-output-type" class="b64-type">Base64</span>
            </span>
            <CopyButton targetId="base64-output" />
          </div>
          <output id="base64-output" aria-live="polite" data-empty>Output will appear here</output>
        </div>
      </CompareLayout>
    )}
  </Fragment>

  <!-- ── Action (not used for base64 — live updates replace the button) ── -->

  {!isBase64 && !isTodoList && !isNotepad && !isKeepScreenAwake && (
    <Fragment slot="action">
      <div class="tool-action">
        <button class="primary-action" type="button" data-run-tool={tool.slug}>{actionLabel}</button>
      </div>
    </Fragment>
  )}

  <!-- ── Result (not used for base64 — output is inline in the compare panel) ── -->

  {isKeepScreenAwake && (
    <Fragment slot="result">
      <div class="wl-status">
        <div class="wl-status-row">
          <button id="wl-toggle" type="button" class="wl-toggle-switch" role="switch" aria-checked="false" aria-label="Keep screen awake">
            <span class="wl-toggle-knob"></span>
          </button>
          <span id="wl-label" class="wl-status-label wl-fade">Sleeping</span>
        </div>
        <div id="wl-timer" class="wl-timer wl-off">
          <span id="wl-timer-label" class="wl-timer-meta">Awake From</span>
          <span id="wl-timer-value" class="wl-timer-value" aria-live="polite" aria-atomic="true">00h 00m 00s</span>
        </div>
        <div class="wl-meta-block wl-off">
          <span id="wl-started-label" class="wl-timer-meta">Started At</span>
          <span id="wl-started-value" class="wl-ends-value"></span>
          <span id="wl-ends-label"   class="wl-timer-meta wl-fade wl-off">Ends At</span>
          <span id="wl-ends-value"   class="wl-ends-value wl-fade wl-off"></span>
        </div>
        <p id="wl-msg" class="wl-msg wl-fade">Ready when you are.</p>
        <div class="wl-view-actions">
          <button id="wl-fs-btn" type="button" class="wl-fs-btn" aria-label="Enter full screen">Full Screen</button>
          <span class="gold-dot" aria-hidden="true"></span>
          <button id="wl-rd-btn" type="button" class="wl-fs-btn" aria-label="Remove distractions">Remove Distractions</button>
        </div>
      </div>
    </Fragment>
  )}

  {!isBase64 && !isTodoList && !isNotepad && !isKeepScreenAwake && (
    <Fragment slot="result">
      <section class="result-panel" aria-live="polite">
        {tool.slug === 'word-counter' && (
          <div class="metric-grid" id="word-counter-result">
            <div><span class="metric-value">0</span><span class="metric-label">Words</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Characters</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Sentences</span></div>
            <div><span class="metric-value">0</span><span class="metric-label">Paragraphs</span></div>
          </div>
        )}
        {tool.slug !== 'word-counter' && (
          <div>
            <h2>Result</h2>
            <output id="tool-output">Enter values and run the tool.</output>
          </div>
        )}
      </section>
    </Fragment>
  )}

  <!-- ── Explanation ────────────────────────────────────────── -->

  <Fragment slot="explanation">
    <section class="content-section">
      <h2>How it works <span class="gold-dot" aria-hidden="true"></span></h2>
      {isTodoList && (
        <>
          <p>Tasks are saved in your browser and restored automatically when you return. Nothing is sent to a server.</p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → How To Use A Todo List</a>
            </p>
          )}
        </>
      )}
      {isNotepad && (
        <>
          <p>Your notes are saved directly in this browser using localStorage. Nothing is sent to a server. Notes survive page refreshes and browser restarts.</p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → How To Take Better Notes</a>
            </p>
          )}
        </>
      )}
      {isKeepScreenAwake && (
        <>
          <p>
            This tool uses the browser Wake Lock API to ask your operating system to keep the display on.
            When active, the screen will not dim or turn off on its own. The lock is released automatically
            when you stop the tool, switch tabs, or close the page. Nothing is sent to a server.
          </p>
          <p>
            Wake locks apply only to the display — they do not prevent your computer from entering system
            sleep if you close the lid or trigger it manually.
          </p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → How to Keep Your Screen Awake</a>
            </p>
          )}
        </>
      )}
      {tool.slug === 'word-counter' && <p>The counter scans the text in your browser and reports common writing metrics without sending content anywhere.</p>}
      {tool.slug === 'case-converter' && <p>The converter transforms the provided text locally using the selected casing rule.</p>}
      {tool.slug === 'percentage-calculator' && <p>The calculator applies the selected percentage formula and shows the computed value immediately.</p>}
      {isBase64 && (
        <>
          <p>
            Base64 converts text or binary data into a text-safe format that can be transmitted
            through systems that primarily support text — such as email servers, URLs, and API
            payloads. The encoder and decoder run entirely in your browser. Nothing is sent to a server.
          </p>
          <p>
            Base64 is encoding, not encryption. Anyone who sees the encoded output can decode it
            instantly without a key.
          </p>
          {guideHref && (
            <p class="guide-callout">
              <a href={guideHref}>Learn more → What Is Base64? Complete Reference Guide</a>
            </p>
          )}
        </>
      )}
    </section>
  </Fragment>

  <!-- ── FAQ ───────────────────────────────────────────────── -->

  <Fragment slot="faq">
    <section class="content-section">
      <h2>FAQ</h2>
      {isNotepad && faqHref ? (
        <FAQPreview
          items={toolFAQs['notepad']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : isTodoList && faqHref ? (
        <FAQPreview
          items={toolFAQs['todo-list']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : isBase64 && faqHref ? (
        <FAQPreview
          items={toolFAQs['base64-encoder-decoder']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : isKeepScreenAwake && faqHref ? (
        <FAQPreview
          items={toolFAQs['keep-screen-awake']!.slice(0, 3)}
          faqHref={faqHref}
        />
      ) : (
        <>
          <details>
            <summary>Does this tool upload my data?</summary>
            <p>No. Everything runs in your browser.</p>
          </details>
          <details>
            <summary>Can I use it on mobile?</summary>
            <p>Yes. Inputs are stacked and reachable on small screens.</p>
          </details>
        </>
      )}
    </section>
  </Fragment>

  <!-- ── Related ────────────────────────────────────────────── -->

  <Fragment slot="related">
    {(isBase64 || isTodoList || isNotepad || isKeepScreenAwake) && ecosystemEntry && (
      <section class="content-section">
        <h2>Reference &amp; Learning</h2>
        <EcosystemLinks
          currentType="tool"
          toolSlug={tool.slug}
          toolCategorySegment={category.segment}
          toolName={tool.name}
          entry={ecosystemEntry}
        />
      </section>
    )}
    {relatedTools.length > 0 && (
      <section class="content-section">
        <h2>Related tools</h2>
        <div class="related-grid">
          {relatedTools.map(related => (
            <ToolCard tool={related} categorySegment={category.segment} />
          ))}
        </div>
      </section>
    )}
    {isKeepScreenAwake && (
      <div id="wl-fullscreen" class="wl-fullscreen" data-state="inactive" hidden>
        <div class="wl-fs-content">
          <div class="wl-fs-status-row">
            <span id="wl-fs-dot" class="wl-dot wl-fs-dot" data-state="inactive" aria-hidden="true"></span>
            <span id="wl-fs-label" class="wl-fs-label">Sleeping</span>
          </div>
          <div id="wl-fs-timer" hidden class="wl-fs-timer">
            <span id="wl-fs-timer-label" class="wl-fs-timer-meta">Awake From</span>
            <span id="wl-fs-timer-value" class="wl-fs-timer-value">00h 00m 00s</span>
          </div>
          <div class="wl-fs-meta-block">
            <div id="wl-fs-started" hidden class="wl-fs-meta-row">
              <span class="wl-fs-timer-meta">Started At</span>
              <span id="wl-fs-started-value" class="wl-fs-meta-value"></span>
            </div>
            <div id="wl-fs-ends" hidden class="wl-fs-meta-row">
              <span class="wl-fs-timer-meta">Ends At</span>
              <span id="wl-fs-ends-value" class="wl-fs-meta-value"></span>
            </div>
          </div>
        </div>
        <button id="wl-fs-exit" type="button" class="wl-fs-exit" aria-label="Exit full screen">✕</button>
      </div>
    )}
  </Fragment>

</ToolLayout>

<style>
  /* ── Shared panel / form styles ───────────────────────────── */

  .tool-panel,
  .result-panel,
  .content-section {
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }

  .tool-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  label {
    font-weight: var(--font-weight-medium);
  }

  textarea,
  input,
  select {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }

  textarea {
    resize: vertical;
    line-height: var(--leading-relaxed);
  }

  .tool-action {
    padding-block: var(--space-4) var(--space-8);
    border-bottom: var(--border);
  }

  .primary-action {
    width: 100%;
    min-height: 52px;
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .primary-action:hover {
    opacity: 0.9;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .metric-grid > div {
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
  }

  .metric-value,
  .metric-label {
    display: block;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
  }

  .metric-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  output {
    display: block;
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    min-height: 52px;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  details {
    border-top: var(--border);
    padding-block: var(--space-4);
  }

  details:last-child {
    border-bottom: var(--border);
  }

  summary {
    min-height: var(--touch-target);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .guide-callout {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .metric-grid,
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .tool-action {
      position: sticky;
      bottom: 0;
      z-index: var(--z-raised);
      margin-inline: calc(var(--space-4) * -1);
      padding: var(--space-3) var(--space-4);
      background: var(--color-bg);
      border-top: var(--border);
    }
  }

  /* ── Notepad ─────────────────────────────────────────────── */

  .notepad-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .notepad-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .notepad-toolbar button {
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    background: transparent;
    border: var(--border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .notepad-toolbar button:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .notepad-clear-confirm {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .notepad-clear-confirm[hidden] {
    display: none;
  }

  .notepad-panel textarea {
    min-height: 400px;
    line-height: 1.7;
    font-size: var(--text-base);
    padding: var(--space-4);
    resize: vertical;
  }

  .notepad-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-top: var(--space-2);
  }

  /* ── Todo List ────────────────────────────────────────────── */

  .todo-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .todo-add {
    display: flex;
    gap: var(--space-2);
  }

  .todo-add input {
    flex: 1;
    min-height: var(--touch-target);
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .todo-add button {
    min-height: var(--touch-target);
    padding-inline: var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .todo-add button:hover {
    opacity: 0.9;
  }

  #todo-list-container {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .todo-empty {
    padding: var(--space-8) 0;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .todo-task {
    border-top: var(--border);
    padding-block: var(--space-3);
  }

  .todo-task-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--touch-target);
  }

  .todo-checkbox {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: var(--space-1);
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .todo-title {
    flex: 1;
    align-self: center;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    transition: color var(--duration-fast) ease;
    word-break: break-word;
  }

  .todo-task--done .todo-title {
    text-decoration: line-through;
    opacity: 0.6;
    color: var(--color-text-subtle);
  }

  .todo-delete,
  .todo-subtask-delete {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
