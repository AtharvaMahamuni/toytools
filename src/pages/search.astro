---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import ToolCard from '@components/ToolCard.astro';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { withBase } from '../lib/paths';

function getCategoryName(slug: string): string {
  return categories.find(c => c.slug === slug)?.name ?? slug;
}
---

<BaseLayout
  title={generatePageTitle('search')}
  description="Search ToyTools utilities by name, category, or tag."
  maxWidth="category"
  robots="noindex,follow"
>
  <section class="search-header">
    <h1>Search tools</h1>
    <form class="search-page-form" action={withBase('/search/')} method="get" role="search">
      <label class="sr-only" for="search-page-query">Search tools</label>
      <input id="search-page-query" type="search" name="q" placeholder="Search by name, category, or tag" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </section>

  <section class="search-results" aria-live="polite">
    <p class="result-count" id="result-count"></p>
    <div class="tool-grid" id="search-results">
      {tools.map(tool => (
        <article
          data-search-item
          data-slug={tool.slug}
          {/* Only the vocabulary the card does NOT already render. Name, description and
              category were in here too, which shipped a second lowercase copy of every tool's
              description in an attribute nothing displayed: 132 tools of pure duplication, and
              the reason this page was the heaviest HTML document on the site. The inline pass
              below reads this attribute AND the card's own text, so matching is unchanged. */}
          data-search={`${tool.tags.join(' ')} ${(tool.keywords ?? []).join(' ')} ${tool.family ?? ''}`.toLowerCase()}
        >
          <ToolCard tool={tool} categoryName={getCategoryName(tool.categorySlug)} />
        </article>
      ))}
    </div>
    {/* A search that finds nothing is the clearest statement of an unmet need anywhere on the
        site: someone has told us exactly what they wanted, in their own words, at the moment
        they wanted it. Carrying the query to the feedback form is the whole point. */}
    <p class="empty-state" id="empty-state" hidden>
      No matching tools found.
      <a id="empty-suggest" href={withBase('/feedback/')}>Suggest it &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .search-header {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-6);
  }

  .search-page-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--width-tool);
  }

  input,
  button {
    min-height: 52px;
    border-radius: var(--radius-md);
    font: inherit;
  }

  input {
    width: 100%;
    padding: 0 var(--space-4);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  button {
    border: var(--border-strong);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .result-count {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .empty-state {
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }

  .empty-state a {
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    margin-left: var(--space-2);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .empty-state a:hover {
    text-decoration: underline;
  }

  .empty-state a:active {
    color: var(--color-accent-strong);
  }

  @media (min-width: 720px) {
    .search-page-form {
      flex-direction: row;
    }

    button {
      min-width: 140px;
    }
  }
</style>

<script is:inline>
  var params = new URLSearchParams(window.location.search);
  var query = (params.get('q') || '').trim().toLowerCase();
  var input = document.getElementById('search-page-query');
  var count = document.getElementById('result-count');
  var empty = document.getElementById('empty-state');
  var items = Array.from(document.querySelectorAll('[data-search-item]'));

  if (input) input.value = query;

  var visible = 0;
  items.forEach(function (item) {
    // The card's own text carries the name, description and category; the attribute carries the
    // tags, keywords and family, which are real search terms that never appear on screen.
    var haystack = (item.getAttribute('data-search') || '') + ' ' + (item.textContent || '').toLowerCase();
    var matches = !query || haystack.includes(query);
    item.hidden = !matches;
    if (matches) visible += 1;
  });

  if (count) count.textContent = query ? visible + ' matching tools' : items.length + ' tools available';
  if (empty) empty.hidden = visible !== 0;

  // Hand the unmatched query to the feedback form, which opens on "Suggest a New Tool" with
  // "what are you trying to do?" already filled in. The raw (uncased) term is used so it
  // reads back the way they typed it.
  var suggest = document.getElementById('empty-suggest');
  if (suggest) {
    var raw = (params.get('q') || '').trim();
    var href = suggest.getAttribute('href') + '?type=new';
    if (raw) href += '&q=' + encodeURIComponent(raw);
    suggest.setAttribute('href', href);
  }
</script>

{/*
  The inline script above is the no-network first pass: it applies ?q= immediately so a shared
  search link never flashes all 114 cards. This module then upgrades the page to the real thing:
  typing filters live (the old script only ran once, so nothing happened until you submitted),
  results REORDER by score rather than merely hiding, and aliases and typos work because it is the
  same ranking the palette uses. It imports from lib/palette so both stay on one measured chunk.
*/}
<script>
  import { loadIndex, rankEntries, entryCategory } from '@lib/palette';

  const form = document.querySelector<HTMLFormElement>('.search-page-form');
  const input = document.getElementById('search-page-query') as HTMLInputElement | null;
  const grid = document.getElementById('search-results');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty-state');
  const suggest = document.getElementById('empty-suggest');

  if (input && grid && count) {
    // [data-search-item] and not [data-slug]: ToolCard's inner <a> carries data-slug too, so the
    // looser selector matches the anchor as well and ends up hiding that instead of the card.
    const cards = new Map<string, HTMLElement>();
    for (const el of grid.querySelectorAll<HTMLElement>('[data-search-item]')) {
      cards.set(el.dataset.slug!, el);
    }

    void loadIndex().then((index) => {
      if (!index) return; // offline: the inline substring pass above still works

      const apply = (raw: string) => {
        const query = raw.trim();

        if (!query) {
          for (const el of cards.values()) el.hidden = false;
          count.textContent = `${cards.size} tools available`;
          if (empty) empty.hidden = true;
          return;
        }

        const ranked = rankEntries(index.t, query);
        const matched = new Set(ranked.map((e) => e.s));
        for (const [slug, el] of cards) el.hidden = !matched.has(slug);
        // Reordering is why this beats hiding: the best answer moves to the top of the page
        // instead of staying wherever the alphabet put it.
        for (const entry of ranked) {
          const el = cards.get(entry.s);
          if (el) grid.appendChild(el);
        }

        count.textContent = `${ranked.length} matching tool${ranked.length === 1 ? '' : 's'}`;
        if (empty) empty.hidden = ranked.length !== 0;
        if (suggest && !ranked.length) {
          suggest.setAttribute('href', `${index.b}/feedback/?type=new&q=${encodeURIComponent(query)}`);
        }
        if (ranked.length) {
          const top = ranked[0]!;
          count.title = `Best match: ${top.n} (${entryCategory(index, top)})`;
        }
      };

      let timer: number | undefined;
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          apply(input.value);
          // Keep the address bar in step so the result set is shareable and survives a reload.
          const url = new URL(window.location.href);
          if (input.value.trim()) url.searchParams.set('q', input.value.trim());
          else url.searchParams.delete('q');
          window.history.replaceState(null, '', url);
        }, 120);
      });

      // Submitting would reload the page for a result set that is already on screen.
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        window.clearTimeout(timer);
        apply(input.value);
      });

      apply(input.value);
      // Marks the upgrade from the inline substring pass to real ranking. Tests wait on this
      // rather than a timeout, and it makes the two-stage behaviour visible when debugging.
      grid.dataset.searchReady = 'true';
    });
  }
</script>
