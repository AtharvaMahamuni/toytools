---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import ToolCard from '@components/ToolCard.astro';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { withBase } from '../lib/paths';

function getCategoryName(slug: string): string {
  return categories.find(c => c.slug === slug)?.name ?? slug;
}
---

<BaseLayout
  title={generatePageTitle('search')}
  description="Search ToyTools utilities by name, category, or tag."
  maxWidth="category"
  robots="noindex,follow"
>
  <section class="search-header">
    <h1>Search tools</h1>
    <form class="search-page-form" action={withBase('/search/')} method="get" role="search">
      <label class="sr-only" for="search-page-query">Search tools</label>
      <input id="search-page-query" type="search" name="q" placeholder="Search by name, category, or tag" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </section>

  <section class="search-results" aria-live="polite">
    <p class="result-count" id="result-count"></p>
    <div class="tool-grid" id="search-results">
      {tools.map(tool => (
        <article
          data-search-item
          data-search={`${tool.name} ${tool.description} ${tool.tags.join(' ')} ${(tool.keywords ?? []).join(' ')} ${tool.family ?? ''} ${getCategoryName(tool.categorySlug)}`.toLowerCase()}
        >
          <ToolCard tool={tool} categoryName={getCategoryName(tool.categorySlug)} />
        </article>
      ))}
    </div>
    {/* A search that finds nothing is the clearest statement of an unmet need anywhere on the
        site: someone has told us exactly what they wanted, in their own words, at the moment
        they wanted it. Carrying the query to the feedback form is the whole point. */}
    <p class="empty-state" id="empty-state" hidden>
      No matching tools found.
      <a id="empty-suggest" href={withBase('/feedback/')}>Suggest it &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .search-header {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-6);
  }

  .search-page-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--width-tool);
  }

  input,
  button {
    min-height: 52px;
    border-radius: var(--radius-md);
    font: inherit;
  }

  input {
    width: 100%;
    padding: 0 var(--space-4);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  button {
    border: var(--border-strong);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .result-count {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .empty-state {
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }

  .empty-state a {
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    margin-left: var(--space-2);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .empty-state a:hover {
    text-decoration: underline;
  }

  .empty-state a:active {
    color: var(--color-accent-strong);
  }

  @media (min-width: 720px) {
    .search-page-form {
      flex-direction: row;
    }

    button {
      min-width: 140px;
    }
  }
</style>

<script is:inline>
  var params = new URLSearchParams(window.location.search);
  var query = (params.get('q') || '').trim().toLowerCase();
  var input = document.getElementById('search-page-query');
  var count = document.getElementById('result-count');
  var empty = document.getElementById('empty-state');
  var items = Array.from(document.querySelectorAll('[data-search-item]'));

  if (input) input.value = query;

  var visible = 0;
  items.forEach(function (item) {
    var matches = !query || item.getAttribute('data-search').includes(query);
    item.hidden = !matches;
    if (matches) visible += 1;
  });

  if (count) count.textContent = query ? visible + ' matching tools' : items.length + ' tools available';
  if (empty) empty.hidden = visible !== 0;

  // Hand the unmatched query to the feedback form, which opens on "Suggest a New Tool" with
  // "what are you trying to do?" already filled in. The raw (uncased) term is used so it
  // reads back the way they typed it.
  var suggest = document.getElementById('empty-suggest');
  if (suggest) {
    var raw = (params.get('q') || '').trim();
    var href = suggest.getAttribute('href') + '?type=new';
    if (raw) href += '&q=' + encodeURIComponent(raw);
    suggest.setAttribute('href', href);
  }
</script>
