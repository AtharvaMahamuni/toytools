---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import ToolCard from '@components/ToolCard.astro';
import CategoryChips from '@components/CategoryChips.astro';
import NewBadgeExpiry from '@components/NewBadgeExpiry.astro';
import { categories } from '@data/categories';
import { tools } from '@data/registry';
import { withBase } from '../lib/paths';

function getCategoryName(slug: string): string {
  return categories.find(c => c.slug === slug)?.name ?? slug;
}

/**
 * The extra vocabulary a card needs, with everything already on screen left out.
 *
 * This page renders every tool server-side, so its HTML grows with the catalog and it is the
 * heaviest document on the site. An earlier pass removed the lowercase copy of each name and
 * description that used to ride in the attribute. What remained was the same duplication one level
 * down: tags and keywords overlap each other heavily, and a tag like "newman projection calculator"
 * repeats the tool name the card already prints.
 *
 * So the accumulator is SEEDED with the card's own visible text, and a phrase is skipped once it is
 * already a substring of what we have. Anything skipped is, by construction, still present in the
 * final haystack, so every phrase that used to match still matches: this shrinks the bytes without
 * changing a single result.
 */
function searchVocabulary(tool: (typeof tools)[number], categoryName: string): string {
  // Seed with what the card actually paints (name, tagline, category) so extras stay
  // complementary rather than duplicating the visible blurb. Description is the SEO meta
  // and is not on the card; unique description phrases still match via tags/keywords.
  const blurb = tool.tagline || tool.description;
  let haystack = `${tool.name} ${blurb} ${categoryName}`.toLowerCase();
  const extra: string[] = [];
  for (const raw of [...(tool.tags ?? []), ...(tool.keywords ?? []), tool.family ?? '']) {
    const phrase = raw.trim().toLowerCase();
    if (!phrase || haystack.includes(phrase)) continue;
    extra.push(phrase);
    haystack += ` ${phrase}`;
  }
  return extra.join(' ');
}
---

<BaseLayout
  title={generatePageTitle('search')}
  description="Search ToyTools utilities by name, category, or tag."
  maxWidth="category"
  robots="noindex,follow"
>
  <section class="search-header">
    <h1>Search tools</h1>
    <form class="search-page-form" action={withBase('/search/')} method="get" role="search">
      <label class="sr-only" for="search-page-query">Search tools</label>
      <input id="search-page-query" type="search" name="q" placeholder="Search by name, category, or tag" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </section>

  <CategoryChips allHref={withBase('/search/')} />

  <section class="search-results" aria-live="polite">
    <p class="result-count" id="result-count"></p>
    <div class="tool-grid" id="search-results">
      {tools.map(tool => (
        <article
          data-search-item
          data-slug={tool.slug}
          {/* Only the vocabulary the card does NOT already render, deduplicated against itself
              and against the card's own text. See searchVocabulary above: the inline pass below
              reads this attribute AND the card's text, and every dropped phrase survives as a
              substring, so matching is unchanged. */}
          data-search={searchVocabulary(tool, getCategoryName(tool.categorySlug))}
        >
          <ToolCard tool={tool} categoryName={getCategoryName(tool.categorySlug)} />
        </article>
      ))}
    </div>
    {/* A search that finds nothing is the clearest statement of an unmet need anywhere on the
        site: someone has told us exactly what they wanted, in their own words, at the moment
        they wanted it. Carrying the query to the feedback form is the whole point. */}
    <p class="empty-state" id="empty-state" hidden>
      No matching tools found.
      <a id="empty-suggest" href={withBase('/feedback/')}>Suggest it &rarr;</a>
    </p>
    <p class="empty-state" id="cat-empty" hidden></p>
  </section>
  <NewBadgeExpiry />
</BaseLayout>

<style>
  .search-header {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-6);
  }

  .search-page-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--width-tool);
  }

  input,
  button {
    min-height: 52px;
    border-radius: var(--radius-md);
    font: inherit;
  }

  input {
    width: 100%;
    padding: 0 var(--space-4);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  button {
    border: var(--border-strong);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-color);
  }

  .result-count {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .empty-state {
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }

  .empty-state a {
    display: inline-block;
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    margin-left: var(--space-2);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: var(--transition-color);
  }

  .empty-state a:hover {
    text-decoration: underline;
  }

  .empty-state a:active {
    color: var(--color-accent-strong);
  }

  @media (min-width: 720px) {
    .search-page-form {
      flex-direction: row;
    }

    button {
      min-width: 140px;
    }
  }
</style>

{/*
  Notes for the inline pass below. They live here, not as // comments inside it, because an
  is:inline script ships verbatim and /search/ is the heaviest HTML document on the site.
  - The card's own text carries the name, description and category; the attribute carries the
    tags, keywords and family, which are real search terms that never appear on screen.
  - Hand the unmatched query to the feedback form, which opens on "Suggest a New Tool" with
    "what are you trying to do?" already filled in. The raw (uncased) term is used so it
    reads back the way they typed it.
*/}
<script is:inline>
  var params = new URLSearchParams(window.location.search);
  var query = (params.get('q') || '').trim().toLowerCase();
  var input = document.getElementById('search-page-query');
  var count = document.getElementById('result-count');
  var empty = document.getElementById('empty-state');
  var items = Array.from(document.querySelectorAll('[data-search-item]'));

  if (input) input.value = query;

  var visible = 0;
  items.forEach(function (item) {
    var haystack = (item.getAttribute('data-search') || '') + ' ' + (item.textContent || '').toLowerCase();
    var matches = !query || haystack.includes(query);
    item.hidden = !matches;
    if (matches) visible += 1;
  });

  if (count) count.textContent = query ? visible + ' matching tools' : items.length + ' tools available';
  if (empty) empty.hidden = visible !== 0;

  var suggest = document.getElementById('empty-suggest');
  if (suggest) {
    var raw = (params.get('q') || '').trim();
    var href = suggest.getAttribute('href') + '?type=new';
    if (raw) href += '&q=' + encodeURIComponent(raw);
    suggest.setAttribute('href', href);
  }
</script>

{/*
  The inline script above is the no-network first pass: it applies ?q= immediately so a shared
  search link never flashes all 114 cards. This module then upgrades the page to the real thing:
  typing filters live (the old script only ran once, so nothing happened until you submitted),
  results REORDER by score rather than merely hiding, and aliases and typos work because it is the
  same ranking the palette uses. It imports from lib/palette so both stay on one measured chunk.
*/}
<script>
  import { loadIndex, rankCatalog, entryCategory } from '@lib/palette';
  import { announceCat } from '@lib/category-filter';

  const form = document.querySelector<HTMLFormElement>('.search-page-form');
  const input = document.getElementById('search-page-query') as HTMLInputElement | null;
  const grid = document.getElementById('search-results');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty-state');
  const suggest = document.getElementById('empty-suggest');

  if (input && grid && count) {
    // [data-search-item] and not [data-slug]: ToolCard's inner <a> carries data-slug too, so the
    // looser selector matches the anchor as well and ends up hiding that instead of the card.
    const cards = new Map<string, HTMLElement>();
    for (const el of grid.querySelectorAll<HTMLElement>('[data-search-item]')) {
      cards.set(el.dataset.slug!, el);
    }

    const chipsRoot = document.querySelector<HTMLElement>('.cat-chips');
    // The cat empty state is built here, not in the HTML: /search/ is the heaviest document.
    const catEmpty = document.getElementById('cat-empty');
    const catEmptyName = document.createElement('span');
    const catClear = document.createElement('button');
    catClear.type = 'button';
    catClear.textContent = 'Show all categories';
    catClear.addEventListener('click', () => {
      chipsRoot?.querySelector<HTMLButtonElement>('button.cat-chip[data-cat=""]')?.click();
    });
    catEmpty?.append('No ', catEmptyName, ' tools match. ', catClear);
    // Category by its URL segment, a stable id, never display text. The card's link already
    // carries it (/tool/<segment>/<slug>/) and each chip carries data-seg, so no per-card bytes.
    const segOf = (el: HTMLElement) => el.querySelector('a')?.getAttribute('href')?.split('/').at(-3) ?? '';

    let index: Awaited<ReturnType<typeof loadIndex>> = null;
    let seq = 0;
    // One pass for both stages. Before the index loads (or offline) it is the substring match the
    // inline script uses; after, the real ranking, which also reorders. The category ANDs on top.
    const apply = async (raw: string) => {
      const token = ++seq;
      const query = raw.trim();
      const seg = chipsRoot?.dataset.activeSeg ?? '';
      const catName = chipsRoot?.dataset.activeName ?? '';

      let shown: string[];
      if (!query) {
        shown = [...cards.keys()];
      } else if (!index) {
        const q = query.toLowerCase();
        shown = [...cards].filter(([, el]) =>
          ((el.dataset.search ?? '') + ' ' + (el.textContent ?? '').toLowerCase()).includes(q)).map(([s]) => s);
      } else {
        const ranked = await rankCatalog(index, query);
        if (token !== seq) return;
        shown = ranked.map((e) => e.s);
        // Reordering is why this beats hiding: the best answer moves to the top of the page
        // instead of staying wherever the alphabet put it.
        for (const slug of shown) {
          const el = cards.get(slug);
          if (el) grid.appendChild(el);
        }
        if (ranked.length) {
          const top = ranked[0]!;
          count.title = `Best match: ${top.n} (${entryCategory(index, top)})`;
        }
      }
      const matched = new Set(shown.filter((s) => !seg || segOf(cards.get(s)!) === seg));
      for (const [slug, el] of cards) el.hidden = !matched.has(slug);
      const n = matched.size;

      // #result-count sits in the results' polite live region, so this is the ONE announcement.
      count.textContent = catName
        ? announceCat(n, catName)
        : query ? `${n} matching tool${n === 1 ? '' : 's'}` : `${cards.size} tools available`;
      const none = n === 0;
      if (empty) empty.hidden = !none || !!seg;
      if (catEmpty) catEmpty.hidden = !none || !seg;
      catEmptyName.textContent = catName;
      if (suggest && none && query && index) {
        suggest.setAttribute('href', `${index.b}/feedback/?type=new&q=${encodeURIComponent(query)}`);
      }
    };

    chipsRoot?.addEventListener('cat-change', () => void apply(input.value));
    // Back and Forward restore ?q as well as ?cat: the chips re-read cat, this re-reads q. It runs
    // after the chips' own popstate listener (registered first), so its pass wins via seq.
    window.addEventListener('popstate', () => {
      input.value = new URLSearchParams(window.location.search).get('q') ?? '';
      void apply(input.value);
    });

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        void apply(input.value);
        // Keep the address bar in step so the result set is shareable and survives a reload.
        const url = new URL(window.location.href);
        if (input.value.trim()) url.searchParams.set('q', input.value.trim());
        else url.searchParams.delete('q');
        window.history.replaceState(null, '', url);
      }, 120);
    });

    // Submitting would reload the page for a result set that is already on screen.
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      window.clearTimeout(timer);
      void apply(input.value);
    });

    void apply(input.value);
    void loadIndex().then((loaded) => {
      index = loaded;
      if (!index) return; // offline: the substring stage above keeps working
      // Marks the upgrade from the substring pass to real ranking. Tests wait on this
      // rather than a timeout, and it makes the two-stage behaviour visible when debugging.
      void apply(input.value).then(() => {
        grid.dataset.searchReady = 'true';
      });
    });
  }
</script>
