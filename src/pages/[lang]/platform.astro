---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { pagePath, categoryPath } from '@lib/paths';
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { engineRegistry, knownPatterns } from '@data/engines';
import XAccountLink from '@components/XAccountLink.astro';
import { ACTIVE_LOCALES, LOCALIZED_LOCALES } from '@data/locales';
import { generateLocalizedPageTitle, getUiStrings, localizeCategory } from '@data/i18n/index';
import { pageHreflangLinks, switcherAlternatesForPath } from '@lib/i18n/registry';
import type { LocalizedLocale } from '@lib/i18n/types';

export const getStaticPaths = (() =>
  LOCALIZED_LOCALES.map(lang => ({ params: { lang }, props: { lang } }))
) satisfies GetStaticPaths;

interface Props {
  lang: LocalizedLocale;
}

const { lang } = Astro.props;
const ui = getUiStrings(lang);

const toolCount = tools.length;
const engineCount = engineRegistry.length;
const patternCount = knownPatterns.size;
const categoryCount = categories.length;
const enginesByReach = [...engineRegistry].sort(
  (a, b) => b.toolCount - a.toolCount || a.name.localeCompare(b.name),
);

const COPY: Record<LocalizedLocale, {
  description: string;
  h1: string;
  lede: string;
  stats: [string, string, string, string];
  enginesHeading: string;
  enginesIntro: string;
  guaranteesHeading: string;
  guarantees: { title: string; body: string }[];
}> = {
  es: {
    description: 'ToyTools es una plataforma unificada: motores probados, un entorno ligero en el navegador y garantías de privacidad compartidas por todas las utilidades.',
    h1: 'La plataforma detrás de las herramientas',
    lede: `Cada herramienta lleva el sello de la misma arquitectura: ${engineCount} motores compartidos, un único núcleo de navegador y verificaciones automáticas que dan soporte a las ${toolCount} herramientas.`,
    stats: ['Motores', 'Patrones', 'Categorías', 'Herramientas'],
    enginesHeading: 'Motores compartidos',
    enginesIntro: 'Cada motor concentra las fórmulas, conversiones y validaciones para todo un conjunto de herramientas.',
    guaranteesHeading: 'Garantías compartidas',
    guarantees: [
      { title: 'Cálculo local', body: 'Sin servidor de aplicaciones: tus datos permanecen en tu navegador.' },
      { title: 'Presupuestos de peso', body: 'Cada compilación verifica límites estrictos de CSS, JS y HTML.' },
      { title: 'Accesibilidad y teclado', body: 'Paleta de búsqueda, contraste AA y navegación por teclado en todo el sitio.' },
    ],
  },
  de: {
    description: 'ToyTools ist eine einheitliche Browser-Plattform aus getesteten Engines, schlanker Laufzeit und klaren Datenschutzgarantien.',
    h1: 'Die Plattform hinter den Tools',
    lede: `Alle ${toolCount} Werkzeuge basieren auf derselben Grundlage: ${engineCount} getrennte Engines, eine gemeinsame Laufzeit und automatische Budget-Prüfungen.`,
    stats: ['Engines', 'Muster', 'Kategorien', 'Tools'],
    enginesHeading: 'Geteilte Engines',
    enginesIntro: 'Jede Engine bündelt geprüfte Rechenlogik und Validierungen für eine ganze Tool-Familie.',
    guaranteesHeading: 'Gemeinsame Garantien',
    guarantees: [
      { title: 'Lokale Ausführung', body: 'Kein Anwendungsserver: Eingaben werden direkt im Browser verarbeitet.' },
      { title: 'Strenge Ladebudgets', body: 'Jeder Build prüft Obergrenzen für CSS, HTML und JavaScript.' },
      { title: 'Tastatur & Barrierefreiheit', body: 'Einheitliche Suchpalette, Kontrastwerte und Tastaturbedienung.' },
    ],
  },
  fr: {
    description: 'ToyTools repose sur une plateforme unifiée : moteurs partagés, exécution locale légère et garanties communes à chaque outil.',
    h1: 'La plateforme derrière les outils',
    lede: `Chacun des ${toolCount} outils repose sur le même socle technique : ${engineCount} moteurs testés, un noyau navigateur unique et des contrôles de budget automatisés.`,
    stats: ['Moteurs', 'Modèles', 'Catégories', 'Outils'],
    enginesHeading: 'Moteurs mutualisés',
    enginesIntro: 'Chaque moteur regroupe les algorithmes, formules et validations d\'une famille complète d\'outils.',
    guaranteesHeading: 'Garanties communes',
    guarantees: [
      { title: 'Calcul sur votre appareil', body: 'Aucun serveur applicatif : vos saisies restent dans votre navigateur.' },
      { title: 'Budgets stricts par page', body: 'La compilation vérifie les plafonds CSS, JS et HTML de chaque route.' },
      { title: 'Accessibilité & clavier', body: 'Palette de recherche rapide, contraste AA et raccourcis unifiés.' },
    ],
  },
  ja: {
    description: 'ToyToolsは共通エンジン、軽量ランタイム、端末完結のプライバシー保護を統合した単一プラットフォームです。',
    h1: 'ツールを支えるプラットフォーム設計',
    lede: `全${toolCount}ツールは同一基盤の上に構築されており、${engineCount}個の共通エンジンと自動品質チェックによって一貫性を保っています。`,
    stats: ['エンジン', 'パターン', 'カテゴリー', 'ツール'],
    enginesHeading: '共有エンジン一覧',
    enginesIntro: '各エンジンが対象分野の計算式・変換ロジック・検証処理を一括して担います。',
    guaranteesHeading: '共通の安全保証',
    guarantees: [
      { title: '端末内処理', body: 'アプリケーションサーバー不要。すべての計算はブラウザ内で完了します。' },
      { title: '厳格な容量制限', body: 'ビルド時にCSS・JS・HTMLの上限サイズを自動検証します。' },
      { title: 'アクセシビリティと操作性', body: '検索パレット、AA準拠の配色コントラスト、キーボード操作を統一しています。' },
    ],
  },
  pt: {
    description: 'ToyTools é uma plataforma unificada: motores testados, execução leve no navegador e garantias comuns de privacidade.',
    h1: 'A plataforma por trás das ferramentas',
    lede: `Cada uma das ${toolCount} ferramentas compartilha a mesma arquitetura: ${engineCount} motores independentes e verificações automáticas de desempenho.`,
    stats: ['Motores', 'Padrões', 'Categorias', 'Ferramentas'],
    enginesHeading: 'Motores compartilhados',
    enginesIntro: 'Cada motor concentra fórmulas, conversões e validações de toda uma família de utilitários.',
    guaranteesHeading: 'Garantias compartilhadas',
    guarantees: [
      { title: 'Cálculo local', body: 'Sem servidor de aplicação: seus dados permanecem no seu navegador.' },
      { title: 'Orçamentos rígidos', body: 'Cada build confere limites estritos de CSS, JS e HTML.' },
      { title: 'Acessibilidade e teclado', body: 'Busca rápida, contraste AA e atalhos padronizados em todo o site.' },
    ],
  },
  hi: {
    description: 'ToyTools एक एकीकृत प्लेटफ़ॉर्म है: प्रमाणित साझा इंजन, तेज़ ब्राउज़र रनटाइम और हर टूल में समान निजता गारंटी।',
    h1: 'इन टूल के पीछे का प्लेटफ़ॉर्म',
    lede: `सभी ${toolCount} टूल एक ही आर्किटेक्चर पर बने हैं: ${engineCount} साझा इंजन और स्वचालित गुणवत्ता जांच।`,
    stats: ['इंजन', 'पैटर्न', 'श्रेणियाँ', 'टूल'],
    enginesHeading: 'साझा इंजन',
    enginesIntro: 'प्रत्येक इंजन अपने श्रेणी के सभी टूल के लिए फ़ॉर्मूले, रूपांतरण और जांच संभालता है।',
    guaranteesHeading: 'समान सुरक्षा गारंटी',
    guarantees: [
      { title: 'स्थानीय गणना', body: 'कोई सर्वर नहीं: आपका इनपुट आपके ब्राउज़र में ही रहता है।' },
      { title: 'आकार सीमा जांच', body: 'हर बिल्ड CSS, JS और HTML के सख्त आकार बजट को सत्यापित करता है।' },
      { title: 'सुगम्यता और शॉर्टकट', body: 'तेज़ सर्च पैलेट, AA कंट्रास्ट और कीबोर्ड नेविगेशन।' },
    ],
  },
};

const c = COPY[lang];
const homeHref = pagePath('/', lang);
const abs = (path: string): string =>
  Astro.site ? new URL(path, Astro.site).href : path;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: abs(homeHref) },
    { '@type': 'ListItem', position: 2, name: ui.footer.platform },
  ],
};

const hreflangLinks = pageHreflangLinks('/platform/', Astro.site);
const switcherAlternates = switcherAlternatesForPath(loc => pagePath('/platform/', loc), ACTIVE_LOCALES);
---

<BaseLayout
  title={generateLocalizedPageTitle('platform', undefined, lang)}
  description={c.description}
  maxWidth="tool"
  lang={lang}
  hreflangLinks={hreflangLinks}
  switcherAlternates={switcherAlternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="page-doc">
    <p class="eyebrow">{ui.tool.poweredBy} <XAccountLink /></p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>

    <dl class="stat-row">
      <div class="stat"><dt>{c.stats[0]}</dt><dd>{engineCount}</dd></div>
      <div class="stat"><dt>{c.stats[1]}</dt><dd>{patternCount}</dd></div>
      <div class="stat"><dt>{c.stats[2]}</dt><dd>{categoryCount}</dd></div>
      <div class="stat"><dt>{c.stats[3]}</dt><dd>{toolCount}</dd></div>
    </dl>

    <h2>{c.enginesHeading}</h2>
    <p>{c.enginesIntro}</p>
    <ul class="engine-list">
      {enginesByReach.map(e => {
        const rawCat = categories.find(cat => cat.slug === e.category);
        const cat = rawCat ? localizeCategory(rawCat, lang) : null;
        return (
          <li>
            <strong>{e.name}</strong> ({e.toolCount})
            {cat && <> · <a href={categoryPath(cat, lang)}>{cat.name}</a></>}
          </li>
        );
      })}
    </ul>

    <h2>{c.guaranteesHeading}</h2>
    <ul>
      {c.guarantees.map(g => (
        <li><strong>{g.title}:</strong> {g.body}</li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .page-doc { padding: var(--space-10) 0 var(--space-12); }
  .eyebrow { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-subtle); margin-bottom: var(--space-2); }
  .lede { font-size: var(--text-lg); color: var(--color-text-muted); margin-top: var(--space-4); }
  .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: var(--space-4); margin: var(--space-8) 0; padding: var(--space-4); border: var(--border); border-radius: var(--radius-md); background: var(--color-surface); }
  .stat dt { font-size: var(--text-xs); color: var(--color-text-subtle); text-transform: uppercase; letter-spacing: 0.06em; }
  .stat dd { font-size: var(--text-2xl); font-weight: var(--font-weight-semibold); font-family: var(--font-mono); margin: var(--space-1) 0 0; }
  .page-doc h2 { margin-top: var(--space-10); }
  .page-doc p, .page-doc ul { margin-top: var(--space-4); line-height: var(--leading-relaxed); }
  .page-doc ul { list-style: disc; padding-left: var(--space-6); }
  .page-doc li { margin-top: var(--space-2); }
</style>
