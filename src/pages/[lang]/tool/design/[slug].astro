import type { GetStaticPaths } from 'astro';
import ToolPage from '@components/tool/ToolPage.astro';
import { localizedToolPathsForSegment } from '@lib/tools/segment-paths';
export const getStaticPaths = (() => {
  return localizedToolPathsForSegment('design');
}) satisfies GetStaticPaths;

const { tool, category, lang, pack } = Astro.props;
const widgets = import.meta.glob<{ default: unknown }>('../../../../tools/design/*/Widget.astro');
const WidgetModule = await widgets[`../../../../tools/design/${tool.slug}/Widget.astro`]?.();
const Widget = WidgetModule?.default as any;
if (!Widget) throw new Error(`No Widget.astro found for tool slug "${tool.slug}"`);
---

<ToolPage tool={tool} category={category} lang={lang} pack={pack}>
