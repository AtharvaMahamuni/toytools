---
import type { GetStaticPaths } from 'astro';
import { BRAND_NAME, siteUrl } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSearch from '@components/HeroSearch.astro';
import CategoryIndex from '@components/CategoryIndex.astro';
import NewBadgeExpiry from '@components/NewBadgeExpiry.astro';
import ToolDirectory from '@components/ToolDirectory.astro';
import CategoryChips from '@components/CategoryChips.astro';
import { tools } from '@data/registry';
import { engineRegistry, knownPatterns } from '@data/engines';
import { pagePath, withBase } from '@lib/paths';
import { ORG_ID } from '@lib/schema/identity';
import XAccountLink from '@components/XAccountLink.astro';
import { ACTIVE_LOCALES, LOCALIZED_LOCALES } from '@data/locales';
import { generateLocalizedPageTitle, getUiStrings } from '@data/i18n/index';
import { pageHreflangLinks, switcherAlternatesForPath } from '@lib/i18n/registry';
import type { LocalizedLocale } from '@lib/i18n/types';

export const getStaticPaths = (() => {
  return LOCALIZED_LOCALES.map(lang => ({
    params: { lang },
    props: { lang },
  }));
}) satisfies GetStaticPaths;

interface Props {
  lang: LocalizedLocale;
}

const { lang } = Astro.props;
const ui = getUiStrings(lang);

const HOME_COPY: Record<LocalizedLocale, {
  h1Line1: string;
  h1Line2: string;
  tagline: string;
  statTools: string;
  statPrivacy: string;
  statOffline: string;
  intro: string;
  favorites: string;
  recent: string;
  browseAll: string;
  platformSummary: string;
  platformHeading: string;
  platformLede: string;
  facts: { title: string; body: string }[];
  platformLink: string;
  mapLink: string;
}> = {
  es: {
    h1Line1: 'Calcula, convierte y formatea.',
    h1Line2: 'Directo en tu navegador.',
    tagline: 'Tu caja de herramientas web. Ábrela, resuelve la tarea al instante y cierra la pestaña.',
    statTools: `${tools.length} herramientas`,
    statPrivacy: 'Sin subir archivos',
    statOffline: 'Funciona sin conexión tras abrirse',
    intro: `Una sola plataforma con ${tools.length} puertas de acceso. Cada utilidad funciona sobre los mismos motores probados y las mismas reglas de privacidad: abre al instante, calcula en tu dispositivo y mantiene tus datos contigo sin cuentas ni registros.`,
    favorites: 'Favoritos:',
    recent: 'Recientes:',
    browseAll: `Explorar las ${tools.length} herramientas`,
    platformSummary: `Una plataforma, ${tools.length} utilidades: cómo está construida`,
    platformHeading: `No son ${tools.length} herramientas aisladas`,
    platformLede: `Es una única plataforma con ${tools.length} interfaces. La lógica vive en ${engineRegistry.length} motores compartidos para que cada mejora y validación beneficie a todo el catálogo a la vez.`,
    facts: [
      { title: `${engineRegistry.length} motores, ${knownPatterns.size} patrones`, body: 'Las fórmulas y validaciones residen en motores auditados, no duplicadas por página.' },
      { title: 'Un entorno ligero', body: 'Estado local, atajos, búsqueda y modo oscuro compartidos. Cada página descarga solo su motor.' },
      { title: 'Sin servidores intermedios', body: 'No hay base de datos ni servidor de aplicación detrás de cada cálculo. Todo corre en tu navegador.' },
      { title: 'Presupuesto de peso verificado', body: 'Cada página tiene un límite estricto de kilobytes controlado en compilación.' },
    ],
    platformLink: 'Cómo funciona la plataforma',
    mapLink: 'Ver mapa técnico',
  },
  de: {
    h1Line1: 'Rechnen, umwandeln, formatieren.',
    h1Line2: 'Direkt im Browser.',
    tagline: 'Der kompakte Werkzeugkasten im Netz. Öffnen, Aufgabe erledigen und Tab wieder schließen.',
    statTools: `${tools.length} Tools`,
    statPrivacy: 'Kein Upload Ihrer Eingaben',
    statOffline: 'Nach dem Öffnen offline nutzbar',
    intro: `Eine Plattform, ${tools.length} spezialisierte Werkzeuge. Jedes Tool nutzt dieselben geprüften Engines und Datenschutzregeln: Es startet sofort, rechnet lokal auf Ihrem Gerät und verlangt weder Konto noch Anmeldung.`,
    favorites: 'Favoriten:',
    recent: 'Zuletzt genutzt:',
    browseAll: `Alle ${tools.length} Tools durchsuchen`,
    platformSummary: `Eine Plattform, ${tools.length} Oberflächen: so ist sie aufgebaut`,
    platformHeading: `Keine ${tools.length} getrennten Einzelprogramme`,
    platformLede: `Hinter allen ${tools.length} Seiten steht eine gemeinsame Architektur mit ${engineRegistry.length} getesteten Engines, einheitlicher Bedienung und strenger lokaler Datenverarbeitung.`,
    facts: [
      { title: `${engineRegistry.length} Engines, ${knownPatterns.size} Muster`, body: 'Rechenlogik steckt zentral in getesteten Modulen statt verstreut in Einzelseiten.' },
      { title: 'Schlanke Laufzeit', body: 'Suchpalette, Tastenkürzel und Dark Mode kommen aus dem Kern; jedes Tool lädt nur seine Engine.' },
      { title: 'Keine Server-Verarbeitung', body: 'Kein Anwendungsserver und keine Datenbank im Hintergrund. Die Berechnung bleibt im Browser.' },
      { title: 'Kontrollierte Ladebudgets', body: 'Jede Seite unterliegt beim Build festen Größenlimits für CSS, HTML und JavaScript.' },
    ],
    platformLink: 'Aufbau der Plattform',
    mapLink: 'Architektur-Karte ansehen',
  },
  fr: {
    h1Line1: 'Calculez, convertissez, formatez.',
    h1Line2: 'Dans votre navigateur.',
    tagline: 'La boîte à outils du web. Ouvrez, réglez votre tâche en quelques secondes et refermez l\'onglet.',
    statTools: `${tools.length} outils`,
    statPrivacy: 'Aucun envoi vers un serveur',
    statOffline: 'Fonctionne hors ligne une fois ouvert',
    intro: `Une plateforme unique donnant accès à ${tools.length} outils ciblés. Chaque utilitaire partage les mêmes moteurs vérifiés et la même règle de confidentialité : démarrage instantané, calcul local sur votre appareil et aucun compte requis.`,
    favorites: 'Favoris :',
    recent: 'Récents :',
    browseAll: `Parcourir les ${tools.length} outils`,
    platformSummary: `Une plateforme, ${tools.length} outils : son architecture`,
    platformHeading: `Ce ne sont pas ${tools.length} sites séparés`,
    platformLede: `Une même base technique alimente les ${tools.length} outils via ${engineRegistry.length} moteurs testés, garantissant fiabilité, sobriété et respect strict des données locales.`,
    facts: [
      { title: `${engineRegistry.length} moteurs, ${knownPatterns.size} modèles`, body: 'La logique mathématique et technique est mutualisée dans des moteurs testés.' },
      { title: 'Exécution légère', body: 'Recherche, raccourcis et thème sombre sont partagés ; chaque page ne charge que son moteur.' },
      { title: 'Aucun serveur applicatif', body: 'Aucune base de données distante : vos entrées sont traitées localement dans votre navigateur.' },
      { title: 'Budgets de poids vérifiés', body: 'Chaque page respecte des plafonds stricts de CSS, HTML et JavaScript contrôlés à chaque build.' },
    ],
    platformLink: 'Découvrir la plateforme',
    mapLink: 'Voir la carte technique',
  },
  ja: {
    h1Line1: '計算・変換・整形を、',
    h1Line2: 'ブラウザですぐに。',
    tagline: '開いた瞬間に使えるWebツール箱。登録なしで作業を片付けてすぐ閉じられます。',
    statTools: `${tools.length}種類のツール`,
    statPrivacy: 'サーバー送信なし',
    statOffline: '初回読込後はオフライン対応',
    intro: `${tools.length}のツールを1つの軽量基盤で提供します。各機能は共通の検証済みエンジンと厳格なプライバシー設計で動き、アカウント不要でお使いの端末内で完結します。`,
    favorites: 'お気に入り：',
    recent: '履歴：',
    browseAll: `${tools.length}件すべてのツールを見る`,
    platformSummary: `1つの基盤に${tools.length}のツール：設計の仕組み`,
    platformHeading: `${tools.length}個のバラバラなツールではありません`,
    platformLede: `全${tools.length}ページは${engineRegistry.length}個の共通エンジンで構築されており、計算精度・操作性・データ保護を一貫して保ちます。`,
    facts: [
      { title: `${engineRegistry.length}個のエンジンと${knownPatterns.size}種のパターン`, body: '検証済みの計算ロジックを各ページで重複なく共有しています。' },
      { title: '軽量ランタイム', body: '検索パレットやダークモードを共有しつつ、必要な機能だけを読み込みます。' },
      { title: 'アプリケーションサーバー不要', body: 'バックエンドDBを使わず、すべてお使いのブラウザ上で処理します。' },
      { title: '厳格な容量バジェット', body: 'ビルドごとに全ページのCSS・JS・HTML容量上限を自動検査します。' },
    ],
    platformLink: 'プラットフォームの仕組み',
    mapLink: '技術マップを見る',
  },
  pt: {
    h1Line1: 'Calcule, converta e formate.',
    h1Line2: 'Direto no navegador.',
    tagline: 'Sua caixa de ferramentas na web. Abra, resolva na hora e feche a aba.',
    statTools: `${tools.length} ferramentas`,
    statPrivacy: 'Sem envio de arquivos',
    statOffline: 'Funciona offline após abrir',
    intro: `Uma única plataforma com ${tools.length} portas de entrada. Cada utilitário usa os mesmos motores auditados e regras estritas de privacidade: abre rápido, processa no seu aparelho e dispensa cadastro.`,
    favorites: 'Favoritos:',
    recent: 'Recentes:',
    browseAll: `Explorar todas as ${tools.length} ferramentas`,
    platformSummary: `Uma plataforma, ${tools.length} utilitários: como funciona`,
    platformHeading: `Não são ${tools.length} sites isolados`,
    platformLede: `Toda a experiência das ${tools.length} ferramentas nasce de ${engineRegistry.length} motores compartilhados, garantindo consistência e rapidez.`,
    facts: [
      { title: `${engineRegistry.length} motores e ${knownPatterns.size} padrões`, body: 'Fórmulas e validações residem em motores testados, não duplicadas por página.' },
      { title: 'Ambiente enxuto', body: 'Busca rápida, atalhos e tema escuro compartilhados; cada rota baixa só o essencial.' },
      { title: 'Sem servidor intermediário', body: 'Não há banco de dados remoto: o processamento fica no seu navegador.' },
      { title: 'Orçamento de bytes verificado', body: 'Cada página passa por limites rígidos de CSS, JS e HTML no build.' },
    ],
    platformLink: 'Conhecer a plataforma',
    mapLink: 'Ver mapa técnico',
  },
  hi: {
    h1Line1: 'गणना, रूपांतरण और फॉर्मेटिंग।',
    h1Line2: 'सीधे आपके ब्राउज़र में।',
    tagline: 'तुरंत काम पूरा करने वाला वेब टूलबॉक्स। खोलें, काम करें और टैब बंद कर दें।',
    statTools: `${tools.length} टूल`,
    statPrivacy: 'कोई डेटा अपलोड नहीं',
    statOffline: 'खुलने के बाद ऑफ़लाइन भी चलता है',
    intro: `एक ही हल्के प्लेटफ़ॉर्म पर ${tools.length} उपयोगी टूल। हर टूल जाँचे हुए साझा इंजन और सख्त निजता नियमों पर चलता है ताकि आपका डेटा हमेशा आपके डिवाइस पर रहे।`,
    favorites: 'पसंदीदा:',
    recent: 'हाल में उपयोग किए:',
    browseAll: `सभी ${tools.length} टूल देखें`,
    platformSummary: `एक प्लेटफ़ॉर्म, ${tools.length} टूल: निर्माण संरचना`,
    platformHeading: `${tools.length} अलग-अलग बिखरे टूल नहीं`,
    platformLede: `सभी ${tools.length} पेज ${engineRegistry.length} साझा इंजनों पर चलते हैं, जिससे हर सुधार और सत्यापन एक साथ पूरे कैटलॉग को बेहतर बनाता है।`,
    facts: [
      { title: `${engineRegistry.length} इंजन और ${knownPatterns.size} पैटर्न`, body: 'गणना और सत्यापन एक ही प्रमाणित कोडबेस में रहते हैं।' },
      { title: 'हल्का रनटाइम', body: 'खोज, कीबोर्ड शॉर्टकट और डार्क थीम साझा हैं; हर पेज केवल जरूरी कोड लोड करता है।' },
      { title: 'कोई सर्वर प्रोसेसिंग नहीं', body: 'न कोई डेटाबेस और न कोई बैकएंड: पूरा काम आपके ब्राउज़र में होता है।' },
      { title: 'सख्त आकार सीमा', body: 'बिल्ड के दौरान हर पेज के CSS, HTML और JS आकार की जाँच होती है।' },
    ],
    platformLink: 'प्लेटफ़ॉर्म कैसे काम करता है',
    mapLink: 'तकनीकी मानचित्र देखें',
  },
};

const copy = HOME_COPY[lang];
const siteHref = siteUrl(Astro.site).href;
const homeHref = pagePath('/', lang);
const homeAbs = new URL(homeHref, siteHref).href;
const searchBaseAbs = new URL(pagePath('/search/', lang), siteHref).href;
const hreflangLinks = pageHreflangLinks('/', Astro.site);
const switcherAlternates = switcherAlternatesForPath(loc => pagePath('/', loc), ACTIVE_LOCALES);
---

<BaseLayout
  title={generateLocalizedPageTitle('home', undefined, lang)}
  description={ui.home.description}
  maxWidth="shell"
  lang={lang}
  hreflangLinks={hreflangLinks}
  switcherAlternates={switcherAlternates}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: BRAND_NAME,
    url: homeAbs,
    inLanguage: lang,
    description: ui.home.description,
    publisher: { '@id': ORG_ID },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${searchBaseAbs}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  })} />

  <section class="hero">
    <h1>{copy.h1Line1}<br class="h1-break" /> {copy.h1Line2}</h1>
    <p class="hero-tagline">{copy.tagline}</p>
    <HeroSearch lang={lang} />
    <p class="hero-sub">
      <span>{copy.statTools}</span>
      <span aria-hidden="true">·</span>
      <span>{copy.statPrivacy}</span>
      <span aria-hidden="true">·</span>
      <span>{copy.statOffline}</span>
    </p>
  </section>

  <p class="hero-intro">{copy.intro}</p>

  <p class="recent-row" id="favorite-row" hidden>
    <span class="recent-label">{copy.favorites}</span>
    <span id="favorite-chips"></span>
  </p>

  <p class="recent-row" id="recent-row" hidden>
    <span class="recent-label">{copy.recent}</span>
    <span id="recent-chips"></span>
  </p>

  <section class="section">
    <CategoryIndex lang={lang} />
  </section>

  <details class="all-tools">
    <summary class="all-tools-summary">{copy.browseAll}</summary>
    <div class="all-tools-body">
      <CategoryChips allHref={homeHref} target="dir" lang={lang} />
      <ToolDirectory lang={lang} />
    </div>
  </details>

  <details class="platform-strip">
    <summary class="platform-summary">
      <span class="strip-eyebrow-inline">{ui.tool.poweredBy}</span>
      <span class="platform-summary-text">{copy.platformSummary}</span>
    </summary>
    <div class="platform-body" aria-labelledby="platform-heading">
      <p class="strip-eyebrow">{ui.tool.poweredBy} <XAccountLink /></p>
      <h2 id="platform-heading">{copy.platformHeading}</h2>
      <p class="strip-lede">{copy.platformLede}</p>
      <ul class="strip-facts">
        {copy.facts.map(f => (
          <li>
            <strong>{f.title}</strong>
            <span>{f.body}</span>
          </li>
        ))}
      </ul>
      <p class="strip-links">
        <a href={pagePath('/platform/', lang)}>{copy.platformLink}</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/architecture/')}>{copy.mapLink}</a>
      </p>
    </div>
  </details>

  <script is:inline>
    (function () {
      function findLink(slug) {
        var direct = document.querySelector('.dir-link[data-slug="' + slug + '"]');
        if (direct) return direct;
        var groups = document.querySelectorAll('.dir-link[data-group-slugs]');
        for (var i = 0; i < groups.length; i++) {
          var slugs = (groups[i].getAttribute('data-group-slugs') || '').split(',');
          if (slugs.indexOf(slug) !== -1) return groups[i];
        }
        return null;
      }

      function renderRow(slugs, chipsId, rowId, limit) {
        var chips = document.getElementById(chipsId);
        var row = document.getElementById(rowId);
        if (!chips || !row || !slugs.length) return;

        var added = 0;
        var seen = {};
        slugs.forEach(function (slug) {
          if (added >= limit || !slug) return;
          var link = findLink(slug);
          if (!link || seen[link.getAttribute('href')]) return;
          seen[link.getAttribute('href')] = true;
          if (added > 0) {
            var sep = document.createElement('span');
            sep.className = 'recent-sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '·';
            chips.appendChild(sep);
          }
          var a = link.cloneNode(true);
          a.className = 'recent-chip';
          chips.appendChild(a);
          added++;
        });
        if (added > 0) row.hidden = false;
      }

      var TT = window.ToyTools;
      var favorites = (TT && TT.favorites) ? TT.favorites.list() : [];
      var recent = (TT && TT.getRecent) ? TT.getRecent() : [];

      renderRow(favorites, 'favorite-chips', 'favorite-row', 6);
      renderRow(
        recent.map(function (e) { return e && e.slug; }).filter(function (slug) {
          return slug && favorites.indexOf(slug) === -1;
        }),
        'recent-chips', 'recent-row', 5
      );
    })();
  </script>
  <NewBadgeExpiry />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-12) 0;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-20);
    }
  }

  .hero h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.72px;
    margin: 0;
    line-height: var(--leading-tight);
    max-width: 22ch;
    color: var(--color-text);
  }

  .h1-break { display: none; }
  @media (min-width: 640px) { .h1-break { display: inline; } }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--color-text-muted);
    max-width: 44ch;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .hero-intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8);
  }

  .hero-sub {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin: 0;
  }

  .recent-row[hidden] { display: none; }
  .recent-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-8);
    max-width: unset;
  }
  .recent-label { color: var(--color-text-subtle); }
  .recent-row :global(.recent-chip) {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
  }
  .recent-row :global(.recent-chip:hover) { color: var(--color-text); text-decoration: underline; }
  .recent-row :global(.recent-sep) { color: var(--color-text-subtle); margin-inline: var(--space-1); user-select: none; }

  .platform-strip {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    border-top: var(--border);
  }
  .platform-summary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-height: var(--touch-target);
    cursor: pointer;
    list-style: none;
    transition: var(--transition-color);
  }
  .platform-summary::-webkit-details-marker { display: none; }
  .platform-summary:hover .platform-summary-text { color: var(--color-text); }
  .strip-eyebrow-inline {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }
  .platform-summary-text { font-size: var(--text-sm); color: var(--color-text-muted); }
  .platform-body { padding-top: var(--space-6); }
  .strip-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-2);
  }
  .strip-eyebrow :global(.x-account) { margin-left: var(--space-2); }
  .platform-strip h2 { margin: 0; }
  .strip-lede { margin: var(--space-3) 0 0; color: var(--color-text-muted); line-height: var(--leading-relaxed); }
  .strip-facts { list-style: none; padding: 0; margin: var(--space-8) 0 0; display: grid; gap: var(--space-6); }
  @media (min-width: 640px) {
    .strip-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); }
