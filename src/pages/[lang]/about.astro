---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { pagePath, withBase } from '@lib/paths';
import { tools } from '@data/registry';
import { categories } from '@data/categories';
import { engineRegistry } from '@data/engines';
import { ACTIVE_LOCALES, LOCALIZED_LOCALES } from '@data/locales';
import { generateLocalizedPageTitle } from '@data/i18n/index';
import { pageHreflangLinks, switcherAlternatesForPath } from '@lib/i18n/registry';
import type { LocalizedLocale } from '@lib/i18n/types';

export const getStaticPaths = (() =>
  LOCALIZED_LOCALES.map(lang => ({ params: { lang }, props: { lang } }))
) satisfies GetStaticPaths;

interface Props {
  lang: LocalizedLocale;
}

const { lang } = Astro.props;
const toolCount = tools.length;
const categoryCount = categories.length;
const guideCount = tools.filter(t => t.guide !== undefined).length;
const engineCount = engineRegistry.length;

const COPY: Record<LocalizedLocale, {
  description: string;
  h1: string;
  s1Title: string;
  s1p1: string;
  s1p2: string;
  s2Title: string;
  s2p1: string;
  s2p2: string;
  s3Title: string;
  s3p1: string;
  s3p2: string;
  s4Title: string;
  s4p1: string;
  s4p2: string;
  s4Link: string;
  s5Title: string;
  links: { label: string; href: string; desc: string }[];
}> = {
  es: {
    description: 'ToyTools es una caja de herramientas web rápida y ligera ejecutada en una plataforma local en tu navegador. Sin cuentas, sin subidas y sin servidores.',
    h1: 'Acerca de ToyTools',
    s1Title: 'Qué es',
    s1p1: 'La imagen de una caja de herramientas define el estándar. Abres un cajón, tomas la utilidad exacta que resuelve la tarea y la cierras. Nada pregunta quién eres ni exige veinte minutos de configuración.',
    s1p2: `Son ${toolCount} utilidades en ${categoryCount} categorías: contar y limpiar texto, convertir y codificar datos, calcular fechas y finanzas, además de simulaciones interactivas de física y matemáticas. ${guideCount} de ellas incluyen una guía escrita para comprender el fondo técnico.`,
    s2Title: 'Una plataforma, no una carpeta suelta',
    s2p1: `Debajo de cada página hay una única arquitectura. La lógica vive en ${engineCount} motores compartidos y probados de forma independiente. La interfaz, los atajos de teclado, el soporte sin conexión y el contrato de privacidad pertenecen a la plataforma.`,
    s2p2: 'Por eso una corrección mejora todas las herramientas de un motor a la vez, la utilidad número cien es tan rápida como la primera y cada página lleva el sello Con tecnología de ToyTools.',
    s3Title: 'Cómo funciona',
    s3p1: 'Cada motor corre en tu navegador. No hay servidor de aplicaciones, ni base de datos ni cuentas de usuario: una calculadora o un contador de palabras no necesita recibir tus textos ni tus cifras privadas.',
    s3p2: 'El sitio se compila de forma estática con presupuestos estrictos de tamaño por página para que abra rápido incluso en redes móviles y funcione sin conexión una vez visitado.',
    s4Title: 'Cómo se eligen las herramientas',
    s4p1: 'A partir de necesidades reales con respuesta determinista y verificable: conversiones, conteos, cálculos y simulaciones visuales.',
    s4p2: 'Lo más útil que puedes enviarnos es un problema recurrente que estés resolviendo a mano.',
    s4Link: 'Cuéntanos qué intentabas resolver',
    s5Title: 'Otros enlaces del sitio',
    links: [
      { label: 'Plataforma', href: pagePath('/platform/', 'es'), desc: 'los motores, el entorno de ejecución y las garantías compartidas.' },
      { label: 'Arquitectura', href: withBase('/architecture/'), desc: 'mapa técnico interactivo generado desde el propio catálogo.' },
      { label: 'Cambios', href: withBase('/changelog/'), desc: 'novedades registradas versión por versión.' },
      { label: 'Privacidad', href: pagePath('/privacy/', 'es'), desc: 'qué se guarda en tu dispositivo y qué nunca sale de él.' },
      { label: 'Ajustes', href: withBase('/settings/'), desc: 'exportar, importar o borrar tus datos locales.' },
    ],
  },
  de: {
    description: 'ToyTools ist ein schneller, schlanker Werkzeugkasten auf einer gemeinsamen Browser-Plattform. Ohne Konto, ohne Upload und ohne Anwendungsserver.',
    h1: 'Über ToyTools',
    s1Title: 'Was ToyTools ist',
    s1p1: 'Ein Werkzeugkasten setzt den Maßstab: Öffnen, das passende Werkzeug nehmen, die Aufgabe lösen und wieder schließen. Keine Registrierung, keine Ablenkung.',
    s1p2: `Aktuell umfasst der Katalog ${toolCount} Werkzeuge in ${categoryCount} Kategorien: Textanalyse, Datenkonvertierung, Finanz- und Datumsrechnung sowie interaktive Physik- und Mathematik-Simulationen. ${guideCount} Tools bringen zusätzlich einen ausführlichen Ratgeber mit.`,
    s2Title: 'Eine Plattform statt loser Einzeldateien',
    s2p1: `Hinter den Seiten arbeitet ein einheitliches System. Die Logik steckt in ${engineCount} unabhängig getesteten Engines; Oberfläche, Tastenkürzel, Offline-Fähigkeit und Datenschutzvertrag stammen aus demselben Kern.`,
    s2p2: 'Dadurch greift jede Fehlerbehebung sofort für alle Tools einer Engine, und neue Werkzeuge bleiben genauso schnell wie die ersten.',
    s3Title: 'Wie es funktioniert',
    s3p1: 'Jede Engine läuft direkt in Ihrem Browser. Es gibt keinen Anwendungsserver und keine Datenbank. Textzähler oder Gehaltsrechner brauchen Ihre Eingaben nicht an Dritte zu übertragen.',
    s3p2: 'Die gesamte Website wird statisch erzeugt und prüft beim Build strenge Byte-Limits je Seite.',
    s4Title: 'Wie neue Tools entstehen',
    s4p1: 'Aus konkreten Alltagsaufgaben mit exakter, überprüfbarer Antwort: Umrechnungen, Berechnungen, Formatierungen und Simulationen.',
    s4p2: 'Wenn sich eine wiederkehrende Aufgabe nur umständlich von Hand lösen lässt, freuen wir uns über Hinweise.',
    s4Link: 'Beschreiben Sie Ihr Anwendungsproblem',
    s5Title: 'Weitere Seiten',
    links: [
      { label: 'Plattform', href: pagePath('/platform/', 'de'), desc: 'Engines, Laufzeit und gemeinsame Garantien.' },
      { label: 'Architektur', href: withBase('/architecture/'), desc: 'interaktive Strukturkarte des gesamten Katalogs.' },
      { label: 'Changelog', href: withBase('/changelog/'), desc: 'alle Änderungen je Version.' },
      { label: 'Datenschutz', href: pagePath('/privacy/', 'de'), desc: 'was lokal gespeichert wird und was Ihr Gerät nie verlässt.' },
      { label: 'Einstellungen', href: withBase('/settings/'), desc: 'lokale Daten exportieren, importieren oder löschen.' },
    ],
  },
  fr: {
    description: 'ToyTools est une boîte à outils web rapide et légère exécutée localement dans votre navigateur. Sans compte, sans envoi de données et sans serveur applicatif.',
    h1: 'À propos de ToyTools',
    s1Title: 'Ce que c\'est',
    s1p1: 'Une vraie boîte à outils reste la meilleure référence : ouvrir un tiroir, utiliser l\'instrument exact et refermer l\'onglet. Aucune inscription ni configuration superflue.',
    s1p2: `Le catalogue rassemble ${toolCount} utilitaires dans ${categoryCount} catégories : analyse de texte, formatage et encodage, calculs financiers et temporels ainsi que simulations interactives. ${guideCount} d\'entre eux s\'accompagnent d\'un guide détaillé.`,
    s2Title: 'Une plateforme unifiée',
    s2p1: `Sous chaque page se trouve une architecture commune : ${engineCount} moteurs testés séparément portent la logique, tandis que l\'interface, les raccourcis et la confidentialité appartiennent au socle.`,
    s2p2: 'Une amélioration de moteur bénéficie immédiatement à tous les outils associés, sans alourdir le chargement.',
    s3Title: 'Fonctionnement technique',
    s3p1: 'Tout s\'exécute dans votre navigateur sans serveur applicatif ni base de données. Vos textes, chiffres ou jetons ne sont jamais transmis.',
    s3p2: 'Le site est généré statiquement avec des budgets stricts par page vérifiés à chaque compilation.',
    s4Title: 'Choix des outils',
    s4p1: 'Nous construisons des outils déterministes pour les tâches qui appellent une réponse exacte : conversions, comptages, calculs et simulations.',
    s4p2: 'Le retour le plus utile reste la description d\'un besoin concret que vous faites encore à la main.',
    s4Link: 'Décrire un besoin',
    s5Title: 'Autres rubriques',
    links: [
      { label: 'Plateforme', href: pagePath('/platform/', 'fr'), desc: 'les moteurs, le socle et les garanties communes.' },
      { label: 'Architecture', href: withBase('/architecture/'), desc: 'carte interactive générée depuis le catalogue.' },
      { label: 'Nouveautés', href: withBase('/changelog/'), desc: 'journal des versions.' },
      { label: 'Confidentialité', href: pagePath('/privacy/', 'fr'), desc: 'ce qui reste sur votre appareil et ce qui est mesuré.' },
      { label: 'Paramètres', href: withBase('/settings/'), desc: 'exporter, importer ou effacer vos données locales.' },
    ],
  },
  ja: {
    description: 'ToyToolsはお使いのブラウザ上で完結する高速・軽量なツール集です。登録やデータアップロードは不要です。',
    h1: 'ToyToolsについて',
    s1Title: 'サービス概要',
    s1p1: '実際の工具箱のように、必要なツールをさっと取り出して用事を済ませ、すぐ閉じられるシンプルさを目指しています。アカウント登録や長い設定画面はありません。',
    s1p2: `${categoryCount}カテゴリー・${toolCount}本のツールを収録し、テキスト解析、開発用データ整形、日付・金融計算、物理・数学シミュレーションを提供します。${guideCount}本には解説ガイドも併設しています。`,
    s2Title: '共通プラットフォーム設計',
    s2p1: `各ページの背後にはテスト済みの${engineCount}個の共通エンジンがあり、UI・キーボード操作・オフライン対応・プライバシー設計を一元化しています。`,
    s2p2: 'エンジンを改善すれば関連ツール全体が同時に向上し、ツール数が増えても軽快さを損ないません。',
    s3Title: '動作の仕組み',
    s3p1: '計算や変換はすべてブラウザ内で実行され、アプリケーションサーバーやデータベースに入力内容を送信しません。',
    s3p2: '静的生成とビルド時の容量バジェット検査により、モバイル回線でも軽快に開き、読込後はオフラインでも動作します。',
    s4Title: 'ツールの追加基準',
    s4p1: '決定的で検証可能な計算・変換・計測・シミュレーションのうち、日常的に繰り返される作業を対象としています。',
    s4p2: '手作業で繰り返している困りごとがあればぜひお寄せください。',
    s4Link: 'ご要望を送る',
    s5Title: '関連ページ',
    links: [
      { label: 'プラットフォーム', href: pagePath('/platform/', 'ja'), desc: 'エンジン構造と共通の安全保証。' },
      { label: '設計マップ', href: withBase('/architecture/'), desc: '全ツールの接続関係を示すインタラクティブ図。' },
      { label: '更新履歴', href: withBase('/changelog/'), desc: 'バージョンごとの変更記録。' },
      { label: 'プライバシー', href: pagePath('/privacy/', 'ja'), desc: '端末内に保存される内容と送信されない内容。' },
      { label: '設定', href: withBase('/settings/'), desc: 'ローカルデータのエクスポート・削除。' },
    ],
  },
  pt: {
    description: 'ToyTools é uma caixa de ferramentas web rápida executada no seu navegador. Sem contas, sem uploads e sem servidor de aplicação.',
    h1: 'Sobre o ToyTools',
    s1Title: 'O que é',
    s1p1: 'Uma caixa de ferramentas real dita o padrão: abrir, pegar o instrumento certo para a tarefa e fechar a aba sem cadastros nem distrações.',
    s1p2: `São ${toolCount} utilitários em ${categoryCount} categorias: texto, conversão de dados, datas, finanças e simulações interativas de física e matemática. ${guideCount} deles incluem guias técnicos completos.`,
    s2Title: 'Uma plataforma única',
    s2p1: `Por trás de cada página existe uma base única: a lógica vive em ${engineCount} motores compartilhados e testados separadamente, garantindo rapidez e consistência.`,
    s2p2: 'Cada melhoria em um motor beneficia todas as ferramentas associadas ao mesmo tempo.',
    s3Title: 'Como funciona',
    s3p1: 'Tudo roda no navegador. Não há servidor de aplicação nem banco de dados recebendo seus textos ou valores.',
    s3p2: 'O site é compilado estaticamente com orçamentos rígidos de tamanho por página e funciona offline após o carregamento.',
    s4Title: 'Critério de novos utilitários',
    s4p1: 'Problemas reais com resposta exata e verificável: conversões, contagens, cálculos e simulações.',
    s4p2: 'O retorno mais útil que você pode enviar é descrever uma tarefa repetitiva feita manualmente.',
    s4Link: 'Conte o que você precisa resolver',
    s5Title: 'Outros links do site',
    links: [
      { label: 'Plataforma', href: pagePath('/platform/', 'pt'), desc: 'motores, execução e garantias compartilhadas.' },
      { label: 'Arquitetura', href: withBase('/architecture/'), desc: 'mapa técnico gerado a partir do catálogo.' },
      { label: 'Mudanças', href: withBase('/changelog/'), desc: 'novidades registradas por versão.' },
      { label: 'Privacidade', href: pagePath('/privacy/', 'pt'), desc: 'o que fica no seu aparelho e o que nunca sai dele.' },
      { label: 'Configurações', href: withBase('/settings/'), desc: 'exportar, importar ou apagar seus dados locais.' },
    ],
  },
  hi: {
    description: 'ToyTools आपके ब्राउज़र में चलने वाला तेज़ और हल्का वेब टूलबॉक्स है। कोई खाता नहीं, कोई अपलोड नहीं और कोई बैकएंड सर्वर नहीं।',
    h1: 'ToyTools के बारे में',
    s1Title: 'यह क्या है',
    s1p1: 'असली टूलबॉक्स की तरह, आप सही टूल खोलते हैं, काम पूरा करते हैं और बिना किसी साइन-अप या झंझट के टैब बंद कर देते हैं।',
    s1p2: `इसमें ${categoryCount} श्रेणियों में ${toolCount} टूल हैं: टेक्स्ट विश्लेषण, डेटा रूपांतरण, तारीख व वित्त गणना और इंटरैक्टिव भौतिकी व गणित सिमुलेशन। इनमें से ${guideCount} के साथ विस्तृत गाइड भी उपलब्ध हैं।`,
    s2Title: 'एक एकीकृत प्लेटफ़ॉर्म',
    s2p1: `हर पेज के पीछे ${engineCount} परीक्षण किए गए साझा इंजन काम करते हैं, ताकि इंटरफ़ेस, शॉर्टकट और निजता एक समान रहें।`,
    s2p2: 'किसी इंजन में सुधार होते ही उससे जुड़े सभी टूल एक साथ बेहतर और तेज़ बनते हैं।',
    s3Title: 'तकनीकी कार्यप्रणाली',
    s3p1: 'सभी गणनाएँ आपके ब्राउज़र में चलती हैं। आपके टेक्स्ट या नंबर किसी बाहरी सर्वर या डेटाबेस तक नहीं जाते।',
    s3p2: 'साइट को सख्त पेज-आकार बजट के साथ स्टैटिक रूप से बनाया जाता है ताकि मोबाइल नेटवर्क पर भी तेज़ी से खुले।',
    s4Title: 'नए टूल का चयन',
    s4p1: 'ऐसे वास्तविक कार्य जिनका उत्तर सटीक और जांचने योग्य हो: रूपांतरण, गिनती, गणना और सिमुलेशन।',
    s4p2: 'यदि कोई दोहराया जाने वाला काम आपको बार-बार हाथ से करना पड़ता है, तो हमें बताएँ।',
    s4Link: 'अपनी आवश्यकता साझा करें',
    s5Title: 'साइट के अन्य लिंक',
    links: [
      { label: 'प्लेटफ़ॉर्म', href: pagePath('/platform/', 'hi'), desc: 'साझा इंजन और सुरक्षा गारंटी।' },
      { label: 'आर्किटेक्चर', href: withBase('/architecture/'), desc: 'कैटलॉग का इंटरैक्टिव तकनीकी मानचित्र।' },
      { label: 'अपडेट लॉग', href: withBase('/changelog/'), desc: 'हर संस्करण के बदलावों का विवरण।' },
      { label: 'गोपनीयता', href: pagePath('/privacy/', 'hi'), desc: 'क्या आपके डिवाइस पर रहता है और क्या कभी बाहर नहीं जाता।' },
      { label: 'सेटिंग्स', href: withBase('/settings/'), desc: 'स्थानीय डेटा एक्सपोर्ट या डिलीट करें।' },
    ],
  },
};

const c = COPY[lang];
const hreflangLinks = pageHreflangLinks('/about/', Astro.site);
const switcherAlternates = switcherAlternatesForPath(loc => pagePath('/about/', loc), ACTIVE_LOCALES);
---

<BaseLayout
  title={generateLocalizedPageTitle('about', undefined, lang)}
  description={c.description}
  maxWidth="tool"
  lang={lang}
  hreflangLinks={hreflangLinks}
  switcherAlternates={switcherAlternates}
>
  <article class="page-doc">
    <h1>{c.h1}</h1>
    <p class="lede">{c.description}</p>

    <h2>{c.s1Title}</h2>
    <p>{c.s1p1}</p>
    <p>{c.s1p2}</p>

    <h2>{c.s2Title}</h2>
    <p>{c.s2p1}</p>
    <p>{c.s2p2}</p>

    <h2>{c.s3Title}</h2>
    <p>{c.s3p1}</p>
    <p>{c.s3p2}</p>

    <h2>{c.s4Title}</h2>
    <p>{c.s4p1}</p>
    <p>{c.s4p2} <a href={pagePath('/feedback/', lang)}>{c.s4Link}</a>.</p>

    <h2>{c.s5Title}</h2>
    <ul>
      {c.links.map(l => (
        <li><a href={l.href}>{l.label}</a>: {l.desc}</li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .page-doc { padding: var(--space-10) 0 var(--space-12); }
  .lede { font-size: var(--text-lg); color: var(--color-text-muted); margin-top: var(--space-4); }
  .page-doc h2 { margin-top: var(--space-12); }
  .page-doc p, .page-doc ul { margin-top: var(--space-4); line-height: var(--leading-relaxed); }
  .page-doc ul { list-style: disc; padding-left: var(--space-6); }
  .page-doc li { margin-top: var(--space-2); }
</style>
