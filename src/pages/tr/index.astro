---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Türkçe')}
  description="ToyTools — ücretsiz, gizli, tarayıcı tabanlı günlük araçlar. Kayıt gerekmez, takip yok."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Ücretsiz, gizli, tarayıcı tabanlı günlük araçlar.</p>
    <a href={withBase('/')}>Tüm araçlara göz at →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
