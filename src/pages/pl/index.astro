---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Polski')}
  description="ToyTools — bezpłatne, prywatne narzędzia przeglądarkowe do codziennych zadań. Bez rejestracji, bez śledzenia."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Bezpłatne, prywatne narzędzia przeglądarkowe do codziennych zadań.</p>
    <a href={withBase('/')}>Przeglądaj wszystkie narzędzia →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
