---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'ภาษาไทย')}
  description="ToyTools — เครื่องมือบนเบราว์เซอร์ที่ฟรีและเป็นส่วนตัวสำหรับงานประจำวัน ไม่ต้องสมัคร ไม่มีการติดตาม"
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>เครื่องมือบนเบราว์เซอร์ที่ฟรีและเป็นส่วนตัวสำหรับงานประจำวัน</p>
    <a href={withBase('/')}>ดูเครื่องมือทั้งหมด →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
