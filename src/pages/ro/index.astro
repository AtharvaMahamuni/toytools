---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Română')}
  description="ToyTools — instrumente gratuite, private, bazate pe browser pentru sarcinile zilnice. Fără înregistrare, fără urmărire."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Instrumente gratuite, private, bazate pe browser pentru sarcinile zilnice.</p>
    <a href={withBase('/')}>Răsfoiți toate instrumentele →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
