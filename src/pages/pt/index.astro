---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Português')}
  description="ToyTools — ferramentas gratuitas, privadas e no navegador para o dia a dia. Sem cadastro, sem rastreamento."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Ferramentas gratuitas, privadas e no navegador para o dia a dia.</p>
    <a href={withBase('/')}>Ver todas as ferramentas →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
