---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', 'Suomi')}
  description="ToyTools — ilmaiset, yksityiset, selainpohjaiset työkalut päivittäisiin tehtäviin. Ei rekisteröitymistä, ei seurantaa."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>Ilmaiset, yksityiset, selainpohjaiset työkalut päivittäisiin tehtäviin.</p>
    <a href={withBase('/')}>Selaa kaikkia työkaluja →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
