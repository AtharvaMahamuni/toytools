---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../lib/titles';
import { categories } from '@data/categories';
import { engineRegistry } from '@data/engines';
import { tools } from '@data/registry';
import { graph } from '@lib/knowledge/graph';
import { RELATION_TYPES } from '@lib/knowledge/types';
import { toolPath } from '../lib/paths';

const catId = (slug: string) => `cat_${slug.replace(/-/g, '_')}`;
const engId = (id: string) => `eng_${id.replace(/-/g, '_')}`;

const segmentFor = (categorySlug: string) =>
  categories.find(c => c.slug === categorySlug)?.segment ?? categorySlug;

function engineFile(sharedWidget: string): string | undefined {
  if (sharedWidget === 'SimulationWidget.astro') return 'src/lib/simulation/';
  if (sharedWidget) return `src/tools/_shared/${sharedWidget}`;
  return undefined;
}

function noun(n: number, one: string, many: string): string {
  return `${n} ${n === 1 ? one : many}`;
}

function engineBlurb(toolCount: number, sharedWidget: string): string {
  const share = toolCount === 1 ? 'shares' : 'share';
  if (sharedWidget === 'SimulationWidget.astro') {
    return `${noun(toolCount, 'simulation', 'simulations')} ${share} the canvas runtime. Each page loads its one model and leaves the rest of this engine unloaded.`;
  }
  if (sharedWidget) {
    return `${noun(toolCount, 'tool', 'tools')} ${share} ${sharedWidget}. A new tool on this engine is configuration. The widget and the resolver stay with the engine.`;
  }
  return `${noun(toolCount, 'tool', 'tools')} ${share} this engine's subject and runtime. Each one draws its own widget.`;
}

// Same derivation as scripts/check-engines.ts. Keep the two in step.
const slugToEngine = new Map(tools.map(t => [t.slug, t.engine]));
const CROSS_TYPES = new Set<string>([
  RELATION_TYPES.RELATED_TOOL,
  RELATION_TYPES.USED_WITH,
  RELATION_TYPES.ALTERNATIVE,
  RELATION_TYPES.NEXT_STEP,
]);
const slugOf = (nodeId: string) => nodeId.slice(nodeId.indexOf(':') + 1);

const pairCounts = new Map<string, number>(); // "engA|engB" (sorted) → count
for (const e of graph.edges) {
  if (!CROSS_TYPES.has(e.type)) continue;
  if (!e.from.startsWith('tool:') || !e.to.startsWith('tool:')) continue;
  const a = slugToEngine.get(slugOf(e.from));
  const b = slugToEngine.get(slugOf(e.to));
  if (!a || !b || a === b) continue;
  const key = [a, b].sort().join('|');
  pairCounts.set(key, (pairCounts.get(key) ?? 0) + 1);
}

const relatedEngines = new Map<string, Array<{ engine: string; count: number }>>();
for (const [key, count] of pairCounts) {
  const [a, b] = key.split('|');
  (relatedEngines.get(a) ?? relatedEngines.set(a, []).get(a)!).push({ engine: b, count });
  (relatedEngines.get(b) ?? relatedEngines.set(b, []).get(b)!).push({ engine: a, count });
}

const relatedCount = (id: string) => (relatedEngines.get(id) ?? []).length;

const infra = [
  ['infra_registry', 'Registry'],
  ['infra_runtime', 'Runtime'],
  ['infra_knowledge', 'Knowledge Graph'],
  ['infra_intel', 'Content Intelligence'],
  ['infra_sitemap', 'Sitemap'],
] as const;

interface NodeInfo {
  kind: 'platform' | 'category' | 'engine' | 'infra';
  title: string;
  subtitle?: string;
  description: string;
  file?: string;
  chips?: string[];
  tools?: Array<{ name: string; url: string }>;
  related?: Array<{ id: string; label: string }>;
}
const nodeInfo: Record<string, NodeInfo> = {};

nodeInfo.platform = {
  kind: 'platform',
  title: 'ToyTools Platform',
  subtitle: 'Data-driven static site',
  description:
    'A pre-rendered Astro site with no server, database, or client framework. Everything below is ' +
    'derived from registries at build time: Categories own Engines, Engines own Tools.',
  chips: [`${categories.length} categories`, `${engineRegistry.length} engines`, `${tools.length} tools`],
};

const INFRA_INFO: Record<string, NodeInfo> = {
  infra_registry: {
    kind: 'infra', title: 'Registry', file: 'src/data/*.generated.ts',
    description: 'Tools live in src/tools/<segment>/<slug>/. The barrels under src/data/ are generated ' +
      'from those directories. Pages, search, sitemaps and this page read the result.',
  },
  infra_runtime: {
    kind: 'infra', title: 'ToyToolsRuntime', file: 'src/lib/runtime/',
    description: 'Shared helpers (toast, copy, storage, state) ship with every page. Each engine ' +
      'loads only on the pages that declare it, and attaches the ToyTools names that engine provides.',
  },
  infra_knowledge: {
    kind: 'infra', title: 'Knowledge Graph', file: 'src/lib/knowledge/',
    description: 'Related tools, guides and FAQs come from engine, pattern, family and category, plus ' +
      'authored edges (used with, alternatives, next steps). Related engines on this page are those ' +
      'edges counted across engines.',
  },
  infra_intel: {
    kind: 'infra', title: 'Content Intelligence', file: 'src/lib/content-intelligence/',
    description: 'Coverage report from npm run intel: gaps, category health and a roadmap, written to ' +
      'dist/content-intelligence/. It is not part of the site build.',
  },
  infra_sitemap: {
    kind: 'infra', title: 'Sitemap', file: 'src/pages/sitemaps/',
    description: 'Index of tools, guides, categories and standalone pages, derived from the registry. ' +
      'A new tool is included on its own.',
  },
};
Object.assign(nodeInfo, INFRA_INFO);

const engineNameOf = (id: string) => engineRegistry.find(e => e.id === id)?.name ?? id;

for (const cat of categories) {
  nodeInfo[catId(cat.slug)] = {
    kind: 'category',
    title: cat.name,
    subtitle: cat.engines.length
      ? `${noun(cat.toolCount, 'tool', 'tools')} · ${noun(cat.engines.length, 'engine', 'engines')}`
      : noun(cat.toolCount, 'tool', 'tools'),
    description: cat.description,
    file: 'src/data/categories.ts',
    chips: cat.engines.map(engineNameOf),
    related: cat.engines.map(e => ({ id: engId(e), label: engineNameOf(e) })),
    tools: cat.engines.length
      ? undefined
      : tools
          .filter(t => t.categorySlug === cat.slug)
          .map(t => ({ name: t.name, url: toolPath({ slug: t.slug, segment: segmentFor(t.categorySlug) }) })),
  };

  for (const eng of engineRegistry.filter(e => e.category === cat.slug)) {
    const engTools = tools
      .filter(t => t.engine === eng.id)
      .map(t => ({ name: t.name, url: toolPath({ slug: t.slug, segment: segmentFor(t.categorySlug) }) }));
    const chips = [
      ...eng.patterns.map(p => `pattern: ${p}`),
      ...eng.supportedFamilies.map(f => `family: ${f}`),
    ];
    if (eng.runtimeGlobal) chips.push(`ToyTools.${eng.runtimeGlobal}()`);
    nodeInfo[engId(eng.id)] = {
      kind: 'engine',
      title: eng.name,
      subtitle: `${cat.name} · ${noun(eng.toolCount, 'tool', 'tools')}`,
      description: engineBlurb(eng.toolCount, eng.sharedWidget),
      file: engineFile(eng.sharedWidget),
      chips,
      tools: engTools,
      related: (relatedEngines.get(eng.id) ?? [])
        .sort((a, b) => b.count - a.count)
        .map(r => ({ id: engId(r.engine), label: `${engineNameOf(r.engine)} · ${r.count} link${r.count === 1 ? '' : 's'}` })),
    };
  }
}

const description = 'How ToyTools is put together: categories, engines, tools, and the layers they share. Generated from the registries.';
---

<BaseLayout
  title={generatePageTitle('architecture')}
  description={description}
  maxWidth="full"
  robots="noindex,follow"
>
  <section class="arch-head">
    <h1>Architecture</h1>
    <p>Categories own engines. Engines own tools. Pick one to read where it lives.</p>
  </section>

  <div class="arch-grid">
    <div class="arch-map">
      <h2 class="arch-kicker">Platform</h2>
      <section class="arch-block">
        <button type="button" data-node="platform">
          <span class="arch-name">ToyTools Platform</span>
          <span class="arch-meta">{tools.length} tools</span>
        </button>
        <ul>
          {infra.map(([id, label]) => (
            <li><button type="button" data-node={id}>{label}</button></li>
          ))}
        </ul>
      </section>

      <h2 class="arch-kicker">Catalog</h2>
      {categories.map(cat => (
        <section class="arch-cat" style={`--swatch:${cat.accent}`}>
          <h3>
            <button type="button" data-node={catId(cat.slug)}>
              <span class="swatch" aria-hidden="true"></span>
              <span class="arch-name">{cat.name}</span>
              <span class="arch-meta">{cat.toolCount}</span>
            </button>
          </h3>
          {engineRegistry.some(e => e.category === cat.slug) && (
            <ul>
              {engineRegistry.filter(e => e.category === cat.slug).map(eng => {
                const links = relatedCount(eng.id);
                return (
                  <li>
                    <button type="button" data-node={engId(eng.id)}>
                      <span class="arch-name">{eng.name}</span>
                      <span class="arch-meta">
                        <span>{eng.toolCount}</span>
                        {links > 0 && <span>{links} related</span>}
                      </span>
                    </button>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))}
    </div>

    <aside id="arch-panel" class="arch-panel" aria-live="polite">
      <div class="arch-panel__empty">
        <h2>Pick a layer or an engine</h2>
        <p>The panel names the file it lives in. An engine lists every tool it powers and which other engines it connects to.</p>
      </div>
    </aside>
  </div>

  <script type="application/json" id="arch-data" set:html={JSON.stringify(nodeInfo)}></script>
  <script>
  type NodeInfo = {
    kind: string; title: string; subtitle?: string; description: string;
    file?: string; chips?: string[];
    tools?: Array<{ name: string; url: string }>;
    related?: Array<{ id: string; label: string }>;
  };

  const data: Record<string, NodeInfo> = JSON.parse(
    document.getElementById('arch-data')?.textContent || '{}',
  );
  const panel = document.getElementById('arch-panel')!;
  const phone = window.matchMedia('(max-width: 1023px)');

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function markSelected(id: string) {
    document.querySelectorAll<HTMLButtonElement>('.arch-map button[data-node]').forEach(btn => {
      btn.setAttribute('aria-pressed', btn.dataset.node === id ? 'true' : 'false');
    });
  }

  function renderPanel(id: string) {
    const info = data[id];
    if (!info) return;
    markSelected(id);
    const parts: string[] = [];
    parts.push(`<div class="arch-panel__kind">${esc(info.kind)}</div>`);
    parts.push(`<h2>${esc(info.title)}</h2>`);
    if (info.subtitle) parts.push(`<p class="arch-panel__sub">${esc(info.subtitle)}</p>`);
    parts.push(`<p>${esc(info.description)}</p>`);
    if (info.file) parts.push(`<p class="arch-panel__file"><code>${esc(info.file)}</code></p>`);
    if (info.chips?.length) {
      parts.push('<ul class="arch-chips">' +
        info.chips.map(c => `<li>${esc(c)}</li>`).join('') + '</ul>');
    }
    if (info.tools?.length) {
      parts.push(`<h3>Tools (${info.tools.length})</h3>`);
      parts.push('<ul class="arch-links">' +
        info.tools.map(t => `<li><a href="${esc(t.url)}">${esc(t.name)}</a></li>`).join('') + '</ul>');
    }
    if (info.related?.length) {
      const heading = info.kind === 'category' ? 'Engines' : 'Related engines';
      parts.push(`<h3>${heading}</h3>`);
      parts.push('<ul class="arch-links">' +
        info.related.map(r => `<li><button type="button" data-node="${esc(r.id)}">${esc(r.label)}</button></li>`).join('') + '</ul>');
    }
    panel.innerHTML = `<div class="arch-panel__body">${parts.join('')}</div>`;
    panel.querySelectorAll<HTMLButtonElement>('button[data-node]').forEach(btn =>
      btn.addEventListener('click', () => renderPanel(btn.dataset.node!)),
    );
    panel.scrollTop = 0;
    if (phone.matches) panel.scrollIntoView({ block: 'start' });
  }

  document.querySelector('.arch-map')?.addEventListener('click', (event) => {
    const btn = (event.target as Element).closest('button[data-node]');
    if (btn instanceof HTMLButtonElement && btn.dataset.node) renderPanel(btn.dataset.node);
  });
  </script>
</BaseLayout>

<style is:global>
  .arch-head { margin-bottom: var(--space-6); }
  .arch-head h1 { margin: 0 0 var(--space-2); }
  .arch-head p { color: var(--color-text-muted); max-width: var(--width-prose); }

  .arch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  .arch-map, .arch-panel { min-width: 0; }
  .arch-panel { order: -1; }
  @media (min-width: 1024px) {
    .arch-grid { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; }
    .arch-panel { order: 0; }
  }

  .arch-kicker {
    margin: var(--space-8) 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .arch-map > .arch-kicker:first-child { margin-top: 0; }

  .arch-block,
  .arch-cat {
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .arch-cat {
    margin-top: var(--space-8);
    border-left: 3px solid var(--swatch);
  }
  .arch-block ul,
  .arch-cat ul { list-style: none; margin: 0; padding: 0; }
  .arch-cat h3 { margin: 0; font-size: inherit; font-weight: inherit; }

  .arch-map button {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    text-align: left;
    font-size: var(--text-sm);
    color: var(--color-text);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .arch-name { flex: 1 1 8rem; min-width: 0; }
  .arch-map button:active,
  .arch-map button[aria-pressed="true"] {
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }
  .arch-map button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .arch-meta {
    margin-left: auto;
    display: flex;
    gap: var(--space-3);
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  .arch-map button[aria-pressed="true"] .arch-meta { color: inherit; }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--swatch);
    flex: none;
  }

  .arch-panel {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    scroll-margin-top: calc(var(--touch-target) + var(--space-6));
  }
  @media (min-width: 1024px) {
    .arch-panel {
      position: sticky;
      top: calc(var(--touch-target) + var(--space-6));
      max-height: calc(100vh - var(--touch-target) - var(--space-8));
      overflow: auto;
    }
  }
  .arch-panel h2 { margin: var(--space-1) 0 0; font-size: var(--text-xl); }
  .arch-panel h3 { margin: var(--space-4) 0 var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .arch-panel p { color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.55; max-width: none; }
  .arch-panel__empty h2 { font-size: var(--text-lg); }
  .arch-panel__kind {
    text-transform: uppercase; letter-spacing: 0.08em;
    font-size: var(--text-xs); color: var(--color-accent); font-weight: 600;
  }
  .arch-panel__sub { font-weight: 600; color: var(--color-text) !important; margin: var(--space-1) 0 var(--space-3); }
  .arch-panel__file code { font-size: var(--text-xs); word-break: break-all; }

  .arch-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .arch-chips li {
    font-size: var(--text-xs); font-family: var(--font-mono);
    padding: 2px 8px; border-radius: 999px;
    background: var(--color-surface-hover); border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .arch-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .arch-links a, .arch-links button {
    display: block; width: 100%; text-align: left;
    font-size: var(--text-sm); color: var(--color-accent);
    background: none; border: none; padding: var(--space-1) 0; cursor: pointer;
    min-height: var(--touch-target);
  }
  .arch-links a:hover, .arch-links button:hover,
  .arch-links a:active, .arch-links button:active { text-decoration: underline; }
  .arch-links button:focus-visible, .arch-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
