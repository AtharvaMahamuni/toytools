---
import type { GetStaticPaths } from 'astro';
import FAQLayout from '@layouts/FAQLayout.astro';
import { toolsWithFaq }   from '@data/registry';
import { faqsByToolSlug } from '@data/faq-registry';
import { categories }     from '@data/categories';

export const getStaticPaths = (() => {
  return toolsWithFaq.map(tool => {
    const faq      = tool.faq!;
    const category = categories.find(c => c.slug === tool.categorySlug)!;
    const items    = faqsByToolSlug[tool.slug] ?? [];
    return {
      params: { slug: `${faq.categorySlug}/${faq.slug}` },
      props:  { tool, category, items },
    };
  });
}) satisfies GetStaticPaths;

const { tool, category, items } = Astro.props;
---

<FAQLayout
  title={`${tool.name} FAQ`}
  description={tool.faq!.description ?? `Answers to common questions about ${tool.name.toLowerCase()}.`}
  toolSlug={tool.slug}
  toolName={tool.name}
  toolCategorySlug={tool.categorySlug}
  items={items}
  entry={tool}
/>
