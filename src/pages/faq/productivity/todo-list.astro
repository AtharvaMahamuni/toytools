---
import FAQLayout from '@layouts/FAQLayout.astro';
import { toolFAQs } from '@data/faqs';
import { ecosystem } from '@data/ecosystem';

const items = toolFAQs['todo-list']!;
const entry = ecosystem['todo-list']!;
---

<FAQLayout
  title="Todo List FAQ"
  description="Answers to common questions about task lists, subtasks, productivity, and organization."
  toolSlug="todo-list"
  toolName="Todo List"
  toolCategorySlug="productivity"
  items={items}
  entry={entry}
/>
