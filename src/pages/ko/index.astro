---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generatePageTitle } from '../../lib/titles';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title={generatePageTitle('language', '한국어')}
  description="ToyTools — 무료, 비공개, 브라우저 기반의 일상 도구. 회원가입 없음, 추적 없음."
  maxWidth="tool"
  robots="noindex,follow"
>
  <div class="lang-stub">
    <h1>ToyTools</h1>
    <p>무료, 비공개, 브라우저 기반의 일상 도구.</p>
    <a href={withBase('/')}>모든 도구 보기 →</a>
  </div>
</BaseLayout>

<style>
  .lang-stub {
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
