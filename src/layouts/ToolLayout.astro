---
import BaseLayout from './BaseLayout.astro';
import { generatePageTitle } from '@lib/titles';
import ToolIdentity from '@components/tool/ToolIdentity.astro';
import ToolBar from '@components/tool/ToolBar.astro';
import FeedbackCapture from '@components/feedback/FeedbackCapture.astro';
import { iconColors } from '@lib/icons/tool-icon';
import { APPLE_TOUCH_SIZE } from '@lib/icons/sizes';
import type { Tool, Category } from '@data/types';
import { withBase } from '../lib/paths';

interface Props {
  tool: Tool;
  category: Category;
}

const { tool, category } = Astro.props;

// Per-tool install metadata — lets this tool be added to the home screen as its
// own app (manifest + maskable icon + theme colour), all derived from the registry.
const pwa = {
  manifestUrl: withBase(`/manifest/${tool.slug}.webmanifest`),
  // iOS ignores SVG for the home-screen icon, so apple-touch-icon points at a PNG.
  iconUrl: withBase(`/icons/tool/${tool.slug}-${APPLE_TOUCH_SIZE}.png`),
  themeColor: iconColors(tool).accent,
  title: tool.name,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: category.name, item: Astro.site ? new URL(withBase(`/category/${category.slug}/`), Astro.site).href : withBase(`/category/${category.slug}/`) },
    { '@type': 'ListItem', position: 3, name: tool.name },
  ],
};

// `dateModified` and `publisher` were absent until 2026-08-17, which left the tool page — the page
// that carries the head term — as the only page type on the site with no recency or authorship
// signal at all. Guides had both. `tool.updatedAt` is already ISO on all 107 configs and was
// simply unused here. No `aggregateRating`: we have no ratings, and inventing them is fabricated
// structured data.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.description,
  url: Astro.url.href,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(tool.updatedAt ? { dateModified: tool.updatedAt } : {}),
  publisher: { '@type': 'Organization', name: 'ToyTools' },
};
---

<BaseLayout title={generatePageTitle('tool', tool.seoTitle ?? tool.name)} description={tool.description} maxWidth="shell" pwa={pwa} engines={[tool.engine]} feedbackTool={tool.slug}>
  <ToolBar slot="header" tool={tool} />

  {/* The BreadcrumbList JSON-LD stays even though the visible trail is gone: Google builds SERP
      breadcrumbs from this, not from the markup, so removing the on-page trail costs nothing in
      search. The link to the category hub moves to Zone C. */}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <ToolIdentity tool={tool} />

  {/* Zone B (ToolSignature) is rendered by ToolPage, not here. This slot holds the widget, the
      nav row AND the knowledge drawers, so anything placed after it lands at the bottom of the
      page rather than under the tool. */}
  <slot />

  {/* Binds to the footer's feedback link. Emitted only where allowsInputCapture says the input
      cannot be a secret; that decision is made at build time, never at runtime. */}
  <FeedbackCapture tool={tool} />

  <script is:inline define:vars={{ slug: tool.slug, segment: category.segment }}>
    if (window.ToyTools && ToyTools.recordRecent) ToyTools.recordRecent(slug, segment);
  </script>
</BaseLayout>

