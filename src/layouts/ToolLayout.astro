---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import type { Tool, Category } from '@data/types';
import { withBase } from '../lib/paths';

interface Props {
  tool: Tool;
  category: Category;
}

const { tool, category } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: category.name, item: Astro.site ? new URL(withBase(`/categories/${category.slug}/`), Astro.site).href : withBase(`/categories/${category.slug}/`) },
    { '@type': 'ListItem', position: 3, name: tool.name },
  ],
};
---

<BaseLayout title={tool.seoTitle ?? tool.name} description={tool.description} maxWidth="tool">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tool-header">
    <Breadcrumb items={[
      { label: 'Home', href: withBase('/') },
      { label: category.name, href: withBase(`/categories/${category.slug}/`) },
      { label: tool.name },
    ]} />
    <h1>{tool.name}</h1>
    <p class="tool-description">{tool.description}</p>
  </div>

  <slot name="inputs" />
  <slot name="action" />
  <slot name="result" />
  <slot name="explanation" />
  <slot name="faq" />
  <slot name="related" />
</BaseLayout>

<style>
  .tool-header {
    padding-bottom: var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-3);
  }

  .tool-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 55ch;
  }
</style>
