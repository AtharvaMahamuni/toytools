---
import BaseLayout from './BaseLayout.astro';
import { generatePageTitle } from '@lib/titles';
import TrustNotice from '@components/tool/TrustNotice.astro';
import InstallButton from '@tools/_shared/InstallButton.astro';
import ToolIdentity from '@components/tool/ToolIdentity.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import FeedbackLink from '@components/feedback/FeedbackLink.astro';
import { iconColors } from '@lib/icons/tool-icon';
import { APPLE_TOUCH_SIZE } from '@lib/icons/sizes';
import type { Tool, Category } from '@data/types';
import { withBase } from '../lib/paths';

interface Props {
  tool: Tool;
  category: Category;
}

const { tool, category } = Astro.props;

// Per-tool install metadata — lets this tool be added to the home screen as its
// own app (manifest + maskable icon + theme colour), all derived from the registry.
const pwa = {
  manifestUrl: withBase(`/manifest/${tool.slug}.webmanifest`),
  // iOS ignores SVG for the home-screen icon, so apple-touch-icon points at a PNG.
  iconUrl: withBase(`/icons/tool/${tool.slug}-${APPLE_TOUCH_SIZE}.png`),
  themeColor: iconColors(tool).accent,
  title: tool.name,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: category.name, item: Astro.site ? new URL(withBase(`/category/${category.slug}/`), Astro.site).href : withBase(`/category/${category.slug}/`) },
    { '@type': 'ListItem', position: 3, name: tool.name },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.description,
  url: Astro.url.href,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout title={generatePageTitle('tool', tool.seoTitle ?? tool.name)} description={tool.description} maxWidth="shell" pwa={pwa} engines={[tool.engine]}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  {/* The BreadcrumbList schema above has always been emitted here with no visible counterpart.
      Guides and category pages already render this component; tool pages now match.

      The star shares this row rather than taking one of its own. On the health calculators the
      answer and its chart are required to land above the fold (tests/e2e/health.spec.ts), and a
      second 48px row spent that budget: giving the star the empty right half of a row already
      being drawn costs nothing extra. */}
  <Breadcrumb
    items={[
      { label: 'Home', href: withBase('/') },
      { label: category.name, href: withBase(`/category/${category.slug}/`) },
      { label: tool.name },
    ]}
  />

  <ToolIdentity tool={tool} />

  <slot />

  {/* Zone B. Trust, installation and the platform's signature all sit BELOW the tool now.
      Above the title they cost 100-150px of a 727px phone screen and pushed the tool itself
      past the fold; below it they read as attribution on a finished thing, which is also the
      right relationship: ToyTools is the infrastructure, the tool is the product. */}
  <div class="tool-signature">
    <TrustNotice variant={tool.trustVariant ?? 'private'} />
    <InstallButton toolName={tool.name} />
  </div>

  {/* Last thing on every tool page, below the widget, the nav row, and the FAQ. Auto-included
      here so every tool inherits it and no tool file ever mentions feedback. */}
  <FeedbackLink tool={tool} />

  <script is:inline define:vars={{ slug: tool.slug, segment: category.segment }}>
    if (window.ToyTools && ToyTools.recordRecent) ToyTools.recordRecent(slug, segment);
  </script>
</BaseLayout>

<style>
  /* Zone B: one row, below the tool. Wraps on a narrow phone rather than forcing a horizontal
     scroll. The install button is mobile-only, so on desktop this is just the trust line. */
  .tool-signature {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }
</style>
