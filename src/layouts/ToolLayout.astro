---
import BaseLayout from './BaseLayout.astro';
import { generatePageTitle } from '@lib/titles';
import Breadcrumb from '@components/Breadcrumb.astro';
import BackButton from '@components/BackButton.astro';
import type { Tool, Category } from '@data/types';
import { withBase } from '../lib/paths';

interface Props {
  tool: Tool;
  category: Category;
}

const { tool, category } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: category.name, item: Astro.site ? new URL(withBase(`/categories/${category.slug}/`), Astro.site).href : withBase(`/categories/${category.slug}/`) },
    { '@type': 'ListItem', position: 3, name: tool.name },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.description,
  url: Astro.url.href,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout title={generatePageTitle('tool', tool.seoTitle ?? tool.name)} description={tool.description} maxWidth="tool">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-header">
    <Breadcrumb items={[
      { label: 'Home', href: withBase('/') },
      { label: category.name, href: withBase(`/categories/${category.slug}/`) },
      { label: tool.name },
    ]} />
    <BackButton />
    <h1>{tool.name}</h1>
    <p class="tool-description">{tool.description}</p>
  </div>

  <slot />
</BaseLayout>

<style>
  .tool-header {
    padding-bottom: var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-3);
  }

  .tool-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 55ch;
  }
</style>
