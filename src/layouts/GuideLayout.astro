---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import type { EcosystemEntry } from '@data/types';
import { categories } from '@data/categories';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  toolSlug: string;
  toolName: string;
  toolCategorySlug: string;
  entry: EcosystemEntry;
}

const {
  title,
  description,
  readMinutes,
  updatedAt,
  toolSlug,
  toolName,
  toolCategorySlug,
  entry,
} = Astro.props;

const category = categories.find(c => c.slug === toolCategorySlug);
const toolCategorySegment = category?.segment ?? toolCategorySlug;
const toolCategoryName = category?.name ?? toolCategorySlug;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: toolCategoryName, item: Astro.site ? new URL(withBase(`/categories/${toolCategorySlug}/`), Astro.site).href : withBase(`/categories/${toolCategorySlug}/`) },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  dateModified: updatedAt,
  author: { '@type': 'Organization', name: 'ToyTools' },
};
---

<BaseLayout
  title={`${title} — Complete Reference Guide`}
  description={description}
  maxWidth="category"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="guide-header">
    <p class="guide-label"><span class="gold-dot" aria-hidden="true"></span> Reference Guide</p>
    <Breadcrumb items={[
      { label: 'Home', href: withBase('/') },
      { label: toolCategoryName, href: withBase(`/categories/${toolCategorySlug}/`) },
      { label: title },
    ]} />
    <h1>{title}</h1>
    <p class="guide-description">{description}</p>
    <p class="guide-meta">
      {readMinutes} min read
      <span class="gold-dot" aria-hidden="true"></span>
      Updated {updatedAt}
    </p>
  </div>

  <div class="guide-body">
    <aside class="toc-column" aria-label="Table of contents">
      <!-- Mobile: collapsible -->
      <details class="toc-mobile">
        <summary class="toc-summary"><span class="gold-dot toc-dot" aria-hidden="true"></span> Contents</summary>
        <ul id="toc-list-mobile" class="toc-list"></ul>
      </details>
      <!-- Desktop: sticky -->
      <nav class="toc-desktop" aria-label="Table of contents">
        <p class="toc-heading">Contents</p>
        <ul id="toc-list-desktop" class="toc-list"></ul>
      </nav>
    </aside>

    <div class="guide-content">
      <slot />
    </div>
  </div>

  <EcosystemLinks
    currentType="guide"
    toolSlug={toolSlug}
    toolCategorySegment={toolCategorySegment}
    toolName={toolName}
    entry={entry}
  />
</BaseLayout>

<style>
  /* ── Guide header ─────────────────────────────────────────── */

  .guide-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    border-bottom: var(--border);
    margin-bottom: var(--space-12);
  }

  .guide-label {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    max-width: unset;
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .guide-description {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 55ch;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .guide-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin-top: var(--space-2);
  }

  /* ── Two-column body ──────────────────────────────────────── */

  .guide-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-12);
  }

  @media (max-width: 900px) {
    .guide-body {
      grid-template-columns: 1fr;
    }
  }

  /* ── TOC column ───────────────────────────────────────────── */

  .toc-desktop {
    position: sticky;
    top: calc(var(--touch-target) + var(--space-4) + var(--space-4));
    display: block;
    padding-right: var(--space-4);
  }

  @media (max-width: 900px) {
    .toc-desktop {
      display: none;
    }
  }

  .toc-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-3);
    max-width: unset;
  }

  /* ── TOC — mobile ─────────────────────────────────────────── */

  .toc-mobile {
    display: none;
    border: var(--border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .toc-mobile {
      display: block;
    }
  }

  .toc-summary {
    list-style: none;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    background: var(--color-bg-tertiary);
    color: var(--color-text-muted);
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile[open] .toc-summary {
    border-bottom: var(--border);
  }

  .toc-mobile .toc-list {
    padding: var(--space-3) var(--space-4);
  }

  .toc-dot {
    flex-shrink: 0;
  }

  /* ── TOC list shared ──────────────────────────────────────── */

  :global(.toc-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  :global(.toc-list li) {
    border-left: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  :global(.toc-list li:has(a[aria-current])) {
    border-left-color: var(--color-gold);
  }

  :global(.toc-list a) {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
    line-height: var(--leading-relaxed);
  }

  :global(.toc-list a:hover) {
    color: var(--color-text);
    text-decoration: none;
  }

  :global(.toc-list a[aria-current]) {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  /* ── Guide content sections ───────────────────────────────── */

  :global(.guide-content section) {
    padding-block: var(--space-12);
    border-bottom: var(--border);
  }

  :global(.guide-content section:last-child) {
    border-bottom: none;
    padding-bottom: var(--space-6);
  }

  :global(.guide-content h2) {
    margin-bottom: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: -0.01em;
  }

  :global(.guide-content p) {
    max-width: 70ch;
  }

  :global(.guide-content p + p) {
    margin-top: var(--space-5);
  }

  :global(.guide-content ul) {
    list-style: disc;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-5);
    max-width: 70ch;
  }

  :global(.guide-content li) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  :global(.guide-content .encoding-example) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-tertiary);
    border: var(--border);
    border-radius: var(--radius-md);
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    max-width: unset;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var sections = document.querySelectorAll('.guide-content section[id]');
    var listM = document.getElementById('toc-list-mobile');
    var listD = document.getElementById('toc-list-desktop');

    /* Build TOC entries */
    sections.forEach(function (sec) {
      var h2 = sec.querySelector('h2');
      if (!h2) return;
      var text = h2.textContent.replace(/[●•·]/g, '').trim();
      [listM, listD].forEach(function (ul) {
        if (!ul) return;
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + sec.id;
        a.textContent = text;
        li.appendChild(a);
        ul.appendChild(li);
      });
    });

    /* Highlight active section as page scrolls */
    if ('IntersectionObserver' in window && sections.length > 0) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var id = e.target.id;
          document.querySelectorAll('#toc-list-desktop a, #toc-list-mobile a').forEach(function (a) {
            a.removeAttribute('aria-current');
          });
          document.querySelectorAll(
            '#toc-list-desktop a[href="#' + id + '"], #toc-list-mobile a[href="#' + id + '"]'
          ).forEach(function (a) {
            a.setAttribute('aria-current', 'true');
          });
        });
      }, { rootMargin: '-15% 0% -70% 0%' });

      sections.forEach(function (s) { io.observe(s); });
    }
  });
</script>
