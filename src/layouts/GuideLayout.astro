---
import BaseLayout from './BaseLayout.astro';
import { generateLocalizedPageTitle, getUiStrings, localizeCategory } from '@data/i18n/index';
import Breadcrumb from '@components/Breadcrumb.astro';
import BackButton from '@components/BackButton.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import RelatedContent from '@components/knowledge/RelatedContent.astro';
import YouMayAlsoNeed from '@components/knowledge/YouMayAlsoNeed.astro';
import ContinueLearning from '@components/knowledge/ContinueLearning.astro';
import type { EcosystemEntry } from '@data/types';
import { categories } from '@data/categories';
import { formatMonthYear } from '@lib/dates';
import { canonicalFor, categoryPath, guidePath, pagePath } from '../lib/paths';
import { privacyStatement, withPrivacy } from '@lib/privacy';
import { tools } from '@data/registry';
import { orgRef, personRef } from '@lib/schema/identity';
import { guidePublishedAt } from '@data/guide-published';
import { getLocaleConfig, type LocaleCode } from '@data/locales';
import {
  availableLocalesForGuide,
  guideHreflangLinks,
  localizeTool,
  switcherAlternatesForPath,
} from '@lib/i18n/registry';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  toolSlug: string;
  toolName: string;
  toolCategorySlug: string;
  entry: EcosystemEntry;
  lang?: LocaleCode;
}

const {
  title,
  description,
  readMinutes,
  updatedAt,
  toolSlug,
  toolName,
  toolCategorySlug,
  entry,
  lang = 'en',
} = Astro.props;

const t = getUiStrings(lang);
const localeCfg = getLocaleConfig(lang);
const rawCategory = categories.find(c => c.slug === toolCategorySlug);
const category = rawCategory ? localizeCategory(rawCategory, lang) : undefined;
const toolCategorySegment = rawCategory?.segment ?? toolCategorySlug;
const toolCategoryName = category?.name ?? toolCategorySlug;

const fullTool = tools.find((item) => item.slug === toolSlug);
const localizedTool = fullTool ? localizeTool(fullTool, lang) : null;
const availableLocales = fullTool?.guide ? availableLocalesForGuide(toolSlug) : ['en' as LocaleCode];
const hreflangLinks = fullTool?.guide ? guideHreflangLinks(fullTool, Astro.site) : [];
const switcherAlternates = fullTool?.guide
  ? switcherAlternatesForPath(
      (loc) => guidePath({ categorySlug: fullTool.guide!.categorySlug, slug: fullTool.guide!.slug }, loc),
      availableLocales,
    )
  : [];

const homeHref = pagePath('/', lang);
const homeAbs = Astro.site ? new URL(homeHref, Astro.site).href : homeHref;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: homeAbs },
    { '@type': 'ListItem', position: 2, name: toolCategoryName, item: canonicalFor({ kind: 'category', slug: toolCategorySlug }, Astro.site, lang) },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

// `updatedAt` is ISO 8601 (see GuideConfig.updatedAt). It goes to the schema verbatim, because that
// is the only shape Google parses, and reaches the visitor through formatMonthYear below.
const updatedDisplay = lang === 'en'
  ? formatMonthYear(updatedAt)
  : new Intl.DateTimeFormat(localeCfg.intlLocale, { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(updatedAt));

// datePublished is the day the guide first shipped (src/data/guide-published.ts). It used to be
// `updatedAt`, so every rewrite claimed the article was brand new. validate-registry keeps every
// guide in that map and never later than `updatedAt`; the fallback only covers a scaffold mid-edit.
const publishedAt = guidePublishedAt[toolSlug] ?? updatedAt;
// The guide speaks for its tool, so a lookup tool's guide carries the lookup privacy statement.
const guideVariant = fullTool?.trustVariant;
const localizedPrivacy = lang === 'en'
  ? privacyStatement(guideVariant)
  : t.footer.privacyByVariant[guideVariant ?? 'private'];

const tocLabels: Record<LocaleCode, string> = {
  en: 'Contents',
  es: 'Contenido',
  de: 'Inhalt',
  fr: 'Sommaire',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: lang === 'en' ? withPrivacy(description, guideVariant) : `${description} ${localizedPrivacy}`.trim(),
  datePublished: publishedAt <= updatedAt ? publishedAt : updatedAt,
  dateModified: updatedAt,
  url: Astro.url.href,
  inLanguage: lang,
  author: personRef(),
  publisher: orgRef(),
};
---

<BaseLayout
  title={generateLocalizedPageTitle('guide', title, lang)}
  description={description}
  maxWidth="content"
  lang={lang}
  hreflangLinks={hreflangLinks}
  switcherAlternates={switcherAlternates}
  privacyLine={localizedPrivacy}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="guide-header">
    <Breadcrumb items={[
      { label: t.nav.home, href: homeHref },
      { label: toolCategoryName, href: categoryPath({ slug: toolCategorySlug }, lang) },
      { label: title },
    ]} />
    <BackButton />
    <p class="guide-eyebrow">{t.tool.guideFallback}</p>
    <h1>{title}</h1>
    <p class="guide-description">{description}</p>
    <p class="guide-meta">
      {readMinutes} {t.guide.readTimeSuffix}
      <span class="guide-meta-sep" aria-hidden="true">·</span>
      {t.guide.updatedPrefix} {updatedDisplay}
    </p>
  </div>

  <div class="guide-body">
    <aside class="toc-column" aria-label={tocLabels[lang]}>
      <!-- Mobile: collapsible -->
      <details class="toc-mobile">
        <summary class="toc-summary">{tocLabels[lang]}</summary>
        <ul id="toc-list-mobile" class="toc-list"></ul>
      </details>
      <!-- Desktop: sticky -->
      <nav class="toc-desktop" aria-label={tocLabels[lang]}>
        <p class="toc-heading">{tocLabels[lang]}</p>
        <ul id="toc-list-desktop" class="toc-list"></ul>
      </nav>
    </aside>

    <div class="guide-content">
      <slot />
      <div class="kg-group">
        <RelatedContent toolSlug={toolSlug} />
        <YouMayAlsoNeed toolSlug={toolSlug} />
        <ContinueLearning toolSlug={toolSlug} />
      </div>
    </div>
  </div>

  <CategoryDiscovery toolSlug={toolSlug} />

  <EcosystemLinks
    currentType="guide"
    toolSlug={toolSlug}
    toolCategorySegment={toolCategorySegment}
    toolName={localizedTool?.name ?? toolName}
    entry={localizedTool ?? entry}
    lang={lang}
  />
</BaseLayout>

<style>
  /* ── Guide header ─────────────────────────────────────────── */

  .guide-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
    border-bottom: var(--border);
    margin-bottom: var(--space-20);
  }

  .guide-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-3);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  h1 {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .guide-description {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 55ch;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .guide-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: unset;
    margin-top: var(--space-2);
  }

  .guide-meta-sep {
    color: var(--color-text-subtle);
  }

  /* ── Two-column body ──────────────────────────────────────── */

  .guide-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-12);
  }

  @media (max-width: 900px) {
    .guide-body {
      grid-template-columns: 1fr;
    }
  }

  /* ── TOC column ───────────────────────────────────────────── */

  .toc-desktop {
    position: sticky;
    top: calc(var(--touch-target) + var(--space-4) + var(--space-4));
    display: block;
    padding-right: var(--space-4);
  }

  @media (max-width: 900px) {
    .toc-desktop {
      display: none;
    }
  }

  .toc-heading {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-3);
    max-width: unset;
  }

  /* ── TOC — mobile ─────────────────────────────────────────── */

  .toc-mobile {
    display: none;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    margin-bottom: var(--space-8);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .toc-mobile {
      display: block;
    }
  }

  .toc-summary {
    list-style: none;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    background: var(--color-bg-tertiary);
    color: var(--color-text-muted);
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile[open] .toc-summary {
    border-bottom: var(--border);
  }

  .toc-mobile .toc-list {
    padding: var(--space-3) var(--space-4);
  }

  /* ── TOC list shared ──────────────────────────────────────── */

  :global(.toc-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  :global(.toc-list li) {
    border-left: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  :global(.toc-list li:has(a[aria-current])) {
    border-left-color: var(--color-accent);
  }

  :global(.toc-list a) {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: var(--transition-color);
    line-height: var(--leading-relaxed);
  }

  :global(.toc-list a:hover) {
    color: var(--color-text);
    text-decoration: none;
  }

  :global(.toc-list a[aria-current]) {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  /* ── Guide content sections ───────────────────────────────── */

  :global(.guide-content section) {
    padding-block: var(--space-20);
    border-bottom: var(--border);
  }

  :global(.guide-content section:last-child) {
    border-bottom: none;
    padding-bottom: var(--space-6);
  }

  :global(.guide-content h2) {
    margin-bottom: var(--space-5);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.0125em;
  }

  :global(.guide-content h2 .gold-dot) {
    display: none;
  }

  :global(.guide-content p) {
    max-width: var(--width-prose);
  }

  :global(.guide-content p + p) {
    margin-top: var(--space-5);
  }

  :global(.guide-content ul) {
    list-style: disc;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-5);
    max-width: var(--width-prose);
  }

  :global(.guide-content li) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── KG sections — single shared border ──────────────────── */

  .kg-group {
    border-top: var(--border);
    padding-top: var(--space-8);
    margin-top: var(--space-8);
  }

  .kg-group :global(.kg-section) {
    border-top: none;
    padding-top: 0;
  }

  .kg-group :global(.kg-section + .kg-section) {
    margin-top: var(--space-8);
    border-top: none;
  }

  /* Hand guides each ship their own fill and an opacity hover. These win without editing those files.
     The resting fill is the AA orange, not #f54e00, whose white label is 3.52:1. */
  :global(.guide-content .cta-link) {
    background: var(--color-action) !important;
    color: var(--color-text-inverse) !important;
  }

  :global(.guide-content .cta-link:hover),
  :global(.guide-content .cta-link:active) {
    opacity: 1 !important;
    background: var(--color-action-hover) !important;
    color: var(--color-text-inverse) !important;
  }

  :global(.guide-content .encoding-example) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    max-width: unset;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var sections = document.querySelectorAll('.guide-content section[id]');
    var listM = document.getElementById('toc-list-mobile');
    var listD = document.getElementById('toc-list-desktop');

    /* Build TOC entries */
    sections.forEach(function (sec) {
      var h2 = sec.querySelector('h2');
      if (!h2) return;
      var text = h2.textContent.replace(/[●•·]/g, '').trim();
      [listM, listD].forEach(function (ul) {
        if (!ul) return;
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + sec.id;
        a.textContent = text;
        li.appendChild(a);
        ul.appendChild(li);
      });
    });

    /* Highlight active section as page scrolls */
    if ('IntersectionObserver' in window && sections.length > 0) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var id = e.target.id;
          document.querySelectorAll('#toc-list-desktop a, #toc-list-mobile a').forEach(function (a) {
            a.removeAttribute('aria-current');
          });
          document.querySelectorAll(
            '#toc-list-desktop a[href="#' + id + '"], #toc-list-mobile a[href="#' + id + '"]'
          ).forEach(function (a) {
            a.setAttribute('aria-current', 'true');
          });
        });
      }, { rootMargin: '-15% 0% -70% 0%' });

      sections.forEach(function (s) { io.observe(s); });
    }
  });
</script>
