---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import BackButton from '@components/BackButton.astro';
import EcosystemLinks from '@components/EcosystemLinks.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import RelatedContent from '@components/knowledge/RelatedContent.astro';
import YouMayAlsoNeed from '@components/knowledge/YouMayAlsoNeed.astro';
import ContinueLearning from '@components/knowledge/ContinueLearning.astro';
import type { FAQItem, EcosystemEntry } from '@data/types';
import { categories } from '@data/categories';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  toolSlug: string;
  toolName: string;
  toolCategorySlug: string;
  items: FAQItem[];
  entry: EcosystemEntry;
}

const {
  title,
  description,
  toolSlug,
  toolName,
  toolCategorySlug,
  items,
  entry,
} = Astro.props;

const category = categories.find(c => c.slug === toolCategorySlug);
const toolCategorySegment = category?.segment ?? toolCategorySlug;
const toolCategoryName = category?.name ?? toolCategorySlug;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    '@id': `#${item.id}`,
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL(withBase('/'), Astro.site).href : withBase('/') },
    { '@type': 'ListItem', position: 2, name: toolCategoryName, item: Astro.site ? new URL(withBase(`/category/${toolCategorySlug}/`), Astro.site).href : withBase(`/category/${toolCategorySlug}/`) },
    { '@type': 'ListItem', position: 3, name: toolName, item: Astro.site ? new URL(withBase(`/tool/${toolCategorySegment}/${toolSlug}/`), Astro.site).href : withBase(`/tool/${toolCategorySegment}/${toolSlug}/`) },
    { '@type': 'ListItem', position: 4, name: 'FAQ' },
  ],
};
---

<BaseLayout title={title} description={description} maxWidth="tool">
  <div class="faq-header">
    <p class="faq-label">FAQ</p>
    <Breadcrumb items={[
      { label: 'Home', href: withBase('/') },
      { label: toolCategoryName, href: withBase(`/category/${toolCategorySlug}/`) },
      { label: toolName, href: withBase(`/tool/${toolCategorySegment}/${toolSlug}/`) },
      { label: 'FAQ' },
    ]} />
    <BackButton />
    <h1>{title}</h1>
    <p class="faq-description">{description}</p>
  </div>

  <FaqAccordion items={items} />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <RelatedContent toolSlug={toolSlug} />
  <YouMayAlsoNeed toolSlug={toolSlug} />
  <ContinueLearning toolSlug={toolSlug} />

  <CategoryDiscovery toolSlug={toolSlug} />

  <EcosystemLinks
    currentType="faq"
    toolSlug={toolSlug}
    toolCategorySegment={toolCategorySegment}
    toolName={toolName}
    entry={entry}
  />
</BaseLayout>

<style>
  .faq-header {
    padding-bottom: var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-8);
  }

  .faq-label {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    max-width: unset;
    margin-bottom: var(--space-2);
  }

  h1 {
    margin-bottom: var(--space-3);
  }

  .faq-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 55ch;
  }
</style>
