---
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import ToyToolsRuntime from '@components/ToyToolsRuntime.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface PwaMeta {
  manifestUrl: string;
  iconUrl: string;
  themeColor: string;
  title: string; // short app title for the home-screen label
}

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  maxWidth?: 'tool' | 'content' | 'shell' | 'category' | 'full';
  robots?: string;
  /** When set (tool pages), emits the per-tool web manifest + install meta so the
   *  tool can be added to the home screen as its own app. */
  pwa?: PwaMeta;
  /** Engine ids whose browser runtime this page needs (tool pages pass their tool's engine).
   *  Emitted as <meta name="tt-engines">, which is the ONLY thing that makes the deferred runtime
   *  fetch an engine chunk — leave it empty and the page ships platform glue and nothing else.
   *  See src/lib/runtime/index.ts. */
  engines?: string[];
  /** Tool slug, when this page is a tool. Only use: the footer's feedback link prefills it, so a
   *  report keeps its per-tool context now that tool pages no longer carry their own invite. */
  feedbackTool?: string;
}

const {
  title,
  description,
  canonicalUrl,
  maxWidth = 'tool',
  robots = 'index,follow',
  pwa,
  engines = [],
  feedbackTool,
} = Astro.props;

const pageTitle = title;
const canonical = canonicalUrl ?? Astro.url.href;

const maxWidthVar =
  maxWidth === 'tool' ? 'var(--width-tool)' :
  maxWidth === 'content' ? 'var(--width-content)' :
  maxWidth === 'shell' || maxWidth === 'category' ? 'var(--width-shell)' :
  'none';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('toytools.theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={withBase('/favicon.svg')} />
    <meta name="robots" content={robots} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={withBase('/favicon.svg')} />
    {/*
      Google picks the favicon it shows in search results from these, and asks for a
      square icon that is a multiple of 48px. favicon.ico is a 32x32 file kept only as
      a legacy fallback for browsers that want an .ico, so the 48 and 96 PNGs are what
      actually qualify. All of them are generated from src/lib/icons/site-icon.ts by
      `npm run icons:generate` — never hand-edit the files in public/.
    */}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={withBase('/favicon-96.png')} />
    {/* Tool pages emit their own per-tool touch icon below; every other page gets the site mark. */}
    {!pwa && <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />}
    {pwa && (
      <>
        <link rel="manifest" href={pwa.manifestUrl} />
        <link rel="apple-touch-icon" href={pwa.iconUrl} />
        <meta name="theme-color" content={pwa.themeColor} />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content={pwa.title} />
        <meta name="application-name" content={pwa.title} />
      </>
    )}
    {engines.length > 0 && <meta name="tt-engines" content={engines.join(',')} />}
    <!--
      Google Analytics is loaded from ToyToolsRuntime (client-side) and ONLY for
      real users. The analytics guard (src/lib/analytics/guard.ts) excludes dev,
      E2E (PUBLIC_E2E=true), browser automation, and localhost — so the gtag.js
      request and every event are suppressed during tests. Do not add a gtag
      snippet here.
    -->
  </head>
  <body>
    <ToyToolsRuntime />
    {/* First focusable thing on the page. Every page carries nav, breadcrumb, tool, related tools,
        FAQ and footer, so without this a keyboard or screen reader user traverses the whole chrome
        on each of 270+ pages before reaching the thing they came for. Visible only on focus. */}
    <a class="skip-link" href="#main">Skip to content</a>
    {/* Tool pages pass their own header (ToolBar) through this slot: chrome belongs to whoever owns
        the page, so a tool wears its own and every platform page wears ToyTools'. Exactly one of
        the two renders, so there is always precisely one role="banner". */}
    {Astro.slots.has('header') ? <slot name="header" /> : <Nav />}
    {/* tabindex="-1" so the skip link can actually move focus here, not just scroll. */}
    <main id="main" tabindex="-1">
      <div class="page-content" style={`max-width: ${maxWidthVar};`}>
        <slot />
      </div>
    </main>
    <Footer feedbackTool={feedbackTool} />
  </body>
</html>
