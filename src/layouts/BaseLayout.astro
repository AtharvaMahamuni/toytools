---
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import ToyToolsRuntime from '@components/ToyToolsRuntime.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  maxWidth?: 'tool' | 'content' | 'shell' | 'category' | 'full';
  robots?: string;
}

const {
  title,
  description,
  canonicalUrl,
  maxWidth = 'tool',
  robots = 'index,follow',
} = Astro.props;

const pageTitle = title;
const canonical = canonicalUrl ?? Astro.url.href;

const maxWidthVar =
  maxWidth === 'tool' ? 'var(--width-tool)' :
  maxWidth === 'content' ? 'var(--width-content)' :
  maxWidth === 'shell' || maxWidth === 'category' ? 'var(--width-shell)' :
  'none';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('toytools.theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={withBase('/favicon.svg')} />
    <meta name="robots" content={robots} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WHD7CL44MX" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WHD7CL44MX');
    </script>
  </head>
  <body>
    <ToyToolsRuntime />
    <Nav />
    <main>
      <div class="page-content" style={`max-width: ${maxWidthVar};`}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
