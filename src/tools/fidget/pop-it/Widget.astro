---
import FeelWidget from '@tools/_shared/FeelWidget.astro';
import { config } from './config';

// Finite 4x3 by default (fixed board, no scroll). Infinite: play-mode chrome + scroll-append.
// Exit Infinite with Exit or Escape.
const COLS = 4;
const INITIAL_ROWS = 3;
const ROW_BATCH = 3;
const MAX_ROWS = 48;
const COUNT = COLS * INITIAL_ROWS;
const bubbles = Array.from({ length: COUNT }, (_, i) => i);
---

<FeelWidget slug={config.slug} playLabel="Infinite mode">
  <div
    slot="stage"
    class="pop-it"
    data-pop-it
    data-cols={COLS}
    data-initial-rows={INITIAL_ROWS}
    data-row-batch={ROW_BATCH}
    data-max-rows={MAX_ROWS}
    data-count={COUNT}
  >
    <div class="pop-scroller" data-pop-scroller tabindex="0" aria-label="Pop It board">
      <div
        class="pop-board"
        data-pop-board
        role="group"
        aria-label="Pop It bubble board"
        style={`--pop-cols: ${COLS}`}
      >
        {
          bubbles.map((i) => (
            <button
              type="button"
              class="pop-bubble"
              data-pop-bubble
              data-index={i}
              aria-pressed="false"
              aria-label={`Bubble ${i + 1}, ready to pop`}
            />
          ))
        }
      </div>
    </div>
  </div>

  <p slot="status" class="pop-status" data-pop-status aria-live="polite">
    {COUNT} ready
  </p>
  <button slot="actions" type="button" class="pop-reset" data-pop-reset data-craft={config.craft!.id}>
    Reset board
  </button>
</FeelWidget>

<style>
  .pop-it {
    display: flex;
    flex-direction: column;
    max-width: 24rem;
    min-width: 0;
  }

  .pop-reset {
    flex: 0 0 auto;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  .pop-reset:active {
    background: var(--color-surface-hover);
  }

  .pop-reset:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .pop-scroller {
    overflow: hidden;
    overscroll-behavior: contain;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: var(--border);
  }

  .pop-it.is-infinite .pop-scroller {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    max-height: calc(100dvh - 8rem);
  }

  .pop-board {
    display: grid;
    grid-template-columns: repeat(var(--pop-cols, 4), minmax(0, 1fr));
    gap: var(--space-3);
    padding: var(--space-4);
  }

  /*
   * Bubble visuals are :global on purpose. Infinite mode appends bubbles with createElement,
   * and Astro scoped selectors (class + data-astro-cid) never match those nodes.
   */
  :global(.pop-bubble) {
    aspect-ratio: 1;
    width: 100%;
    min-block-size: var(--touch-target);
    border-radius: 999px;
    border: var(--border);
    padding: 0;
    cursor: pointer;
    background: color-mix(in srgb, var(--color-accent) 28%, var(--color-surface));
    box-shadow:
      inset 0 -0.2rem color-mix(in srgb, var(--color-accent) 45%, transparent),
      0 0.15rem 0.35rem color-mix(in srgb, var(--color-text) 12%, transparent);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease,
      background-color 0.12s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  :global(.pop-bubble:active:not(.is-popped)) {
    transform: scale(0.94);
  }

  :global(.pop-bubble.is-popped) {
    background: var(--color-bg-tertiary);
    box-shadow: inset 0 0.2rem 0.45rem color-mix(in srgb, var(--color-text) 18%, transparent);
    cursor: default;
  }

  :global(.pop-bubble:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .pop-status {
    margin: 0;
    max-width: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .pop-it.is-motion-reduced :global(.pop-bubble) {
    transition: none;
  }
</style>

<style is:global>
  html.tt-play-mode [data-pop-it] {
    display: flex;
    flex-direction: column;
    max-width: none;
    height: 100%;
    min-height: 0;
  }

  html.tt-play-mode [data-pop-scroller] {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    max-height: none;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-pop-it]');
    if (!root) return;

    var board = root.querySelector('[data-pop-board]');
    var scroller = root.querySelector('[data-pop-scroller]');
    var statusEl = document.querySelector('[data-pop-status]');
    var resetBtn = document.querySelector('[data-pop-reset]');
    var feelRoot = root.closest('[data-feel-slug]');
    var cols = Number(root.getAttribute('data-cols')) || 4;
    var rowBatch = Number(root.getAttribute('data-row-batch')) || 3;
    var maxRows = Number(root.getAttribute('data-max-rows')) || 48;
    var initialRows = Number(root.getAttribute('data-initial-rows')) || 3;
    var rows = initialRows;
    var feel = null;
    var pendingCue = null;
    var infiniteOn = false;
    var appending = false;

    function bubbles() {
      return root.querySelectorAll('[data-pop-bubble]');
    }

    function total() {
      return bubbles().length;
    }

    function remaining() {
      var list = bubbles();
      var n = 0;
      for (var i = 0; i < list.length; i++) {
        if (list[i].getAttribute('aria-pressed') !== 'true') n++;
      }
      return n;
    }

    function syncStatus() {
      if (!statusEl) return;
      var left = remaining();
      var all = total();
      if (left === all) statusEl.textContent = all + ' ready';
      else if (left === 0) {
        if (infiniteOn && rows < maxRows) {
          statusEl.textContent = 'Board clear. Scroll for more, or Reset.';
        } else {
          statusEl.textContent = 'Board clear. Reset to continue.';
        }
      } else statusEl.textContent = left + ' left';
    }

    function setPopped(btn, popped) {
      btn.setAttribute('aria-pressed', popped ? 'true' : 'false');
      btn.classList.toggle('is-popped', popped);
      var idx = Number(btn.getAttribute('data-index')) + 1;
      btn.setAttribute(
        'aria-label',
        popped ? 'Bubble ' + idx + ', popped' : 'Bubble ' + idx + ', ready to pop'
      );
    }

    function syncMotionClass() {
      if (!feel || typeof feel.motionAllowed !== 'function') return;
      var allowed = false;
      try {
        allowed = !!feel.motionAllowed();
      } catch (e) {
        allowed = true;
      }
      root.classList.toggle('is-motion-reduced', !allowed);
    }

    function runCue(kind) {
      if (!feel) return;
      try {
        if (kind === 'pop' && typeof feel.feedback === 'function') feel.feedback('pop');
        else if (kind === 'soft' && typeof feel.play === 'function') feel.play('soft');
      } catch (e) {}
    }

    function flushPendingCue() {
      if (!pendingCue || !feel) return;
      var cue = pendingCue;
      pendingCue = null;
      runCue(cue);
    }

    function tryResolveFeelSync() {
      if (feel) return true;
      var TT = window.ToyTools;
      if (TT && TT.feel) {
        feel = TT.feel;
        syncMotionClass();
        return true;
      }
      return false;
    }

    var readyArmed = false;
    function armFeelReady() {
      if (readyArmed) return;
      var TT = window.ToyTools;
      if (!TT || !TT.onReady) return;
      readyArmed = true;
      TT.onReady(function () {
        feel = TT.feel || null;
        syncMotionClass();
        flushPendingCue();
      });
    }

    function requestCue(kind) {
      if (tryResolveFeelSync()) {
        runCue(kind);
        return;
      }
      if (!pendingCue) pendingCue = kind;
      armFeelReady();
    }

    function createBubble(index) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pop-bubble';
      btn.setAttribute('data-pop-bubble', '');
      btn.setAttribute('data-index', String(index));
      setPopped(btn, false);
      return btn;
    }

    function appendRows(count) {
      if (!board || appending || !infiniteOn) return 0;
      if (rows >= maxRows) return 0;
      appending = true;
      var add = Math.min(count, maxRows - rows);
      var start = rows * cols;
      var frag = document.createDocumentFragment();
      for (var r = 0; r < add; r++) {
        for (var c = 0; c < cols; c++) {
          frag.appendChild(createBubble(start + r * cols + c));
        }
      }
      board.appendChild(frag);
      rows += add;
      root.setAttribute('data-rows', String(rows));
      root.setAttribute('data-count', String(total()));
      appending = false;
      syncStatus();
      return add;
    }

    function ensureScrollable() {
      if (!infiniteOn || !scroller) return;
      var guard = 0;
      while (guard < 16 && rows < maxRows && scroller.scrollHeight <= scroller.clientHeight + 8) {
        if (appendRows(rowBatch) === 0) break;
        guard++;
      }
    }

    function trimToFinite() {
      if (!board) return;
      var list = bubbles();
      var keep = initialRows * cols;
      for (var i = list.length - 1; i >= keep; i--) {
        board.removeChild(list[i]);
      }
      rows = initialRows;
      root.setAttribute('data-rows', String(rows));
      root.setAttribute('data-count', String(total()));
      if (scroller) scroller.scrollTop = 0;
    }

    function popBubble(btn) {
      if (!btn || btn.getAttribute('aria-pressed') === 'true') return;
      setPopped(btn, true);
      syncStatus();
      requestCue('pop');
    }

    function resetBoard() {
      var list = bubbles();
      for (var i = 0; i < list.length; i++) setPopped(list[i], false);
      if (scroller) scroller.scrollTop = 0;
      syncStatus();
      requestCue('soft');
    }

    function setInfiniteMode(on) {
      infiniteOn = !!on;
      root.classList.toggle('is-infinite', infiniteOn);
      if (!infiniteOn) {
        trimToFinite();
      } else {
        // Always seed one batch so Infinite is visibly more than the finite 4x3, even if
        // layout has not yet given the scroller a height (play-mode 100% can be 0 for a frame).
        appendRows(rowBatch);
        if (scroller) void scroller.offsetHeight;
        requestAnimationFrame(function () {
          if (scroller) void scroller.offsetHeight;
          ensureScrollable();
          bottomArmed = true;
        });
      }
      if (scroller) {
        scroller.setAttribute('aria-label', infiniteOn ? 'Scrollable Pop It board' : 'Pop It board');
      }
      syncStatus();
      if (infiniteOn && scroller) {
        try {
          scroller.focus();
        } catch (e) {}
      }
    }

    function onPointerDown(ev) {
      if (ev.button != null && ev.button !== 0) return;
      var btn = ev.target && ev.target.closest ? ev.target.closest('[data-pop-bubble]') : null;
      if (!btn || !board || !board.contains(btn)) return;
      popBubble(btn);
    }

    function onClick(ev) {
      var btn = ev.target && ev.target.closest ? ev.target.closest('[data-pop-bubble]') : null;
      if (!btn || !board || !board.contains(btn)) return;
      popBubble(btn);
    }

    var bottomArmed = true;

    function armInfiniteScroll() {
      if (!scroller) return;
      scroller.addEventListener(
        'scroll',
        function () {
          if (!infiniteOn) return;
          var nearBottom =
            scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 64;
          if (!nearBottom) {
            bottomArmed = true;
            return;
          }
          if (!bottomArmed) return;
          var added = appendRows(rowBatch);
          if (added > 0) bottomArmed = false;
        },
        { passive: true },
      );
    }

    if (board) {
      board.addEventListener('pointerdown', onPointerDown);
      board.addEventListener('click', onClick);
    }
    if (resetBtn) resetBtn.addEventListener('click', resetBoard);
    document.addEventListener('feel:play', function () {
      setInfiniteMode(true);
    });
    document.addEventListener('feel:exit', function () {
      setInfiniteMode(false);
    });
    var playBtn = document.querySelector('[data-feel-play]');
    if (playBtn) {
      playBtn.addEventListener('click', function () {
        setInfiniteMode(true);
      });
    }

    try {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('is-motion-reduced');
      }
    } catch (e) {}

    if (!tryResolveFeelSync()) armFeelReady();

    root.setAttribute('data-rows', String(rows));
    armInfiniteScroll();
    syncStatus();
  })();
</script>
