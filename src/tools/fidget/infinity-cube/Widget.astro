---
import FeelWidget from '@tools/_shared/FeelWidget.astro';
import { config } from './config';
import { closedState, countLabel, drawModel } from '@lib/engines/feel/infinity-cube';

const closed = closedState();
const model = drawModel(closed.hinge, closed.angle);
const box = model.viewBox.split(' ').map(Number);
const ratio = box[2]! / box[3]!;
const label = countLabel(closed);
---

<FeelWidget slug={config.slug}>
  <div
    slot="stage"
    class="infinity"
    id="infinity-cube-root"
    data-tool={config.slug}
    data-infinity
    data-craft={config.craft!.id}
    data-infinity-phase="closed"
    style={`--infinity-ratio: ${ratio.toFixed(4)}`}
  >
    <svg
      id="infinity-cube-stage"
      class="infinity-svg"
      data-infinity-svg
      viewBox={model.viewBox}
      role="group"
      aria-label={label}
      tabindex="0"
    >
      {
        model.faces.map((face) => (
          <polygon
            points={face.points}
            data-infinity-cube={face.cube}
            data-free={face.free ? '1' : '0'}
            data-tone={face.tone}
          />
        ))
      }
    </svg>
  </div>

  <p
    slot="status"
    id="infinity-cube-count"
    class="infinity-count"
    data-infinity-count
    data-infinity-folds="0"
    aria-live="polite"
  >
    {label}
  </p>
  <button slot="actions" type="button" id="infinity-cube-reset" class="infinity-reset" data-infinity-reset>
    Reset
  </button>
</FeelWidget>

<style>
  .infinity {
    --infinity-max: 22rem;
    width: min(100%, var(--infinity-max));
    max-width: var(--infinity-max);
    aspect-ratio: var(--infinity-ratio, 1);
    margin-inline: auto;
    min-width: 0;
  }

  .infinity-svg {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-md);
    touch-action: none;
  }

  .infinity-svg polygon[data-tone='light'] {
    fill: color-mix(in srgb, var(--color-accent) 46%, var(--color-surface));
  }

  .infinity-svg polygon[data-tone='mid'] {
    fill: color-mix(in srgb, var(--color-accent) 26%, var(--color-surface));
  }

  .infinity-svg polygon[data-tone='dark'] {
    fill: color-mix(in srgb, var(--color-text) 16%, var(--color-surface));
  }

  .infinity-svg polygon {
    stroke: color-mix(in srgb, var(--color-text) 28%, var(--color-surface));
    stroke-width: 0.035;
    stroke-linejoin: round;
  }

  .infinity-svg polygon[data-free='1'] {
    cursor: pointer;
  }

  .infinity-svg polygon[data-free='1']:active {
    fill: color-mix(in srgb, var(--color-accent) 64%, var(--color-surface));
  }

  .infinity-svg:focus-visible,
  .infinity-reset:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .infinity-count {
    margin: 0;
    max-width: none;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .infinity-reset {
    min-block-size: var(--touch-target);
    min-inline-size: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    font-family: inherit;
    cursor: pointer;
  }

  .infinity-reset:active {
    background: var(--color-surface-hover);
  }
</style>

<style is:global>
  html.tt-play-mode [data-infinity] {
    --infinity-max: 100%;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-feel-slug="infinity-cube"]');
    if (!root) return;

    var stage = root.querySelector('[data-infinity]');
    var svg = root.querySelector('#infinity-cube-stage');
    var countEl = root.querySelector('#infinity-cube-count');
    var resetBtn = root.querySelector('#infinity-cube-reset');
    var feel = null;
    var loop = null;
    var state = { hinge: 0, angle: 0, folding: false, folds: 0 };

    function cubeApi() {
      return feel && feel.infinityCube ? feel.infinityCube : null;
    }

    function stopLoop() {
      if (loop && loop.stop) loop.stop();
      loop = null;
    }

    function cue() {
      if (feel && typeof feel.feedback === 'function') {
        try {
          feel.feedback('click');
        } catch (e) {}
      }
    }

    function paint() {
      var api = cubeApi();
      var text = 'Closed · 0 folds';
      var phase = 'closed';
      if (api) {
        text = api.countLabel(state);
        if (state.folding) phase = 'folding';
        else if (!api.isClosed(state)) phase = 'open';
        var model = api.drawModel(state.hinge, state.angle);
        var html = '';
        for (var i = 0; i < model.faces.length; i++) {
          var face = model.faces[i];
          html +=
            '<polygon points="' +
            face.points +
            '" data-infinity-cube="' +
            face.cube +
            '" data-free="' +
            (face.free ? '1' : '0') +
            '" data-tone="' +
            face.tone +
            '" />';
        }
        if (svg) svg.innerHTML = html;
      }
      if (countEl) {
        countEl.textContent = text;
        countEl.setAttribute('data-infinity-folds', String(state.folds));
      }
      if (stage) stage.setAttribute('data-infinity-phase', phase);
      if (svg) svg.setAttribute('aria-label', text);
    }

    function begin() {
      var api = cubeApi();
      if (!api || state.folding) return;
      var reduced = false;
      if (feel && typeof feel.motionAllowed === 'function') {
        try {
          reduced = !feel.motionAllowed();
        } catch (e) {
          reduced = false;
        }
      }
      var next = api.requestFold(state, api.legalHinge(state), reduced);
      if (next === state) return;
      state = next;
      paint();
      if (!state.folding) {
        cue();
        return;
      }
      if (!feel || typeof feel.raf !== 'function') {
        state = api.stepAngle(state, 90);
        paint();
        cue();
        return;
      }
      stopLoop();
      var ms = api.FOLD_MS || 480;
      var speed = 90 / (ms / 1000);
      loop = feel.raf(function (dt) {
        var prev = state.folds;
        state = api.stepAngle(state, speed * dt);
        paint();
        if (state.folds !== prev) {
          cue();
          loop = null;
          return false;
        }
        return true;
      });
      if (loop && loop.start) loop.start();
    }

    function onDown(ev) {
      if (ev.button != null && ev.button !== 0) return;
      if (state.folding) return;
      var node = ev.target && ev.target.closest ? ev.target.closest('[data-infinity-cube]') : null;
      if (!node || node.getAttribute('data-free') !== '1') return;
      if (feel && typeof feel.unlock === 'function') {
        try {
          feel.unlock();
        } catch (e) {}
      }
      begin();
    }

    function onKey(ev) {
      if (ev.key !== 'Enter' && ev.key !== ' ') return;
      ev.preventDefault();
      if (state.folding) return;
      if (feel && typeof feel.unlock === 'function') {
        try {
          feel.unlock();
        } catch (e) {}
      }
      begin();
    }

    function reset() {
      stopLoop();
      var api = cubeApi();
      state = api ? api.closedState() : { hinge: 0, angle: 0, folding: false, folds: 0 };
      paint();
    }

    if (svg) {
      svg.addEventListener('pointerdown', onDown);
      svg.addEventListener('keydown', onKey);
    }
    if (resetBtn) resetBtn.addEventListener('click', reset);

    var TT = window.ToyTools;
    if (TT && TT.onReady) {
      TT.onReady(function () {
        feel = TT.feel || null;
        paint();
      });
    }
  })();
</script>
