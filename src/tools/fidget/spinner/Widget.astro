---
import FeelWidget from '@tools/_shared/FeelWidget.astro';
import { config } from './config';
---

<FeelWidget slug={config.slug}>
  <div slot="stage" class="spin" data-spinner>
    <div
      class="spin-stage"
      data-spin-stage
      tabindex="0"
      role="img"
      aria-label="Fidget spinner. Flick to spin."
    >
      <svg class="spin-svg" data-spin-disc viewBox="-80 -80 160 160" aria-hidden="true">
        <circle cx="0" cy="0" r="18" />
        <circle cx="0" cy="-52" r="22" />
        <circle cx="45" cy="26" r="22" />
        <circle cx="-45" cy="26" r="22" />
        <circle cx="0" cy="0" r="7" class="spin-hub" />
      </svg>
    </div>
  </div>

  <p slot="status" class="spin-status" data-spin-status data-craft={config.craft!.id} aria-live="polite">
    Stopped
  </p>
</FeelWidget>

<style>
  .spin {
    max-width: 24rem;
    min-width: 0;
  }

  .spin-stage {
    aspect-ratio: 1;
    width: 100%;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: var(--border);
    display: grid;
    place-items: center;
    touch-action: none;
    cursor: grab;
  }

  .spin-stage:active {
    cursor: grabbing;
  }

  .spin-stage:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .spin-svg {
    width: min(72%, 16rem);
    height: auto;
    transform-origin: 50% 50%;
    will-change: transform;
    fill: color-mix(in srgb, var(--color-accent) 32%, var(--color-surface));
    stroke: color-mix(in srgb, var(--color-accent) 55%, var(--color-text));
    stroke-width: 1.5;
  }

  .spin-hub {
    fill: var(--color-surface);
  }

  .spin-status {
    margin: 0;
    max-width: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .spin.is-motion-reduced .spin-svg {
    transition: none;
  }
</style>

<style is:global>
  html.tt-play-mode [data-spinner] {
    display: flex;
    flex-direction: column;
    max-width: none;
    height: 100%;
    min-height: 0;
  }

  html.tt-play-mode [data-spin-stage] {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    aspect-ratio: auto;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-spinner]');
    if (!root) return;

    var stage = root.querySelector('[data-spin-stage]');
    var disc = root.querySelector('[data-spin-disc]');
    var statusEl = document.querySelector('[data-spin-status]');
    var feelRoot = root.closest('[data-feel-slug]');
    var feel = null;
    var angle = 0;
    var omega = 0;
    var dragging = false;
    var lastX = 0;
    var lastY = 0;
    var lastT = 0;
    var loop = null;
    var tapCount = 0;
    var lastHapticAt = 0;
    var cx = 0;
    var cy = 0;
    var samples = [];

    function setStatus(text) {
      if (statusEl) statusEl.textContent = text;
    }

    function paint() {
      disc.style.transform = 'rotate(' + (angle * 180) / Math.PI + 'deg) translateZ(0)';
    }

    function spinCfg() {
      var s = feel && feel.spinner ? feel.spinner : {};
      return {
        rest: s.SPINNER_REST || 0.12,
        friction: s.SPINNER_FRICTION || 0.985,
        max: s.SPINNER_MAX_OMEGA || 52,
        boost: s.SPINNER_FLICK_BOOST || 2.4,
      };
    }

    function hubDa(x0, y0, x1, y1) {
      if (feel && typeof feel.hubDelta === 'function') {
        return feel.hubDelta(x0, y0, x1, y1, cx, cy, 16);
      }
      var a0 = Math.atan2(y0 - cy, x0 - cx);
      var a1 = Math.atan2(y1 - cy, x1 - cx);
      var da = a1 - a0;
      if (da > Math.PI) da -= Math.PI * 2;
      if (da < -Math.PI) da += Math.PI * 2;
      return da;
    }

    function reduced() {
      if (feel && typeof feel.motionAllowed === 'function') {
        try {
          return !feel.motionAllowed();
        } catch (e) {}
      }
      return root.classList.contains('is-motion-reduced');
    }

    function stopLoop() {
      if (loop && loop.stop) loop.stop();
      loop = null;
      omega = 0;
      setStatus('Stopped');
    }

    function maybeTick(prev, next) {
      var s = feel && feel.spinner;
      if (!s || typeof s.crossedTick !== 'function') return;
      if (!s.crossedTick(prev, next)) return;
      if (feel && typeof feel.play === 'function') {
        try {
          feel.play('tick');
        } catch (e) {}
      }
      var now = typeof performance !== 'undefined' ? performance.now() : Date.now();
      var speed = Math.abs(omega);
      var gap = speed > 14 ? 80 : speed > 6 ? 50 : 32;
      if (now - lastHapticAt > gap && feel && typeof feel.vibrate === 'function') {
        lastHapticAt = now;
        try {
          feel.vibrate(speed > 14 ? [10, 10, 18] : speed > 6 ? [16, 12, 24] : [22, 14, 32]);
        } catch (e) {}
      }
    }

    function startLoop() {
      if (loop || !feel || typeof feel.raf !== 'function') return;
      if (reduced()) {
        stopLoop();
        return;
      }
      setStatus('Spinning');
      loop = feel.raf(function (dt) {
        if (dragging) return true;
        var prev = angle;
        var cfg = spinCfg();
        if (typeof feel.friction === 'function') {
          omega = feel.friction(omega, { friction: cfg.friction, restVelocity: cfg.rest }, dt);
        } else {
          omega *= 0.985;
        }
        var rest = cfg.rest;
        if (feel.spinner && typeof feel.spinner.isAtRest === 'function' && feel.spinner.isAtRest(omega, rest)) {
          omega = 0;
          loop = null;
          setStatus('Stopped');
          return false;
        }
        if (typeof feel.integrate === 'function') {
          angle = feel.integrate(angle, omega, dt);
        } else {
          angle += omega * dt;
        }
        maybeTick(prev, angle);
        paint();
        return true;
      });
      if (loop && loop.start) loop.start();
    }

    function stageCenter() {
      var r = stage.getBoundingClientRect();
      cx = r.left + r.width / 2;
      cy = r.top + r.height / 2;
    }

    function onDown(ev) {
      if (ev.button != null && ev.button !== 0) return;
      dragging = true;
      lastX = ev.clientX;
      lastY = ev.clientY;
      lastT = ev.timeStamp || Date.now();
      stageCenter();
      omega = 0;
      samples = [];
      try {
        stage.setPointerCapture(ev.pointerId);
      } catch (e) {}
      if (feel && typeof feel.unlock === 'function') {
        try {
          feel.unlock();
        } catch (e) {}
      }
    }

    function onMove(ev) {
      if (!dragging) return;
      var now = ev.timeStamp || Date.now();
      var dt = Math.max(0.008, (now - lastT) / 1000);
      var da = hubDa(lastX, lastY, ev.clientX, ev.clientY);
      var prev = angle;
      angle += da;
      var instant = da / dt;
      var cfg = spinCfg();
      if (feel && typeof feel.clampVelocity === 'function') instant = feel.clampVelocity(instant, cfg.max);
      omega = instant;
      if (feel && typeof feel.pushFlick === 'function') {
        feel.pushFlick(samples, instant, dt);
      } else {
        samples.push({ omega: instant, dt: dt });
      }
      lastX = ev.clientX;
      lastY = ev.clientY;
      lastT = now;
      if (reduced()) {
        setStatus('Motion reduced');
        paint();
        return;
      }
      maybeTick(prev, angle);
      paint();
    }

    function onUp(ev) {
      if (!dragging) return;
      dragging = false;
      try {
        stage.releasePointerCapture(ev.pointerId);
      } catch (e) {}
      if (reduced()) {
        // Discrete nudge so reduced motion is not a dead toy.
        var step = (Math.PI * 2) / 12;
        angle += step;
        tapCount += 1;
        setStatus('Motion reduced');
        paint();
        if (feel && typeof feel.feedback === 'function') {
          try {
            feel.feedback('tick');
          } catch (e) {}
        }
        return;
      }
      var cfg = spinCfg();
      var flicked = feel && typeof feel.flick === 'function' ? feel.flick(samples, cfg.boost) : omega * cfg.boost;
      if (feel && typeof feel.clampVelocity === 'function') flicked = feel.clampVelocity(flicked, cfg.max);
      omega = Math.abs(flicked) < cfg.rest ? 0 : flicked;
      samples = [];
      if (Math.abs(omega) >= cfg.rest && feel && typeof feel.vibrate === 'function') {
        try {
          feel.vibrate([16, 14, 36, 18, 24]);
        } catch (e) {}
      }
      startLoop();
    }

    function onVis() {
      if (document.visibilityState !== 'visible') stopLoop();
    }

    stage.addEventListener('pointerdown', onDown);
    stage.addEventListener('pointermove', onMove);
    stage.addEventListener('pointerup', onUp);
    stage.addEventListener('pointercancel', onUp);
    document.addEventListener('visibilitychange', onVis);
    if (feelRoot) {
      feelRoot.addEventListener('feel:exit', stopLoop);
    }

    var TT = window.ToyTools;
    if (TT && TT.onReady) {
      TT.onReady(function () {
        feel = TT.feel || null;
        if (feel && typeof feel.motionAllowed === 'function' && !feel.motionAllowed()) {
          root.classList.add('is-motion-reduced');
          setStatus('Motion reduced');
        }
      });
    }
  })();
</script>
