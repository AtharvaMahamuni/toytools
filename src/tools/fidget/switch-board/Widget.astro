---
import FeelWidget from '@tools/_shared/FeelWidget.astro';
import { config } from './config';

const COLS = 4;
const COUNT = 16;
const switches = Array.from({ length: COUNT }, (_, i) => i);
---

<FeelWidget slug={config.slug}>
  <div slot="stage" class="sb" data-switch-board data-cols={COLS} data-count={COUNT}>
    <div
      class="sb-board"
      data-sb-board
      role="grid"
      aria-label="Switch board"
      tabindex="0"
      style={`--sb-cols: ${COLS}`}
    >
      {
        switches.map((i) => (
          <button
            type="button"
            class="sb-switch"
            data-sb-switch
            data-index={i}
            role="gridcell"
            aria-pressed="false"
            aria-label={`Switch ${i + 1}, off`}
            tabindex="-1"
          />
        ))
      }
    </div>
  </div>

  <p slot="status" class="sb-status" data-sb-status aria-live="polite">0 on</p>
  <button
    slot="actions"
    type="button"
    class="sb-all-off"
    data-sb-all-off
    data-craft={config.craft!.id}
    hidden
  >
    All off
  </button>
</FeelWidget>

<style>
  .sb {
    display: flex;
    flex-direction: column;
    max-width: 24rem;
    min-width: 0;
  }

  .sb-board {
    display: grid;
    grid-template-columns: repeat(var(--sb-cols, 4), minmax(0, 1fr));
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: var(--border);
    min-width: 0;
  }

  .sb-board:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .sb-switch {
    aspect-ratio: 3 / 5;
    width: 100%;
    min-block-size: var(--touch-target);
    min-width: 0;
    border-radius: var(--radius-md);
    border: var(--border);
    padding: 0;
    cursor: pointer;
    background: var(--color-surface);
    box-shadow:
      inset 0 -0.15rem color-mix(in srgb, var(--color-text) 12%, transparent),
      0 0.12rem 0.28rem color-mix(in srgb, var(--color-text) 10%, transparent);
    transition:
      background-color 0.12s ease,
      box-shadow 0.12s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .sb-switch:active {
    background: var(--color-surface-hover);
  }

  .sb-switch.is-on {
    background: color-mix(in srgb, var(--color-accent) 28%, var(--color-surface));
    box-shadow: inset 0 0.18rem 0.4rem color-mix(in srgb, var(--color-text) 16%, transparent);
  }

  .sb-switch.is-focused,
  .sb-switch:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .sb-status {
    margin: 0;
    max-width: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .sb-all-off {
    flex: 0 0 auto;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  .sb-all-off:active {
    background: var(--color-surface-hover);
  }

  .sb-all-off:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .sb-all-off[hidden] {
    display: none;
  }

  .sb.is-motion-reduced .sb-switch {
    transition: none;
  }
</style>

<style is:global>
  html.tt-play-mode [data-switch-board] {
    display: flex;
    flex-direction: column;
    max-width: none;
    height: 100%;
    min-height: 0;
  }

  html.tt-play-mode [data-sb-board] {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-switch-board]');
    if (!root) return;

    var board = root.querySelector('[data-sb-board]');
    var statusEl = document.querySelector('[data-sb-status]');
    var allOffBtn = document.querySelector('[data-sb-all-off]');
    var cols = Number(root.getAttribute('data-cols')) || 4;
    var feel = null;
    var ignoreClick = false;
    var focusIndex = 0;

    function switches() {
      return root.querySelectorAll('[data-sb-switch]');
    }

    function isOn(btn) {
      return btn.getAttribute('aria-pressed') === 'true';
    }

    function onCount() {
      var list = switches();
      var n = 0;
      for (var i = 0; i < list.length; i++) {
        if (isOn(list[i])) n++;
      }
      return n;
    }

    function syncStatus() {
      var n = onCount();
      if (statusEl) statusEl.textContent = n + ' on';
      if (allOffBtn) allOffBtn.hidden = n === 0;
    }

    function setSwitch(btn, on) {
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.classList.toggle('is-on', on);
      var idx = Number(btn.getAttribute('data-index')) + 1;
      btn.setAttribute('aria-label', 'Switch ' + idx + ', ' + (on ? 'on' : 'off'));
    }

    function cue() {
      if (feel && typeof feel.feedback === 'function') {
        try {
          feel.feedback('click');
        } catch (e) {}
      }
    }

    function flip(btn) {
      if (!btn) return;
      setSwitch(btn, !isOn(btn));
      cue();
      syncStatus();
    }

    function allOff() {
      var list = switches();
      var any = false;
      for (var i = 0; i < list.length; i++) {
        if (isOn(list[i])) {
          setSwitch(list[i], false);
          any = true;
        }
      }
      if (any) cue();
      syncStatus();
    }

    function setFocus(index) {
      var list = switches();
      if (!list.length) return;
      var next = ((index % list.length) + list.length) % list.length;
      for (var i = 0; i < list.length; i++) {
        list[i].tabIndex = -1;
        list[i].classList.toggle('is-focused', i === next);
      }
      list[next].tabIndex = 0;
      list[next].focus();
      focusIndex = next;
    }

    function onPointerDown(ev) {
      if (ev.button != null && ev.button !== 0) return;
      var btn = ev.target && ev.target.closest ? ev.target.closest('[data-sb-switch]') : null;
      if (!btn || !board || !board.contains(btn)) return;
      ignoreClick = true;
      focusIndex = Number(btn.getAttribute('data-index')) || 0;
      flip(btn);
    }

    function onClick(ev) {
      if (ignoreClick) {
        ignoreClick = false;
        return;
      }
      var btn = ev.target && ev.target.closest ? ev.target.closest('[data-sb-switch]') : null;
      if (!btn || !board || !board.contains(btn)) return;
      flip(btn);
    }

    function onKeyDown(ev) {
      if (!board) return;
      var t = ev.target;
      var onBoard =
        document.activeElement === board || (t && t.closest && t.closest('[data-sb-switch]'));
      if (!onBoard) return;
      var list = switches();
      var max = list.length - 1;
      if (ev.key === 'ArrowRight') {
        ev.preventDefault();
        setFocus(focusIndex + 1);
      } else if (ev.key === 'ArrowLeft') {
        ev.preventDefault();
        setFocus(focusIndex - 1);
      } else if (ev.key === 'ArrowDown') {
        ev.preventDefault();
        setFocus(focusIndex + cols);
      } else if (ev.key === 'ArrowUp') {
        ev.preventDefault();
        setFocus(focusIndex - cols);
      } else if (ev.key === 'Home') {
        ev.preventDefault();
        setFocus(0);
      } else if (ev.key === 'End') {
        ev.preventDefault();
        setFocus(max);
      } else if (ev.key === ' ' || ev.key === 'Enter') {
        ev.preventDefault();
        flip(list[focusIndex]);
      }
    }

    if (board) {
      board.addEventListener('pointerdown', onPointerDown);
      board.addEventListener('click', onClick);
      board.addEventListener('keydown', onKeyDown);
      board.addEventListener('focus', function () {
        var list = switches();
        if (list[focusIndex]) list[focusIndex].tabIndex = 0;
      });
    }
    if (allOffBtn) {
      allOffBtn.addEventListener('click', allOff);
    }

    var TT = window.ToyTools;
    if (TT && TT.onReady) {
      TT.onReady(function () {
        feel = TT.feel || null;
        if (feel && typeof feel.motionAllowed === 'function' && !feel.motionAllowed()) {
          root.classList.add('is-motion-reduced');
        }
      });
    }

    syncStatus();
  })();
</script>
