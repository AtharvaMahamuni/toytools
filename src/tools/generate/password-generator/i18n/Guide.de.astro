---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Ein starkes Passwort entsteht durch echte Zufälligkeit und ausreichende Länge, nicht durch leicht durchschaubare Ersetzungen wie „@“ statt „a“. Ab 16 zufälligen Zeichen über die Web Crypto API bleibt die Schlüsselerzeugung vollständig lokal auf deinem Gerät und schützt zuverlässig vor Wörterbuch- und Brute-Force-Angriffen.
    </p>
    <a href={toolHref} class="cta-link">Passwort-Generator öffnen →</a>
  </section>

  <section id="laenge-statt-komplexitaet">
    <h2>Warum Länge wichtiger ist als Komplexität <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Jedes zusätzliche Zeichen vervielfacht den Suchraum exponentiell. Ein kurzes 8-Zeichen-Passwort mit Sonderzeichen bleibt schneller knackbar als ein 16- bis 20-stelliges Zufallspasswort aus Buchstaben und Ziffern.
    </p>
    <ReferenceBlock type="key-idea" heading="Richtwert für Entropie">
      <p>Für Standardkonten genügen 60 bis 80 Bit Entropie; für E-Mail, Banking und Master-Passwörter sind 100 Bit oder mehr empfehlenswert. 16 Zeichen mit allen vier Zeichensätzen erreichen etwa 103 Bit.</p>
    </ReferenceBlock>
  </section>

  <section id="aufbewahrung">
    <h2>Sichere Aufbewahrung und passende Tools <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Speichere jedes Passwort einzeln in einem verschlüsselten Passwort-Manager und schließe verwechselbare Zeichen aus, falls es abgetippt werden muss. Für WLAN-Zugangsdaten hilft der <a href={toolPathBySlug('qr-code-generator', 'de')}>QR-Code-Generator</a>, für Datensatz-IDs der <a href={toolPathBySlug('uuid-generator', 'de')}>UUID-Generator</a> und für technische Tokens der <a href={toolPathBySlug('random-string-generator')}>Random String Generator</a>.
    </p>
  </section>
</GuideLayout>
