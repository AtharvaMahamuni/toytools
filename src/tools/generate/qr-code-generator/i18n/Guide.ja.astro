---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath, categoryPath } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find((c) => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
const categoryHref = categoryPath(category, 'ja');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="ja"
>
  <section id="quick-answer">
    <h2>概要（クイック回答） <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      QRコードはスマートフォンのカメラで読み取るだけでWebサイトを開いたり、Wi-Fiへ自動接続したり、連絡先を登録したりできる2次元バーコードです。この作成ツールは種類（URL・Wi-Fi・vCard・メール・電話・テキスト）を選ぶだけでブラウザ内に即座に生成し、PNGとベクターSVGの両方で無料ダウンロードできます。
    </p>
    <a href={toolHref} class="cta-link">QRコード作成ツールを開く →</a>
  </section>

  <section id="why-local">
    <h2>ローカル生成が安心な理由 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Wi-Fiのパスワードや個人の電話番号・メールアドレスを含むQRコードを外部サイトで作成すると、入力内容がサーバーに送信されたり、中継リダイレクトURLへ書き換えられたりするリスクがあります。本ツールは通信を行わないため、有効期限もトラッキングもない純正の静的QRコードが作れます。
    </p>
    <ReferenceBlock type="key-idea" heading="QRコードの中身は標準化されたテキストです">
      <p>Wi-Fi接続なら <code>WIFI:T:WPA;S:...;;</code> のようにスマホOSが解釈できる決まったテキスト構文を並べることで自動起動します。</p>
    </ReferenceBlock>
  </section>

  <section id="printing-tips">
    <h2>印刷・保存で失敗しないためのポイント <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>チラシやポスター印刷には SVG を選ぶ:</strong> ベクターSVGならどれほど拡大しても境界線がギザギザになりません。</li>
      <li><strong>周囲の白い余白（クワイエットゾーン）を残す:</strong> 枠線の外側に余白がないとカメラが認識できません。</li>
      <li><strong>URLはなるべく短くする:</strong> パラメータを削るほどドットが大きくなり暗い室内でも素早く読み取れます。</li>
      <li><strong>大部数印刷の前に実機テスト:</strong> 印刷原稿の原寸サイズで必ずiPhoneとAndroid両方で確認してください。</li>
    </ul>
    <ReferenceBlock type="common-mistake" heading="有効期限やデザイン破壊に注意">
      <p>生成した静的QRコードは半永久的に有効ですが、後から飛び先を変更することはできません。将来のURL変更が想定される場合は自前ドメインの短縮URLなどをご活用ください。</p>
    </ReferenceBlock>
  </section>

  <section id="next-steps">
    <h2>関連カテゴリー <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      パスワードやUUIDの作成ツールも揃う <a href={categoryHref}>生成ツール一覧</a> もあわせてご活用ください。
    </p>
  </section>
</GuideLayout>
