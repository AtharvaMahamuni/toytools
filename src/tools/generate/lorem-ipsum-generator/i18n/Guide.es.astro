---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Lorem Ipsum es el texto simulado universal para evaluar maquetación, tipografía y espaciado antes de recibir la redacción definitiva. Al no distraer con el significado de las palabras, permite centrar la revisión visual en la estructura de la interfaz o el documento impreso.
    </p>
    <a href={toolHref} class="cta-link">Abrir Generador Lorem Ipsum →</a>
  </section>

  <section id="origen-ciceron">
    <h2>Origen clásico y ventajas visuales <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      El pasaje clásico proviene de una adaptación fragmentada de *De finibus bonorum et malorum*, obra escrita por Cicerón en el año 45 a. C. Frente a palabras aleatorias en español, mantiene longitudes silábicas y puntuación equilibradas para juzgar el color tipográfico sin leer cada frase.
    </p>
    <ReferenceBlock type="key-idea" heading="Sustituir antes de publicar">
      <p>Usa texto simulado en bocetos iniciales y pruebas de fuentes, pero valida titulares, botones y límites reales con copy aproximado antes de dar el visto bueno final.</p>
    </ReferenceBlock>
  </section>

  <section id="medir-texto">
    <h2>Control de longitud y herramientas útiles <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Si estás preparando maquetas con límites estrictos, puedes comprobar el volumen exacto de palabras en el <a href={toolPathBySlug('word-counter', 'es')}>Contador de Palabras</a> o verificar el número máximo de caracteres admitidos con el <a href={toolPathBySlug('character-counter', 'es')}>Contador de Caracteres</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
