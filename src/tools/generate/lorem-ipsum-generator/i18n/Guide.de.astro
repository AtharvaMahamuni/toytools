---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Lorem ipsum ist der etablierte Blindtext im Grafik- und Webdesign, um Layouts, Schriftarten und Abstände zu prüfen, bevor finale Inhalte feststehen. Weil der Text keine lesbare Aussage trägt, bleibt der Blick unvoreingenommen auf der Gestaltung.
    </p>
    <a href={toolHref} class="cta-link">Lorem-Ipsum-Generator öffnen →</a>
  </section>

  <section id="herkunft">
    <h2>Herkunft bei Cicero und typografischer Nutzen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Die Textbasis stammt aus einer stark abgewandelten Passage von Ciceros Werk *De finibus bonorum et malorum* aus dem Jahr 45 v. Chr. Gegenüber deutschen Zufallswörtern entsteht ein ruhiger Grauwert ohne ungewollte Leseablenkung.
    </p>
    <ReferenceBlock type="key-idea" heading="Rechtzeitig durch echten Text ersetzen">
      <p>Für erste Wireframes und Schrifttests eignet sich Blindtext ideal; vor der Abnahme sollten jedoch realistische Überschriften und Maximallängen mit echtem Content überprüft werden.</p>
    </ReferenceBlock>
  </section>

  <section id="textlaenge-messen">
    <h2>Textmenge gezielt abstimmen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Wenn dein Design feste Textgrenzen hat, prüfe den genauen Umfang direkt im <a href={toolPathBySlug('word-counter', 'de')}>Wörterzähler</a> oder kontrolliere knappe UI-Labels im <a href={toolPathBySlug('character-counter', 'de')}>Zeichenzähler</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
