---
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
---

<section class="tool-panel" data-tool="todo-list">
  <p class="todo-storage-note">
    Stored locally <span class="gold-dot" aria-hidden="true"></span> Never leaves your device
  </p>
  <div class="todo-add">
    <input id="todo-new-task" type="text" aria-label="Add a task" placeholder="Add a task..." autocomplete="off" enterkeyhint="done" />
    <button id="todo-add-btn" type="button">Add</button>
  </div>
  <div class="todo-toolbar">
    <button id="todo-fullscreen" type="button" aria-pressed="false">Full Screen</button>
    <button id="todo-distraction" type="button" aria-pressed="false">Remove Distractions</button>
    <button id="todo-wake" type="button" aria-pressed="false">Keep Awake</button>
    <span id="todo-wake-timer" class="todo-wake-timer" hidden aria-live="polite">
      <span class="todo-wake-dot" aria-hidden="true"></span>
      <span id="todo-wake-elapsed" class="todo-wake-elapsed">00:00:00</span>
    </span>
    <button id="todo-focus-exit" type="button" class="tt-focus-exit" hidden>Exit Focus</button>
  </div>
  <div id="todo-list-container" aria-live="polite"></div>
  <div class="todo-footer">
    <div class="todo-footer-row">
      <div id="todo-progress" class="todo-progress" aria-live="polite"></div>
      <label class="todo-hide-label">
        <input type="checkbox" id="todo-hide-completed" aria-label="Hide completed tasks" />
        Hide Completed
      </label>
    </div>
    <div id="todo-progress-track" class="todo-progress-track" hidden aria-hidden="true">
      <div id="todo-progress-bar" class="todo-progress-bar"></div>
    </div>
  </div>
</section>

<CategoryDiscovery toolSlug="todo-list" />



<style is:global>
  .todo-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .todo-add {
    display: flex;
    gap: var(--space-2);
  }

  .todo-add input {
    flex: 1;
    min-height: var(--touch-target);
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-base);
    font-family: inherit;
  }

  .todo-add button {
    min-height: var(--touch-target);
    padding-inline: var(--space-5);
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .todo-add button:hover { opacity: 0.9; }
  .todo-add button:active { opacity: 0.8; }

  .todo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .todo-toolbar button {
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    background: transparent;
    border: var(--border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
    transition: var(--transition-color);
  }

  .todo-toolbar button:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .todo-toolbar button:active { background: var(--color-bg-tertiary); }

  .todo-toolbar button[aria-pressed="true"] {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  /* Elapsed timer shown while Keep Awake is active */
  .todo-wake-timer {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .todo-wake-timer[hidden] { display: none; }

  .todo-wake-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    animation: dot-breathe 5s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .todo-wake-dot { animation: none; }
  }

  .todo-wake-elapsed {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  #todo-list-container {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .todo-empty {
    padding: var(--space-8) 0;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    text-align: center;
  }

  .todo-task {
    border-top: var(--border);
    padding-block: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    transition: box-shadow var(--duration-normal) ease,
                background-color var(--duration-normal) ease,
                opacity var(--duration-normal) ease,
                transform var(--duration-normal) ease;
  }

  /* The row being dragged lifts off the list as a card. */
  .todo-task.todo-dragging {
    border-top-color: transparent;
    background: var(--color-bg);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
    cursor: grabbing;
    position: relative;
    z-index: 2;
  }
  .todo-task.todo-collapsing {
    opacity: 0;
    transform: translateX(8px);
  }

  .todo-task-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  /* Six-dot grip. Aligns to the first line of the title (line box = 1.5rem). */
  .todo-drag-handle,
  .todo-subtask-drag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-text-subtle);
    cursor: grab;
    border-radius: var(--radius-sm);
    touch-action: none;
    opacity: 0;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }
  .todo-drag-handle svg,
  .todo-subtask-drag svg { width: 16px; height: 16px; display: block; }
  .todo-subtask-drag { width: 20px; height: 20px; }
  .todo-subtask-drag svg { width: 14px; height: 14px; }

  .todo-task-row:hover .todo-drag-handle,
  .todo-task:focus-within .todo-drag-handle,
  .todo-subtask-row:hover .todo-subtask-drag,
  .todo-subtask-row:focus-within .todo-subtask-drag {
    opacity: 1;
  }
  .todo-drag-handle:hover,
  .todo-subtask-drag:hover { color: var(--color-text); background: var(--color-bg-tertiary); }
  .todo-drag-handle:active,
  .todo-subtask-drag:active { cursor: grabbing; }

  /* Minimal custom checkbox — square, hollow → accent fill + check on done */
  .todo-checkbox,
  .todo-subtask-checkbox {
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    box-sizing: border-box;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    cursor: pointer;
    position: relative;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .todo-checkbox {
    width: 20px;
    height: 20px;
    /* Center the 20px box against the first line of the title (1.5rem = 24px box). */
    margin-top: calc((1.5rem - 20px) / 2);
  }

  .todo-checkbox:hover,
  .todo-subtask-checkbox:hover { border-color: var(--color-accent); }

  .todo-checkbox:checked,
  .todo-subtask-checkbox:checked {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* The tick — drawn with a rotated border corner. */
  .todo-checkbox::after,
  .todo-subtask-checkbox::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid var(--color-text-inverse);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) scale(0);
    opacity: 0;
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }
  .todo-checkbox:checked::after,
  .todo-subtask-checkbox:checked::after {
    transform: rotate(45deg) scale(1);
    opacity: 1;
  }
  .todo-subtask-checkbox::after {
    left: 4.5px;
    top: 1.5px;
    width: 4px;
    height: 8px;
  }

  /* Satisfying pop, fired from JS on genuine user toggle only (not on re-render). */
  .todo-checkbox.todo-pop,
  .todo-subtask-checkbox.todo-pop { animation: todo-box-pop var(--duration-normal) var(--ease-default); }
  .todo-checkbox.todo-pop::after,
  .todo-subtask-checkbox.todo-pop::after { animation: todo-check-in var(--duration-normal) var(--ease-default); }

  @keyframes todo-box-pop {
    0%   { transform: scale(1); }
    45%  { transform: scale(0.86); }
    100% { transform: scale(1); }
  }
  @keyframes todo-check-in {
    0%   { transform: rotate(45deg) scale(0); opacity: 0; }
    60%  { transform: rotate(45deg) scale(1.25); opacity: 1; }
    100% { transform: rotate(45deg) scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .todo-checkbox.todo-pop,
    .todo-subtask-checkbox.todo-pop,
    .todo-checkbox.todo-pop::after,
    .todo-subtask-checkbox.todo-pop::after { animation: none; }
    .todo-checkbox::after,
    .todo-subtask-checkbox::after { transition: none; }
  }

  .todo-title {
    flex: 1;
    font-size: var(--text-base);
    line-height: 1.5;
    transition: color var(--duration-fast) ease;
    word-break: break-word;
  }

  .todo-task--done .todo-title {
    text-decoration: line-through;
    color: var(--color-text-subtle);
  }

  /* Minimal delete — quiet ✕ glyph, reveals on hover/focus, aligns to first line. */
  .todo-delete,
  .todo-subtask-delete {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    color: var(--color-text-subtle);
    font-size: var(--text-base);
    line-height: 1;
    font-family: inherit;
    cursor: pointer;
    border-radius: var(--radius-sm);
    opacity: 0;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .todo-task-row:hover .todo-delete,
  .todo-task:focus-within .todo-delete,
  .todo-subtask-row:hover .todo-subtask-delete,
  .todo-subtask-row:focus-within .todo-subtask-delete {
    opacity: 1;
  }

  /* Touch devices have no hover — drag handles and delete stay visible. */
  @media (hover: none) {
    .todo-delete,
    .todo-subtask-delete,
    .todo-drag-handle,
    .todo-subtask-drag {
      opacity: 1;
    }
  }

  .todo-delete:hover,
  .todo-subtask-delete:hover {
    color: var(--color-danger);
    background: var(--color-danger-bg);
  }

  .todo-subtasks {
    /* Indent past the drag handle so subtasks nest under the parent checkbox column. */
    padding-left: calc(24px + var(--space-2));
    display: flex;
    flex-direction: column;
    margin-top: var(--space-1);
  }

  .todo-subtask-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    padding-block: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    transition: box-shadow var(--duration-normal) ease;
  }
  .todo-subtask-row.todo-dragging {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    cursor: grabbing;
    position: relative;
    z-index: 2;
  }

  .todo-subtask-checkbox {
    width: 16px;
    height: 16px;
  }

  .todo-subtask-title {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
    word-break: break-word;
  }

  .todo-subtask--done .todo-subtask-title {
    text-decoration: line-through;
    color: var(--color-text-subtle);
  }

  .todo-add-subtask {
    display: flex;
    gap: var(--space-2);
    padding-left: calc(24px + var(--space-2));
    margin-top: var(--space-2);
  }

  .todo-add-subtask input {
    flex: 1;
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .todo-add-subtask-btn {
    min-height: 40px;
    padding-inline: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-color);
  }

  .todo-add-subtask-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .todo-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
  }

  .todo-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .todo-progress {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Unique touch: a slim completion bar under the footer summary. */
  .todo-progress-track {
    height: 4px;
    width: 100%;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .todo-progress-track[hidden] { display: none; }

  .todo-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    transition: width var(--duration-normal) var(--ease-default);
  }
  @media (prefers-reduced-motion: reduce) {
    .todo-progress-bar { transition: none; }
    .todo-task { transition: none; }
  }

  .todo-hide-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    font-weight: var(--font-weight-normal);
  }

  .todo-hide-label input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    box-sizing: border-box;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    cursor: pointer;
    position: relative;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .todo-hide-label input[type="checkbox"]:hover { border-color: var(--color-accent); }

  .todo-hide-label input[type="checkbox"]:checked {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .todo-hide-label input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 4.5px;
    top: 1.5px;
    width: 4px;
    height: 8px;
    border: solid var(--color-text-inverse);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
</style>

<script is:inline>
  (function () {
    var newTaskInput = document.getElementById('todo-new-task');
    if (!newTaskInput) return;

    var STORAGE_KEY = 'toytools.todo.tasks';
    var tasks = [];

    // A six-dot grip glyph, inline so it inherits currentColor and needs no asset.
    var GRIP_SVG = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">' +
      '<circle cx="5" cy="3" r="1.4"/><circle cx="11" cy="3" r="1.4"/>' +
      '<circle cx="5" cy="8" r="1.4"/><circle cx="11" cy="8" r="1.4"/>' +
      '<circle cx="5" cy="13" r="1.4"/><circle cx="11" cy="13" r="1.4"/></svg>';

    function loadTasks() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) tasks = JSON.parse(saved);
      } catch (_) { tasks = []; }
    }

    function saveTasks() {
      try {
        var str = JSON.stringify(tasks);
        if (str.length < ToyTools.storage.MAX) localStorage.setItem(STORAGE_KEY, str);
      } catch (_) {}
    }

    function uid() {
      return Date.now().toString(36) + Math.random().toString(36).slice(2);
    }

    function findTask(id) { return tasks.find(function (x) { return x.id === id; }); }

    function addTask(title) {
      tasks.unshift({ id: uid(), title: title, completed: false, createdAt: new Date().toISOString(), subtasks: [] });
      saveTasks(); render();
    }

    function deleteTask(id) {
      tasks = tasks.filter(function (x) { return x.id !== id; });
      saveTasks(); render();
    }

    function addSubtask(taskId, title) {
      var t = findTask(taskId);
      if (t) { t.subtasks.push({ id: uid(), title: title, completed: false }); saveTasks(); render(); }
    }

    function deleteSubtask(taskId, subId) {
      var t = findTask(taskId);
      if (t) { t.subtasks = t.subtasks.filter(function (x) { return x.id !== subId; }); saveTasks(); render(); }
    }

    // ---- Pointer + keyboard drag-to-reorder -------------------------------
    // Handle-only drag that works with mouse and touch (Pointer Events), plus
    // ArrowUp/ArrowDown when the grip is focused. Live-reorders the DOM, then
    // commits the new order back to the data model on drop.
    function makeSortable(handle, item, container, commit) {
      var dragging = false, pid = null;

      function siblings() {
        var out = [];
        Array.prototype.forEach.call(container.children, function (c) {
          if (c !== item && c.hasAttribute('data-id')) out.push(c);
        });
        return out;
      }

      function onMove(e) {
        if (!dragging) return;
        var y = e.clientY;
        var sibs = siblings(), placed = false;
        for (var i = 0; i < sibs.length; i++) {
          var r = sibs[i].getBoundingClientRect();
          if (y < r.top + r.height / 2) { container.insertBefore(item, sibs[i]); placed = true; break; }
        }
        if (!placed) container.appendChild(item);
      }

      function onUp() {
        if (!dragging) return;
        dragging = false;
        item.classList.remove('todo-dragging');
        try { handle.releasePointerCapture(pid); } catch (_) {}
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
        document.removeEventListener('pointercancel', onUp);
        commit();
      }

      handle.addEventListener('pointerdown', function (e) {
        if (e.button != null && e.button > 0) return; // primary button / touch only
        e.preventDefault();
        dragging = true; pid = e.pointerId;
        item.classList.add('todo-dragging');
        try { handle.setPointerCapture(pid); } catch (_) {}
        document.addEventListener('pointermove', onMove);
        document.addEventListener('pointerup', onUp);
        document.addEventListener('pointercancel', onUp);
      });

      handle.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
        e.preventDefault();
        if (e.key === 'ArrowUp') {
          var prev = item.previousElementSibling;
          if (prev && prev.hasAttribute('data-id')) container.insertBefore(item, prev);
        } else {
          var next = item.nextElementSibling;
          if (next && next.hasAttribute('data-id')) container.insertBefore(next, item);
        }
        commit();
        handle.focus();
      });
    }

    function domOrderIds(container) {
      var ids = [];
      Array.prototype.forEach.call(container.children, function (c) {
        var id = c.getAttribute('data-id');
        if (id) ids.push(id);
      });
      return ids;
    }

    // Reorder top-level tasks from the DOM. When "Hide Completed" filters some
    // out, only the visible slots are reshuffled; hidden tasks keep their spot.
    function commitTaskOrder(container) {
      var domIds = domOrderIds(container);
      var visible = {};
      domIds.forEach(function (id) { visible[id] = true; });
      var byId = {};
      tasks.forEach(function (t) { byId[t.id] = t; });
      var vi = 0;
      tasks = tasks.map(function (t) {
        if (visible[t.id]) { var nt = byId[domIds[vi]]; vi++; return nt || t; }
        return t;
      });
      saveTasks();
    }

    function commitSubtaskOrder(taskId, container) {
      var t = findTask(taskId);
      if (!t) return;
      var domIds = domOrderIds(container);
      var byId = {};
      t.subtasks.forEach(function (s) { byId[s.id] = s; });
      var reordered = domIds.map(function (id) { return byId[id]; }).filter(Boolean);
      if (reordered.length === t.subtasks.length) { t.subtasks = reordered; saveTasks(); }
    }

    // ---- Surgical toggles (no full re-render, so the pop animation shows) --
    function popCheckbox(cb) {
      cb.classList.remove('todo-pop');
      // Force reflow so re-adding the class restarts the animation.
      void cb.offsetWidth;
      cb.classList.add('todo-pop');
      setTimeout(function () { cb.classList.remove('todo-pop'); }, 260);
    }

    function toggleTask(task, itemEl, cb) {
      task.completed = cb.checked;
      saveTasks();
      if (task.completed) popCheckbox(cb);
      itemEl.classList.toggle('todo-task--done', task.completed);

      var hideEl = document.getElementById('todo-hide-completed');
      if (hideEl && hideEl.checked && task.completed) {
        // Collapse the row out, then drop it from the DOM (data already saved).
        itemEl.classList.add('todo-collapsing');
        setTimeout(function () { if (itemEl.parentNode) itemEl.parentNode.removeChild(itemEl); updateProgress(); }, 200);
      } else {
        updateProgress();
      }
    }

    function toggleSubtask(sub, rowEl, cb) {
      sub.completed = cb.checked;
      saveTasks();
      if (sub.completed) popCheckbox(cb);
      rowEl.classList.toggle('todo-subtask--done', sub.completed);
      updateProgress();
    }

    // ---- Rendering ---------------------------------------------------------
    function makeHandle(cls, label) {
      var h = document.createElement('button');
      h.type = 'button'; h.className = cls; h.innerHTML = GRIP_SVG;
      h.setAttribute('aria-label', label);
      h.title = label;
      return h;
    }

    function createSubtaskEl(taskId, sub, subList) {
      var row = document.createElement('div');
      row.className = 'todo-subtask-row' + (sub.completed ? ' todo-subtask--done' : '');
      row.setAttribute('data-id', sub.id);

      var handle = makeHandle('todo-subtask-drag', 'Reorder subtask, or use arrow keys');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.className = 'todo-subtask-checkbox'; cb.checked = sub.completed;
      cb.setAttribute('aria-label', sub.title);
      cb.addEventListener('change', function () { toggleSubtask(sub, row, cb); });
      var title = document.createElement('span');
      title.className = 'todo-subtask-title'; title.textContent = sub.title;
      var del = document.createElement('button');
      del.type = 'button'; del.className = 'todo-subtask-delete'; del.textContent = '✕';
      del.setAttribute('aria-label', 'Delete subtask');
      del.addEventListener('click', function () { deleteSubtask(taskId, sub.id); });

      row.appendChild(handle); row.appendChild(cb); row.appendChild(title); row.appendChild(del);
      makeSortable(handle, row, subList, function () { commitSubtaskOrder(taskId, subList); });
      return row;
    }

    function createTaskEl(task, container) {
      var item = document.createElement('div');
      item.className = 'todo-task' + (task.completed ? ' todo-task--done' : '');
      item.setAttribute('data-id', task.id);

      var row = document.createElement('div'); row.className = 'todo-task-row';
      var handle = makeHandle('todo-drag-handle', 'Reorder task, or use arrow keys');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.className = 'todo-checkbox'; cb.checked = task.completed;
      cb.setAttribute('aria-label', task.title);
      cb.addEventListener('change', function () { toggleTask(task, item, cb); });
      var title = document.createElement('span');
      title.className = 'todo-title'; title.textContent = task.title;
      var del = document.createElement('button');
      del.type = 'button'; del.className = 'todo-delete'; del.textContent = '✕';
      del.setAttribute('aria-label', 'Delete task');
      del.addEventListener('click', function () { deleteTask(task.id); });
      row.appendChild(handle); row.appendChild(cb); row.appendChild(title); row.appendChild(del);
      item.appendChild(row);

      var subList = document.createElement('div'); subList.className = 'todo-subtasks';
      task.subtasks.forEach(function (sub) { subList.appendChild(createSubtaskEl(task.id, sub, subList)); });
      if (task.subtasks.length > 0) item.appendChild(subList);

      var addSub = document.createElement('div'); addSub.className = 'todo-add-subtask';
      var subInput = document.createElement('input');
      subInput.type = 'text'; subInput.placeholder = 'Add subtask...'; subInput.autocomplete = 'off';
      subInput.setAttribute('enterkeyhint', 'done');
      function submitSub() { var val = subInput.value.trim(); if (val) addSubtask(task.id, val); }
      subInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') submitSub(); });
      var subBtn = document.createElement('button');
      subBtn.type = 'button'; subBtn.className = 'todo-add-subtask-btn'; subBtn.textContent = 'Add Subtask';
      subBtn.addEventListener('click', submitSub);
      addSub.appendChild(subInput); addSub.appendChild(subBtn);
      item.appendChild(addSub);

      makeSortable(handle, item, container, function () { commitTaskOrder(container); });
      return item;
    }

    function updateProgress() {
      var el = document.getElementById('todo-progress');
      var track = document.getElementById('todo-progress-track');
      var bar = document.getElementById('todo-progress-bar');
      if (tasks.length === 0) {
        if (el) el.textContent = '';
        if (track) track.hidden = true;
        return;
      }
      // Count every checkable item — each task and each of its subtasks — so the
      // percentage reflects subtask progress, not just top-level tasks.
      var total = 0, done = 0;
      tasks.forEach(function (t) {
        total += 1; if (t.completed) done += 1;
        t.subtasks.forEach(function (s) { total += 1; if (s.completed) done += 1; });
      });
      var pct = Math.round((done / total) * 100);
      if (el) el.textContent = done + ' of ' + total + ' completed ● ' + pct + '%';
      if (track) track.hidden = false;
      if (bar) bar.style.width = pct + '%';
    }

    function render() {
      var container = document.getElementById('todo-list-container'); if (!container) return;
      var hideEl = document.getElementById('todo-hide-completed');
      var hideCompleted = hideEl ? hideEl.checked : false;
      container.innerHTML = '';
      if (tasks.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'todo-empty'; empty.textContent = 'No tasks yet. Add your first task above.';
        container.appendChild(empty); updateProgress(); return;
      }
      var visible = hideCompleted ? tasks.filter(function (t) { return !t.completed; }) : tasks;
      visible.forEach(function (task) { container.appendChild(createTaskEl(task, container)); });
      updateProgress();
    }

    document.getElementById('todo-add-btn')?.addEventListener('click', function () {
      var val = newTaskInput.value.trim();
      if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
    });

    newTaskInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        var val = newTaskInput.value.trim();
        if (val) { addTask(val); newTaskInput.value = ''; newTaskInput.focus(); }
      }
    });

    document.getElementById('todo-hide-completed')?.addEventListener('change', render);

    loadTasks(); render();

    // Keep Awake elapsed timer — shown only while the wake lock is held.
    var wakeTimer = document.getElementById('todo-wake-timer');
    var wakeElapsed = document.getElementById('todo-wake-elapsed');
    var wakeStart = null, wakeInterval = null;

    function pad(n) { return String(n).padStart(2, '0'); }

    function renderElapsed() {
      if (!wakeElapsed || wakeStart === null) return;
      var s = Math.floor((Date.now() - wakeStart) / 1000);
      var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
      wakeElapsed.textContent = pad(h) + ':' + pad(m) + ':' + pad(sec);
    }

    function startWakeTimer() {
      wakeStart = Date.now();
      renderElapsed();
      if (wakeTimer) wakeTimer.hidden = false;
      wakeInterval = setInterval(renderElapsed, 1000);
    }

    function stopWakeTimer() {
      if (wakeInterval) { clearInterval(wakeInterval); wakeInterval = null; }
      wakeStart = null;
      if (wakeTimer) wakeTimer.hidden = true;
    }

    ToyTools.focus.attach({
      panel: document.querySelector('.tool-panel[data-tool="todo-list"]'),
      fsBtn: document.getElementById('todo-fullscreen'),
      rdBtn: document.getElementById('todo-distraction'),
      wakeBtn: document.getElementById('todo-wake'),
      exitBtn: document.getElementById('todo-focus-exit'),
      onEnter: function () { newTaskInput.focus(); },
      onWakeChange: function (on) { if (on) startWakeTimer(); else stopWakeTimer(); }
    });
  })();
</script>
