---
// Keep Screen Awake.
//
// The whole product is a promise about something invisible: "the screen you are looking at would
// have slept, and it did not." Two consequences shape this widget.
//
//   1. Trust is the feature. The UI must never claim "Awake" while the lock is actually gone, so
//      every frame of the status is derived from the live WakeLockSentinel, and a lock lost mid
//      session is reported and retried rather than hidden.
//   2. The screen is the product. Most sessions are a propped-up phone read across a room, so the
//      ambient view is a first-class surface, not a hidden "remove distractions" mode.
//
// One render() derives every visible element from one state object. The previous version mutated
// six elements from five call sites and could desync (a failed re-acquire left the ticker running
// behind a "Sleeping" label).
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import { withBase } from '@lib/paths';

const toolUrl = withBase('/tool/productivity/keep-screen-awake/');
const iconUrl = withBase('/favicon.ico');
---

<!-- URLs for the completion notification (no import.meta.env inside is:inline) -->
<meta id="wl-tool-url" content={toolUrl} />
<meta id="wl-icon-url" content={iconUrl} />

<ToolSplit ratio="1-1" stackOrder="output-first" stickyOutput={false} equalHeight={false}>

<!-- ── Status: the answer, first on mobile ───────────────────────────────── -->
<div slot="output">
  <IoPanel label="Screen" result={true} class="wl-panel">
    <div class="wl-stage" data-state="idle" id="wl-stage">
      <div class="wl-ring-wrapper">
        <div class="wl-lamp" aria-hidden="true"></div>
        <svg viewBox="0 0 200 200" class="wl-ring-svg" aria-hidden="true">
          <circle class="wl-ring-track" cx="100" cy="100" r="85" />
          <circle
            id="wl-ring-progress"
            class="wl-ring-progress"
            cx="100" cy="100" r="85"
            stroke-dasharray="534"
            stroke-dashoffset="534"
          />
        </svg>
        <div class="wl-hero-overlay">
          <span id="wl-hero" class="wl-hero">0:00</span>
          <span id="wl-hero-label" class="wl-hero-label">Ready</span>
        </div>
      </div>

      <p id="wl-live" class="wl-sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

      <button id="wl-toggle" type="button" class="wl-primary" aria-pressed="false">
        Keep Screen Awake
      </button>

      <p id="wl-lock" class="wl-lock" data-lock="none">Ready when you are.</p>

      <dl id="wl-meta" class="wl-meta" hidden>
        <div class="wl-meta-row"><dt>Started</dt><dd id="wl-started-value"></dd></div>
        <div id="wl-ends-row" class="wl-meta-row" hidden><dt>Ends</dt><dd id="wl-ends-value"></dd></div>
      </dl>

      <p id="wl-today" class="wl-today" hidden></p>

      <div class="wl-view-actions">
        <button id="wl-ambient-btn" type="button" class="wl-text-btn">Ambient mode</button>
      </div>
    </div>
  </IoPanel>
</div>

<!-- ── Session setup ─────────────────────────────────────────────────────── -->
<div slot="input">
  <IoPanel label="Session" class="wl-panel">
    <div class="io-body">
      <div id="wl-unsupported" hidden class="wl-unsupported">
        <p class="wl-unsupported-title">This browser cannot hold a wake lock.</p>
        <p id="wl-unsupported-hint" class="wl-unsupported-hint"></p>
      </div>

      <fieldset class="wl-fieldset">
        <legend class="wl-legend">Keep awake for</legend>
        <div class="wl-duration-grid" role="group" aria-label="Session length">
          <button data-duration="0"    class="wl-dur is-selected" type="button">Until I stop</button>
          <button data-duration="900"  class="wl-dur" type="button">15 min</button>
          <button data-duration="1800" class="wl-dur" type="button">30 min</button>
          <button data-duration="3600" class="wl-dur" type="button">1 hour</button>
          <button data-duration="7200" class="wl-dur" type="button">2 hours</button>
        </div>
        <div class="wl-custom-row">
          <label class="wl-custom-label" for="wl-custom-min">Custom</label>
          <input
            id="wl-custom-min"
            type="number"
            min="1"
            max="480"
            inputmode="numeric"
            enterkeyhint="done"
            autocomplete="off"
            placeholder="minutes"
            class="wl-custom-input"
          />
        </div>
      </fieldset>

      <details class="wl-options">
        <summary class="wl-options-summary">Alerts and display</summary>
        <div class="wl-options-body">
          <label class="wl-check-row">
            <input id="wl-sound" type="checkbox" class="wl-checkbox" />
            <span>Chime when the session ends</span>
          </label>
          <label class="wl-check-row">
            <input id="wl-notify" type="checkbox" class="wl-checkbox" />
            <span>Browser notification when it ends</span>
          </label>
          <label id="wl-guard-row" class="wl-check-row" hidden>
            <input id="wl-guard" type="checkbox" class="wl-checkbox" />
            <span>Release below 15% battery</span>
          </label>
          <div class="wl-format-row" role="group" aria-label="Clock format">
            <span class="wl-format-label">Clock</span>
            <button data-format="12" class="wl-fmt is-selected" type="button">12h</button>
            <button data-format="24" class="wl-fmt" type="button">24h</button>
          </div>
          <p id="wl-battery" class="wl-battery" hidden></p>
        </div>
      </details>
    </div>
  </IoPanel>
</div>

</ToolSplit>

<CategoryDiscovery toolSlug="keep-screen-awake" />

<!-- ── Ambient view ──────────────────────────────────────────────────────── -->
<!-- The propped-up-phone surface: a big clock read across a room. Controls fade out so the
     screen is calm, and the whole block drifts slowly so an OLED left on for two hours does
     not burn in. -->
<div id="wl-ambient" class="wl-ambient" data-state="idle" data-dim="0" data-chrome="on" hidden>
  <div class="wl-ambient-drift">
    <div class="wl-ambient-content">
      <span id="wl-amb-clock" class="wl-amb-clock">00:00</span>
      <div class="wl-amb-status">
        <span id="wl-amb-dot" class="wl-amb-dot" data-state="idle" aria-hidden="true"></span>
        <span id="wl-amb-state" class="wl-amb-state">Sleeping</span>
      </div>
      <div id="wl-amb-timer" class="wl-amb-timer" hidden>
        <span id="wl-amb-timer-label" class="wl-amb-meta">Remaining</span>
        <span id="wl-amb-timer-value" class="wl-amb-timer-value">0:00</span>
      </div>
      <div id="wl-amb-ends" class="wl-amb-ends" hidden>
        <span class="wl-amb-meta">Ends at</span>
        <span id="wl-amb-ends-value" class="wl-amb-ends-value"></span>
      </div>
    </div>
  </div>

  <div id="wl-amb-controls" class="wl-amb-controls">
    <button id="wl-amb-toggle" type="button" class="wl-amb-btn">Keep Awake</button>
    <button id="wl-amb-dim"    type="button" class="wl-amb-btn wl-amb-btn--quiet">Dim</button>
    <button id="wl-amb-exit"   type="button" class="wl-amb-btn wl-amb-btn--quiet">Exit</button>
  </div>
</div>

<style>
  .wl-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Status stage ──────────────────────────────────────────────────────── */
  .wl-stage {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    text-align: center;
  }

  .wl-ring-wrapper {
    position: relative; width: 200px; height: 200px; flex-shrink: 0;
  }

  /* The lamp: the single "it is on" signal. Gold is the brand's live colour, so the ring
     glowing is the whole status readout — no separate dot, label and message competing. */
  .wl-lamp {
    position: absolute; inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-gold-subtle) 0%, transparent 68%);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-default);
  }
  .wl-stage[data-state="active"] .wl-lamp {
    opacity: 1;
    animation: dot-breathe 5s ease-in-out infinite;
  }

  .wl-ring-svg { position: relative; width: 100%; height: 100%; }
  .wl-ring-track { fill: none; stroke: var(--color-border); stroke-width: 6; }
  .wl-ring-progress {
    fill: none; stroke: var(--color-gold); stroke-width: 6; stroke-linecap: round;
    transform-origin: 100px 100px; transform: rotate(-90deg);
  }
  .wl-stage[data-state="completed"] .wl-ring-progress { stroke: var(--color-success); }

  .wl-hero-overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-1);
  }

  .wl-hero {
    font-family: var(--font-mono);
    font-size: clamp(var(--text-2xl), 7vw, var(--text-4xl));
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .wl-hero-label {
    font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  /* ── Primary control ───────────────────────────────────────────────────── */
  /* The kill switch was an 18px toggle: the one control that matters, a quarter of the
     minimum touch target. It is now a full-width press target with a real pressed state,
     because phones have no hover. */
  .wl-primary {
    width: 100%; max-width: 280px;
    min-height: var(--touch-target);
    padding-inline: var(--space-6);
    background: var(--color-text); color: var(--color-bg);
    border: 1px solid var(--color-text); border-radius: var(--radius-md);
    font-size: var(--text-sm); font-weight: var(--font-weight-semibold);
    font-family: inherit; cursor: pointer;
    transition: var(--transition-color);
  }
  .wl-primary:hover { background: var(--color-text-muted); border-color: var(--color-text-muted); }
  .wl-primary:active { background: var(--color-text-muted); border-color: var(--color-text-muted); }
  .wl-primary[aria-pressed="true"] {
    background: var(--color-gold-subtle);
    color: var(--color-gold-strong);
    border-color: var(--color-gold);
  }
  .wl-primary:disabled { opacity: 0.55; cursor: not-allowed; }

  .wl-lock {
    margin: 0;
    font-size: var(--text-sm); color: var(--color-text-muted);
  }
  .wl-lock[data-lock="held"]    { color: var(--color-text-muted); }
  .wl-lock[data-lock="lost"]    { color: var(--color-danger); }
  .wl-lock[data-lock="done"]    { color: var(--color-success); }

  .wl-meta {
    margin: 0;
    display: grid; grid-template-columns: max-content max-content;
    column-gap: var(--space-4); row-gap: var(--space-1);
    justify-content: center; align-items: baseline;
    font-size: var(--text-sm);
  }
  .wl-meta[hidden] { display: none; }
  .wl-meta-row { display: contents; }
  .wl-meta-row[hidden] { display: none; }
  .wl-meta dt {
    font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-text-muted); text-align: right;
  }
  .wl-meta dd { margin: 0; font-weight: var(--font-weight-medium); font-variant-numeric: tabular-nums; }

  .wl-today {
    margin: 0; font-size: var(--text-xs); color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .wl-today[hidden] { display: none; }

  .wl-view-actions { margin-top: auto; padding-top: var(--space-2); }

  .wl-text-btn {
    min-height: var(--touch-target);
    background: none; border: none; padding-inline: var(--space-2);
    color: var(--color-text-subtle); font-size: var(--text-xs); font-family: inherit;
    cursor: pointer; text-decoration: underline; text-underline-offset: 3px;
    transition: var(--transition-color);
  }
  .wl-text-btn:hover, .wl-text-btn:active { color: var(--color-text); }

  /* ── Session setup ─────────────────────────────────────────────────────── */
  .wl-unsupported {
    padding: var(--space-3);
    background: var(--color-bg-tertiary, var(--color-surface));
    border: var(--border); border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
  .wl-unsupported[hidden] { display: none; }
  .wl-unsupported-title { margin: 0 0 var(--space-1); font-weight: var(--font-weight-medium); }
  .wl-unsupported-hint  { margin: 0; color: var(--color-text-muted); }

  .wl-fieldset { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .wl-legend {
    padding: 0; font-size: var(--text-xs); font-weight: var(--font-weight-medium);
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted);
  }

  /* Duration is the one decision a visitor comes here to make. It used to sit behind a
     disclosure labelled "Tool Settings"; it is now the first thing in the panel. */
  .wl-duration-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: var(--space-2);
  }

  .wl-dur, .wl-fmt {
    min-height: var(--touch-target); padding-inline: var(--space-3);
    border: var(--border); border-radius: var(--radius-md);
    background: transparent; color: var(--color-text-muted);
    font-size: var(--text-sm); font-family: inherit; cursor: pointer;
    transition: var(--transition-color);
  }
  .wl-dur:hover, .wl-fmt:hover,
  .wl-dur:active, .wl-fmt:active {
    color: var(--color-text); background: var(--color-surface-hover); border-color: var(--color-border-strong);
  }
  .wl-dur.is-selected, .wl-fmt.is-selected {
    background: var(--color-text); color: var(--color-bg); border-color: var(--color-text);
  }
  .wl-dur:disabled, .wl-fmt:disabled { opacity: 0.55; cursor: not-allowed; }

  .wl-custom-row { display: flex; align-items: center; gap: var(--space-3); }
  .wl-custom-label { font-size: var(--text-sm); color: var(--color-text-muted); }

  .wl-custom-input {
    min-height: var(--touch-target); width: 120px; padding-inline: var(--space-3);
    border: var(--border); border-radius: var(--radius-md);
    background: transparent; color: var(--color-text);
    /* >=16px so iOS does not zoom the page on focus. */
    font-size: var(--text-base); font-family: inherit;
    transition: var(--transition-color);
  }
  .wl-custom-input.is-selected { background: var(--color-text); color: var(--color-bg); border-color: var(--color-text); }
  .wl-custom-input:disabled { opacity: 0.55; cursor: not-allowed; }

  .wl-options { border-top: var(--border); padding-top: var(--space-3); }
  .wl-options-summary {
    min-height: var(--touch-target); display: flex; align-items: center;
    font-size: var(--text-sm); color: var(--color-text-muted); cursor: pointer;
    transition: var(--transition-color);
  }
  .wl-options-summary:hover, .wl-options-summary:active { color: var(--color-text); }
  .wl-options-body { display: flex; flex-direction: column; gap: var(--space-1); padding-top: var(--space-2); }

  .wl-check-row {
    display: flex; align-items: center; gap: var(--space-3);
    min-height: var(--touch-target);
    font-size: var(--text-sm); color: var(--color-text); cursor: pointer;
  }
  .wl-check-row[hidden] { display: none; }
  .wl-checkbox { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--color-gold); cursor: pointer; }

  .wl-format-row { display: flex; align-items: center; gap: var(--space-2); min-height: var(--touch-target); }
  .wl-format-label { font-size: var(--text-sm); color: var(--color-text-muted); margin-right: auto; }
  .wl-fmt { min-width: 56px; }

  .wl-battery { margin: 0; font-size: var(--text-xs); color: var(--color-text-subtle); }
  .wl-battery[hidden] { display: none; }

  /* ── Ambient view ──────────────────────────────────────────────────────── */
  .wl-ambient {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--color-overlay-bg);
    transition: background-color 600ms ease;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    /* Notch and home-indicator safe: this is the surface most likely to be viewed on a phone. */
    padding:
      max(var(--space-8), env(safe-area-inset-top))
      max(var(--space-8), env(safe-area-inset-right))
      max(var(--space-8), env(safe-area-inset-bottom))
      max(var(--space-8), env(safe-area-inset-left));
  }
  .wl-ambient[hidden] { display: none; }
  /* Per-state scene tints — intentional immersive palette, theme-invariant */
  .wl-ambient[data-state="active"]    { background: #16100A; }
  .wl-ambient[data-state="completed"] { background: #071A0D; }

  .wl-ambient[data-dim="1"] .wl-ambient-drift { opacity: 0.6; }
  .wl-ambient[data-dim="2"] .wl-ambient-drift { opacity: 0.3; }

  /* Slow drift: static bright numerals held for hours are exactly how OLED burn-in happens. */
  .wl-ambient-drift {
    animation: wl-drift 120s ease-in-out infinite;
    transition: opacity var(--duration-normal) var(--ease-default);
  }

  @keyframes wl-drift {
    0%, 100% { transform: translate(-10px, -8px); }
    50%      { transform: translate(10px, 8px); }
  }

  .wl-ambient-content {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-3);
    text-align: center;
  }

  .wl-amb-clock {
    font-family: var(--font-mono);
    font-size: clamp(var(--text-4xl), 18vw, 7rem);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1; color: var(--color-overlay-text);
  }

  .wl-amb-status { display: flex; align-items: center; gap: var(--space-3); }
  .wl-amb-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .wl-amb-dot[data-state="idle"]      { background: transparent; border: 2px solid var(--color-overlay-muted); }
  .wl-amb-dot[data-state="active"]    { background: var(--color-gold); animation: dot-breathe 5s ease-in-out infinite; }
  .wl-amb-dot[data-state="completed"] { background: var(--color-success); }

  .wl-amb-state {
    font-size: var(--text-base); font-weight: var(--font-weight-semibold);
    color: var(--color-overlay-text);
  }

  .wl-amb-timer, .wl-amb-ends { display: flex; align-items: baseline; gap: var(--space-3); }
  .wl-amb-timer[hidden], .wl-amb-ends[hidden] { display: none; }

  .wl-amb-meta {
    font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-overlay-muted);
  }
  .wl-amb-timer-value {
    font-family: var(--font-mono); font-size: var(--text-2xl);
    font-variant-numeric: tabular-nums; font-weight: var(--font-weight-semibold);
    color: var(--color-overlay-text);
  }
  .wl-amb-ends-value {
    font-size: var(--text-sm); font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums; color: var(--color-overlay-muted);
  }

  /* Controls fade out so the ambient screen is calm, and come back on any tap. */
  .wl-amb-controls {
    position: absolute;
    bottom: max(var(--space-6), env(safe-area-inset-bottom));
    left: 50%; transform: translateX(-50%);
    display: flex; gap: var(--space-2);
    transition: opacity var(--duration-normal) var(--ease-default);
  }
  .wl-ambient[data-chrome="off"] .wl-amb-controls { opacity: 0; pointer-events: none; }

  .wl-amb-btn {
    min-height: var(--touch-target); padding-inline: var(--space-5);
    border: 1px solid var(--color-overlay-border); border-radius: var(--radius-md);
    background: transparent; color: var(--color-overlay-text);
    font-size: var(--text-sm); font-weight: var(--font-weight-medium); font-family: inherit;
    cursor: pointer;
    transition: var(--transition-color);
  }
  .wl-amb-btn:hover, .wl-amb-btn:active { background: rgba(255, 255, 255, 0.1); }
  .wl-amb-btn--quiet { color: var(--color-overlay-muted); }

  @media (max-width: 480px) {
    .wl-ring-wrapper { width: 168px; height: 168px; }
    .wl-stage { padding: var(--space-5) var(--space-4); gap: var(--space-3); }
    .wl-amb-btn { padding-inline: var(--space-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-stage[data-state="active"] .wl-lamp,
    .wl-amb-dot[data-state="active"] { animation: none; }
    .wl-ambient-drift { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var toggleBtn = document.getElementById('wl-toggle');
    if (!toggleBtn) return;

    var TOOL_ID    = 'keep-screen-awake';
    var LEGACY_DUR = 'toytools.keep-screen-awake.duration';
    var LEGACY_FMT = 'toytools.keep-screen-awake.timeformat';
    var RING_CIRC  = 534;

    var stage        = document.getElementById('wl-stage');
    var hero         = document.getElementById('wl-hero');
    var heroLabel    = document.getElementById('wl-hero-label');
    var ring         = document.getElementById('wl-ring-progress');
    var live         = document.getElementById('wl-live');
    var lockLine     = document.getElementById('wl-lock');
    var metaEl       = document.getElementById('wl-meta');
    var startedValue = document.getElementById('wl-started-value');
    var endsRow      = document.getElementById('wl-ends-row');
    var endsValue    = document.getElementById('wl-ends-value');
    var todayEl      = document.getElementById('wl-today');
    var customInput  = document.getElementById('wl-custom-min');
    var unsupported  = document.getElementById('wl-unsupported');
    var unsupHint    = document.getElementById('wl-unsupported-hint');
    var soundBox     = document.getElementById('wl-sound');
    var notifyBox    = document.getElementById('wl-notify');
    var guardBox     = document.getElementById('wl-guard');
    var guardRow     = document.getElementById('wl-guard-row');
    var batteryEl    = document.getElementById('wl-battery');
    var ambientBtn   = document.getElementById('wl-ambient-btn');

    var amb          = document.getElementById('wl-ambient');
    var ambClock     = document.getElementById('wl-amb-clock');
    var ambDot       = document.getElementById('wl-amb-dot');
    var ambState     = document.getElementById('wl-amb-state');
    var ambTimer     = document.getElementById('wl-amb-timer');
    var ambTimerLbl  = document.getElementById('wl-amb-timer-label');
    var ambTimerVal  = document.getElementById('wl-amb-timer-value');
    var ambEnds      = document.getElementById('wl-amb-ends');
    var ambEndsVal   = document.getElementById('wl-amb-ends-value');
    var ambToggle    = document.getElementById('wl-amb-toggle');
    var ambDim       = document.getElementById('wl-amb-dim');
    var ambExit      = document.getElementById('wl-amb-exit');

    var toolUrlMeta = document.getElementById('wl-tool-url');
    var iconUrlMeta = document.getElementById('wl-icon-url');
    var toolUrl = toolUrlMeta ? toolUrlMeta.getAttribute('content') : '/';
    var iconUrl = iconUrlMeta ? iconUrlMeta.getAttribute('content') : '';

    var supported = 'wakeLock' in navigator;

    // ── State ────────────────────────────────────────────────────────────
    // Every visible element is derived from this in render(). Nothing else writes the DOM.
    var S = {
      phase: 'idle',        // 'idle' | 'active' | 'completed'
      startTime: null,
      endTime: null,        // null = open ended
      duration: 0,          // seconds; 0 = open ended
      lockHeld: false,
      lostAt: null,         // when a held lock went away mid session
      format: '12',
      sound: false,
      notify: false,
      guard: true,
      today: { date: '', sessions: 0, seconds: 0 },
    };

    var wakeLock = null;
    var lockPending = false;
    var ticker = null;
    var origTitle = document.title;
    var chromeTimer = null;

    // ── Persistence (ToyTools.state, so settings ride along in the data backup) ──
    var TT = window.ToyTools;

    function todayKey() {
      var d = new Date();
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    function persist() {
      if (!TT || !TT.state) return;
      TT.state.save(TOOL_ID, {
        duration: S.duration,
        format: S.format,
        sound: S.sound,
        notify: S.notify,
        guard: S.guard,
        today: S.today,
      });
    }

    function restore() {
      var saved = TT && TT.state ? TT.state.load(TOOL_ID) : null;

      // One-time migration off the old dot-namespaced keys, which sat outside `toytools:`
      // and were therefore missing from ToyTools.data exports.
      if (!saved) {
        saved = {};
        try {
          var ld = localStorage.getItem(LEGACY_DUR);
          if (ld !== null && !isNaN(parseInt(ld, 10))) saved.duration = parseInt(ld, 10);
          var lf = localStorage.getItem(LEGACY_FMT);
          if (lf === '12' || lf === '24') saved.format = lf;
          localStorage.removeItem(LEGACY_DUR);
          localStorage.removeItem(LEGACY_FMT);
        } catch (_) {}
      }

      if (typeof saved.duration === 'number' && saved.duration >= 0) S.duration = saved.duration;
      if (saved.format === '12' || saved.format === '24') S.format = saved.format;
      if (typeof saved.sound === 'boolean') S.sound = saved.sound;
      if (typeof saved.notify === 'boolean') S.notify = saved.notify;
      if (typeof saved.guard === 'boolean') S.guard = saved.guard;
      if (saved.today && saved.today.date === todayKey()) S.today = saved.today;
      else S.today = { date: todayKey(), sessions: 0, seconds: 0 };
    }

    // ── Formatting ───────────────────────────────────────────────────────
    function pad(n) { return String(n).padStart(2, '0'); }

    function formatClock(totalSeconds) {
      var s = Math.max(0, Math.floor(totalSeconds));
      var h = Math.floor(s / 3600);
      var m = Math.floor((s % 3600) / 60);
      var sec = s % 60;
      // No leading "00h" on a 15 minute session: show only the units in play.
      return h > 0 ? h + ':' + pad(m) + ':' + pad(sec) : m + ':' + pad(sec);
    }

    function formatTimeOfDay(date) {
      if (S.format === '24') return pad(date.getHours()) + ':' + pad(date.getMinutes());
      return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    }

    function formatMinutes(totalSeconds) {
      var mins = Math.round(totalSeconds / 60);
      if (mins < 60) return mins + 'm';
      var h = Math.floor(mins / 60);
      var m = mins % 60;
      return m === 0 ? h + 'h' : h + 'h ' + m + 'm';
    }

    // ── Render: one function, one source of truth ────────────────────────
    function elapsedSeconds() {
      return S.startTime ? Math.floor((Date.now() - S.startTime) / 1000) : 0;
    }

    function remainingSeconds() {
      return S.endTime ? Math.max(0, Math.floor((S.endTime - Date.now()) / 1000)) : 0;
    }

    function heroSeconds() {
      if (S.phase === 'idle') return S.duration;         // preview of the session about to start
      if (S.phase === 'completed') return S.lastElapsed || 0;
      return S.endTime ? remainingSeconds() : elapsedSeconds();
    }

    function lockText() {
      if (S.phase === 'completed') return 'Session complete.';
      if (S.phase === 'idle') return supported ? 'Ready when you are.' : 'Use your device settings instead.';
      if (S.lockHeld) return 'Wake lock held by your device.';
      return 'Lock lost. Reconnecting...';
    }

    function lockKind() {
      if (S.phase === 'completed') return 'done';
      if (S.phase === 'active') return S.lockHeld ? 'held' : 'lost';
      return 'none';
    }

    function render() {
      var active = S.phase === 'active';

      if (stage) stage.dataset.state = S.phase;

      if (hero) hero.textContent = formatClock(heroSeconds());
      if (heroLabel) {
        heroLabel.textContent =
          S.phase === 'idle'      ? (S.duration > 0 ? 'Planned' : 'Ready')
          : S.phase === 'completed' ? 'Total awake'
          : S.endTime               ? 'Remaining'
          : 'Awake for';
      }

      if (ring) {
        var fraction = 0;
        if (S.phase === 'completed') fraction = 1;
        else if (active && S.endTime && S.duration > 0) {
          fraction = Math.min(1, Math.max(0, 1 - remainingSeconds() / S.duration));
        }
        ring.setAttribute('stroke-dashoffset', String(RING_CIRC * (1 - fraction)));
      }

      toggleBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
      toggleBtn.textContent = active ? 'Stop' : 'Keep Screen Awake';

      if (lockLine) {
        lockLine.textContent = lockText();
        lockLine.dataset.lock = lockKind();
      }

      var showMeta = S.phase !== 'idle' && S.startTime !== null;
      if (metaEl) metaEl.hidden = !showMeta;
      if (showMeta && startedValue) startedValue.textContent = formatTimeOfDay(new Date(S.startTime));
      if (endsRow) endsRow.hidden = !(active && S.endTime);
      if (active && S.endTime && endsValue) endsValue.textContent = formatTimeOfDay(new Date(S.endTime));

      if (todayEl) {
        var has = S.today.sessions > 0;
        todayEl.hidden = !has;
        if (has) {
          todayEl.textContent =
            'Today: ' + S.today.sessions + (S.today.sessions === 1 ? ' session' : ' sessions') +
            ' / ' + formatMinutes(S.today.seconds) + ' awake';
        }
      }

      // Duration controls are frozen for the length of a session.
      setControlsDisabled(active);
      renderDurationSelection();
      renderAmbient();

      document.title = active ? 'Awake / Keep Screen Awake' : origTitle;
    }

    // The live region announces STATE, never the ticking numerals. A per-second aria-live
    // on the timer made a screen reader read the clock aloud once a second, forever.
    function announce(text) { if (live) live.textContent = text; }

    function setControlsDisabled(disabled) {
      document.querySelectorAll('.wl-dur').forEach(function (b) { b.disabled = disabled; });
      if (customInput) customInput.disabled = disabled;
    }

    function renderDurationSelection() {
      var matchedPreset = false;
      document.querySelectorAll('.wl-dur').forEach(function (btn) {
        var on = parseInt(btn.getAttribute('data-duration'), 10) === S.duration;
        btn.classList.toggle('is-selected', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on) matchedPreset = true;
      });
      if (customInput) customInput.classList.toggle('is-selected', !matchedPreset && S.duration > 0);
    }

    function renderAmbient() {
      if (!amb || amb.hidden) return;
      amb.dataset.state = S.phase;
      if (ambClock) ambClock.textContent = formatTimeOfDay(new Date());
      if (ambDot) ambDot.dataset.state = S.phase;
      if (ambState) {
        ambState.textContent =
          S.phase === 'active' ? (S.lockHeld ? 'Awake' : 'Reconnecting')
          : S.phase === 'completed' ? 'Completed'
          : 'Sleeping';
      }
      if (ambTimer) ambTimer.hidden = S.phase === 'idle';
      if (ambTimerLbl) {
        ambTimerLbl.textContent =
          S.phase === 'completed' ? 'Total awake' : S.endTime ? 'Remaining' : 'Awake for';
      }
      if (ambTimerVal) ambTimerVal.textContent = formatClock(heroSeconds());
      if (ambEnds) ambEnds.hidden = !(S.phase === 'active' && S.endTime);
      if (S.phase === 'active' && S.endTime && ambEndsVal) {
        ambEndsVal.textContent = formatTimeOfDay(new Date(S.endTime));
      }
      if (ambToggle) ambToggle.textContent = S.phase === 'active' ? 'Stop' : 'Keep Awake';
    }

    // ── Wake lock ────────────────────────────────────────────────────────
    function requestLock() {
      if (!supported || lockPending || wakeLock) return Promise.resolve(false);
      lockPending = true;
      return navigator.wakeLock.request('screen').then(function (sentinel) {
        lockPending = false;
        wakeLock = sentinel;
        S.lockHeld = true;
        S.lostAt = null;
        sentinel.addEventListener('release', function () {
          wakeLock = null;
          if (S.phase === 'active') {
            // The old build only retried on visibilitychange, so a lock dropped while the tab
            // stayed visible (battery saver, OS power policy) was never re-acquired and the UI
            // went on claiming "Awake" over a sleeping screen. ensureLock() in the ticker now
            // retries every second regardless of what caused the release.
            S.lockHeld = false;
            S.lostAt = Date.now();
            announce('Wake lock lost. Reconnecting.');
            render();
          }
        });
        render();
        return true;
      }).catch(function () {
        lockPending = false;
        S.lockHeld = false;
        render();
        return false;
      });
    }

    function releaseLock() {
      if (!wakeLock) return;
      try { wakeLock.release(); } catch (_) {}
      wakeLock = null;
      S.lockHeld = false;
    }

    /** Re-acquire whenever we are running, visible and lockless. Cheap and unconditional. */
    function ensureLock() {
      if (S.phase !== 'active' || wakeLock || lockPending) return;
      if (document.visibilityState !== 'visible') return;
      requestLock();
    }

    // ── Battery ──────────────────────────────────────────────────────────
    // Keeping a display lit is the largest power draw a page can cause, so the tool that asks
    // for it should be the one that watches the cost.
    var battery = null;

    function renderBattery() {
      if (!battery || !batteryEl) return;
      var pct = Math.round(battery.level * 100);
      batteryEl.hidden = false;
      batteryEl.textContent = 'Battery ' + pct + '%' + (battery.charging ? ' and charging' : '');
      if (guardRow) guardRow.hidden = false;
    }

    function checkBatteryGuard() {
      if (!battery || !S.guard || S.phase !== 'active') return;
      if (battery.charging) return;
      if (battery.level > 0.15) return;
      stop('Stopped at ' + Math.round(battery.level * 100) + '% battery to protect your charge.');
    }

    if (navigator.getBattery) {
      try {
        navigator.getBattery().then(function (b) {
          battery = b;
          renderBattery();
          b.addEventListener('levelchange', function () { renderBattery(); checkBatteryGuard(); });
          b.addEventListener('chargingchange', function () { renderBattery(); checkBatteryGuard(); });
        }).catch(function () {});
      } catch (_) {}
    }

    // ── End-of-session alerts ────────────────────────────────────────────
    // A timed session ends precisely when you are not looking at the screen, so a silent
    // "Completed" label is no signal at all.
    function chime() {
      if (!S.sound) return;
      try {
        var ctx = new (window.AudioContext || window.webkitAudioContext)();
        [660, 880].forEach(function (freq, i) {
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.connect(gain); gain.connect(ctx.destination);
          osc.frequency.value = freq;
          var at = ctx.currentTime + i * 0.18;
          gain.gain.setValueAtTime(0.0001, at);
          gain.gain.exponentialRampToValueAtTime(0.25, at + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, at + 0.35);
          osc.start(at); osc.stop(at + 0.4);
        });
      } catch (_) {}
    }

    function buzz() {
      try { if (navigator.vibrate) navigator.vibrate([120, 60, 120]); } catch (_) {}
    }

    function notifyDone(body) {
      if (!S.notify) return;
      if (typeof Notification === 'undefined' || Notification.permission !== 'granted') return;
      try {
        var n = new Notification('Screen released', { body: body, icon: iconUrl, data: { url: toolUrl } });
        n.onclick = function () { window.focus(); n.close(); };
      } catch (_) {}
    }

    // ── Session lifecycle ────────────────────────────────────────────────
    function recordSession(seconds) {
      if (seconds < 1) return;
      if (S.today.date !== todayKey()) S.today = { date: todayKey(), sessions: 0, seconds: 0 };
      S.today.sessions += 1;
      S.today.seconds += seconds;
      persist();
    }

    function start() {
      if (!supported) return;
      S.startTime = Date.now();
      S.endTime = S.duration > 0 ? S.startTime + S.duration * 1000 : null;
      S.phase = 'active';
      S.lockHeld = false;
      S.lastElapsed = 0;

      requestLock().then(function (ok) {
        if (!ok && !wakeLock) {
          // Could not get a lock at all: do not pretend the session is running.
          S.phase = 'idle';
          S.startTime = null;
          S.endTime = null;
          stopTicker();
          announce('Could not acquire a wake lock.');
          render();
        }
      });

      startTicker();
      announce(S.endTime ? 'Screen kept awake for ' + formatMinutes(S.duration) + '.' : 'Screen kept awake.');
      render();
    }

    function stop(message) {
      if (S.phase !== 'active') return;
      var elapsed = elapsedSeconds();
      S.lastElapsed = elapsed;
      stopTicker();
      releaseLock();
      recordSession(elapsed);
      S.phase = 'idle';
      S.startTime = null;
      S.endTime = null;
      announce(message || 'Screen released.');
      render();
      if (message && lockLine) lockLine.textContent = message;
    }

    function complete() {
      var elapsed = elapsedSeconds();
      S.lastElapsed = S.duration > 0 ? S.duration : elapsed;
      stopTicker();
      releaseLock();
      recordSession(S.lastElapsed);
      S.phase = 'completed';
      S.endTime = null;
      chime(); buzz();
      notifyDone('Your ' + formatMinutes(S.lastElapsed) + ' session finished.');
      announce('Session complete after ' + formatMinutes(S.lastElapsed) + '.');
      render();
    }

    function startTicker() {
      stopTicker();
      ticker = setInterval(tick, 1000);
    }

    function stopTicker() {
      if (ticker) clearInterval(ticker);
      ticker = null;
    }

    function tick() {
      if (S.phase !== 'active') { stopTicker(); return; }
      if (S.endTime && Date.now() >= S.endTime) { complete(); return; }
      ensureLock();
      checkBatteryGuard();
      render();
    }

    function toggle() {
      if (S.phase === 'active') stop();
      else start();
    }

    toggleBtn.addEventListener('click', toggle);

    // ── Duration controls ────────────────────────────────────────────────
    function setDuration(seconds) {
      S.duration = seconds;
      persist();
      syncUrl();
      render();
    }

    document.querySelectorAll('.wl-dur').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (customInput) customInput.value = '';
        setDuration(parseInt(btn.getAttribute('data-duration'), 10));
      });
    });

    if (customInput) {
      customInput.addEventListener('input', function () {
        var mins = parseInt(customInput.value, 10);
        if (isNaN(mins) || mins < 1) return;
        // The max attribute only constrains the spinner; typed values need the same ceiling.
        if (mins > 480) { mins = 480; customInput.value = '480'; }
        setDuration(mins * 60);
      });
    }

    document.querySelectorAll('.wl-fmt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        S.format = btn.getAttribute('data-format');
        document.querySelectorAll('.wl-fmt').forEach(function (b) {
          b.classList.toggle('is-selected', b === btn);
        });
        persist();
        render();
      });
    });

    if (soundBox) {
      soundBox.addEventListener('change', function () { S.sound = soundBox.checked; persist(); });
    }

    if (notifyBox) {
      notifyBox.addEventListener('change', function () {
        S.notify = notifyBox.checked;
        persist();
        if (S.notify && typeof Notification !== 'undefined' && Notification.permission === 'default') {
          try { Notification.requestPermission(); } catch (_) {}
        }
      });
    }

    if (guardBox) {
      guardBox.addEventListener('change', function () { S.guard = guardBox.checked; persist(); });
    }

    // ── Shareable link ───────────────────────────────────────────────────
    // replaceState, never pushState: choosing a duration must not fill the back button.
    function syncUrl() {
      try {
        var url = new URL(window.location.href);
        if (S.duration > 0) url.searchParams.set('d', String(Math.round(S.duration / 60)));
        else url.searchParams.delete('d');
        window.history.replaceState(null, '', url.toString());
      } catch (_) {}
    }

    function readUrl() {
      try {
        var raw = new URL(window.location.href).searchParams.get('d');
        if (raw === null) return false;
        var mins = parseInt(raw, 10);
        if (isNaN(mins) || mins < 0) return false;
        S.duration = Math.min(480, mins) * 60;
        if (S.duration > 0 && customInput) {
          var preset = document.querySelector('.wl-dur[data-duration="' + S.duration + '"]');
          if (!preset) customInput.value = String(Math.min(480, mins));
        }
        return true;
      } catch (_) { return false; }
    }

    // ── Ambient view ─────────────────────────────────────────────────────
    function armChromeTimer() {
      if (chromeTimer) clearTimeout(chromeTimer);
      if (amb) amb.dataset.chrome = 'on';
      chromeTimer = setTimeout(function () { if (amb) amb.dataset.chrome = 'off'; }, 4000);
    }

    function openAmbient() {
      if (!amb) return;
      amb.hidden = false;
      document.body.style.overflow = 'hidden';
      armChromeTimer();
      renderAmbient();
      var el = document.documentElement;
      var req = el.requestFullscreen || el.webkitRequestFullscreen;
      // Native fullscreen is a bonus, not a requirement: the overlay stands on its own if the
      // browser refuses. Swallow the rejection so it never surfaces as a page error.
      if (req) {
        try {
          var p = req.call(el);
          if (p && p.catch) p.catch(function () {});
        } catch (_) {}
      }
    }

    function closeAmbient() {
      if (!amb) return;
      amb.hidden = true;
      document.body.style.overflow = '';
      if (chromeTimer) { clearTimeout(chromeTimer); chromeTimer = null; }
      var exit = document.exitFullscreen || document.webkitExitFullscreen;
      if (exit && (document.fullscreenElement || document.webkitFullscreenElement)) {
        try {
          var p = exit.call(document);
          if (p && p.catch) p.catch(function () {});
        } catch (_) {}
      }
    }

    if (ambientBtn) ambientBtn.addEventListener('click', openAmbient);
    if (ambExit) ambExit.addEventListener('click', function (e) { e.stopPropagation(); closeAmbient(); });
    if (ambToggle) ambToggle.addEventListener('click', function (e) { e.stopPropagation(); toggle(); armChromeTimer(); });
    if (ambDim) {
      ambDim.addEventListener('click', function (e) {
        e.stopPropagation();
        var next = ((parseInt(amb.dataset.dim, 10) || 0) + 1) % 3;
        amb.dataset.dim = String(next);
        armChromeTimer();
      });
    }
    if (amb) amb.addEventListener('click', armChromeTimer);

    document.addEventListener('fullscreenchange', function () {
      if (!document.fullscreenElement && amb && !amb.hidden) closeAmbient();
    });
    document.addEventListener('webkitfullscreenchange', function () {
      if (!document.webkitFullscreenElement && amb && !amb.hidden) closeAmbient();
    });

    // ── Keyboard ─────────────────────────────────────────────────────────
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && amb && !amb.hidden) { closeAmbient(); return; }
      if (e.code !== 'Space' || e.metaKey || e.ctrlKey || e.altKey) return;
      var t = e.target;
      if (!t) return;
      var tag = t.tagName;
      // Never hijack typing, and never double-fire on a focused button (Space already clicks it).
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'BUTTON' ||
          tag === 'SUMMARY' || t.isContentEditable) return;
      if (!supported) return;
      e.preventDefault();
      toggle();
    });

    // ── Re-acquisition hooks ─────────────────────────────────────────────
    // The ticker is the workhorse; these just make the recovery immediate instead of
    // up to a second late when the user comes back.
    document.addEventListener('visibilitychange', ensureLock);
    window.addEventListener('pageshow', ensureLock);
    window.addEventListener('focus', ensureLock);

    // A running session must not survive a reload as a *claim* without a lock behind it,
    // so nothing is restored here beyond preferences.
    window.addEventListener('pagehide', function () { releaseLock(); });

    // ── Unsupported browsers ─────────────────────────────────────────────
    function deviceHint() {
      var ua = navigator.userAgent;
      if (/iPhone|iPad|iPod/i.test(ua)) return 'On iOS: Settings > Display & Brightness > Auto-Lock > Never.';
      if (/Android/i.test(ua))         return 'On Android: Settings > Display > Screen timeout.';
      if (/Mac OS X/i.test(ua))        return 'On macOS: System Settings > Lock Screen > Turn display off.';
      if (/Windows/i.test(ua))         return 'On Windows: Settings > System > Power & battery > Screen and sleep.';
      return 'Set your screen timeout in your device display settings.';
    }

    if (!supported) {
      if (unsupported) unsupported.hidden = false;
      if (unsupHint) unsupHint.textContent = deviceHint();
      toggleBtn.disabled = true;
    }

    // ── Boot ─────────────────────────────────────────────────────────────
    restore();
    // A link beats saved state: a shared /?d=30 must reproduce that session length. Nothing is
    // written back on load, so arriving on a clean URL leaves it clean.
    readUrl();

    if (soundBox)  soundBox.checked  = S.sound;
    if (notifyBox) notifyBox.checked = S.notify;
    if (guardBox)  guardBox.checked  = S.guard;
    document.querySelectorAll('.wl-fmt').forEach(function (b) {
      b.classList.toggle('is-selected', b.getAttribute('data-format') === S.format);
    });

    render();

    // The ambient clock keeps ticking even with no session running: a propped-up phone
    // showing a dead clock is not an ambient display.
    setInterval(function () { if (amb && !amb.hidden) renderAmbient(); }, 1000);
  })();
</script>
