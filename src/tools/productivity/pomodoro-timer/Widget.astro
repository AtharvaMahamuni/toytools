---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import { withBase } from '@lib/paths';

const swUrl    = withBase('/sw.js');
const toolUrl  = withBase('/tool/productivity/pomodoro-timer/');
const iconUrl  = withBase('/favicon.ico');
---

<!-- Service worker URL passed to inline script via meta tag (no import.meta.env in is:inline) -->
<meta id="pt-sw-url"   content={swUrl}   />
<meta id="pt-tool-url" content={toolUrl} />
<meta id="pt-icon-url" content={iconUrl} />

<ToolSplit ratio="3-2" stackOrder="input-first" stickyOutput={false}>

<!-- Settings panel -->
<div slot="output" class="pt-settings">
  <button id="pt-settings-toggle" type="button" class="pt-text-action">
    Customize ▾
  </button>
  <div id="pt-settings-panel" hidden class="pt-settings-panel">
    <div class="pt-settings-grid">
      <label class="pt-setting-label" for="pt-focus-mins">Focus Duration <span class="pt-setting-unit">(min)</span></label>
      <input id="pt-focus-mins" type="number" min="1" max="180" value="25" class="pt-setting-input" />

      <label class="pt-setting-label" for="pt-short-break-mins">Short Break <span class="pt-setting-unit">(min)</span></label>
      <input id="pt-short-break-mins" type="number" min="1" max="60" value="5" class="pt-setting-input" />

      <label class="pt-setting-label" for="pt-long-break-mins">Long Break <span class="pt-setting-unit">(min)</span></label>
      <input id="pt-long-break-mins" type="number" min="1" max="120" value="15" class="pt-setting-input" />

      <label class="pt-setting-label" for="pt-sessions-per-cycle">Sessions Per Cycle</label>
      <input id="pt-sessions-per-cycle" type="number" min="1" max="12" value="4" class="pt-setting-input" />
    </div>
    <div class="pt-toggles">
      <label class="pt-toggle-row">
        <input id="pt-sound-toggle" type="checkbox" class="pt-checkbox" aria-label="Play notification sound" />
        <span class="pt-toggle-label">Play Notification Sound</span>
      </label>
      <label class="pt-toggle-row">
        <input id="pt-notif-toggle" type="checkbox" class="pt-checkbox" aria-label="Browser notifications" />
        <span class="pt-toggle-label">Browser Notifications</span>
      </label>
      <label class="pt-toggle-row">
        <input id="pt-autostart-toggle" type="checkbox" class="pt-checkbox" aria-label="Auto start next session" />
        <span class="pt-toggle-label">Auto Start Next Session</span>
      </label>
    </div>
  </div>
</div>

<!-- Timer section -->
<div slot="input" class="pt-timer-section">
  <div id="pt-mode" class="pt-mode" aria-label="Current mode: Focus">FOCUS</div>

  <div class="pt-ring-wrapper" role="timer" aria-label="Pomodoro timer">
    <svg viewBox="0 0 200 200" class="pt-ring-svg" aria-hidden="true">
      <circle class="pt-ring-track" cx="100" cy="100" r="85" />
      <circle
        id="pt-ring-progress"
        class="pt-ring-progress"
        cx="100" cy="100" r="85"
        stroke-dasharray="534"
        stroke-dashoffset="0"
      />
    </svg>
    <div class="pt-time-overlay">
      <span id="pt-time" class="pt-time" aria-live="polite" aria-atomic="true">25:00</span>
    </div>
  </div>

  <div class="pt-controls">
    <button id="pt-start" type="button" class="pt-btn-primary">Start</button>
    <button id="pt-pause" type="button" class="pt-btn-primary" hidden>Pause</button>
    <button id="pt-reset" type="button" class="pt-btn-secondary">Reset</button>
  </div>

  <div id="pt-transition-msg" class="pt-transition-msg" aria-live="polite" hidden>
    Focus Complete ✓
  </div>
</div>

<!-- Session progress -->
<div slot="input" class="pt-progress-section">
  <div id="pt-dots" class="pt-dots" role="group" aria-label="Session progress"></div>
  <div id="pt-session-label" class="pt-session-label">Session 1 of 4</div>
</div>

<!-- View actions -->
<div slot="input" class="pt-view-actions">
  <button id="pt-fs-btn" type="button" class="pt-fs-btn" aria-label="Enter full screen">Full Screen</button>
  <span class="gold-dot" aria-hidden="true"></span>
  <button id="pt-rd-btn" type="button" class="pt-fs-btn" aria-label="Remove distractions">Remove Distractions</button>
</div>

<!-- Today's statistics -->
<div slot="output" class="pt-stats-section">
  <span id="pt-stats" class="pt-stats" aria-live="polite" aria-atomic="true">
    Today ● 0 Sessions ● 0 Minutes
  </span>
</div>

</ToolSplit>




<!-- Fullscreen / Remove Distractions overlay -->
<div id="pt-fullscreen" class="pt-fullscreen" data-phase="focus" hidden>
  <div class="pt-fs-content">
    <div id="pt-fs-mode" class="pt-fs-mode">FOCUS</div>
    <div id="pt-fs-time" class="pt-fs-time">25:00</div>
    <div id="pt-fs-dots" class="pt-fs-dots"></div>
    <div id="pt-fs-session-label" class="pt-fs-session-label">Session 1 of 4</div>
    <div class="pt-fs-controls">
      <button id="pt-fs-start" type="button" class="pt-fs-start-btn">Start</button>
    </div>
  </div>
  <button id="pt-fs-exit" type="button" class="pt-fs-exit" aria-label="Exit full screen">✕</button>
</div>

<style is:global>
  /* ── Settings ─────────────────────────────────────────── */
  .pt-settings {
    padding: var(--space-6);
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pt-text-action {
    background: none; border: none; padding: 0;
    color: var(--color-text-muted); font-size: var(--text-sm); font-family: inherit;
    cursor: pointer; text-align: left; width: fit-content;
    transition: color var(--duration-fast) ease;
  }
  .pt-text-action:hover { color: var(--color-text); }

  .pt-settings-panel[hidden] { display: none; }
  .pt-settings-panel {
    display: flex; flex-direction: column; gap: var(--space-5);
  }

  .pt-settings-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .pt-setting-label {
    font-size: var(--text-sm); color: var(--color-text-muted);
  }
  .pt-setting-unit { font-size: var(--text-xs); }

  .pt-setting-input {
    width: 72px; min-height: 36px;
    padding-inline: var(--space-2); text-align: center;
    border: var(--border); border-radius: var(--radius-md);
    background: transparent; color: var(--color-text);
    font-size: var(--text-sm); font-family: inherit;
    transition: var(--transition-color);
  }
  .pt-setting-input:focus { outline: none; border-color: var(--color-text-muted); }

  .pt-toggles { display: flex; flex-direction: column; gap: var(--space-2); }

  .pt-toggle-row {
    display: flex; align-items: center; gap: var(--space-2); cursor: pointer;
  }

  .pt-checkbox {
    width: 16px; height: 16px; cursor: pointer;
    accent-color: var(--color-gold);
  }

  .pt-toggle-label { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ── Timer section ────────────────────────────────────── */
  .pt-timer-section {
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
    display: flex; flex-direction: column; align-items: center;
    gap: var(--space-5);
  }

  .pt-mode {
    font-size: var(--text-xs); font-weight: var(--font-weight-semibold);
    letter-spacing: 0.15em; color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .pt-ring-wrapper {
    position: relative;
    width: 200px; height: 200px;
    flex-shrink: 0;
  }

  .pt-ring-svg { width: 100%; height: 100%; }

  .pt-ring-track {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 6;
  }

  .pt-ring-progress {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 6;
    stroke-linecap: round;
    transform-origin: 100px 100px;
    transform: rotate(-90deg);
    transition: stroke-dashoffset 1s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-ring-progress { transition: none; }
  }

  .pt-time-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
  }

  .pt-time {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .pt-controls {
    display: flex; gap: var(--space-3); align-items: center;
  }

  .pt-btn-primary {
    min-width: 120px; min-height: var(--touch-target);
    padding-inline: var(--space-6);
    background: var(--color-text); color: var(--color-bg);
    border: none; border-radius: var(--radius-md);
    font-size: var(--text-sm); font-weight: var(--font-weight-semibold);
    font-family: inherit; cursor: pointer;
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }
  .pt-btn-primary:hover { opacity: 0.85; }
  .pt-btn-primary:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }

  .pt-btn-secondary {
    min-height: var(--touch-target); padding-inline: var(--space-4);
    background: transparent; color: var(--color-text-muted);
    border: var(--border); border-radius: var(--radius-md);
    font-size: var(--text-sm); font-family: inherit; cursor: pointer;
    transition: var(--transition-color);
  }
  .pt-btn-secondary:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .pt-btn-secondary:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }

  .pt-transition-msg {
    font-size: var(--text-sm); color: var(--color-gold);
    font-weight: var(--font-weight-medium);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .pt-transition-msg[hidden] { display: none; }
  .pt-transition-msg.pt-visible { opacity: 1; }

  /* ── Session progress ─────────────────────────────────── */
  .pt-progress-section {
    padding-block: var(--space-6);
    padding-inline: var(--space-6);
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
  }

  .pt-dots { display: flex; gap: var(--space-3); align-items: center; }

  .pt-dot {
    display: inline-block; width: 12px; height: 12px;
    border-radius: 50%; flex-shrink: 0;
    transition: background-color var(--duration-normal) ease;
  }
  .pt-dot[data-state="completed"] { background: var(--color-text); }
  .pt-dot[data-state="current"]   {
    background: var(--color-gold);
    animation: dot-breathe 5s ease-in-out infinite;
  }
  .pt-dot[data-state="remaining"] { background: transparent; border: 2px solid var(--color-border); }

  @keyframes dot-breathe {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-dot[data-state="current"] { animation: none; }
  }

  .pt-session-label {
    font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.05em;
  }

  /* ── View actions ─────────────────────────────────────── */
  .pt-view-actions {
    padding-block: var(--space-4);
    padding-inline: var(--space-6);
    display: flex; align-items: center; justify-content: center; gap: var(--space-2);
  }

  .pt-fs-btn {
    background: none; border: none; padding: 0;
    color: var(--color-text-subtle); font-size: var(--text-xs); font-family: inherit;
    cursor: pointer; text-decoration: underline; text-underline-offset: 3px;
    transition: color var(--duration-fast) ease;
  }
  .pt-fs-btn:hover { color: var(--color-text-muted); }

  /* ── Today's stats ────────────────────────────────────── */
  .pt-stats-section {
    padding: var(--space-5) var(--space-6);
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex; justify-content: center;
  }

  .pt-stats {
    font-size: var(--text-sm); color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  /* ── Fullscreen overlay ───────────────────────────────── */
  .pt-fullscreen {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--color-overlay-bg);
    transition: background-color 600ms ease;
    display: flex; align-items: flex-end; justify-content: flex-start;
    padding: var(--space-8);
  }
  .pt-fullscreen[hidden] { display: none; }
  /* Per-phase scene tints — intentional immersive palette, theme-invariant */
  .pt-fullscreen[data-phase="shortBreak"]  { background: #0A1020; }
  .pt-fullscreen[data-phase="longBreak"]   { background: #071A0D; }

  .pt-fs-content {
    display: flex; flex-direction: column; gap: var(--space-4);
  }

  .pt-fs-mode {
    font-size: var(--text-xs); font-weight: var(--font-weight-semibold);
    letter-spacing: 0.15em; color: var(--color-overlay-muted); text-transform: uppercase;
  }

  .pt-fs-time {
    font-family: var(--font-mono);
    font-size: clamp(var(--text-4xl), 8vw, 6rem);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-overlay-text); line-height: 1;
  }

  .pt-fs-dots { display: flex; gap: var(--space-3); align-items: center; }

  .pt-fs-dot {
    display: inline-block; width: 10px; height: 10px;
    border-radius: 50%;
  }
  .pt-fs-dot[data-state="completed"] { background: var(--color-overlay-text); }
  .pt-fs-dot[data-state="current"]   { background: var(--color-gold); }
  .pt-fs-dot[data-state="remaining"] { background: transparent; border: 2px solid var(--color-overlay-border); }

  .pt-fs-session-label {
    font-size: var(--text-xs); color: var(--color-overlay-muted); letter-spacing: 0.05em;
  }

  .pt-fs-controls { margin-top: var(--space-2); }

  .pt-fs-start-btn {
    min-width: 100px; min-height: 44px; padding-inline: var(--space-5);
    background: rgba(255,255,255,0.1); color: var(--color-overlay-text);
    border: 1px solid rgba(255,255,255,0.2); border-radius: var(--radius-md);
    font-size: var(--text-sm); font-weight: var(--font-weight-semibold);
    font-family: inherit; cursor: pointer;
    transition: background-color var(--duration-fast) ease;
  }
  .pt-fs-start-btn:hover { background: rgba(255,255,255,0.18); }

  .pt-fs-exit {
    position: absolute; top: var(--space-6); right: var(--space-6);
    background: none; border: none; padding: var(--space-2);
    color: var(--color-overlay-muted); font-size: var(--text-lg); font-family: inherit;
    cursor: pointer; transition: color var(--duration-fast) ease; line-height: 1;
  }
  .pt-fs-exit:hover { color: var(--color-overlay-text); }
</style>

<script is:inline>
(function () {

  // ── Layer 1: Generic countdown engine ──────────────────────────────────
  function createCountdown(initialMs, onTick, onComplete) {
    var state = 'idle';
    var remainingMs = initialMs;
    var startedAt = null;
    var tickRef = null;

    function getRemaining() {
      if (state === 'running') return Math.max(0, remainingMs - (Date.now() - startedAt));
      return remainingMs;
    }

    function tick() {
      var left = getRemaining();
      onTick(left);
      if (left <= 0 && state === 'running') {
        state = 'completed';
        clearInterval(tickRef); tickRef = null;
        onComplete();
      }
    }

    return {
      start: function () {
        if (state !== 'idle' && state !== 'paused') return;
        startedAt = Date.now();
        state = 'running';
        tick();
        tickRef = setInterval(tick, 1000);
      },
      pause: function () {
        if (state !== 'running') return;
        remainingMs = getRemaining();
        state = 'paused';
        clearInterval(tickRef); tickRef = null;
        tick();
      },
      reset: function (newMs) {
        clearInterval(tickRef); tickRef = null;
        if (newMs !== undefined) initialMs = newMs;
        remainingMs = initialMs;
        startedAt = null;
        state = 'idle';
        tick();
      },
      getState:     function () { return state; },
      getRemaining: getRemaining,
      getDuration:  function () { return initialMs; },
      cancel:       function () { clearInterval(tickRef); tickRef = null; state = 'idle'; },
    };
  }

  // ── Layer 2: Pomodoro orchestrator ─────────────────────────────────────
  function createPomodoroOrchestrator(getSettings, getPrefs, ui) {
    var phase = 'focus';
    var sessionNum = 1;
    var countdown = null;

    function phaseDurationMs() {
      var s = getSettings();
      if (phase === 'focus')      return s.focusMins      * 60000;
      if (phase === 'shortBreak') return s.shortBreakMins * 60000;
      return s.longBreakMins * 60000;
    }

    function buildCountdown() {
      if (countdown) countdown.cancel();
      var dur = phaseDurationMs();
      countdown = createCountdown(dur, function (left) {
        ui.renderTimer(left, dur);
        ui.syncFullscreen();
      }, onPhaseComplete);
    }

    function onPhaseComplete() {
      if (phase === 'focus') {
        var s = getSettings();
        ui.onFocusComplete(s.focusMins);
        var nextPhase = sessionNum >= s.sessionsPerCycle ? 'longBreak' : 'shortBreak';
        phase = nextPhase;
        buildCountdown();
        ui.saveTimerState(phase, sessionNum, countdown.getRemaining(), phaseDurationMs());
        ui.renderMode(phase);
        ui.renderDots(sessionNum, s.sessionsPerCycle, 'break');
        ui.syncFullscreen();
        if (getPrefs().autoStart) { countdown.start(); ui.setRunningState(true); }
        else { ui.setRunningState(false); }
      } else {
        var s2 = getSettings();
        ui.onBreakComplete(phase);
        if (phase === 'longBreak') {
          sessionNum = 1;
        } else {
          sessionNum = Math.min(sessionNum + 1, s2.sessionsPerCycle);
        }
        phase = 'focus';
        buildCountdown();
        ui.saveTimerState(phase, sessionNum, countdown.getRemaining(), phaseDurationMs());
        ui.renderMode(phase);
        ui.renderDots(sessionNum, s2.sessionsPerCycle, 'focus');
        ui.syncFullscreen();
        if (getPrefs().autoStart) { countdown.start(); ui.setRunningState(true); }
        else { ui.setRunningState(false); }
      }
    }

    buildCountdown();

    return {
      start: function () {
        if (!countdown) return;
        countdown.start();
      },
      pause: function () {
        if (!countdown) return;
        countdown.pause();
      },
      reset: function () {
        if (countdown) {
          phase = 'focus';
          sessionNum = 1;
          buildCountdown();
          var s = getSettings();
          ui.renderMode(phase);
          ui.renderDots(sessionNum, s.sessionsPerCycle, 'focus');
          ui.syncFullscreen();
          ui.setRunningState(false);
        }
      },
      getState:      function () { return countdown ? countdown.getState() : 'idle'; },
      getPhase:      function () { return phase; },
      getSessionNum: function () { return sessionNum; },
      getRemaining:  function () { return countdown ? countdown.getRemaining() : 0; },
      getDuration:   function () { return countdown ? countdown.getDuration() : 0; },
      restoreFromSaved: function (saved) {
        if (countdown) countdown.cancel();
        phase      = saved.phase      || 'focus';
        sessionNum = saved.sessionNum || 1;
        buildCountdown();
        countdown.reset(saved.remainingMs);
        var s = getSettings();
        ui.renderMode(phase);
        ui.renderDots(sessionNum, s.sessionsPerCycle, phase === 'focus' ? 'focus' : 'break');
        ui.syncFullscreen();
        ui.setRunningState(false);
      },
      rebuildForSettingChange: function () {
        var wasRunning = countdown && countdown.getState() === 'running';
        if (wasRunning) countdown.pause();
        phase = 'focus'; sessionNum = 1;
        buildCountdown();
        var s = getSettings();
        ui.renderMode(phase);
        ui.renderDots(sessionNum, s.sessionsPerCycle, 'focus');
        ui.syncFullscreen();
        ui.setRunningState(false);
      },
    };
  }

  // ── Layer 3: UI + DOM ──────────────────────────────────────────────────
  var SETTINGS_KEY  = 'toytools.pomodoro-timer.settings';
  var PREFS_KEY     = 'toytools.pomodoro-timer.prefs';
  var STATS_KEY     = 'toytools.pomodoro-timer.stats';
  var TIMERSTATE_KEY= 'toytools.pomodoro-timer.timerstate';
  var TIMER_MAX_AGE = 8 * 3600 * 1000; // discard saved state older than 8 h

  var CIRCUMFERENCE = 2 * Math.PI * 85; // ~533.8

  var settings = { focusMins: 25, shortBreakMins: 5, longBreakMins: 15, sessionsPerCycle: 4 };
  var prefs    = { sound: false, notifications: false, autoStart: false };
  var stats    = { date: null, completedSessions: 0, focusedMinutes: 0 };

  var origTitle = document.title;
  var isRunning = false;

  // SW URLs from build-time meta tags
  var swUrl   = (document.getElementById('pt-sw-url')   || {}).content   || '/sw.js';
  var toolUrl = (document.getElementById('pt-tool-url') || {}).content   || '/';
  var iconUrl = (document.getElementById('pt-icon-url') || {}).content   || '/favicon.ico';

  // Service Worker registration — used for break/finish notifications. Skipped
  // under browser automation (navigator.webdriver) so E2E never registers the
  // (now page-claiming) worker.
  var swReg = null;
  if ('serviceWorker' in navigator && !navigator.webdriver) {
    navigator.serviceWorker.register(swUrl).then(function (reg) { swReg = reg; }).catch(function () {});
  }

  // DOM refs
  var modeEl         = document.getElementById('pt-mode');
  var timeEl         = document.getElementById('pt-time');
  var ringProgress   = document.getElementById('pt-ring-progress');
  var startBtn       = document.getElementById('pt-start');
  var pauseBtn       = document.getElementById('pt-pause');
  var resetBtn       = document.getElementById('pt-reset');
  var transMsg       = document.getElementById('pt-transition-msg');
  var dotsEl         = document.getElementById('pt-dots');
  var sessionLbl     = document.getElementById('pt-session-label');
  var statsEl        = document.getElementById('pt-stats');
  var settingsToggle = document.getElementById('pt-settings-toggle');
  var settingsPanel  = document.getElementById('pt-settings-panel');
  var focusInput     = document.getElementById('pt-focus-mins');
  var shortInput     = document.getElementById('pt-short-break-mins');
  var longInput      = document.getElementById('pt-long-break-mins');
  var sessionsInput  = document.getElementById('pt-sessions-per-cycle');
  var soundToggle    = document.getElementById('pt-sound-toggle');
  var notifToggle    = document.getElementById('pt-notif-toggle');
  var autostartToggle= document.getElementById('pt-autostart-toggle');
  var fsBtn          = document.getElementById('pt-fs-btn');
  var rdBtn          = document.getElementById('pt-rd-btn');
  var fsOverlay      = document.getElementById('pt-fullscreen');
  var fsExit         = document.getElementById('pt-fs-exit');
  var fsModeEl       = document.getElementById('pt-fs-mode');
  var fsTimeEl       = document.getElementById('pt-fs-time');
  var fsDotsEl       = document.getElementById('pt-fs-dots');
  var fsSessionLbl   = document.getElementById('pt-fs-session-label');
  var fsStartBtn     = document.getElementById('pt-fs-start');

  // ── Storage ─────────────────────────────────────────────────────────
  function loadStorage() {
    try {
      var s = localStorage.getItem(SETTINGS_KEY);
      if (s) {
        var parsed = JSON.parse(s);
        settings.focusMins        = parsed.focusMins        || 25;
        settings.shortBreakMins   = parsed.shortBreakMins   || 5;
        settings.longBreakMins    = parsed.longBreakMins    || 15;
        settings.sessionsPerCycle = parsed.sessionsPerCycle || 4;
      }
    } catch (_) {}
    try {
      var p = localStorage.getItem(PREFS_KEY);
      if (p) {
        var pp = JSON.parse(p);
        prefs.sound         = !!pp.sound;
        prefs.notifications = !!pp.notifications;
        prefs.autoStart     = !!pp.autoStart;
      }
    } catch (_) {}
    try {
      var st = localStorage.getItem(STATS_KEY);
      if (st) {
        var sp = JSON.parse(st);
        var today = new Date().toISOString().slice(0, 10);
        if (sp.date === today) {
          stats.completedSessions = sp.completedSessions || 0;
          stats.focusedMinutes    = sp.focusedMinutes    || 0;
        } else {
          stats.completedSessions = 0; stats.focusedMinutes = 0;
        }
        stats.date = today;
      }
    } catch (_) {}
  }

  function saveSettings() {
    try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch (_) {}
  }
  function savePrefs() {
    try { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); } catch (_) {}
  }
  function saveStats() {
    stats.date = new Date().toISOString().slice(0, 10);
    try { localStorage.setItem(STATS_KEY, JSON.stringify(stats)); } catch (_) {}
  }

  // Timer state persistence
  function saveTimerState(phase, sessionNum, remainingMs, phaseTotalMs) {
    try {
      localStorage.setItem(TIMERSTATE_KEY, JSON.stringify({
        phase: phase, sessionNum: sessionNum,
        remainingMs: remainingMs, phaseTotalMs: phaseTotalMs,
        savedAt: Date.now(),
      }));
    } catch (_) {}
  }

  function clearTimerState() {
    try { localStorage.removeItem(TIMERSTATE_KEY); } catch (_) {}
  }

  function loadTimerState() {
    try {
      var raw = localStorage.getItem(TIMERSTATE_KEY);
      if (!raw) return null;
      var saved = JSON.parse(raw);
      if (!saved || Date.now() - (saved.savedAt || 0) > TIMER_MAX_AGE) return null;
      return saved;
    } catch (_) { return null; }
  }

  // ── Helpers ──────────────────────────────────────────────────────────
  function pad2(n) { return String(Math.floor(n)).padStart(2, '0'); }

  function formatMs(ms) {
    var s   = Math.max(0, Math.ceil(ms / 1000));
    var m   = Math.floor(s / 60);
    var sec = s % 60;
    return pad2(m) + ':' + pad2(sec);
  }

  function phaseLabel(phase) {
    if (phase === 'shortBreak') return 'SHORT BREAK';
    if (phase === 'longBreak')  return 'LONG BREAK';
    return 'FOCUS';
  }

  function playBeep() {
    if (!prefs.sound) return;
    try {
      var ctx = new (window.AudioContext || window.webkitAudioContext)();
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.frequency.value = 800;
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
      osc.start(); osc.stop(ctx.currentTime + 0.5);
    } catch (_) {}
  }

  // Transient notification (phase completions) — clickable, focuses tab
  function sendTransientNotification(msg) {
    if (!prefs.notifications) return;
    if (typeof Notification === 'undefined' || Notification.permission !== 'granted') return;
    try {
      var n = new Notification(msg);
      n.onclick = function () { window.focus(); n.close(); };
    } catch (_) {}
  }

  // Persistent "Pomodoro running" notification via Service Worker
  function showRunningNotification(phase) {
    if (!swReg || !prefs.notifications || Notification.permission !== 'granted') return;
    var isBreak = phase !== 'focus';
    try {
      swReg.showNotification(isBreak ? 'Break Time' : '● Pomodoro Running', {
        body: isBreak ? 'Take a break. Tap to return to timer.' : 'Focus session in progress. Tap to return.',
        tag: 'pomodoro-running',
        requireInteraction: true,
        renotify: false,
        icon: iconUrl,
        data: { url: toolUrl },
      });
    } catch (_) {}
  }

  function dismissRunningNotification() {
    if (!swReg) return;
    try {
      swReg.getNotifications({ tag: 'pomodoro-running' }).then(function (ns) {
        ns.forEach(function (n) { n.close(); });
      });
    } catch (_) {}
  }

  // ── Dot rendering ────────────────────────────────────────────────────
  function buildDots(container, sessionNum, total, phase) {
    if (!container) return;
    container.innerHTML = '';
    for (var i = 1; i <= total; i++) {
      var dot = document.createElement('span');
      var isFocus = (phase === 'focus' || phase === 'paused');
      if (i < sessionNum) {
        dot.dataset.state = 'completed';
        dot.setAttribute('aria-label', 'Session ' + i + ': completed');
      } else if (i === sessionNum && isFocus) {
        dot.dataset.state = 'current';
        dot.setAttribute('aria-label', 'Session ' + i + ': in progress');
      } else {
        dot.dataset.state = 'remaining';
        dot.setAttribute('aria-label', 'Session ' + i + ': remaining');
      }
      container.appendChild(dot);
    }
  }

  // ── UI callbacks (passed to orchestrator) ────────────────────────────
  var uiCallbacks = {
    renderTimer: function (remainingMs, totalMs) {
      if (timeEl) timeEl.textContent = formatMs(remainingMs);
      if (ringProgress) {
        var fraction = totalMs > 0 ? remainingMs / totalMs : 0;
        ringProgress.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - fraction));
      }
    },
    renderMode: function (phase) {
      if (modeEl) {
        modeEl.textContent = phaseLabel(phase);
        modeEl.setAttribute('aria-label', 'Current mode: ' + phaseLabel(phase));
      }
      if (fsOverlay) fsOverlay.dataset.phase = phase;
      if (fsModeEl)  fsModeEl.textContent = phaseLabel(phase);
    },
    renderDots: function (sessionNum, total, context) {
      buildDots(dotsEl, sessionNum, total, context);
      buildDots(fsDotsEl, sessionNum, total, context);
      if (sessionLbl)   sessionLbl.textContent   = 'Session ' + sessionNum + ' of ' + total;
      if (fsSessionLbl) fsSessionLbl.textContent = 'Session ' + sessionNum + ' of ' + total;
    },
    renderStats: function () {
      if (statsEl) {
        statsEl.textContent =
          'Today  ●  ' + stats.completedSessions + ' Session' +
          (stats.completedSessions === 1 ? '' : 's') +
          '  ●  ' + stats.focusedMinutes + ' Minute' +
          (stats.focusedMinutes === 1 ? '' : 's');
      }
    },
    syncFullscreen: function () {
      if (!fsOverlay || fsOverlay.hidden) return;
      if (pom && fsTimeEl) fsTimeEl.textContent = formatMs(pom.getRemaining());
    },
    saveTimerState: saveTimerState,
    setRunningState: function (running) {
      isRunning = running;
      if (startBtn) startBtn.hidden = running;
      if (pauseBtn) pauseBtn.hidden = !running;
      if (fsStartBtn) fsStartBtn.textContent = running ? 'Pause' : 'Start';
      if (running) {
        showRunningNotification(pom ? pom.getPhase() : 'focus');
      } else {
        document.title = origTitle;
        dismissRunningNotification();
      }
    },
    onFocusComplete: function (focusMins) {
      playBeep();
      sendTransientNotification('Focus session complete — time for a break!');
      stats.completedSessions++;
      stats.focusedMinutes += focusMins;
      saveStats();
      uiCallbacks.renderStats();
      if (transMsg) {
        transMsg.hidden = false;
        transMsg.classList.remove('pt-visible');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            transMsg.classList.add('pt-visible');
            setTimeout(function () {
              transMsg.classList.remove('pt-visible');
              setTimeout(function () { transMsg.hidden = true; }, 300);
            }, 2000);
          });
        });
      }
    },
    onBreakComplete: function (breakPhase) {
      playBeep();
      var msg = breakPhase === 'longBreak'
        ? 'Long break over — time to focus!'
        : 'Break over — back to work!';
      sendTransientNotification(msg);
      dismissRunningNotification();
    },
  };

  // ── Init ──────────────────────────────────────────────────────────────
  loadStorage();

  if (focusInput)      focusInput.value      = String(settings.focusMins);
  if (shortInput)      shortInput.value      = String(settings.shortBreakMins);
  if (longInput)       longInput.value       = String(settings.longBreakMins);
  if (sessionsInput)   sessionsInput.value   = String(settings.sessionsPerCycle);
  if (soundToggle)     soundToggle.checked   = prefs.sound;
  if (notifToggle)     notifToggle.checked   = prefs.notifications;
  if (autostartToggle) autostartToggle.checked = prefs.autoStart;

  uiCallbacks.renderStats();

  var pom = createPomodoroOrchestrator(
    function () { return settings; },
    function () { return prefs; },
    uiCallbacks
  );

  // Restore saved timer state (or do initial render)
  var savedTimerState = loadTimerState();
  if (savedTimerState && savedTimerState.remainingMs > 0) {
    pom.restoreFromSaved(savedTimerState);
    ToyTools.toast('Session restored — press Start to resume.');
  } else {
    uiCallbacks.renderMode(pom.getPhase());
    uiCallbacks.renderDots(pom.getSessionNum(), settings.sessionsPerCycle, 'focus');
    uiCallbacks.renderTimer(settings.focusMins * 60000, settings.focusMins * 60000);
  }

  // Save state on beforeunload; warn if running
  window.addEventListener('beforeunload', function (e) {
    if (pom) saveTimerState(pom.getPhase(), pom.getSessionNum(), pom.getRemaining(), pom.getDuration());
    if (isRunning) { e.preventDefault(); e.returnValue = ''; }
  });

  // ── Title update on tick (1s) ─────────────────────────────────────────
  setInterval(function () {
    if (!isRunning || !pom) return;
    var remaining = pom.getRemaining();
    var icon = pom.getPhase() === 'focus' ? '●' : '◌';
    document.title = icon + ' ' + formatMs(remaining) + ' · ' +
      phaseLabel(pom.getPhase()).charAt(0) + phaseLabel(pom.getPhase()).slice(1).toLowerCase() +
      ' — Pomodoro Timer';
  }, 1000);

  // ── Controls ──────────────────────────────────────────────────────────
  function handleStart() {
    if (!pom) return;
    if (pom.getState() !== 'running') { pom.start(); uiCallbacks.setRunningState(true); }
  }

  function handlePause() {
    if (!pom) return;
    if (pom.getState() === 'running') {
      pom.pause();
      saveTimerState(pom.getPhase(), pom.getSessionNum(), pom.getRemaining(), pom.getDuration());
      uiCallbacks.setRunningState(false);
    }
  }

  function handleStartPause() {
    if (!pom) return;
    if (pom.getState() === 'running') handlePause(); else handleStart();
  }

  if (startBtn)   startBtn.addEventListener('click', handleStart);
  if (pauseBtn)   pauseBtn.addEventListener('click', handlePause);
  if (fsStartBtn) fsStartBtn.addEventListener('click', handleStartPause);

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      pom.reset();
      clearTimerState();
      dismissRunningNotification();
      uiCallbacks.renderTimer(settings.focusMins * 60000, settings.focusMins * 60000);
      document.title = origTitle;
    });
  }

  // ── Settings panel ────────────────────────────────────────────────────
  if (settingsToggle && settingsPanel) {
    settingsToggle.addEventListener('click', function () {
      settingsPanel.hidden = !settingsPanel.hidden;
      settingsToggle.textContent = settingsPanel.hidden ? 'Customize ▾' : 'Customize ▴';
    });
  }

  function applySettingChange() {
    var fm  = parseInt(focusInput    && focusInput.value,    10);
    var sbm = parseInt(shortInput    && shortInput.value,    10);
    var lbm = parseInt(longInput     && longInput.value,     10);
    var spc = parseInt(sessionsInput && sessionsInput.value, 10);
    if (fm  > 0 && fm  <= 180) settings.focusMins        = fm;
    if (sbm > 0 && sbm <= 60)  settings.shortBreakMins   = sbm;
    if (lbm > 0 && lbm <= 120) settings.longBreakMins    = lbm;
    if (spc > 0 && spc <= 12)  settings.sessionsPerCycle = spc;
    saveSettings();
    clearTimerState();
    pom.rebuildForSettingChange();
    uiCallbacks.renderTimer(settings.focusMins * 60000, settings.focusMins * 60000);
  }

  [focusInput, shortInput, longInput, sessionsInput].forEach(function (inp) {
    if (!inp) return;
    inp.addEventListener('change', applySettingChange);
  });

  // ── Preference toggles ────────────────────────────────────────────────
  if (soundToggle) {
    soundToggle.addEventListener('change', function () {
      prefs.sound = soundToggle.checked;
      savePrefs();
    });
  }

  if (notifToggle) {
    notifToggle.addEventListener('change', function () {
      prefs.notifications = notifToggle.checked;
      savePrefs();
      if (prefs.notifications && typeof Notification !== 'undefined' && Notification.permission === 'default') {
        Notification.requestPermission();
      }
    });
  }

  if (autostartToggle) {
    autostartToggle.addEventListener('change', function () {
      prefs.autoStart = autostartToggle.checked;
      savePrefs();
    });
  }

  // ── Fullscreen / Remove Distractions ─────────────────────────────────
  function showOverlay() {
    if (!fsOverlay) return;
    fsOverlay.hidden = false;
    if (pom) {
      uiCallbacks.renderMode(pom.getPhase());
      uiCallbacks.renderDots(pom.getSessionNum(), settings.sessionsPerCycle,
        pom.getPhase() === 'focus' ? 'focus' : 'break');
      if (fsTimeEl) fsTimeEl.textContent = formatMs(pom.getRemaining());
    }
  }

  function hideOverlay() { if (fsOverlay) fsOverlay.hidden = true; }

  function exitNativeFullscreen() {
    var exit = document.exitFullscreen || document.webkitExitFullscreen ||
               document.mozCancelFullScreen || document.msExitFullscreen;
    if (exit && (document.fullscreenElement || document.webkitFullscreenElement)) exit.call(document);
  }

  if (fsBtn) {
    fsBtn.addEventListener('click', function () {
      var el  = document.documentElement;
      var req = el.requestFullscreen || el.webkitRequestFullscreen ||
                el.mozRequestFullScreen || el.msRequestFullscreen;
      if (req) req.call(el).then(showOverlay).catch(showOverlay);
      else showOverlay();
    });
  }

  if (rdBtn) rdBtn.addEventListener('click', showOverlay);

  if (fsExit) {
    fsExit.addEventListener('click', function () { hideOverlay(); exitNativeFullscreen(); });
  }

  document.addEventListener('fullscreenchange', function () {
    if (!document.fullscreenElement) hideOverlay();
  });
  document.addEventListener('webkitfullscreenchange', function () {
    if (!document.webkitFullscreenElement) hideOverlay();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && fsOverlay && !fsOverlay.hidden &&
        !document.fullscreenElement && !document.webkitFullscreenElement) {
      hideOverlay();
    }
    if ((e.key === ' ' || e.key === 'Spacebar') && e.target === document.body) {
      e.preventDefault(); handleStartPause();
    }
  });

})();
</script>
