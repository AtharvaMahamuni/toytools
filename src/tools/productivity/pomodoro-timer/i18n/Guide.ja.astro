---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="ja"
>
  <section id="quick-answer">
    <h2>概要（クイック回答） <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      ポモドーロ・テクニックとは、25分間の集中作業と5分間の短い休憩を1セットとし、4セット終えたあとに15分の長い休憩を取る時間管理法です。開始時の心理的ハードルを下げ、通知による中断の影響を最小限に抑えて、1日の終わりまで安定した集中力を保てます。
    </p>
    <a href={toolHref} class="cta-link">ポモドーロタイマーを開く →</a>
  </section>

  <section id="why-focus-breaks">
    <h2>なぜ集中力は途切れるのか <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>割り込みによるリセット:</strong> チャットや通知に反応すると、元の深い思考に戻るまで20分以上かかることがあります。</li>
      <li><strong>タスク切り替えのコスト:</strong> メールと作業を頻繁に行き来するとワーキングメモリを消耗しミスが増えます。</li>
      <li><strong>ゴールの曖昧さ:</strong> 大きな仕事ほど着手が重くなりますが、「25分だけ進める」と区切れば最初の一歩が出やすくなります。</li>
      <li><strong>気づきにくい疲労蓄積:</strong> 休憩なしでぶっ続けで働くと、1時間後から急激に判断力が落ちます。</li>
    </ul>
  </section>

  <section id="how-cycle-works">
    <h2>ポモドーロの基本サイクル <span class="gold-dot" aria-hidden="true"></span></h2>
    <ol>
      <li><strong>取り組むタスクを1つだけ選ぶ:</strong> 今この25分でやることを具体的に決めます。</li>
      <li><strong>25分間それだけに集中する:</strong> 雑念が浮かんだらメモに書いてすぐ元の作業に戻ります。</li>
      <li><strong>5分間しっかり休む:</strong> 画面から目を離して水分を取り、体を伸ばします。</li>
      <li><strong>4サイクル完了ごとに15分の長休憩:</strong> 一度しっかり脳を回復させて次のラウンドへ進みます。</li>
    </ol>
    <ReferenceBlock type="key-idea" heading="休憩こそがメソッドの核">
      <p>アラームが鳴ったら文章やコードの途中でも区切りをつけて休憩に入ります。計画的な小休止が次の25分の質を保ちます。</p>
    </ReferenceBlock>
  </section>

  <section id="examples">
    <h2>職種・目的別の使い分け <span class="gold-dot" aria-hidden="true"></span></h2>
    <h3>試験勉強・語学学習</h3>
    <p>教科書を1節読む、単語カードを50枚回すなど終了条件を明確にするとペースがつかみやすくなります。</p>
    <h3>ソフトウェア開発</h3>
    <p>バグ調査や単体テストには25/5、設計や重い実装には50/10へとタイマーを切り替えるのが効果的です。</p>
    <h3>執筆・資料作成</h3>
    <p>構成案づくりと本文執筆を別ポモドーロに分けると完璧主義で手が止まるのを防げます。</p>
  </section>

  <section id="variations">
    <h2>定番の時間配分: 25/5・50/10・90/20 <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>25/5（標準）:</strong> 着手しやすく幅広いデスクワークや勉強に向きます。</li>
      <li><strong>50/10（拡張型）:</strong> コード記述や設計など深い没入を要する作業に向きます。</li>
      <li><strong>90/20（ウルトラディアン）:</strong> 人間の集中リズムに合わせた長時間クリエイティブ向けです。</li>
    </ul>
  </section>

  <section id="mistakes">
    <h2>よくある失敗パターン <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>休憩中にスマホを見る:</strong> SNSスクロールは視覚と注意資源を使い続けるため休まりません。</li>
      <li><strong>回数稼ぎが目的化する:</strong> 重要でない雑務で8セット回すより、重要課題に2セット使う方が価値があります。</li>
      <li><strong>タイマーが鳴っても無理に続ける:</strong> 疲労が溜まり後半の集中力が崩れます。</li>
    </ul>
  </section>

  <section id="related-tools">
    <h2>関連ツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><a href={toolPathBySlug('no-sleep-website', 'ja')}>画面スリープ防止</a>: スマホの画面を点けたままタイマーを見たいときに。</li>
      <li><a href={toolPathBySlug('todo-list')}>Todo List</a>: セッション前にやることを1つ書き出すのに便利。</li>
      <li><a href={toolPathBySlug('notepad')}>Notepad</a>: 集中中に浮かんだ用件を一時メモできます。</li>
    </ul>
  </section>
</GuideLayout>
