---
---

<section class="tool-panel notepad-panel" data-tool="notepad">
  <p class="notepad-storage-note">
    Stored locally <span class="gold-dot" aria-hidden="true"></span> Auto-saved
  </p>
  <div class="notepad-toolbar">
    <button id="notepad-paste" type="button">Paste</button>
    <span class="gold-dot" aria-hidden="true"></span>
    <button id="notepad-copy" type="button" class="action-btn action-btn--copy" data-label="Copy">Copy</button>
    <span class="gold-dot" aria-hidden="true"></span>
    <button id="notepad-download" type="button">Download TXT</button>
    <span class="gold-dot" aria-hidden="true"></span>
    <button id="notepad-clear" type="button" class="action-btn action-btn--clear" data-label="Clear">Clear</button>
    <span class="gold-dot" aria-hidden="true"></span>
    <button id="notepad-fullscreen" type="button" aria-pressed="false">Full Screen</button>
    <button id="notepad-distraction" type="button" aria-pressed="false">Remove Distractions</button>
    <button id="notepad-wake" type="button" aria-pressed="false">Keep Awake</button>
    <button id="notepad-focus-exit" type="button" class="tt-focus-exit" hidden>Exit Focus</button>
  </div>

  <!-- Export/Import stay on the tool screen (Atharva hard rule) - never behind More about, Details, or menus.
       Placed above the note so they stay findable without scrolling past the textarea. -->
  <div class="np-backup" role="group" aria-label="Backup">
    <button type="button" id="np-export" class="np-tool-btn">Export JSON</button>
    <button type="button" id="np-import-btn" class="np-tool-btn" aria-expanded="false" aria-controls="np-import-panel">Import JSON</button>
  </div>
  <div id="np-import-panel" class="np-import" hidden>
    <label class="np-field" for="np-import-text">
      <span>Paste backup JSON</span>
      <textarea id="np-import-text" rows="4" placeholder='{"v":1,"note":"..."}'></textarea>
    </label>
    <div class="np-import-row">
      <input id="np-import-file" type="file" accept="application/json,.json" aria-label="Choose JSON backup file" />
      <button type="button" id="np-import-run" class="np-primary">Import</button>
    </div>
    <p id="np-import-msg" class="np-msg" role="status" hidden></p>
  </div>

  <textarea
    id="notepad-input"
    aria-label="Notepad"
    placeholder={"Start typing...\nYour notes are automatically saved in this browser."}
    spellcheck="true"
    autocomplete="off"
  ></textarea>
  <div class="notepad-stats" aria-live="polite">
    <span id="notepad-words">0 Words</span>
    <span class="gold-dot" aria-hidden="true"></span>
    <span id="notepad-chars">0 Characters</span>
  </div>
</section>




<style is:global>
  .notepad-storage-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .notepad-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .notepad-toolbar button {
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    background: transparent;
    border: var(--border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
    transition: var(--transition-color);
  }

  .notepad-toolbar button:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .notepad-toolbar button[aria-pressed="true"] {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .notepad-panel textarea {
    min-height: 400px;
    line-height: 1.7;
    font-size: var(--text-base);
    padding: var(--space-4);
    resize: vertical;
    width: 100%;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
  }

  .notepad-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-top: var(--space-2);
  }

  .np-backup, .np-import-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .np-backup { margin-bottom: var(--space-3); }
  .np-import[hidden], .np-msg[hidden] { display: none; }
  .np-import {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .np-tool-btn {
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-full, 999px);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .np-tool-btn:hover { color: var(--color-text); border-color: var(--color-accent); }
  .np-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .np-field textarea {
    min-height: 96px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    resize: vertical;
  }
  .np-primary {
    min-height: var(--touch-target);
    padding-inline: var(--space-5);
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .np-msg { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }
  .np-msg.is-error { color: var(--color-danger, var(--color-text)); }
</style>

<script is:inline>
  (function () {
    var textarea = document.getElementById('notepad-input');
    if (!textarea) return;

    var STORAGE_KEY = 'toytools.notepad.note';

    function updateStats() {
      var text    = textarea.value;
      var words   = text.trim() ? text.trim().split(/\s+/).filter(Boolean).length : 0;
      var wordsEl = document.getElementById('notepad-words');
      var charsEl = document.getElementById('notepad-chars');
      if (wordsEl) wordsEl.textContent = words + (words === 1 ? ' Word' : ' Words');
      if (charsEl) charsEl.textContent = text.length + (text.length === 1 ? ' Character' : ' Characters');
    }

    try {
      var saved = ToyTools.storage.get(STORAGE_KEY);
      if (saved) textarea.value = saved;
    } catch (_) {}
    updateStats();

    textarea.addEventListener('input', function () {
      updateStats();
      ToyTools.storage.set(STORAGE_KEY, textarea.value);
    });

    var pasteBtn = document.getElementById('notepad-paste');
    if (pasteBtn) {
      pasteBtn.addEventListener('click', function () {
        navigator.clipboard.readText().then(function (text) {
          var pos = textarea.selectionStart;
          textarea.value = textarea.value.slice(0, pos) + text + textarea.value.slice(textarea.selectionEnd);
          textarea.selectionStart = textarea.selectionEnd = pos + text.length;
          textarea.dispatchEvent(new Event('input'));
        }).catch(function () {
          pasteBtn.textContent = 'No permission';
          setTimeout(function () { pasteBtn.textContent = 'Paste'; }, 2000);
        });
      });
    }

    var copyBtn = document.getElementById('notepad-copy');
    var copyTimer;
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (!textarea.value) { ToyTools.toast('Nothing to copy!'); return; }
        ToyTools.copy(textarea.value);
        copyBtn.classList.add('is-success');
        copyBtn.textContent = '✓ Copied';
        clearTimeout(copyTimer);
        copyTimer = setTimeout(function () {
          copyBtn.classList.remove('is-success');
          copyBtn.textContent = 'Copy';
        }, 2000);
      });
    }

    var dlBtn = document.getElementById('notepad-download');
    if (dlBtn) {
      dlBtn.addEventListener('click', function () {
        var blob = new Blob([textarea.value], { type: 'text/plain' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'note.txt'; a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Ctrl/Cmd+S exports the note instead of triggering the browser save dialog
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 's' || e.key === 'S')) {
        e.preventDefault();
        if (dlBtn) dlBtn.click();
      }
    });

    // Two-click confirm clear — matches the shared ToolActions pattern
    var clearBtn  = document.getElementById('notepad-clear');
    var clearTimer;
    function resetClear() {
      clearTimeout(clearTimer);
      if (clearBtn) { clearBtn.classList.remove('is-confirming'); clearBtn.textContent = 'Clear'; }
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (!clearBtn.classList.contains('is-confirming')) {
          clearBtn.classList.add('is-confirming');
          clearBtn.textContent = 'Confirm Clear';
          clearTimeout(clearTimer);
          clearTimer = setTimeout(resetClear, 3000);
          return;
        }
        resetClear();
        textarea.value = '';
        ToyTools.storage.clear(STORAGE_KEY);
        updateStats();
        textarea.focus();
      });
      document.addEventListener('click', function (e) {
        if (clearBtn.classList.contains('is-confirming') && !e.target.closest('#notepad-clear')) resetClear();
      });
    }

    // Backup covers the real storage key (toytools.notepad.note — dot namespace,
    // so Settings global toytools:* backup may miss it).
    var importPanel = document.getElementById('np-import-panel');
    var importMsg = document.getElementById('np-import-msg');
    var importText = document.getElementById('np-import-text');

    document.getElementById('np-export') && document.getElementById('np-export').addEventListener('click', function () {
      var payload = JSON.stringify({
        v: 1,
        exportedAt: new Date().toISOString(),
        note: textarea.value
      }, null, 2);
      var blob = new Blob([payload], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'notepad-backup.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 500);
      if (window.ToyTools && ToyTools.toast) ToyTools.toast('Backup downloaded.');
    });

    var importBtn = document.getElementById('np-import-btn');
    importBtn && importBtn.addEventListener('click', function () {
      var open = importPanel && importPanel.hidden;
      if (importPanel) importPanel.hidden = !open;
      importBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    function applyImport(text) {
      try {
        var parsed = JSON.parse(text);
        var note = null;
        if (typeof parsed === 'string') note = parsed;
        else if (parsed && typeof parsed.note === 'string') note = parsed.note;
        else throw new Error('missing note');
        textarea.value = note;
        ToyTools.storage.set(STORAGE_KEY, note);
        updateStats();
        if (importMsg) {
          importMsg.hidden = false;
          importMsg.className = 'np-msg';
          importMsg.textContent = 'Imported note (' + note.length + ' character' + (note.length === 1 ? '' : 's') + ').';
        }
        if (window.ToyTools && ToyTools.toast) ToyTools.toast('Import complete.');
      } catch (_) {
        if (importMsg) {
          importMsg.hidden = false;
          importMsg.className = 'np-msg is-error';
          importMsg.textContent = 'Could not import that JSON. Check the file and try again.';
        }
      }
    }

    document.getElementById('np-import-run') && document.getElementById('np-import-run').addEventListener('click', function () {
      applyImport((importText && importText.value) || '');
    });

    document.getElementById('np-import-file') && document.getElementById('np-import-file').addEventListener('change', function (e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function () { applyImport(String(reader.result || '')); };
      reader.readAsText(file);
    });

    ToyTools.focus.attach({
      panel: document.querySelector('.notepad-panel'),
      fsBtn: document.getElementById('notepad-fullscreen'),
      rdBtn: document.getElementById('notepad-distraction'),
      wakeBtn: document.getElementById('notepad-wake'),
      exitBtn: document.getElementById('notepad-focus-exit'),
      onEnter: function () { textarea.focus(); }
    });
  })();
</script>
