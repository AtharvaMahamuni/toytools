---
// "Install app" affordance for a tool page, on every screen size.
//
// Behaviour is decided at runtime:
//   • Chromium (Android or desktop) — if the browser fired beforeinstallprompt
//     we install natively in one tap; otherwise we show the manual steps.
//   • iOS Safari  — no install API exists, so we show Share → Add to Home Screen.
//   • macOS Safari — File → Add to Dock.
//   • Firefox      — hidden. It has no install path at all, and a sheet that
//     says "your browser cannot do this" is worse than no button.
//
// Desktop was hidden by a CSS media query until 2026-08-09. Chromium desktop has
// supported installing web apps the whole time, so the button now renders in the
// tool bar beside the favourite star at every width.
//
// Visibility is controlled entirely by CSS CLASSES (is-visible / is-open /
// is-active), never the `hidden` attribute. A `display` rule silently overrides
// the `hidden` attribute, which previously left the sheet stuck open — so the
// base state is `display:none` and JS adds a class to reveal.
interface Props {
  toolName: string;
}
const { toolName } = Astro.props;
---

<div class="tt-install-wrap">
  <button id="tt-install-btn" type="button" class="tt-install-btn" aria-label={`Install ${toolName} as an app`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12" />
      <path d="M7 11l5 5 5-5" />
      <path d="M4 20h16" />
    </svg>
    <span>Install app</span>
  </button>

  <div id="tt-install-sheet" class="tt-install-sheet" role="dialog" aria-modal="true" aria-labelledby="tt-install-sheet-title">
    <div class="tt-install-panel">
      {/* Not an <h2>. This sheet is in the DOM of all 119 tool pages, so its title was one of
          only two H2s most pages had, and "Add to Home Screen" tells a search engine nothing
          about the tool. The id stays, so the dialog keeps its accessible name via
          aria-labelledby. See docs/analysis/2026-08-08-tool-identity-architecture.md (F2). */}
      <p class="tt-install-title" id="tt-install-sheet-title">Install this tool</p>
      <p>Install <strong>{toolName}</strong> so it opens like an app and works offline.</p>

      <ol class="tt-steps" data-steps="android">
        <li>Open Chrome&rsquo;s menu <span class="tt-hint">(&#8942;, top-right)</span>.</li>
        <li>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
        <li>Confirm &mdash; the icon appears on your home screen.</li>
      </ol>

      <ol class="tt-steps" data-steps="ios">
        <li>
          Tap the <strong>Share</strong> button
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12" /><path d="M8 7l4-4 4 4" /><path d="M6 12v7a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-7" />
          </svg>
          in Safari&rsquo;s toolbar.
        </li>
        <li>Choose <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong>.</li>
      </ol>

      <ol class="tt-steps" data-steps="desktop">
        <li>In Chrome or Edge, click the <strong>install</strong> icon at the right of the address bar.</li>
        <li>In Safari, choose <strong>File</strong> then <strong>Add to Dock</strong>.</li>
        <li>Just want a bookmark? Press <kbd>Ctrl</kbd>+<kbd>D</kbd> (<kbd>Cmd</kbd>+<kbd>D</kbd> on a Mac).</li>
      </ol>

      <button type="button" class="tt-install-done" data-close aria-label="Close install instructions">Got it</button>
    </div>
  </div>
</div>

<style>
  .tt-install-wrap { display: contents; }

  /* Base: hidden. Revealed only by the is-visible class (never the hidden attr,
     which a display rule would override). */
  .tt-install-btn { display: none; }
  .tt-install-btn.is-visible {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: border-color 150ms, background-color 150ms, color 150ms;
  }
  .tt-install-btn.is-visible:hover { border-color: var(--color-accent); color: var(--color-accent-strong); }
  .tt-install-btn svg { flex: none; }

  /* Overlay: hidden until is-open. */
  .tt-install-sheet { display: none; }
  .tt-install-sheet.is-open {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
    background: var(--color-overlay-scrim, rgba(0, 0, 0, 0.5));
    padding: var(--space-4);
  }
  .tt-install-panel {
    width: 100%;
    max-width: 420px;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(0, 0, 0, 0.25));
  }
  .tt-install-panel p { color: var(--color-text-muted); margin: 0 0 var(--space-4); font-size: var(--text-sm); }
  /* Carries the weight the <h2> used to, without being one. Scoped through .tt-install-panel
     so it outranks the generic paragraph rule above rather than losing to it on specificity. */
  .tt-install-panel .tt-install-title { font-size: var(--text-lg); font-weight: var(--font-weight-semibold); color: var(--color-text); margin: 0 0 var(--space-2); }

  /* Step lists: hidden until the matching platform gets is-active. */
  .tt-steps { display: none; margin: 0 0 var(--space-5); padding-left: var(--space-5); }
  .tt-steps.is-active { display: grid; gap: var(--space-2); }
  .tt-steps li { font-size: var(--text-sm); line-height: 1.5; }
  .tt-steps li svg { vertical-align: -3px; margin: 0 2px; }
  .tt-hint { color: var(--color-text-muted); }

  .tt-install-done {
    width: 100%;
    min-height: var(--touch-target);
    border: none;
    border-radius: var(--radius-md, 10px);
    background: var(--color-accent);
    color: var(--color-on-accent, #fff);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: background-color 150ms;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('tt-install-btn');
    var sheet = document.getElementById('tt-install-sheet');
    if (!btn) return;

    function isStandalone() {
      try {
        return window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
      } catch (e) { return false; }
    }
    // Already running as an installed app → nothing to offer.
    if (isStandalone()) return;

    var ua = navigator.userAgent || '';
    // iPadOS Safari reports as a Mac + touch. Exclude Chrome/Android so Android
    // (including desktop-site mode) is never treated as iOS.
    var isIOS = /iphone|ipad|ipod/i.test(ua) ||
      (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1 && !/Chrome|CriOS|Chromium|Android/i.test(ua));
    var isAndroid = /android/i.test(ua);
    // Firefox has no install path on any platform, so there is nothing honest to put in a sheet.
    var isFirefox = /firefox|fxios/i.test(ua);
    if (isFirefox) return;
    var platform = isIOS ? 'ios' : (isAndroid ? 'android' : 'desktop');
    var deferred = null;

    function showBtn() { btn.classList.add('is-visible'); }
    function hideBtn() { btn.classList.remove('is-visible'); }
    function closeSheet() { if (sheet) sheet.classList.remove('is-open'); }
    function openSheet() {
      if (!sheet) return;
      var which = platform;
      var lists = sheet.querySelectorAll('.tt-steps');
      for (var i = 0; i < lists.length; i++) {
        if (lists[i].getAttribute('data-steps') === which) lists[i].classList.add('is-active');
        else lists[i].classList.remove('is-active');
      }
      // "Add to Home Screen" is the phrase people recognise on a phone and nonsense on a laptop.
      var title = document.getElementById('tt-install-sheet-title');
      if (title) title.textContent = which === 'desktop' ? 'Install this tool' : 'Add to Home Screen';
      sheet.classList.add('is-open');
    }

    // Android / Chromium: intercept the native prompt so our button drives it.
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      showBtn();
    });
    window.addEventListener('appinstalled', function () {
      deferred = null;
      closeSheet();
      hideBtn();
      if (window.ToyTools && ToyTools.toast) ToyTools.toast('Installed to your home screen');
    });

    // Every remaining platform has a real path, native or manual.
    showBtn();

    btn.addEventListener('click', function () {
      if (deferred) {
        deferred.prompt();
        var choice = deferred.userChoice;
        deferred = null;
        hideBtn();
        if (choice && choice.catch) choice.catch(function () {});
        return;
      }
      openSheet();
    });

    if (sheet) {
      var closeBtn = sheet.querySelector('[data-close]');
      if (closeBtn) closeBtn.addEventListener('click', closeSheet);
      sheet.addEventListener('click', function (e) { if (e.target === sheet) closeSheet(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSheet();
      });
    }
  })();
</script>
