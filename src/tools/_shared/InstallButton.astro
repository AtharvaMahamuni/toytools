---
// Mobile-only "Install app" affordance for a tool page.
//
// Behaviour is decided at runtime:
//   • Android/Chromium — if the browser fired beforeinstallprompt we install
//     natively in one tap; otherwise we show Chrome's manual steps (⋮ menu).
//   • iOS Safari       — no install API exists, so we show the Share → Add to
//                        Home Screen steps.
// The instruction sheet is platform-aware, so Android never sees Safari steps.
//
// Shown on mobile whenever the tool is not already running as an installed app,
// so there is always a path to the home screen. Desktop is hidden via CSS.
interface Props {
  toolName: string;
}
const { toolName } = Astro.props;
---

<div class="tt-install-wrap">
  <button id="tt-install-btn" type="button" class="tt-install-btn" hidden aria-label={`Install ${toolName} as an app`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12" />
      <path d="M7 11l5 5 5-5" />
      <path d="M4 20h16" />
    </svg>
    <span>Install app</span>
  </button>

  <div id="tt-install-sheet" class="tt-install-sheet" hidden role="dialog" aria-modal="true" aria-labelledby="tt-install-sheet-title">
    <div class="tt-install-panel">
      <h2 id="tt-install-sheet-title">Add to Home Screen</h2>
      <p>Install <strong>{toolName}</strong> so it opens like an app and works offline.</p>

      <ol data-steps="android" hidden>
        <li>Open Chrome&rsquo;s menu <span class="tt-hint">(&#8942;, top-right)</span>.</li>
        <li>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
        <li>Confirm &mdash; the icon appears on your home screen.</li>
      </ol>

      <ol data-steps="ios" hidden>
        <li>
          Tap the <strong>Share</strong> button
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12" /><path d="M8 7l4-4 4 4" /><path d="M6 12v7a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-7" />
          </svg>
          in Safari&rsquo;s toolbar.
        </li>
        <li>Choose <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong>.</li>
      </ol>

      <button type="button" class="tt-install-done" data-close aria-label="Close install instructions">Got it</button>
    </div>
  </div>
</div>

<style>
  /* Desktop never shows the mobile install affordance. */
  @media (min-width: 641px) {
    .tt-install-wrap { display: none !important; }
  }

  .tt-install-wrap { margin-top: var(--space-3); }

  .tt-install-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: border-color 150ms, background-color 150ms, color 150ms;
  }
  .tt-install-btn:hover { border-color: var(--color-accent); color: var(--color-accent-strong); }
  .tt-install-btn svg { flex: none; }

  .tt-install-sheet {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: var(--color-overlay-scrim, rgba(0, 0, 0, 0.5));
    padding: var(--space-4);
  }
  .tt-install-panel {
    width: 100%;
    max-width: 420px;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(0, 0, 0, 0.25));
  }
  .tt-install-panel h2 { font-size: var(--text-lg); margin: 0 0 var(--space-2); }
  .tt-install-panel p { color: var(--color-text-muted); margin: 0 0 var(--space-4); font-size: var(--text-sm); }
  .tt-install-panel ol { margin: 0 0 var(--space-5); padding-left: var(--space-5); display: grid; gap: var(--space-2); }
  .tt-install-panel li { font-size: var(--text-sm); line-height: 1.5; }
  .tt-install-panel li svg { vertical-align: -3px; margin: 0 2px; }
  .tt-hint { color: var(--color-text-muted); }

  .tt-install-done {
    width: 100%;
    min-height: var(--touch-target);
    border: none;
    border-radius: var(--radius-md, 10px);
    background: var(--color-accent);
    color: var(--color-on-accent, #fff);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: background-color 150ms;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('tt-install-btn');
    var sheet = document.getElementById('tt-install-sheet');
    if (!btn) return;

    function isStandalone() {
      try {
        return window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
      } catch (e) { return false; }
    }
    // Already running as an installed app → the button has no job.
    if (isStandalone()) return;

    var ua = navigator.userAgent || '';
    // iPadOS Safari masquerades as a Mac (Macintosh UA + a touchscreen). Exclude
    // Chrome/Android so Android — including desktop-site mode, which can also send
    // a Macintosh UA — is never misdetected as iOS and shown Safari steps.
    var isIOS = /iphone|ipad|ipod/i.test(ua) ||
      (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1 && !/Chrome|CriOS|Chromium|Android/i.test(ua));
    var deferred = null;

    // Android/Chromium: capture the native prompt so our button can trigger it.
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      btn.hidden = false;
    });
    window.addEventListener('appinstalled', function () {
      deferred = null;
      btn.hidden = true;
      if (sheet) sheet.hidden = true;
      if (window.ToyTools && ToyTools.toast) ToyTools.toast('Installed to your home screen');
    });

    // Always offer a path on mobile (desktop is hidden by CSS). If a native
    // prompt is available the tap installs directly; otherwise we show the
    // correct manual steps for this platform.
    btn.hidden = false;

    function openSheet() {
      if (!sheet) return;
      var which = isIOS ? 'ios' : 'android';
      var lists = sheet.querySelectorAll('[data-steps]');
      for (var i = 0; i < lists.length; i++) {
        lists[i].hidden = lists[i].getAttribute('data-steps') !== which;
      }
      sheet.hidden = false;
    }

    btn.addEventListener('click', function () {
      if (deferred) {
        deferred.prompt();
        // A captured prompt can only be used once.
        var choice = deferred.userChoice;
        deferred = null;
        btn.hidden = true;
        if (choice && choice.catch) choice.catch(function () {});
        return;
      }
      openSheet();
    });

    if (sheet) {
      var closeBtn = sheet.querySelector('[data-close]');
      if (closeBtn) closeBtn.addEventListener('click', function () { sheet.hidden = true; });
      sheet.addEventListener('click', function (e) { if (e.target === sheet) sheet.hidden = true; });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !sheet.hidden) sheet.hidden = true;
      });
    }
  })();
</script>
