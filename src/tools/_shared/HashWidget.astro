---
// Generic hashing widget — powers every hash-generator tool (md5, sha1, sha256, and any
// future hasher). It knows nothing about a specific hasher: it reads a hashId and runs
// `text → await ToyTools.runHash(id, text) → hex` on demand. Per-tool Widget.astro files
// are 3-line wrappers passing config + faqItems.
//
// If a new hasher family ever requires editing this file, the architecture has failed.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import CopyButton from '@components/CopyButton.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
import TrustNotice from '@components/tool/TrustNotice.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { withBase } from '@lib/paths';
import type { ToolConfig, FAQItem } from '@data/types';

interface Props {
  slug: string;
  hashId: string;
  config: ToolConfig;
  faqItems?: FAQItem[];
}

const { slug, hashId, config, faqItems = [] } = Astro.props;

const inputId = `${slug}-input`;
const outputId = `${slug}-output`;

const guideHref = config.guide
  ? withBase(`/guide/${config.guide.categorySlug}/${config.guide.slug}/`)
  : null;
const faqHref = config.faq
  ? withBase(`/faq/${config.faq.categorySlug}/${config.faq.slug}/`)
  : null;
---

<TrustNotice variant="private" />

<div class="hash-container">
  <ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={false}>
    <div slot="input" class="hash-panel" data-hash={hashId} data-slug={slug}>
      <div class="hash-header">
        <label class="hash-label" for={inputId}>Input</label>
      </div>
      <textarea
        id={inputId}
        placeholder="Type or paste text to hash"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"></textarea>
      <ToolActions clearTarget={inputId} pasteTarget={inputId} />
      <div class="hash-extra-actions">
        <button type="button" class="action-btn action-btn--primary" data-hash-generate>Generate</button>
      </div>
    </div>

    <div slot="output" class="hash-panel">
      <div class="hash-header" data-copy-bar>
        <span class="hash-label">Digest (hex)</span>
        <CopyButton targetId={outputId} />
      </div>
      <output id={outputId} aria-live="polite" data-empty>Hash will appear here</output>
    </div>
  </ToolSplit>
</div>

<CategoryDiscovery toolSlug={slug} />

<ToolSection heading="How it works">
  <p>{config.description} Everything runs locally in your browser — your text never leaves your device.</p>
  {guideHref && config.guide && (
    <p class="guide-callout">
      <a href={guideHref}>Learn more → {config.guide.title}</a>
    </p>
  )}
</ToolSection>

{faqHref && faqItems.length > 0 && (
  <section class="content-section">
    <h2>FAQ</h2>
    <FAQPreview items={faqItems.slice(0, 3)} faqHref={faqHref} />
  </section>
)}

<style is:global>
  .hash-container {
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }
  .hash-panel {
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    min-height: 240px;
    overflow: hidden;
  }
  .hash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-bottom: var(--border);
    min-height: var(--touch-target);
    flex-shrink: 0;
  }
  .hash-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }
  .hash-panel textarea {
    flex: 1;
    resize: none;
    width: 100%;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    background: var(--color-bg);
    color: var(--color-text);
    font-variant-ligatures: none;
  }
  .hash-panel output {
    flex: 1;
    display: block;
    margin: 0;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow-y: auto;
    color: var(--color-text);
    font-variant-ligatures: none;
  }
  .hash-panel output[data-empty] {
    color: var(--color-text-subtle);
  }
  .hash-extra-actions {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hash][data-slug]');
    if (!root) return;
    var hid = root.getAttribute('data-hash');
    var slug = root.getAttribute('data-slug');
    var input = document.getElementById(slug + '-input');
    var output = document.getElementById(slug + '-output');
    var genBtn = document.querySelector('[data-hash-generate]');
    if (!input || !output || !genBtn) return;

    function setOutput(text, empty) {
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else output.removeAttribute('data-empty');
    }

    function generate() {
      if (!(window.ToyTools && ToyTools.runHash)) return;
      genBtn.disabled = true;
      ToyTools.runHash(hid, input.value).then(function (hex) {
        setOutput(hex, false);
      }).catch(function () {
        setOutput('Unable to hash input.', false);
      }).then(function () {
        genBtn.disabled = false;
      });
    }

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save(slug, { input: input.value });
    }

    try {
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load(slug);
      if (saved && typeof saved.input === 'string') input.value = saved.input;
    } catch (_) {}

    genBtn.addEventListener('click', function () { generate(); });
    input.addEventListener('input', persist);
  })();
</script>
