---
// Shared widget for all simple text measurement tools.
// Scope: Word Counter, Character Counter, Sentence Counter, Paragraph Counter, Reading Time.
// Complex tools requiring custom analysis logic should NOT use this component.
import type { MetricFormatter } from '@data/types';
import HeroMetric from '@components/tool/HeroMetric.astro';
import StatGrid from '@components/tool/StatGrid.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';

interface StatDef {
  metric: string;
  label: string;
  formatter?: MetricFormatter;
}

interface Props {
  slug: string;
  stats: StatDef[];
  emptyMessage?: string;
  sampleText?: string;
  /** Group id from config.toolGroup — members share one state envelope. */
  toolGroup?: string;
}

const { slug, stats, sampleText, toolGroup } = Astro.props;
const stateKey = toolGroup ? `group:${toolGroup}` : slug;
const [primaryStat, ...secondaryStats] = stats;
const inputId = `${slug}-input`;
---

<ToolSplit ratio="2-1" stackOrder="output-first" stickyOutput={false}>
  <IoPanel slot="input" label="Your text" labelFor={inputId} variant="prose">
    <textarea id={inputId} placeholder="Paste or type text here…"></textarea>
  </IoPanel>

  <IoPanel slot="output" label="Result" variant="prose" result>
    <HeroMetric
      metric={primaryStat.metric}
      label={primaryStat.label}
      formatter={primaryStat.formatter}
    />
    {secondaryStats.length > 0 && <StatGrid stats={secondaryStats} />}
  </IoPanel>
</ToolSplit>

<ToolActions copyTarget={inputId} clearTarget={inputId} pasteTarget={inputId}>
  {sampleText && (
    <button
      class="action-btn action-btn--sample"
      data-action="sample"
      data-target={inputId}
      aria-label="Load a sample text"
    >
      Sample
    </button>
  )}
  <slot name="actions" />
</ToolActions>

<!-- Optional per-tool depth section (e.g. line/space counter breakdowns), rendered
     between the metric output and the category cross-link. -->
<slot />

<CategoryDiscovery toolSlug={slug} />

<script is:inline define:vars={{ slug, sampleText, stateKey }}>
(function () {
  var inputId = slug + '-input';
  var textarea = document.getElementById(inputId);
  var hint = document.querySelector('.empty-hint');
  var secondary = document.querySelector('.tm-secondary');
  var hero = document.querySelector('.hero-value');
  if (!textarea) return;

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var pulseTimer;

  function pulse() {
    if (reduceMotion || !hero) return;
    hero.classList.add('is-updated');
    clearTimeout(pulseTimer);
    pulseTimer = setTimeout(function () { hero.classList.remove('is-updated'); }, 200);
  }

  function setMetric(el, value) {
    var fmt = el.dataset.formatter || 'integer';
    var next = ToyTools.formatMetric(value, fmt);
    if (el.textContent !== next) {
      el.textContent = next;
      if (el === hero) pulse();
    }
  }

  function update() {
    var text = textarea.value;
    if (!text.trim()) {
      if (hero) setMetric(hero, 0);
      if (secondary) secondary.hidden = true;
      if (hint) hint.hidden = false;
      return;
    }
    if (hint) hint.hidden = true;
    if (secondary) secondary.hidden = false;
    var r = ToyTools.analyze(text);
    document.querySelectorAll('[data-metric]').forEach(function (el) {
      var key = el.dataset.metric;
      setMetric(el, r[key] !== undefined ? r[key] : 0);
    });
  }

  // Sample button
  if (sampleText) {
    var sampleBtn = document.querySelector('[data-action="sample"][data-target="' + inputId + '"]');
    if (sampleBtn) {
      sampleBtn.addEventListener('click', function () {
        textarea.value = sampleText;
        textarea.dispatchEvent(new Event('input'));
        textarea.focus();
      });
    }
  }

  // Clickable stat-row copy is wired globally in ToyToolsRuntime (delegated).

  // Restore prior text — group key first, then the tool's old per-slug key (migration).
  try {
    var saved = ToyTools.state && (ToyTools.state.load(stateKey) || ToyTools.state.load(slug));
    if (saved && typeof saved.text === 'string') {
      textarea.value = saved.text;
    }
  } catch (_) {}

  textarea.addEventListener('input', function () {
    update();
    if (ToyTools.state) ToyTools.state.save(stateKey, { text: textarea.value });
  });
  ToyTools.onReady(function () {
    update();
    // Notify any slotted depth sections (rendered before this script) that
    // restored text is present, so they compute on load instead of only on type.
    if (textarea.value) textarea.dispatchEvent(new Event('input'));
  });

  if (!textarea.value && window.matchMedia('(min-width: 1024px)').matches) textarea.focus();
})();
</script>
