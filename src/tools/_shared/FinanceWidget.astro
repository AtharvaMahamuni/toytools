---
// FinanceWidget — the ONE finance widget. It is deliberately THIN: it renders the input form from the
// calculator's field schema (via SmartInput) and delegates ALL result rendering to the platform
// ExperienceRenderer. It is finance-specific only in its wiring (ToyTools.runFinance); the input layer
// and the entire result experience are platform-owned and reused unchanged by future engines.
//
// If a new finance tool ever requires editing this file, the architecture has failed.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import SmartInput from '@components/inputs/SmartInput.astro';
import CurrencyInput from '@components/inputs/CurrencyInput.astro';
import ExperienceRenderer from '@components/experience/ExperienceRenderer.astro';
import { getFinanceCalculator } from '@lib/engines/finance/registry';
import { financeExamplesFor } from '@lib/engines/finance/examples';
import { SUPPORTED_CURRENCIES, groupingFor } from '@lib/inputs/currency';
import { DEFAULT_CAPABILITIES } from '@lib/results/types';
import { urlStateMode } from '@lib/url-state';
import type { ToolConfig } from '@data/types';

interface Props {
  slug: string;
  financeId: string;
  config: ToolConfig;
  emptyText?: string;
}

const { slug, financeId, config, emptyText } = Astro.props;
const calc = getFinanceCalculator(financeId);
const fields = calc?.fields ?? [];
const scenarios = calc?.scenarios ?? [];
const caps = { ...DEFAULT_CAPABILITIES, ...(calc?.capabilities ?? {}) };
const examples = financeExamplesFor(financeId).map((e) => e.inputs);
const defaults = Object.fromEntries(fields.map((f) => [f.id, f.default]));
const resolvedEmpty = emptyText ?? 'Enter your values to calculate, visualize milestones, and see what happens over time.';

// "A shareable link to this calculation" is the most requested thing an online calculator does, and
// finance inputs are impersonal amounts, so these auto-sync. The mode is decided at build time from
// the registry, never here: see src/lib/url-state.ts.
const urlMode = urlStateMode(config.engine, config.pattern);

// Per-currency client metadata: tentative magnitude factor + the locale that drives grouping (Indian
// for INR). The widget scales default amounts/presets to the active currency and formats chip labels
// with this — no live FX, just rounded "feels-native" magnitudes. Single source of truth = currency.ts.
const currencyMeta = Object.fromEntries(
  SUPPORTED_CURRENCIES.map((c) => [
    c.code,
    { scale: c.scale ?? 1, locale: groupingFor(c.code) === 'indian' ? 'en-IN' : 'en-US' },
  ]),
);
---

<ToolSplit ratio="3-2" stackOrder="input-first" stickyOutput={false} equalHeight={false}>
  <IoPanel
    slot="input"
    label="Details"
    variant="prose"
    data-finance={financeId}
    data-slug={slug}
    data-defaults={JSON.stringify(defaults)}
    data-currency-meta={JSON.stringify(currencyMeta)}
    data-url-state={urlMode}
  >
    <CurrencyInput slot="header-end" id={`${slug}-currency`} />

    <div class="io-body finance-form" id={`${slug}-form`} data-finance-form>
      {scenarios.length > 0 && (
        <div class="finance-scenarios" role="group" aria-label="Scenarios">
          {scenarios.map((s) => (
            <button type="button" class="smart-preset finance-scenario" data-scenario={JSON.stringify(s.values)}>{s.label}</button>
          ))}
        </div>
      )}
      {fields.map((field) => <SmartInput field={field} idPrefix={slug} />)}
    </div>
  </IoPanel>

  <ExperienceRenderer
    slot="output"
    idPrefix={slug}
    emptyText={resolvedEmpty}
    layout={calc?.layout}
    capabilities={caps}
  />
</ToolSplit>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id={`${slug}-copy`} data-label="Copy" type="button">Copy</button>
  {caps.loadExample && examples.length > 0 && (
    <button class="action-btn" id={`${slug}-example`} type="button">Load Example</button>
  )}
  {caps.undo && (
    <button class="action-btn" id={`${slug}-undo`} type="button" hidden>Undo</button>
  )}
  {urlMode !== 'off' && (
    <button class="action-btn" id={`${slug}-share`} data-label="Copy link" type="button">Copy link</button>
  )}
  <button class="action-btn action-btn--clear" id={`${slug}-reset`} data-label="Reset" type="button">Reset to Defaults</button>
</div>

{examples.length > 0 && (
  <script type="application/json" id={`${slug}-examples`} set:html={JSON.stringify(examples)} />
)}

<CategoryDiscovery toolSlug={slug} />

<script is:inline>
  (function () {
    var root = document.querySelector('[data-finance][data-slug]');
    if (!root) return;
    var fid = root.getAttribute('data-finance');
    var slug = root.getAttribute('data-slug');
    var defaults = {};
    try { defaults = JSON.parse(root.getAttribute('data-defaults') || '{}'); } catch (_) {}
    var currencyMeta = {};
    try { currencyMeta = JSON.parse(root.getAttribute('data-currency-meta') || '{}'); } catch (_) {}

    var form = document.getElementById(slug + '-form');
    var expRoot = document.getElementById(slug + '-experience');
    var currencyEl = document.getElementById(slug + '-currency');
    var heroEl = document.getElementById(slug + '-hero');
    if (!form || !expRoot) return;

    var fieldEls = form.querySelectorAll('[data-field-id]');
    var presetChips = form.querySelectorAll('[data-preset-currency]');

    // ── Display-currency scaling ──────────────────────────────────────────────
    // Currency is display + a tentative, rounded magnitude (no live FX). Default amounts and quick-add
    // presets scale by a clean per-currency factor so they read natively (e.g. $3,000 -> ₹30,000).
    function metaFor(code) { return currencyMeta[code] || { scale: 1, locale: 'en-US' }; }
    function scaleOf(code) { var s = metaFor(code).scale; return (typeof s === 'number' && s > 0) ? s : 1; }

    // Round to a clean number (2 significant figures for thousands+, cents below) so scaled custom
    // values stay tidy. Power-of-10 factors keep the round presets exact.
    function roundNice(n) {
      if (!isFinite(n) || n === 0) return 0;
      var abs = Math.abs(n);
      if (abs >= 1000) {
        var mag = Math.pow(10, Math.floor(Math.log10(abs)) - 1);
        return Math.round(n / mag) * mag;
      }
      return Math.round(n * 100) / 100;
    }

    // Compact currency chip label, e.g. "$2K" / "₹20K" / "₹10L" / "₹1Cr" (Indian lakh/crore for INR).
    function compactLabel(value, code) {
      var m = metaFor(code);
      try {
        var s = new Intl.NumberFormat(m.locale, {
          style: 'currency', currency: code, notation: 'compact', maximumFractionDigits: 1,
        }).format(value);
        // en-IN compact writes thousands as "T" (e.g. ₹20T) which reads as trillion to most people.
        // Keep the idiomatic L/Cr but show the unambiguous "K" for thousands.
        if (m.locale === 'en-IN') s = s.replace('T', 'K');
        return s;
      } catch (_) { return String(value); }
    }

    // Grouped display string for a money value in the active currency's grouping.
    function groupDisplay(value, code) {
      var m = metaFor(code);
      try { return new Intl.NumberFormat(m.locale, { maximumFractionDigits: 2 }).format(value); }
      catch (_) { return String(value); }
    }

    function isCurrencyField(el) { return el.getAttribute('data-field-type') === 'currency'; }

    // Relabel + rescale the quick-add chips to the given currency (chips carry their USD-baseline value).
    function relabelPresets(code) {
      for (var i = 0; i < presetChips.length; i++) {
        var chip = presetChips[i];
        var base = parseFloat(chip.getAttribute('data-preset-base'));
        if (isNaN(base)) continue;
        var scaled = roundNice(base * scaleOf(code));
        chip.setAttribute('data-preset-value', String(scaled));
        chip.textContent = compactLabel(scaled, code);
      }
    }

    // Set a currency field to a money value, grouped in the active currency.
    function setMoney(el, value, code) {
      el.value = groupDisplay(value, code);
      el.setAttribute('data-raw', String(value));
    }

    // Apply a map of USD-baseline field values, scaling money fields to the active currency.
    function applyValues(values) {
      var code = currencyEl ? currencyEl.value : 'USD';
      for (var id in values) {
        var el = fieldById(id);
        if (el && isCurrencyField(el) && Number(values[id]) !== 0) {
          setMoney(el, roundNice(Number(values[id]) * scaleOf(code)), code);
        } else {
          setField(id, values[id]);
        }
      }
    }
    var undoStack = [];
    var undoBtn = document.getElementById(slug + '-undo');

    function fieldById(id) {
      for (var i = 0; i < fieldEls.length; i++) {
        if (fieldEls[i].getAttribute('data-field-id') === id) return fieldEls[i];
      }
      return null;
    }

    function readValue(el) {
      var type = el.getAttribute('data-field-type');
      if (type === 'select') return el.value;
      var raw = el.getAttribute('data-raw');
      if (raw === '' || raw == null) return '';
      var n = parseFloat(raw);
      return isNaN(n) ? '' : n;
    }

    function collect() {
      var input = {};
      var missingRequired = false;
      for (var i = 0; i < fieldEls.length; i++) {
        var el = fieldEls[i];
        var id = el.getAttribute('data-field-id');
        var required = el.getAttribute('data-required') === 'true';
        var v = readValue(el);
        if ((v === '' ) && el.getAttribute('data-field-type') !== 'select') {
          if (required) missingRequired = true;
          v = 0;
        }
        input[id] = v;
      }
      return { input: input, missingRequired: missingRequired };
    }

    function snapshot() {
      var snap = {};
      for (var i = 0; i < fieldEls.length; i++) {
        var el = fieldEls[i];
        snap[el.getAttribute('data-field-id')] = { value: el.value, raw: el.getAttribute('data-raw') };
      }
      return snap;
    }

    function restore(snap) {
      for (var id in snap) {
        var el = fieldById(id);
        if (!el) continue;
        el.value = snap[id].value;
        if (el.getAttribute('data-field-type') !== 'select') el.setAttribute('data-raw', snap[id].raw == null ? '' : snap[id].raw);
      }
    }

    function setField(id, value) {
      var el = fieldById(id);
      if (!el) return;
      if (el.getAttribute('data-field-type') === 'select') {
        el.value = String(value);
      } else {
        el.value = String(value);
        el.setAttribute('data-raw', String(value));
      }
    }

    function pushUndo() {
      undoStack.push(snapshot());
      if (undoStack.length > 20) undoStack.shift();
      if (undoBtn) undoBtn.hidden = false;
    }

    function run() {
      if (!(window.ToyTools && ToyTools.runFinance && ToyTools.experience)) return;
      var c = collect();
      var currency = currencyEl ? currencyEl.value : 'USD';
      if (c.missingRequired) {
        ToyTools.experience.render(expRoot, { ok: false, uiState: 'empty', metrics: [] });
        return;
      }
      var res = ToyTools.runFinance(fid, c.input, { currency: currency });
      ToyTools.experience.render(expRoot, res);
    }

    // ── Shareable link ────────────────────────────────────────────────────────
    // urlMode is decided at build time from the tool's engine/pattern (src/lib/url-state.ts) and
    // arrives as an attribute; the client cannot widen it. Finance tools are "auto", so the
    // address bar follows the inputs and a reload or a shared link reproduces the calculation.
    var urlMode = root.getAttribute('data-url-state') || 'off';

    /** Absolute field values (raw, unformatted) plus the display currency. */
    function shareValues() {
      var out = {};
      if (currencyEl) out.currency = currencyEl.value;
      for (var i = 0; i < fieldEls.length; i++) {
        var el = fieldEls[i];
        var v = readValue(el);
        if (v !== '' && v !== null && v !== undefined) out[el.getAttribute('data-field-id')] = v;
      }
      return out;
    }

    function persist() {
      if (!(window.ToyTools && ToyTools.state)) return;
      var data = { currency: currencyEl ? currencyEl.value : 'USD', fields: {} };
      for (var i = 0; i < fieldEls.length; i++) {
        data.fields[fieldEls[i].getAttribute('data-field-id')] = { value: fieldEls[i].value, raw: fieldEls[i].getAttribute('data-raw') };
      }
      ToyTools.state.save(slug, data);
      // Every mutation path in this widget ends in persist(), so syncing here covers typing,
      // currency changes, preset chips, scenarios, undo and reset in one place.
      if (urlMode === 'auto' && ToyTools.url) ToyTools.url.write(shareValues());
    }

    // Restore: currency from cross-tool prefs first, then per-tool saved state.
    var prevCurrency = currencyEl ? currencyEl.value : 'USD';
    try {
      if (currencyEl && window.ToyTools && ToyTools.prefs) {
        var pc = ToyTools.prefs.get('currency', null);
        if (pc) currencyEl.value = pc;
      }
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load(slug);
      var savedFields = (saved && saved.fields) || {};
      if (saved && saved.currency && currencyEl) currencyEl.value = saved.currency;
      prevCurrency = currencyEl ? currencyEl.value : 'USD';

      // Saved field values are absolute — restore as-is. Fields without a saved value keep their
      // default, scaled to the active currency so a first visit in ₹/¥ reads natively, not in dollars.
      for (var i = 0; i < fieldEls.length; i++) {
        var fel = fieldEls[i];
        var fid2 = fel.getAttribute('data-field-id');
        if (savedFields[fid2]) {
          fel.value = savedFields[fid2].value;
          if (fel.getAttribute('data-field-type') !== 'select') fel.setAttribute('data-raw', savedFields[fid2].raw == null ? '' : savedFields[fid2].raw);
        } else if (isCurrencyField(fel) && defaults[fid2] && Number(defaults[fid2]) !== 0) {
          setMoney(fel, roundNice(Number(defaults[fid2]) * scaleOf(prevCurrency)), prevCurrency);
        }
      }
      relabelPresets(prevCurrency);
    } catch (_) {}

    // A shared link beats saved state: someone followed it to see THOSE numbers, not the ones
    // they last typed. Values in the link are absolute and already in its currency, so they are
    // applied as-is rather than scaled the way the USD-baseline scenario chips are.
    if (urlMode !== 'off') {
      try {
        var incoming = (window.ToyTools && ToyTools.url) ? ToyTools.url.read() : {};
        if (incoming.currency && currencyEl) {
          currencyEl.value = incoming.currency;
          prevCurrency = incoming.currency;
          relabelPresets(prevCurrency);
        }
        var linkCode = currencyEl ? currencyEl.value : 'USD';
        for (var uid in incoming) {
          if (uid === 'currency') continue;
          var uel = fieldById(uid);
          if (!uel) continue;
          var unum = parseFloat(incoming[uid]);
          if (isCurrencyField(uel) && !isNaN(unum)) setMoney(uel, unum, linkCode);
          else setField(uid, incoming[uid]);
        }
      } catch (_) {}
    }

    // Field input -> recompute + persist.
    for (var i = 0; i < fieldEls.length; i++) {
      fieldEls[i].addEventListener('change', function () { run(); persist(); });
      fieldEls[i].addEventListener('input', function () { run(); persist(); });
    }

    if (currencyEl) currencyEl.addEventListener('change', function () {
      var next = currencyEl.value;
      var ratio = scaleOf(next) / scaleOf(prevCurrency);
      // Rescale every money field by the magnitude ratio so amounts read natively (e.g. 3,000 -> 30,000).
      if (ratio !== 1) {
        for (var i = 0; i < fieldEls.length; i++) {
          var el = fieldEls[i];
          if (!isCurrencyField(el)) continue;
          var raw = el.getAttribute('data-raw');
          if (raw === '' || raw == null) continue;
          var n = parseFloat(raw);
          if (isNaN(n)) continue;
          setMoney(el, roundNice(n * ratio), next);
        }
      } else {
        // Same magnitude (e.g. USD<->EUR): keep values, just regroup the display for the new locale.
        for (var j = 0; j < fieldEls.length; j++) {
          var el2 = fieldEls[j];
          if (!isCurrencyField(el2)) continue;
          var raw2 = el2.getAttribute('data-raw');
          if (raw2 === '' || raw2 == null) continue;
          var n2 = parseFloat(raw2);
          if (!isNaN(n2)) setMoney(el2, n2, next);
        }
      }
      relabelPresets(next);
      prevCurrency = next;
      if (window.ToyTools && ToyTools.prefs) ToyTools.prefs.set('currency', next);
      run(); persist();
    });

    // Per-field preset chips.
    form.querySelectorAll('[data-preset-for]').forEach(function (chip) {
      chip.addEventListener('click', function () {
        pushUndo();
        var targetId = chip.getAttribute('data-preset-for');
        var target = fieldById(targetId);
        if (target && isCurrencyField(target)) {
          setMoney(target, parseFloat(chip.getAttribute('data-preset-value')), currencyEl ? currencyEl.value : 'USD');
        } else {
          setField(targetId, chip.getAttribute('data-preset-value'));
        }
        run(); persist();
      });
    });

    // Multi-field scenario chips.
    form.querySelectorAll('[data-scenario]').forEach(function (chip) {
      chip.addEventListener('click', function () {
        pushUndo();
        var values = {};
        try { values = JSON.parse(chip.getAttribute('data-scenario') || '{}'); } catch (_) {}
        applyValues(values);
        run(); persist();
      });
    });

    // Copy link / share.
    var shareBtn = document.getElementById(slug + '-share');
    if (shareBtn) shareBtn.addEventListener('click', function () {
      if (!(window.ToyTools && ToyTools.url)) return;
      ToyTools.url.share(shareValues(), document.title);
      if (!navigator.share) {
        shareBtn.classList.add('is-success');
        shareBtn.textContent = '✓ Link copied';
        setTimeout(function () {
          shareBtn.classList.remove('is-success');
          shareBtn.textContent = 'Copy link';
        }, 2000);
      }
    });

    // Undo.
    if (undoBtn) undoBtn.addEventListener('click', function () {
      var snap = undoStack.pop();
      if (snap) restore(snap);
      if (undoStack.length === 0) undoBtn.hidden = true;
      run(); persist();
    });

    // Reset to defaults.
    var resetBtn = document.getElementById(slug + '-reset');
    var resetTimer;
    if (resetBtn) resetBtn.addEventListener('click', function () {
      if (!resetBtn.classList.contains('is-confirming')) {
        resetBtn.classList.add('is-confirming');
        resetBtn.textContent = 'Confirm Reset';
        clearTimeout(resetTimer);
        resetTimer = setTimeout(function () { resetBtn.classList.remove('is-confirming'); resetBtn.textContent = 'Reset to Defaults'; }, 3000);
        return;
      }
      pushUndo();
      resetBtn.classList.remove('is-confirming');
      resetBtn.textContent = 'Reset to Defaults';
      var code = currencyEl ? currencyEl.value : 'USD';
      for (var id in defaults) {
        var del = fieldById(id);
        if (del && isCurrencyField(del) && Number(defaults[id]) !== 0) {
          setMoney(del, roundNice(Number(defaults[id]) * scaleOf(code)), code);
        } else {
          setField(id, defaults[id]);
        }
      }
      run(); persist();
    });

    // Load Example — cycles through the calculator's worked examples.
    var exampleNode = document.getElementById(slug + '-examples');
    var exampleBtn = document.getElementById(slug + '-example');
    var exampleIdx = 0;
    if (exampleBtn && exampleNode) {
      var examples = [];
      try { examples = JSON.parse(exampleNode.textContent || '[]'); } catch (_) {}
      exampleBtn.addEventListener('click', function () {
        if (!examples.length) return;
        pushUndo();
        var ex = examples[exampleIdx % examples.length];
        exampleIdx++;
        applyValues(ex);
        run(); persist();
      });
    }

    // Copy hero value.
    var copyBtn = document.getElementById(slug + '-copy');
    var copyTimer;
    if (copyBtn) copyBtn.addEventListener('click', function () {
      var val = heroEl ? heroEl.textContent : '';
      if (!val || val === '0') { if (window.ToyTools) ToyTools.toast('Nothing to copy yet!'); return; }
      if (window.ToyTools) ToyTools.copy(val);
      copyBtn.classList.add('is-success'); copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () { copyBtn.classList.remove('is-success'); copyBtn.textContent = 'Copy'; }, 2000);
    });

    // runFinance + experience attach via the deferred runtime module — wait so restored input renders.
    if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(run); else run();
  })();
</script>

<style>
  .finance-scenarios {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
</style>
