---
// WellnessWidget — the ONE wellness-calculator widget. Like MathWidget, DateTimeWidget, and
// FinanceWidget it is deliberately THIN: it renders the input form from the tool's field schema
// (via SmartInput) and delegates ALL result rendering to the platform ExperienceRenderer. It is
// wellness-specific only in its wiring (ToyTools.runWellness); the input layer and the result
// experience are platform-owned.
//
// If a new wellness tool ever requires editing this file, the architecture has failed — add a
// calculator under src/lib/engines/wellness/calculators/ instead.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import SmartInput from '@components/inputs/SmartInput.astro';
import ExperienceRenderer from '@components/experience/ExperienceRenderer.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
import { getWellnessCalculator } from '@lib/engines/wellness/registry';
import { wellnessExamplesFor } from '@lib/engines/wellness/examples';
import { DEFAULT_CAPABILITIES } from '@lib/results/types';
import { urlStateMode } from '@lib/url-state';
import type { ToolConfig } from '@data/types';

interface Props {
  slug: string;
  wellnessId: string;
  config: ToolConfig;
  emptyText?: string;
}

const { slug, wellnessId, config, emptyText } = Astro.props;

// Shareable-link mode, decided at build time from the registry (src/lib/url-state.ts).
// "auto" syncs the address bar as you type; "manual" only builds a link when asked.
const urlMode = urlStateMode(config.engine, config.pattern);
const tool = getWellnessCalculator(wellnessId);
const fields = tool?.fields ?? [];
const caps = { ...DEFAULT_CAPABILITIES, ...(tool?.capabilities ?? {}) };
const examples = wellnessExamplesFor(wellnessId).map((e) => e.inputs);
const defaults = Object.fromEntries(fields.map((f) => [f.id, f.default]));
const resolvedEmpty = emptyText ?? 'Enter your details to calculate.';
const craftId = config.craft?.id;
---

<ToolSplit ratio="3-2" stackOrder="input-first" stickyOutput={false} equalHeight={false}>
  <IoPanel
    slot="input"
    label="Details"
    variant="prose"
    data-wellness={wellnessId}
    data-slug={slug}
    data-url-state={urlMode}
    data-defaults={JSON.stringify(defaults)}
    data-produces={JSON.stringify(tool?.produces ?? [])}
    data-consumes={JSON.stringify(tool?.consumes ?? [])}
  >
    <p class="wellness-profile" id={`${slug}-profile`} hidden>
      <span data-profile-text></span>
      <button type="button" class="wellness-profile-forget" id={`${slug}-forget`}>Forget</button>
    </p>
    <div class="io-body wellness-form" id={`${slug}-form`} data-wellness-form>
      {fields.map((field) => <SmartInput field={field} idPrefix={slug} />)}
    </div>
  </IoPanel>

  <div slot="output">
    <ExperienceRenderer
      idPrefix={slug}
      emptyText={resolvedEmpty}
      layout={tool?.layout}
      capabilities={caps}
    />
    {craftId && <CraftNote id={`${slug}-caveat`} craftId={craftId} />}
  </div>
</ToolSplit>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id={`${slug}-copy`} data-label="Copy" type="button">Copy</button>
  {caps.loadExample && examples.length > 0 && (
    <button class="action-btn" id={`${slug}-example`} type="button">Load Example</button>
  )}
  {urlMode !== 'off' && (
    <button class="action-btn" id={`${slug}-share`} data-label="Copy link" type="button">Copy link</button>
  )}
  <button class="action-btn action-btn--clear" id={`${slug}-reset`} data-label="Reset" type="button">Reset to Defaults</button>
</div>

{examples.length > 0 && (
  <script type="application/json" id={`${slug}-examples`} set:html={JSON.stringify(examples)} />
)}


<script is:inline>
  (function () {
    var root = document.querySelector('[data-wellness][data-slug]');
    if (!root) return;
    var wid = root.getAttribute('data-wellness');
    var slug = root.getAttribute('data-slug');
    var defaults = {};
    try { defaults = JSON.parse(root.getAttribute('data-defaults') || '{}'); } catch (_) {}
    var produces = [];
    try { produces = JSON.parse(root.getAttribute('data-produces') || '[]'); } catch (_) {}
    var consumes = [];
    try { consumes = JSON.parse(root.getAttribute('data-consumes') || '[]'); } catch (_) {}

    var form = document.getElementById(slug + '-form');
    var expRoot = document.getElementById(slug + '-experience');
    var heroEl = document.getElementById(slug + '-hero');
    if (!form || !expRoot) return;

    var fieldEls = form.querySelectorAll('[data-field-id]');

    function fieldById(id) {
      for (var i = 0; i < fieldEls.length; i++) {
        if (fieldEls[i].getAttribute('data-field-id') === id) return fieldEls[i];
      }
      return null;
    }

    // Non-numeric fields (select) carry their raw string as the value; numeric fields keep the
    // canonical number in data-raw.
    function isStringField(el) {
      var t = el.getAttribute('data-field-type');
      return t === 'select' || t === 'segmented' || t === 'date' || t === 'datetime' || t === 'text';
    }

    function readValue(el) {
      if (isStringField(el)) return el.value;
      var raw = el.getAttribute('data-raw');
      if (raw === '' || raw == null) return '';
      var n = parseFloat(raw);
      return isNaN(n) ? '' : n;
    }

    function setField(id, value) {
      var el = fieldById(id);
      if (!el) return;
      el.value = value == null ? '' : String(value);
      if (!isStringField(el)) el.setAttribute('data-raw', el.value);
    }

    function collect() {
      var input = {};
      var missingRequired = false;
      for (var i = 0; i < fieldEls.length; i++) {
        var el = fieldEls[i];
        var id = el.getAttribute('data-field-id');
        var required = el.getAttribute('data-required') === 'true';
        var v = readValue(el);
        if (v === '' && required) missingRequired = true;
        input[id] = v;
      }
      return { input: input, missingRequired: missingRequired };
    }

    var caveatEl = document.getElementById(slug + '-caveat');
    var caveatTxt = document.getElementById(slug + '-caveat-text');

    // The craft line: every result on this engine already carries a standing caution, which is why
    // nobody reads it. This one fires only when THIS input has landed where the model is weakest,
    // and states the cost as a number.
    function caveat(input) {
      if (!caveatEl || !caveatTxt) return;
      var msg = (input && window.ToyTools && ToyTools.wellnessCaveat)
        ? ToyTools.wellnessCaveat(wid, input)
        : null;
      if (!msg) { caveatEl.hidden = true; caveatTxt.textContent = ''; return; }
      caveatTxt.textContent = msg;
      caveatEl.hidden = false;
    }

    function run() {
      if (!(window.ToyTools && ToyTools.runWellness && ToyTools.experience)) return;
      var c = collect();
      if (c.missingRequired) {
        ToyTools.experience.render(expRoot, { ok: false, uiState: 'empty', metrics: [] });
        caveat(null);
        renderDelta(null);
        return;
      }
      var res = ToyTools.runWellness(wid, c.input, {});
      ToyTools.experience.render(expRoot, res);
      caveat(res && res.ok ? c.input : null);
      publishDerived(res);
      recordSnapshot(res);
      renderDelta(res);
    }

    // Publish any result another calculator declares as its input, so the number travels.
    function publishDerived(res) {
      if (!res || !res.ok || !produces.length || !(window.ToyTools && ToyTools.profile)) return;
      for (var i = 0; i < produces.length; i++) {
        var spec = produces[i];
        var cards = [res.hero].concat(res.metrics || []);
        for (var j = 0; j < cards.length; j++) {
          if (cards[j] && cards[j].id === spec.cardId && typeof cards[j].raw === 'number') {
            ToyTools.profile.setDerived(spec.name, cards[j].raw);
            break;
          }
        }
      }
    }

    // ── Saved history ────────────────────────────────────────────────────────
    // A calculator used to keep only the values you last typed, so every recalculation overwrote
    // the last and your BMI from a month ago existed nowhere. Snapshots make a one-shot calculator
    // worth returning to: at most one a day, capped, and only when the answer actually moved.
    var HISTORY_MAX = 50;
    var history = [];

    function todayKey() {
      var d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function recordSnapshot(res) {
      if (!res || !res.ok || !res.hero || typeof res.hero.raw !== 'number') return;
      var last = history[history.length - 1];
      // One entry per day, and only when the number moved: tweaking an input ten times in a row
      // is one visit, not ten data points.
      if (last && last.raw === res.hero.raw) return;
      if (last && last.day === todayKey()) history[history.length - 1] = { day: todayKey(), raw: res.hero.raw, value: res.hero.value };
      else history.push({ day: todayKey(), raw: res.hero.raw, value: res.hero.value });
      if (history.length > HISTORY_MAX) history = history.slice(history.length - HISTORY_MAX);
    }

    /** The change since the last DIFFERENT day's reading, or null when there is nothing to compare. */
    function priorReading() {
      var today = todayKey();
      for (var i = history.length - 1; i >= 0; i--) {
        if (history[i].day !== today) return history[i];
      }
      return null;
    }

    function renderDelta(res) {
      var el = document.getElementById(slug + '-delta');
      if (!el) return;
      var prior = priorReading();
      if (!res || !res.ok || !res.hero || typeof res.hero.raw !== 'number' || !prior) {
        el.hidden = true;
        return;
      }
      var diff = res.hero.raw - prior.raw;
      var rounded = Math.round(diff * 100) / 100;
      var text;
      if (rounded === 0) text = 'Unchanged since your last check (' + prior.value + ').';
      else text = (rounded > 0 ? 'Up ' : 'Down ') + Math.abs(rounded) + ' from your last check (' + prior.value + ').';
      el.textContent = text;
      el.hidden = false;

      // A trend line, once there is a trend to show.
      var sparkEl = document.getElementById(slug + '-spark');
      if (sparkEl && window.ToyTools && ToyTools.viz && history.length > 2) {
        sparkEl.innerHTML = ToyTools.viz.sparkline(history.map(function (h) { return h.raw; }));
        sparkEl.hidden = false;
      } else if (sparkEl) {
        sparkEl.hidden = true;
      }
    }

    // ── Shareable link ────────────────────────────────────────────────────────
    // The mode arrives as an attribute and is decided at build time; the client cannot widen it.
    var urlMode = root.getAttribute('data-url-state') || 'off';

    /** Current field values, raw and unformatted, for a link. */
    function shareValues() {
      var out = {};
      for (var i = 0; i < fieldEls.length; i++) {
        var el = fieldEls[i];
        var v = readValue(el);
        if (v !== '' && v !== null && v !== undefined) out[el.getAttribute('data-field-id')] = v;
      }
      return out;
    }

    function persist() {
      if (!(window.ToyTools && ToyTools.state)) return;
      var data = { fields: {}, history: history };
      for (var i = 0; i < fieldEls.length; i++) {
        data.fields[fieldEls[i].getAttribute('data-field-id')] = fieldEls[i].value;
      }
      ToyTools.state.save(slug, data);
      // Every mutation path ends in persist(), so one call here covers typing, presets and reset.
      if (urlMode === 'auto' && ToyTools.url) ToyTools.url.write(shareValues());
    }

    function applyValues(values) {
      for (var id in values) setField(id, values[id]);
    }

    // ── Body profile ─────────────────────────────────────────────────────────
    // Height, weight, age, sex and units are the same facts across these calculators, so they are
    // remembered once and prefilled everywhere. Precedence is deliberate: this tool's own saved
    // input wins over the shared profile, because a value you last typed HERE is the more specific
    // answer. Whatever the profile filled is always stated on screen with a way to undo it.
    var profileEl = document.getElementById(slug + '-profile');
    var profileTextEl = profileEl && profileEl.querySelector('[data-profile-text]');
    var forgetBtn = document.getElementById(slug + '-forget');

    function profileFieldIds() {
      var out = [];
      if (!(window.ToyTools && ToyTools.profile)) return out;
      var known = ToyTools.profile.FIELDS;
      for (var i = 0; i < fieldEls.length; i++) {
        var id = fieldEls[i].getAttribute('data-field-id');
        if (known.indexOf(id) !== -1) out.push(id);
      }
      return out;
    }

    function showProfileNotice(usedIds, derivedNotes) {
      if (!profileEl || !profileTextEl) return;
      var parts = [];
      if (usedIds.length) {
        var summary = ToyTools.profile.summary();
        parts.push(summary ? 'Using your saved details (' + summary + ').' : 'Using your saved details.');
      }
      for (var i = 0; i < derivedNotes.length; i++) parts.push(derivedNotes[i]);
      if (!parts.length) { profileEl.hidden = true; return; }
      profileTextEl.textContent = parts.join(' ');
      profileEl.hidden = false;
    }

    function saveProfile() {
      if (!(window.ToyTools && ToyTools.profile)) return;
      var ids = profileFieldIds();
      if (!ids.length) return;
      var values = {};
      for (var i = 0; i < ids.length; i++) {
        var el = fieldById(ids[i]);
        if (el) values[ids[i]] = el.value;
      }
      ToyTools.profile.merge(values);
    }

    // Restore: this tool's own saved input first, then the shared profile for anything still unset.
    var savedFields = {};
    try {
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load(slug);
      savedFields = (saved && saved.fields) || {};
      if (saved && Array.isArray(saved.history)) history = saved.history;
      for (var id in savedFields) setField(id, savedFields[id]);
    } catch (_) {}

    // A shared link beats saved state: someone followed it to see THOSE values.
    if (urlMode !== 'off') {
      try {
        var incoming = (window.ToyTools && ToyTools.url) ? ToyTools.url.read() : {};
        for (var uid in incoming) if (fieldById(uid)) setField(uid, incoming[uid]);
      } catch (_) {}
    }

    var filledFromProfile = [];
    var derivedNotes = [];
    try {
      if (window.ToyTools && ToyTools.profile) {
        var prof = ToyTools.profile.get();
        var ids = profileFieldIds();
        for (var pi = 0; pi < ids.length; pi++) {
          var pid = ids[pi];
          var already = savedFields[pid];
          if (already !== undefined && already !== '') continue;
          if (prof[pid] === undefined || prof[pid] === '') continue;
          setField(pid, prof[pid]);
          filledFromProfile.push(pid);
        }

        // Numbers another calculator produced (e.g. TDEE -> the macro calculator's calorie target).
        for (var ci = 0; ci < consumes.length; ci++) {
          var spec = consumes[ci];
          var savedHere = savedFields[spec.field];
          if (savedHere !== undefined && savedHere !== '') continue;
          var val = ToyTools.profile.getDerived(spec.name);
          if (val === undefined || val === null || val === '') continue;
          setField(spec.field, val);
          derivedNotes.push(spec.note + ': ' + val + '. Change it above to override.');
        }

        showProfileNotice(filledFromProfile, derivedNotes);
      }
    } catch (_) {}

    if (forgetBtn) forgetBtn.addEventListener('click', function () {
      if (window.ToyTools && ToyTools.profile) ToyTools.profile.clear();
      if (profileEl) profileEl.hidden = true;
      if (window.ToyTools) ToyTools.toast('Saved details forgotten');
    });

    // Field input -> recompute + persist (locally and to the shared profile).
    for (var i = 0; i < fieldEls.length; i++) {
      fieldEls[i].addEventListener('change', function () { run(); persist(); saveProfile(); });
      fieldEls[i].addEventListener('input', function () { run(); persist(); saveProfile(); });
    }

    // Copy link / share.
    var shareBtn = document.getElementById(slug + '-share');
    if (shareBtn) shareBtn.addEventListener('click', function () {
      if (!(window.ToyTools && ToyTools.url)) return;
      ToyTools.url.share(shareValues(), document.title);
      if (!navigator.share) {
        shareBtn.classList.add('is-success');
        shareBtn.textContent = '✓ Link copied';
        setTimeout(function () {
          shareBtn.classList.remove('is-success');
          shareBtn.textContent = 'Copy link';
        }, 2000);
      }
    });

    // Reset to defaults (two-tap confirm).
    var resetBtn = document.getElementById(slug + '-reset');
    var resetTimer;
    if (resetBtn) resetBtn.addEventListener('click', function () {
      if (!resetBtn.classList.contains('is-confirming')) {
        resetBtn.classList.add('is-confirming');
        resetBtn.textContent = 'Confirm Reset';
        clearTimeout(resetTimer);
        resetTimer = setTimeout(function () {
          resetBtn.classList.remove('is-confirming');
          resetBtn.textContent = 'Reset to Defaults';
        }, 3000);
        return;
      }
      resetBtn.classList.remove('is-confirming');
      resetBtn.textContent = 'Reset to Defaults';
      for (var id in defaults) setField(id, defaults[id]);
      run(); persist();
    });

    // Load Example — cycles through the tool's worked examples.
    var exampleNode = document.getElementById(slug + '-examples');
    var exampleBtn = document.getElementById(slug + '-example');
    var exampleIdx = 0;
    if (exampleBtn && exampleNode) {
      var examples = [];
      try { examples = JSON.parse(exampleNode.textContent || '[]'); } catch (_) {}
      exampleBtn.addEventListener('click', function () {
        if (!examples.length) return;
        applyValues(examples[exampleIdx % examples.length]);
        exampleIdx++;
        run(); persist();
      });
    }

    // Copy the hero value.
    var copyBtn = document.getElementById(slug + '-copy');
    var copyTimer;
    if (copyBtn) copyBtn.addEventListener('click', function () {
      var val = heroEl ? heroEl.textContent : '';
      if (!val || val === '0') { if (window.ToyTools) ToyTools.toast('Nothing to copy yet!'); return; }
      if (window.ToyTools) ToyTools.copy(val);
      copyBtn.classList.add('is-success'); copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () { copyBtn.classList.remove('is-success'); copyBtn.textContent = 'Copy'; }, 2000);
    });

    // runWellness + experience attach via the deferred runtime module — wait so restored input renders.
    if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(run); else run();
  })();
</script>
