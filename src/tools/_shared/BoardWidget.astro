---
interface Props {
  rulesId: string;
  slug: string;
  craftId: string;
  columns: number;
  rows: number;
  label: string;
}

const { rulesId, slug, craftId, columns, rows, label } = Astro.props;
const cells = Array.from({ length: columns * rows }, (_, index) => index);
---

<section class="board-match" data-tool={slug} data-rules={rulesId} aria-label={label}>
  <div class="board-stage">
    <p class="board-banner" data-board-banner>X to play. Pass the phone.</p>
    <p class="board-score" data-board-score>X 0, O 0, draws 0</p>
    <div
      class="board-grid"
      data-craft={craftId}
      data-board-grid
      style={`--board-cols: ${columns}; --board-rows: ${rows};`}
      role="group"
      aria-label={label}
    >
      {cells.map((index) => (
        <button type="button" class="board-cell" data-cell={index} data-shape="empty" data-mark="empty" aria-label={`Square ${index + 1}, empty`}>
          <span class="mark" aria-hidden="true"></span>
          <span class="mark-letter"></span>
        </button>
      ))}
    </div>
    <p class="board-note" data-board-note hidden></p>
    <div class="board-actions">
      <button type="button" class="action-btn" data-board-undo disabled>Undo</button>
      <button type="button" class="action-btn" data-board-rematch>Rematch</button>
    </div>
  </div>
</section>

<style>
  .board-match {
    display: flex;
    justify-content: center;
  }
  .board-stage {
    width: min(100%, var(--width-control));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .board-banner,
  .board-score,
  .board-note {
    max-width: none;
    margin: 0;
  }
  .board-banner {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .board-score,
  .board-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .board-note[hidden] { display: none; }
  .board-grid {
    display: grid;
    grid-template-columns: repeat(var(--board-cols), minmax(0, 1fr));
    gap: var(--space-2);
    aspect-ratio: var(--board-cols) / var(--board-rows);
    width: 100%;
    padding: var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .board-cell {
    min-width: 0;
    min-height: var(--touch-target);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    cursor: pointer;
  }
  .board-cell:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .board-cell:active { background: var(--color-surface-hover); }
  .board-cell.is-win { background: var(--color-accent-subtle); }
  .mark {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }
  .mark-x { position: relative; }
  .mark-x::before,
  .mark-x::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--color-text);
  }
  .mark-x::before { transform: translateX(-50%) rotate(45deg); }
  .mark-x::after { transform: translateX(-50%) rotate(-45deg); }
  .mark-o {
    box-sizing: border-box;
    border: 2px solid var(--color-text);
    border-radius: 50%;
  }
  .mark-letter {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    line-height: 1;
    min-height: 1em;
  }
  .board-actions {
    display: flex;
    gap: var(--space-2);
  }
  .board-actions .action-btn {
    flex: 1;
  }
  .board-actions .action-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
</style>

<script is:inline define:vars={{ slug, rulesId }}>
  (function () {
    var root = document.querySelector('[data-tool="' + slug + '"][data-rules="' + rulesId + '"]');
    if (!root) return;
    var scoreKey = 'toytools.' + slug + '.session';

    function readScore() {
      var raw = '';
      try { raw = ToyTools.storage.get(scoreKey) || ''; } catch (e) { raw = ''; }
      if (!raw) return null;
      try {
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (![parsed.X, parsed.O, parsed.draws].every(function (n) { return typeof n === 'number' && n >= 0 && Math.floor(n) === n; })) return null;
        return parsed;
      } catch (e) { return null; }
    }

    function paint(view, reason) {
      var banner = root.querySelector('[data-board-banner]');
      var score = root.querySelector('[data-board-score]');
      var note = root.querySelector('[data-board-note]');
      var undo = root.querySelector('[data-board-undo]');
      if (banner) banner.textContent = view.banner;
      if (score) score.textContent = view.scoreText;
      if (note) {
        note.textContent = reason || '';
        if (reason) note.removeAttribute('hidden');
        else note.setAttribute('hidden', '');
      }
      if (undo) undo.disabled = !view.canUndo;
      view.cells.forEach(function (cell) {
        var button = root.querySelector('[data-cell="' + cell.index + '"]');
        if (!button) return;
        button.setAttribute('data-shape', cell.shape);
        button.setAttribute('data-mark', cell.mark || 'empty');
        button.classList.toggle('is-win', !!cell.win);
        var mark = button.querySelector('.mark');
        if (mark) mark.className = 'mark' + (cell.shape === 'cross' ? ' mark-x' : cell.shape === 'ring' ? ' mark-o' : '');
        var letter = button.querySelector('.mark-letter');
        if (letter) letter.textContent = cell.letter;
        var name = cell.letter ? 'Square ' + (cell.index + 1) + ', ' + cell.letter : 'Square ' + (cell.index + 1) + ', empty';
        button.setAttribute('aria-label', name);
      });
    }

    function saveScore(state) {
      try { ToyTools.storage.set(scoreKey, JSON.stringify(state.score)); } catch (e) {}
    }

    ToyTools.onReady(function () {
      var api = ToyTools.boardGame;
      if (!api) return;
      var state = api.create(rulesId, readScore());

      function show(next, reason) {
        state = next;
        saveScore(state);
        paint(api.view(state), reason || '');
      }

      root.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        var cell = target.closest('[data-cell]');
        if (cell && root.contains(cell)) {
          var result = api.apply(state, Number(cell.getAttribute('data-cell')));
          show(result.state, result.ok ? '' : result.reason);
          return;
        }
        if (target.closest('[data-board-undo]')) {
          show(api.undo(state), '');
          return;
        }
        if (target.closest('[data-board-rematch]')) show(api.rematch(state), '');
      });

      show(state, '');
      root.setAttribute('data-ready', 'true');
    });
  })();
</script>
