---
interface Props {
  rulesId: string;
  slug: string;
  craftId: string;
  columns: number;
  rows: number;
  label: string;
  /** Where the single craft affordance sits. Chess uses the note, quantum the links. */
  craftAt?: 'grid' | 'note' | 'links';
  /** One plain line of house rules under the score, in the score's own style (no new CSS). */
  rule?: string;
}

const { rulesId, slug, craftId, columns, rows, label, craftAt = 'grid', rule } = Astro.props;
const cells = Array.from({ length: columns * rows }, (_, index) => index);
const dense = columns >= 7;
const where = (index: number) => `Row ${Math.floor(index / columns) + 1}, column ${(index % columns) + 1}`;
---

<section class="board-match" data-tool={slug} data-rules={rulesId} aria-label={label}>
  <div class="board-stage">
    <div class="board-head">
      <span class="board-turn" data-board-turn data-seat="X" aria-hidden="true"><svg class="mark-svg" viewBox="0 0 100 100"></svg></span>
      <p class="board-banner" data-board-banner role="status" aria-live="polite">X to play. Pass the phone.</p>
    </div>
    <p class="board-score" data-board-score>X 0, O 0, draws 0</p>
    {rule && <p class="board-score" data-board-rule>{rule}</p>}
    <div class="board-hand" data-board-hand hidden></div>
    <div
      class:list={['board-grid', { 'is-dense': dense }]}
      data-craft={craftAt === 'grid' ? craftId : undefined}
      data-board-grid
      style={`--board-cols: ${columns}; --board-rows: ${rows};`}
      role="group"
      aria-label={label}
    >
      <svg class="board-links" data-board-links data-craft={craftAt === 'links' ? craftId : undefined} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" hidden></svg>
      {cells.map((index) => (
        <button type="button" class="board-cell" data-cell={index} data-shape="empty" data-mark="empty" tabindex={index === 0 ? 0 : -1} aria-label={`${where(index)}, empty`}>
          <span class="mark" aria-hidden="true"></span>
          <span class="mark-letter"></span>
        </button>
      ))}
    </div>
    <div class="board-choices" data-board-choices hidden></div>
    <p class="board-note sr-only" data-board-note data-craft={craftAt === 'note' ? craftId : undefined} role="status" aria-live="polite"></p>
    <div class="board-actions">
      <button type="button" class="action-btn" data-board-undo disabled>Undo</button>
      <button type="button" class="action-btn" data-board-rematch>Rematch</button>
      <button type="button" class="action-btn" data-board-reset>Reset score</button>
    </div>
  </div>
</section>

<style>
  .board-match {
    display: flex;
    justify-content: center;
  }
  .board-stage {
    width: min(100%, var(--width-control));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .board-banner,
  .board-score,
  .board-note {
    max-width: none;
    margin: 0;
  }
  .board-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .board-turn {
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0.25rem;
    border: 2px solid currentColor;
    border-radius: var(--radius-sm);
  }
  .board-turn[hidden] { display: none; }
  .board-banner {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .board-score,
  .board-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .board-hand[hidden],
  .board-choices[hidden],
  .board-links[hidden] { display: none; }
  .board-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--board-cols), minmax(0, 1fr));
    gap: var(--space-2);
    aspect-ratio: var(--board-cols) / var(--board-rows);
    width: 100%;
    padding: var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  /* Seven columns at 48px need a 2px gap to stay on a 393px phone. --space-2 drops the cells under the touch target. */
  .board-grid.is-dense {
    gap: 2px;
    padding: 2px;
  }
  .board-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .board-links line {
    stroke: var(--color-text);
    stroke-width: 0.8;
    stroke-linecap: round;
  }
  .board-cell {
    position: relative;
    min-width: 0;
    min-height: var(--touch-target);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    cursor: pointer;
  }
  .board-cell:focus-visible,
  :global(.board-hand-btn:focus-visible),
  :global(.board-choice-btn:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .board-cell:active { background: var(--color-surface-hover); }
  /* Seat colours: X is the text colour, O the accent. Both clear 3:1 on the cell in each theme. */
  [data-mark='X'],
  [data-seat='X'] { color: var(--color-text); }
  [data-mark='O'],
  [data-seat='O'] { color: var(--color-accent); }
  .board-cell.is-last { box-shadow: inset 0 0 0 2px var(--color-text-muted); }
  .board-cell.is-win,
  .board-cell.is-preview,
  :global(.board-hand-btn.is-selected) { background: var(--color-accent-subtle); }
  .board-cell.is-selected,
  :global(.board-hand-btn.is-selected) {
    background: var(--color-accent-subtle);
    box-shadow: inset 0 0 0 3px var(--color-accent);
  }
  .board-cell.is-target::after {
    content: '';
    position: absolute;
    inset: 36%;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .board-cell.is-target:not([data-mark='empty'])::after {
    inset: 8%;
    background: none;
    border: 3px solid var(--color-accent);
  }
  .board-cell.is-ghost .mark { opacity: 0.45; }
  .mark {
    width: min(68%, 4rem);
    aspect-ratio: 1;
    display: block;
  }
  .board-grid.is-dense .mark { width: 78%; }
  :global(.mark-svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 13;
    stroke-linecap: round;
  }
  :global(.mark-svg .fill) {
    fill: currentColor;
    stroke: var(--color-bg);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  :global(.mark-svg .cut) {
    stroke: var(--color-bg);
    stroke-width: 4;
  }
  :global(.board-hand-btn .mark-svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  :global(.board-hand-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .mark-letter {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    line-height: 1;
    min-height: 1em;
  }
  .board-hand,
  .board-choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(.board-hand-btn),
  :global(.board-choice-btn) {
    min-height: var(--touch-target);
    min-width: var(--touch-target);
    padding-inline: var(--space-3);
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  :global(.board-choice-btn) {
    flex: 1 1 100%;
    text-align: left;
  }
  :global(.board-hand-btn:active),
  :global(.board-choice-btn:active) { background: var(--color-surface-hover); }
  .board-actions {
    display: flex;
    gap: var(--space-2);
  }
  .board-actions .action-btn {
    flex: 1;
  }
  .board-actions .action-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
</style>

<script is:inline define:vars={{ slug, rulesId, columns, rows }}>
  // The score lives in this page's memory only: nothing is saved (privacy rule), so a refresh or a
  // new tab starts at 0. Reset score zeroes it without touching the board.
  (function () {
    var root = document.querySelector('[data-tool="' + slug + '"][data-rules="' + rulesId + '"]');
    if (!root) return;
    var picked = '';
    var fromIndex = -1;
    var pairIndex = -1;
    var previewCol = -1;
    var inputMode = 'cell';
    var lastReason = '';
    var noteFrame = 0;
    // The shown state, for the turn chip and legal-move markers, and the squares the last move changed.
    var currentState = null;
    var lastMove = [];
    var targetsFor = null;
    var grid = root.querySelector('[data-board-grid]');

    // Every mark is an inline SVG drawn in currentColor: no font glyph, so no tofu and no emoji.
    var PIECE = {
      pawn: '<circle class="fill" cx="50" cy="30" r="13"/><path class="fill" d="M36 80Q38 56 45 44h10q7 12 9 36Z"/><rect class="fill" x="24" y="78" width="52" height="12" rx="4"/>',
      rook: '<path class="fill" d="M26 14h12v9h6v-9h12v9h6v-9h12v24l-9 7v27l9 6v12H26V78l9-6V45l-9-7Z"/>',
      knight: '<path class="fill" d="M28 90h48v-8c0-20-5-40-13-52-5-8-12-14-20-16l-2 9c-9 5-17 15-19 25l7 7 12-6c4 4 9 6 13 6-12 9-25 17-26 35Z"/><circle class="cut" cx="45" cy="30" r="1"/>',
      bishop: '<circle class="fill" cx="50" cy="13" r="7"/><path class="fill" d="M50 22C35 34 33 52 41 62h18c8-10 6-28-9-40Z"/><path class="fill" d="M28 90q4-20 14-26h16q10 6 14 26Z"/><path class="cut" d="M46 34l9 12"/>',
    };
    var SHAPE = {
      cross: '<path d="M24 24L76 76M76 24L24 76"/>',
      ring: '<circle cx="50" cy="50" r="31"/>',
      disc: '<circle class="fill" cx="50" cy="50" r="44"/>',
      donut: '<circle cx="50" cy="50" r="34" style="stroke-width:20"/>',
    };
    function svgFor(shape) {
      if (inputMode === 'column' && shape === 'ring') shape = 'donut';
      return SHAPE[shape] || PIECE[shape] || '';
    }
    function shapeClass(shape) {
      if (shape === 'cross') return ' mark-x';
      if (shape === 'ring') return ' mark-o';
      if (shape === 'disc') return ' mark-disc';
      if (shape && shape !== 'empty') return ' mark-piece';
      return '';
    }

    function fillButtons(box, items, className, attr, selected) {
      if (!box) return;
      while (box.firstChild) box.removeChild(box.firstChild);
      if (!items.length) {
        box.setAttribute('hidden', '');
        return;
      }
      box.removeAttribute('hidden');
      items.forEach(function (item) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = className + (String(item.id) === String(selected) ? ' is-selected' : '');
        button.setAttribute(attr, String(item.id));
        if (attr === 'data-piece') button.setAttribute('aria-pressed', String(String(item.id) === String(selected)));
        button.textContent = item.label;
        if (item.shape) {
          var icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          icon.setAttribute('class', 'mark-svg');
          icon.setAttribute('viewBox', '0 0 100 100');
          icon.setAttribute('aria-hidden', 'true');
          icon.innerHTML = PIECE[item.shape] || '';
          button.insertBefore(icon, button.firstChild);
        }
        if (item.name) button.setAttribute('aria-label', item.name);
        box.appendChild(button);
      });
    }

    function paintLinks(links) {
      var svg = root.querySelector('[data-board-links]');
      if (!svg) return;
      while (svg.firstChild) svg.removeChild(svg.firstChild);
      if (!links || !links.length) {
        svg.setAttribute('hidden', '');
        return;
      }
      svg.removeAttribute('hidden');
      links.forEach(function (link) {
        var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', String(((link.a % columns) + 0.5) / columns * 100));
        line.setAttribute('y1', String((Math.floor(link.a / columns) + 0.5) / rows * 100));
        line.setAttribute('x2', String(((link.b % columns) + 0.5) / columns * 100));
        line.setAttribute('y2', String((Math.floor(link.b / columns) + 0.5) / rows * 100));
        svg.appendChild(line);
      });
    }

    // `fresh` is true only when a move was just tried. Hover previews and piece picks repaint with
    // the last reason and must not announce it again.
    function paint(view, reason, fresh) {
      inputMode = view.input || 'cell';
      var banner = root.querySelector('[data-board-banner]');
      var score = root.querySelector('[data-board-score]');
      var note = root.querySelector('[data-board-note]');
      var undo = root.querySelector('[data-board-undo]');
      if (banner && banner.textContent !== view.banner) banner.textContent = view.banner;
      if (score) score.textContent = view.scoreText;
      // The note is a live region that stays rendered: screen readers miss the first message in a
      // region that was display:none. Empty, it wears the global .sr-only clip (1px, no layout);
      // with a reason it shows. The same reason twice after a fresh tap (a second tap on a taken
      // square) would not change the text, so it is cleared and set again on the next frame. Any
      // paint first cancels a re-set still pending, so a stale reason never lands late.
      if (note) {
        var text = reason || '';
        if (noteFrame) {
          cancelAnimationFrame(noteFrame);
          noteFrame = 0;
        }
        note.classList.toggle('sr-only', !text);
        if (fresh && text && note.textContent === text) {
          note.textContent = '';
          noteFrame = requestAnimationFrame(function () {
            noteFrame = 0;
            note.textContent = text;
          });
        } else if (note.textContent !== text) {
          note.textContent = text;
        }
      }
      if (undo) undo.disabled = !view.canUndo;
      fillButtons(
        root.querySelector('[data-board-hand]'),
        (view.hand || []).map(function (piece) { return { id: piece.id, label: piece.letter, name: piece.name ? 'Place ' + piece.name : '', shape: piece.name || '' }; }),
        'board-hand-btn',
        'data-piece',
        picked
      );
      fillButtons(
        root.querySelector('[data-board-choices]'),
        (view.choices || []).map(function (choice) { return { id: choice.id, label: choice.label }; }),
        'board-choice-btn',
        'data-choice',
        ''
      );
      paintLinks(view.links || []);
      var targets = legalTargets();
      var turn = root.querySelector('[data-board-turn]');
      if (turn) {
        var seat = currentState ? currentState.turn : 'X';
        turn.hidden = view.status !== 'playing';
        turn.setAttribute('data-seat', seat);
        var chip = inputMode === 'column' ? (seat === 'X' ? 'disc' : 'donut') : inputMode === 'chess' ? 'pawn' : seat === 'X' ? 'cross' : 'ring';
        var chipSvg = turn.querySelector('svg');
        if (chipSvg && turn.getAttribute('data-drawn') !== chip) {
          turn.setAttribute('data-drawn', chip);
          chipSvg.innerHTML = SHAPE[chip] || PIECE[chip];
        }
      }
      // Quantum: with one open square left a single tap marks it, so its label says so.
      var openCells = view.cells.filter(function (c) { return !c.mark; });
      var lastOpen = inputMode === 'pair' && view.status === 'playing' && openCells.length === 1 ? openCells[0].index : -1;
      view.cells.forEach(function (cell) {
        var button = root.querySelector('[data-cell="' + cell.index + '"]');
        if (!button) return;
        button.setAttribute('data-shape', cell.shape);
        button.setAttribute('data-mark', cell.mark || 'empty');
        button.classList.toggle('is-win', !!cell.win);
        button.classList.toggle('is-preview', !!cell.preview);
        button.classList.toggle('is-ghost', !!cell.ghost);
        var selected = cell.index === fromIndex || cell.index === pairIndex;
        button.classList.toggle('is-selected', selected);
        button.classList.toggle('is-target', targets.indexOf(cell.index) >= 0);
        button.classList.toggle('is-last', lastMove.indexOf(cell.index) >= 0 && !cell.ghost);
        var mark = button.querySelector('.mark');
        if (mark) {
          var cls = 'mark' + shapeClass(cell.shape);
          var key = cell.shape + (cell.shape === 'ring' ? inputMode : '');
          if (mark.className !== cls || mark.getAttribute('data-drawn') !== key) {
            mark.className = cls;
            mark.setAttribute('data-drawn', key);
            mark.innerHTML = cell.shape === 'empty' ? '' : '<svg class="mark-svg" viewBox="0 0 100 100">' + svgFor(cell.shape) + '</svg>';
          }
        }
        var letter = button.querySelector('.mark-letter');
        var text = cell.letter || '';
        if (letter) letter.textContent = text;
        var name = 'Row ' + (Math.floor(cell.index / columns) + 1) + ', column ' + ((cell.index % columns) + 1) + ', ' + (cell.name ? cell.mark + ' ' + cell.name : text || 'empty') + (cell.win ? ', winning line' : '') + (cell.index === lastOpen ? ', last square' : '') + (selected ? ', selected' : '');
        if (cell.ghost) name = 'Column ' + ((cell.index % columns) + 1) + ', preview';
        button.setAttribute('aria-label', name);
      });
    }

    function legalTargets() {
      return targetsFor ? targetsFor() : [];
    }

    function columnFromEvent(event) {
      var target = event.target;
      if (!target || !target.closest) return -1;
      var cell = target.closest('[data-cell]');
      if (!cell || !root.contains(cell)) return -1;
      return Number(cell.getAttribute('data-cell')) % columns;
    }

    ToyTools.onReady(function () {
      var api = ToyTools.boardGame;
      if (!api) return;
      var state = api.create(rulesId);
      // Legal targets for the current pick, found by asking the engine (apply is pure and never throws).
      targetsFor = function () {
        var out = [];
        if (state.outcome) return out;
        for (var i = 0; i < columns * rows; i++) {
          var move = null;
          if (inputMode === 'chess' && picked) move = { kind: 'place', piece: picked, index: i };
          else if (inputMode === 'chess' && fromIndex >= 0 && i !== fromIndex) move = { kind: 'slide', from: fromIndex, to: i };
          else if (inputMode === 'pair' && pairIndex >= 0 && i !== pairIndex) move = { kind: 'mark', a: pairIndex, b: i };
          if (move && api.apply(state, move).ok) out.push(i);
        }
        return out;
      };
      function changed(before, after) {
        var out = [];
        if (!before) return out;
        after.cells.forEach(function (cell, i) {
          var was = before.cells[i];
          if (was && (was.mark !== cell.mark || was.shape !== cell.shape || was.letter !== cell.letter)) out.push(i);
        });
        return out;
      }
      function deselect() {
        if (!picked && fromIndex < 0 && pairIndex < 0) return false;
        picked = '';
        fromIndex = -1;
        pairIndex = -1;
        paint(api.view(state), lastReason);
        return true;
      }

      function show(next, reason, keepSelection, moved) {
        var before = currentState ? api.view(currentState) : null;
        state = next;
        currentState = next;
        if (moved === true) lastMove = changed(before, api.view(next));
        else if (moved === 'clear') lastMove = [];
        if (!keepSelection) {
          picked = '';
          fromIndex = -1;
          pairIndex = -1;
        }
        previewCol = -1;
        lastReason = reason || '';
        paint(api.view(state), lastReason, true);
      }

      if (grid) {
        // Roving tabindex: the board is one Tab stop. Arrows move between squares, Home and End
        // go to the row's ends, and Enter or Space plays the focused square as before.
        var cellCount = columns * rows;
        function rove(index, focus) {
          var buttons = grid.querySelectorAll('[data-cell]');
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].tabIndex = Number(buttons[i].getAttribute('data-cell')) === index ? 0 : -1;
          }
          var next = grid.querySelector('[data-cell="' + index + '"]');
          if (focus && next) next.focus();
        }
        grid.addEventListener('focusin', function (event) {
          var cell = event.target && event.target.closest ? event.target.closest('[data-cell]') : null;
          if (cell) rove(Number(cell.getAttribute('data-cell')), false);
        });
        grid.addEventListener('keydown', function (event) {
          var cell = event.target && event.target.closest ? event.target.closest('[data-cell]') : null;
          if (!cell) return;
          var at = Number(cell.getAttribute('data-cell'));
          var row = Math.floor(at / columns);
          var col = at % columns;
          var to = -1;
          if (event.key === 'ArrowRight') to = col < columns - 1 ? at + 1 : at;
          else if (event.key === 'ArrowLeft') to = col > 0 ? at - 1 : at;
          else if (event.key === 'ArrowDown') to = at + columns < cellCount ? at + columns : at;
          else if (event.key === 'ArrowUp') to = at - columns >= 0 ? at - columns : at;
          else if (event.key === 'Home') to = row * columns;
          else if (event.key === 'End') to = row * columns + columns - 1;
          if (to < 0) return;
          event.preventDefault();
          rove(to, true);
        });
        grid.addEventListener('pointerover', function (event) {
          if (inputMode !== 'column') return;
          var col = columnFromEvent(event);
          if (col < 0 || col === previewCol) return;
          previewCol = col;
          paint(api.view(state, { column: col }), lastReason);
        });
        grid.addEventListener('pointerleave', function () {
          if (inputMode !== 'column' || previewCol < 0) return;
          previewCol = -1;
          paint(api.view(state), lastReason);
        });
        grid.addEventListener('pointerup', function (event) {
          if (inputMode !== 'column') return;
          var col = columnFromEvent(event);
          previewCol = -1;
          if (col < 0) {
            paint(api.view(state), lastReason);
            return;
          }
          var result = api.apply(state, col);
          show(result.state, result.ok ? '' : result.reason, false, result.ok);
        });
      }

      // Escape drops a picked piece, a selected square, or the first square of a pair.
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        var active = document.activeElement;
        if (active && active !== document.body && !root.contains(active)) return;
        if (deselect()) event.preventDefault();
      });

      root.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        if (target.closest('[data-board-undo]')) {
          show(api.undo(state), '', false, 'clear');
          return;
        }
        if (target.closest('[data-board-rematch]')) {
          show(api.rematch(state), '', false, 'clear');
          return;
        }
        if (target.closest('[data-board-reset]')) {
          show(api.resetScore(state), '', false, 'clear');
          return;
        }
        var choice = target.closest('[data-choice]');
        if (choice && root.contains(choice)) {
          var collapsed = api.apply(state, { kind: 'collapse', resolution: Number(choice.getAttribute('data-choice')) });
          show(collapsed.state, collapsed.ok ? '' : collapsed.reason, false, collapsed.ok);
          return;
        }
        var piece = target.closest('[data-piece]');
        if (piece && root.contains(piece)) {
          var id = piece.getAttribute('data-piece') || '';
          picked = picked === id ? '' : id;
          fromIndex = -1;
          // A valid pick answers the last refusal, so its note goes.
          lastReason = '';
          paint(api.view(state), lastReason);
          return;
        }
        var cell = target.closest('[data-cell]');
        if (!cell || !root.contains(cell)) return;
        if (inputMode === 'column') {
          // Pointer drops happen on pointerup (above), and the click that follows them has
          // detail >= 1, so it is ignored: one press, one disc. A keyboard press (Enter or Space on
          // a focused square) fires only a click, with detail 0, so it drops into that column.
          if (event.detail !== 0) return;
          var dropped = api.apply(state, Number(cell.getAttribute('data-cell')) % columns);
          show(dropped.state, dropped.ok ? '' : dropped.reason, false, dropped.ok);
          return;
        }
        var index = Number(cell.getAttribute('data-cell'));
        if (inputMode === 'chess') {
          var placed;
          if (picked) {
            placed = api.apply(state, { kind: 'place', piece: picked, index: index });
          } else if (fromIndex < 0 || (index !== fromIndex && state.cells[index] === state.turn)) {
            // Only the mover's own piece can be the origin. An empty or opposing square is not
            // selected: the engine's reason ("That is not your piece." or "Place a piece from
            // your hand first.") is shown and nothing stays picked, so the next tap starts fresh.
            // Tapping another of your own pieces moves the selection to it.
            if (state.cells[index] !== state.turn) {
              var notYours = api.apply(state, { kind: 'slide', from: index, to: index });
              show(notYours.state, notYours.reason || 'That is not your piece.');
              return;
            }
            fromIndex = index;
            lastReason = '';
            paint(api.view(state), lastReason);
            return;
          } else if (fromIndex === index) {
            fromIndex = -1;
            paint(api.view(state), lastReason);
            return;
          } else {
            placed = api.apply(state, { kind: 'slide', from: fromIndex, to: index });
          }
          // A refused move keeps the selection only while it is still the mover's own piece.
          show(placed.state, placed.ok ? '' : placed.reason, !placed.ok && (picked !== '' || state.cells[fromIndex] === placed.state.turn), placed.ok);
          return;
        }
        if (inputMode === 'pair') {
          if (api.view(state).choices.length) {
            // A collapse is waiting: say so on the first tap instead of half-selecting a pair.
            var waiting = api.apply(state, { kind: 'mark', a: index, b: index });
            show(waiting.state, waiting.reason);
            return;
          }
          var markAttr = cell.getAttribute('data-mark');
          if (markAttr === 'X' || markAttr === 'O') {
            var classical = api.apply(state, { kind: 'mark', a: index, b: index });
            show(classical.state, classical.ok ? '' : classical.reason, !classical.ok, classical.ok);
            return;
          }
          // One square left: a move cannot mark two, so a single tap places the classical mark
          // there (the engine takes it as a = b). The banner says so.
          var open = state.cells.filter(function (c) { return c === null; }).length;
          if (open === 1 && pairIndex < 0) {
            var last = api.apply(state, { kind: 'mark', a: index, b: index });
            show(last.state, last.ok ? '' : last.reason, false, last.ok);
            return;
          }
          if (pairIndex < 0) {
            pairIndex = index;
            paint(api.view(state), lastReason);
            return;
          }
          var marked = api.apply(state, { kind: 'mark', a: pairIndex, b: index });
          show(marked.state, marked.ok ? '' : marked.reason, !marked.ok, marked.ok);
          return;
        }
        var result = api.apply(state, index);
        show(result.state, result.ok ? '' : result.reason, false, result.ok);
      });

      show(state, '');
      root.setAttribute('data-ready', 'true');
    });
  })();
</script>
