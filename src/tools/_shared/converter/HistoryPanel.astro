---
// Recent conversions (last 5, this page view only). The ConverterWidget fills the <ul> from
// ToyTools.history and toggles the section's `hidden`. Each item restores on click.
// Privacy-first: ToyTools.history keeps the list in memory, never in any browser storage, so a
// reload or a closed tab forgets it.
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<section class="conv-history" data-conv-history hidden>
  <h2 class="conv-history-title">Recent conversions</h2>
  <ul class="conv-history-list" id={id} aria-label="Recent conversions — click to restore"></ul>
</section>
