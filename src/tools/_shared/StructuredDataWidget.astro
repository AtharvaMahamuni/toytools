---
// Generic structured-data widget — powers json-formatter / json-minifier / json-validator
// (and any future structured-data tool). It knows nothing about a specific tool: it reads a
// structuredId and runs `input → ToyTools.runStructuredData(id, input) → { ok, output, error }`
// live, rendering a ✓/✗ status line. Per-tool Widget.astro files are 3-line wrappers.
//
// If a new structured-data tool ever requires editing this file, the architecture has failed.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import EducationalInsight from '@tools/_shared/converter/EducationalInsight.astro';
import TechnicalDetails from '@tools/_shared/converter/TechnicalDetails.astro';
import ExampleLoader from '@tools/_shared/converter/ExampleLoader.astro';
import { structuredInfo } from '@lib/engines/structured-data/info';
import { STRUCTURED_TOOLS } from '@lib/engines/structured-data/registry';
import type { ToolConfig } from '@data/types';

interface Props {
  slug: string;
  structuredId: string;
  config: ToolConfig;
  showOutput?: boolean;
  /**
   * Opt-in phone-first layout (beta-v12.1, used only by JSON to JSON Schema). Moves the insight
   * paragraph and the Technical details rows out of the widget into Zone C's "More about" row
   * (still in the HTML: see [data-more-about] in KnowledgeDrawers), labels the example button
   * "Sample" so the four actions fit one row at 390px, and opens the input at about six rows
   * (.sd-slim in tool-widget.css). Off by default, and off means byte-identical markup to before:
   * every slim difference is a conditional that renders nothing when the flag is unset.
   */
  slim?: boolean;
}

const { slug, structuredId, config, showOutput = true, slim = false } = Astro.props;
// Fragment when not slim, so the default path gains no wrapper element.
const Root = slim ? 'div' : Fragment;
const rootProps = slim ? { class: 'sd-slim' } : {};

// Group members share one state envelope so input survives switching modes.
const stateKey = config?.toolGroup ? `group:${config.toolGroup}` : slug;
// Reusable educational blocks (same ones the ConverterWidget uses).
const info = structuredInfo(structuredId);
const insightLines = info.insight == null ? [] : Array.isArray(info.insight) ? info.insight : [info.insight];
const technicalRows = info.technical ?? [];
// A tool whose input is not JSON has no honest repair to offer, and declining must cost
// nothing on the page: no hidden button, no bytes, no markup.
const repairable = STRUCTURED_TOOLS[structuredId]?.jsonInput === true;

const inputId = `${slug}-input`;
const outputId = `${slug}-output`;
const statusId = `${slug}-status`;
---

<Root {...rootProps}>
<ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={false}>
  <IoPanel slot="input" label="Input" labelFor={inputId} data-structured={structuredId} data-slug={slug} data-state-key={stateKey} data-sample={info.sample ?? ''}>
    <textarea
      id={inputId}
      aria-label={info.inputLabel ?? 'JSON input'}
      placeholder={info.placeholder ?? 'Paste JSON here'}
      rows={slim ? '6' : undefined}
      spellcheck="false"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"></textarea>
  </IoPanel>

  <IoPanel slot="output" label={showOutput ? 'Output' : 'Status'} copyTargetId={showOutput ? outputId : undefined}>
    <p id={statusId} class="io-status" data-ok="" aria-live="polite"></p>
    {/* The craft seam: the status line names the fault, and the fix belongs where the diagnosis
        is. A button and nothing else — no new bordered card (R2/R5). */}
    {repairable && (
      <button type="button" class="sd-repair" id={`${slug}-repair`} data-craft={config.craft?.id} hidden></button>
    )}
    {showOutput && (
      <output id={outputId} class="io-output--bordered" aria-live="polite" data-empty>Output will appear here</output>
    )}
  </IoPanel>
</ToolSplit>

<ToolActions
  clearTarget={inputId}
  pasteTarget={inputId}
  downloadTarget={showOutput ? outputId : undefined}
  downloadFilename={showOutput ? `${slug}${info.downloadExt ?? '.json'}` : undefined}
>
  <ExampleLoader hasSample={!!info.sample} label={slim ? 'Sample' : undefined} />
</ToolActions>

<slot />

{!slim && <EducationalInsight insight={info.insight} />}
{!slim && <TechnicalDetails technical={info.technical} />}

{/* slim: the same insight and technical rows, handed to Zone C's "More about" row instead of
    painted under the actions. One drawer, not a callout plus a drawer. */}
{slim && (insightLines.length > 0 || technicalRows.length > 0) && (
  <div class="more-about" data-more-about>
    <details class="widget-details" id={`${slug}-about`}>
      <summary><h2>How {config.name} works</h2></summary>
      {insightLines.map((line) => <p>{line}</p>)}
      {technicalRows.length > 0 && (
        <dl class="conv-tech-list">
          {technicalRows.map((entry) => (
            <div class="conv-tech-row">
              <dt>{entry.term}</dt>
              <dd>{entry.detail}</dd>
            </div>
          ))}
        </dl>
      )}
    </details>
  </div>
)}
</Root>


<script is:inline>
  (function () {
    var root = document.querySelector('[data-structured][data-slug]');
    if (!root) return;
    var sid = root.getAttribute('data-structured');
    var slug = root.getAttribute('data-slug');
    var stateKey = root.getAttribute('data-state-key') || slug;
    var input = document.getElementById(slug + '-input');
    var output = document.getElementById(slug + '-output');
    var status = document.getElementById(slug + '-status');
    if (!input || !status) return;

    function setOutput(text, empty) {
      if (!output) return;
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else output.removeAttribute('data-empty');
    }

    function run() {
      if (!(window.ToyTools && ToyTools.runStructuredData)) return;
      if (!input.value.trim()) {
        status.textContent = '';
        status.setAttribute('data-ok', '');
        setOutput('Output will appear here', true);
        repair.offer(true);
        return;
      }
      var ticket = ++runSeq;
      var res = ToyTools.runStructuredData(sid, input.value);
      if (res && typeof res.then === 'function') {
        res.then(function (settled) { if (ticket === runSeq) apply(settled); });
        return;
      }
      apply(res);
    }

    var runSeq = 0;
    function apply(res) {
      status.setAttribute('data-ok', res.ok ? 'true' : 'false');
      status.textContent = res.ok ? '✓ Valid' : '✗ ' + (res.error || 'Invalid');
      setOutput(res.ok ? (res.output || '') : 'Output will appear here', !res.ok);
      repair.offer(res.ok);
    }

    // JSON.parse reports a character offset the user has to count to by hand, and the two commonest
    // causes — a trailing comma and the smart quotes a document inserted — are mechanically fixable.
    // Silent unless the engine has a repair that actually parses.
    var repair = (function (el) {
      var pending = null;
      function hide() { if (el) { el.hidden = true; el.textContent = ''; } pending = null; }
      function offer(ok) {
        if (!el) return;
        if (ok || !(window.ToyTools && ToyTools.repairStructuredData)) { hide(); return; }
        var r = ToyTools.repairStructuredData(sid, input.value);
        if (!r || !r.label) { hide(); return; }
        pending = r;
        el.textContent = r.label;
        el.hidden = false;
      }
      if (el) {
        el.addEventListener('click', function () {
          if (!pending) return;
          var next = pending;
          input.value = next.text;
          hide();
          run();
          persist();
          if (window.ToyTools && ToyTools.toast) ToyTools.toast('Applied: ' + next.label);
          input.focus();
        });
      }
      return { offer: offer, hide: hide };
    })(document.getElementById(slug + '-repair'));

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save(stateKey, { input: input.value });
    }

    // Restore prior input — group key first, then the tool's old per-slug key (migration).
    try {
      var saved = window.ToyTools && ToyTools.state && (ToyTools.state.load(stateKey) || ToyTools.state.load(slug));
      if (saved && typeof saved.input === 'string') input.value = saved.input;
    } catch (_) {}

    input.addEventListener('input', function () { run(); persist(); });

    var exBtn = document.querySelector('[data-conv-example]');
    if (exBtn) exBtn.addEventListener('click', function () {
      var sample = root.getAttribute('data-sample') || '';
      if (!sample) return;
      input.value = sample;
      run(); persist();
      input.focus();
    });

    // runStructuredData attaches via a deferred module; wait so restored input validates on load.
    if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(run); else run();
  })();
</script>
