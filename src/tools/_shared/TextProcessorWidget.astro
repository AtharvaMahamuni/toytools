---
// Generic text-processor widget — powers every transform/cleanup tool (and any future
// processor family). It knows nothing about specific processors: it reads a processorId,
// runs `text → ToyTools.process(processorId, text) → output` live, and renders shared
// chrome. Per-tool Widget.astro files are 3-line wrappers passing config.
//
// If a new processor family ever requires editing this file, the architecture has failed.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import ExampleLoader from '@tools/_shared/converter/ExampleLoader.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
import { withBase } from '@lib/paths';
import type { ToolConfig } from '@data/types';

interface Props {
  slug: string;
  processorId: string;
  config: ToolConfig;
  /** Overrides the family default sample for the Load-example action. */
  sampleText?: string;
}

const { slug, processorId, config, sampleText } = Astro.props;

// Tools in a group share one state envelope so input survives mode switches.
const stateKey = config?.toolGroup ? `group:${config.toolGroup}` : slug;

// Sample action parity with the other engine widgets: one messy default per family
// (the cleanup sample trips every cleanup processor; the transform one re-cases well).
const FAMILY_SAMPLES: Record<string, string> = {
  transform: 'The quick brown fox jumps over the lazy dog',
  cleanup:
    '  The   quick  brown fox  \n  The   quick  brown fox  \n\n\tjumps\tover the lazy dog.  \n\n  Café déjà vu  ',
};
const sample = sampleText ?? (config.family ? FAMILY_SAMPLES[config.family] : undefined);

const inputId = `${slug}-input`;
const outputId = `${slug}-output`;

// The craft seam (src/lib/text/handoff.ts) hands off to a sibling on this same engine, so every
// destination lives under one segment. withBase is a build-time function and cannot be called from
// the inline script, so the prefix is rendered once and the script appends the slug.
const craftId = config.craft?.id;
const siblingBase = withBase('/tool/text/');
---

<ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={false}>
  <IoPanel slot="input" label="Text" labelFor={inputId} variant="prose"
    data-tool={slug} data-processor={processorId} data-slug={slug} data-state-key={stateKey}
    data-sample={sample ?? ''} data-sibling-base={siblingBase}>
    <textarea id={inputId} placeholder="Paste or type text here"></textarea>
  </IoPanel>

  <IoPanel slot="output" label="Result" variant="prose" copyTargetId={outputId}>
    <textarea id={outputId} readonly placeholder="Result appears here" aria-label="Result"></textarea>
    {craftId && <CraftNote id={`${slug}-handoff`} craftId={craftId} linkAction />}
  </IoPanel>
</ToolSplit>

<ToolActions
  clearTarget={inputId}
  pasteTarget={inputId}
  downloadTarget={outputId}
  downloadFilename={`${slug}-output.txt`}
>
  <ExampleLoader hasSample={!!sample} />
</ToolActions>


<script is:inline>
  (function () {
    var root = document.querySelector('[data-processor][data-slug]');
    if (!root) return;
    var pid = root.getAttribute('data-processor');
    var slug = root.getAttribute('data-slug');
    var stateKey = root.getAttribute('data-state-key') || slug;
    var input = document.getElementById(slug + '-input');
    var out = document.getElementById(slug + '-output');
    if (!input || !out) return;

    var noteEl = document.getElementById(slug + '-handoff');
    var noteTxt = document.getElementById(slug + '-handoff-text');
    var noteLink = document.getElementById(slug + '-handoff-action');
    var siblingBase = root.getAttribute('data-sibling-base') || '/tool/text/';

    // The craft line: eighteen tools on this engine are one paste apart, and the commonest way to
    // fail here is to land on the wrong one and get a correct-looking result. The engine is the only
    // thing that can see the input, the output and what the sibling would have done.
    function note() {
      if (!noteEl || !noteTxt) return;
      var h = (window.ToyTools && ToyTools.textHandoff)
        ? ToyTools.textHandoff(pid, input.value, out.value)
        : null;
      if (!h) { noteEl.hidden = true; noteTxt.textContent = ''; if (noteLink) noteLink.hidden = true; return; }
      noteTxt.textContent = h.text;
      if (noteLink) {
        if (h.tool) {
          noteLink.textContent = h.tool.name;
          noteLink.setAttribute('href', siblingBase + h.tool.slug + '/');
          noteLink.hidden = false;
        } else {
          noteLink.hidden = true;
        }
      }
      noteEl.hidden = false;
    }

    function run() {
      // Registry lookup only — the widget never names a processor.
      out.value = (window.ToyTools && ToyTools.process)
        ? ToyTools.process(pid, input.value)
        : input.value;
      note();
    }

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save(stateKey, { input: input.value });
    }

    // Restore prior input — group key first, then the tool's old per-slug key (migration).
    try {
      var saved = window.ToyTools && ToyTools.state
        && (ToyTools.state.load(stateKey) || ToyTools.state.load(slug));
      if (saved && typeof saved.input === 'string') input.value = saved.input;
    } catch (_) {}

    input.addEventListener('input', function () { run(); persist(); });

    var exBtn = document.querySelector('[data-conv-example]');
    if (exBtn) exBtn.addEventListener('click', function () {
      var sample = root.getAttribute('data-sample') || '';
      if (!sample) return;
      input.value = sample;
      run(); persist();
      input.focus();
    });

    // ToyTools.process attaches via the deferred runtime module — wait for it so
    // restored input renders converted on load (matches the other engine widgets).
    if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(run); else run();
  })();
</script>
