---
// GeneratorOptions — renders a generator's option controls from its declarative field schema.
// Presentational only: no per-tool knowledge. Each control carries data-field-id / data-field-type
// so the GeneratorWidget controller can collect values generically, and conditional (showWhen)
// fields carry data-show-when-* so the controller can toggle their visibility. Booleans that share
// a `group` render under one heading. Tokens only; 48px touch targets; every control is labelled.
import type { GeneratorField } from '@lib/generation/types';

interface Props {
  fields: GeneratorField[];
  idPrefix: string;
}
const { fields, idPrefix } = Astro.props;

const fid = (id: string) => `${idPrefix}-f-${id}`;
const defaults: Record<string, GeneratorField['default']> = Object.fromEntries(fields.map((f) => [f.id, f.default]));

// A field is initially hidden when its showWhen condition does not match the controlling default.
function initiallyHidden(f: GeneratorField): boolean {
  if (!f.showWhen) return false;
  const current = String(defaults[f.showWhen.field]);
  if (f.showWhen.oneOf) return !f.showWhen.oneOf.includes(current);
  return current !== String(f.showWhen.equals);
}

// Track group boundaries so a shared heading renders once per cluster.
let lastGroup: string | undefined;
const rows = fields.map((f) => {
  const showGroupLabel = f.group && f.group !== lastGroup;
  lastGroup = f.group;
  return { field: f, showGroupLabel };
});
---

<div class="gen-options">
  {rows.map(({ field, showGroupLabel }) => (
    <>
      {showGroupLabel && <p class="gen-group-label">{field.group}</p>}
      <div
        class:list={['gen-field', `gen-field--${field.type}`]}
        data-field-id={field.id}
        data-field-type={field.type}
        hidden={initiallyHidden(field)}
        {...(field.showWhen
          ? {
              'data-show-when-field': field.showWhen.field,
              'data-show-when-values': (field.showWhen.oneOf ?? [field.showWhen.equals]).join(','),
            }
          : {})}
      >
        {field.type === 'boolean' ? (
          <label class="gen-check" for={fid(field.id)}>
            <input type="checkbox" id={fid(field.id)} checked={field.default === true} />
            <span>{field.label}</span>
          </label>
        ) : (
          <label class="gen-label" for={fid(field.id)}>{field.label}</label>
        )}

        {field.type === 'range' && (
          <div class="gen-range-row">
            <input
              type="range"
              id={fid(field.id)}
              min={field.min}
              max={field.max}
              step={field.step ?? 1}
              value={Number(field.default)}
              aria-label={field.label}
            />
            <output class="gen-range-value" for={fid(field.id)} data-range-value>{field.default}</output>
          </div>
        )}

        {field.type === 'number' && (
          <input
            type="number"
            id={fid(field.id)}
            min={field.min}
            max={field.max}
            step={field.step ?? 1}
            value={Number(field.default)}
          />
        )}

        {field.type === 'select' && (
          <select id={fid(field.id)}>
            {(field.options ?? []).map((o) => (
              <option value={o.value} selected={o.value === field.default}>{o.label}</option>
            ))}
          </select>
        )}

        {field.type === 'text' && (
          <input
            type="text"
            id={fid(field.id)}
            value={String(field.default ?? '')}
            placeholder={field.placeholder}
            autocomplete="off"
            spellcheck={false}
          />
        )}

        {field.help && <p class="gen-help">{field.help}</p>}
      </div>
    </>
  ))}
</div>

<style>
  .gen-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .gen-group-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin: var(--space-2) 0 calc(-1 * var(--space-1));
  }
  .gen-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .gen-field[hidden] { display: none; }
  .gen-field--boolean { flex-direction: row; }
  .gen-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }
  .gen-check {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .gen-check input[type='checkbox'] {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .gen-range-row { display: flex; align-items: center; gap: var(--space-3); }
  .gen-range-row input[type='range'] { flex: 1; min-height: var(--touch-target); accent-color: var(--color-accent); cursor: pointer; }
  .gen-range-value {
    min-width: 3ch;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .gen-field input[type='number'],
  .gen-field input[type='text'],
  .gen-field select {
    width: 100%;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    font-family: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border);
    border-radius: var(--radius-md);
  }
  .gen-field input[type='text'] { font-family: var(--font-mono); }
  .gen-help { font-size: var(--text-xs); color: var(--color-text-muted); margin: 0; }
</style>
