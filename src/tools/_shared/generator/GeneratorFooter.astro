---
// GeneratorFooter — the local-processing reassurance line shown under every generator. The header
// already carries the TrustNotice badge; this restates the promise in plain words next to the
// output, matching the platform's privacy-first messaging.
import { PRIVACY_LINE } from '@lib/privacy';
import type { LocaleCode } from '@data/locales';
import { getUiStrings } from '@data/i18n';

interface Props {
  lang?: LocaleCode;
}
const { lang = 'en' } = Astro.props;
const t = getUiStrings(lang);
const privacyLine = lang === 'en' ? PRIVACY_LINE : t.footer.privacyByVariant.private;
---

<p class="gen-footer">
  <span class="gen-footer-dot" aria-hidden="true">●</span>
  {privacyLine}
</p>

<style>
  .gen-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .gen-footer-dot { color: var(--color-text-subtle); }
</style>
