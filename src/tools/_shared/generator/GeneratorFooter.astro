---
// GeneratorFooter — the local-processing reassurance line shown under every generator. The header
// already carries the TrustNotice badge; this restates the promise in plain words next to the
// output, matching the platform's privacy-first messaging.
import { PRIVACY_LINE } from '@lib/privacy';
---

<p class="gen-footer">
  <span class="gen-footer-dot" aria-hidden="true">●</span>
  {PRIVACY_LINE}
</p>

<style>
  .gen-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .gen-footer-dot { color: var(--color-accent); }
</style>
