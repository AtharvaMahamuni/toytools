---
// Generic encoding widget — powers every encode/decode tool (base64, url, html-entity,
// and any future encoder family). It knows nothing about a specific encoder: it reads an
// encodingId + mode and runs `text → ToyTools.runEncoding(id, mode, text) → output` live.
// Per-tool Widget.astro files are 3-line wrappers passing config + faqItems.
//
// If a new encoder family ever requires editing this file, the architecture has failed.
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import CopyButton from '@components/CopyButton.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
import TrustNotice from '@components/tool/TrustNotice.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { ENCODERS } from '@lib/engines/encoding/registry';
import { withBase } from '@lib/paths';
import type { ToolConfig, FAQItem } from '@data/types';

interface Props {
  slug: string;
  encodingId: string;
  config: ToolConfig;
  faqItems?: FAQItem[];
}

const { slug, encodingId, config, faqItems = [] } = Astro.props;

const inputId = `${slug}-input`;
const outputId = `${slug}-output`;
const modeId = `${slug}-mode`;
const sample = ENCODERS[encodingId]?.sample ?? '';

const guideHref = config.guide
  ? withBase(`/guide/${config.guide.categorySlug}/${config.guide.slug}/`)
  : null;
const faqHref = config.faq
  ? withBase(`/faq/${config.faq.categorySlug}/${config.faq.slug}/`)
  : null;
---

<TrustNotice variant="private" />

<div class="enc-container">
  <ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={false}>
    <div slot="input" class="enc-panel" data-encoding={encodingId} data-slug={slug} data-sample={sample}>
      <div class="enc-header">
        <label class="enc-label" for={inputId}>Input</label>
        <select id={modeId} class="enc-mode" aria-label="Conversion mode">
          <option value="encode">Encode →</option>
          <option value="decode">Decode ←</option>
        </select>
      </div>
      <textarea
        id={inputId}
        placeholder="Type or paste here"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"></textarea>
      <ToolActions clearTarget={inputId} pasteTarget={inputId} />
      <div class="enc-extra-actions">
        <button type="button" class="action-btn" data-enc-swap aria-label="Swap input and output">Swap</button>
        <button type="button" class="action-btn" data-enc-sample aria-label="Load sample input">Sample</button>
      </div>
    </div>

    <div slot="output" class="enc-panel">
      <div class="enc-header" data-copy-bar>
        <span class="enc-label">Output</span>
        <CopyButton targetId={outputId} />
      </div>
      <output id={outputId} aria-live="polite" data-empty>Output will appear here</output>
    </div>
  </ToolSplit>
</div>

<CategoryDiscovery toolSlug={slug} />

<ToolSection heading="How it works">
  <p>{config.description} Everything runs locally in your browser — your text never leaves your device.</p>
  {guideHref && config.guide && (
    <p class="guide-callout">
      <a href={guideHref}>Learn more → {config.guide.title}</a>
    </p>
  )}
</ToolSection>

{faqHref && faqItems.length > 0 && (
  <section class="content-section">
    <h2>FAQ</h2>
    <FAQPreview items={faqItems.slice(0, 3)} faqHref={faqHref} />
  </section>
)}

<style is:global>
  .enc-container {
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }
  .enc-panel {
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    min-height: 320px;
    overflow: hidden;
  }
  .enc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-bottom: var(--border);
    min-height: var(--touch-target);
    flex-shrink: 0;
  }
  .enc-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }
  .enc-mode {
    min-height: unset;
    width: auto;
    border: none;
    border-left: var(--border);
    border-radius: 0;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
    align-self: stretch;
  }
  .enc-panel textarea {
    flex: 1;
    resize: none;
    width: 100%;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    background: var(--color-bg);
    color: var(--color-text);
    font-variant-ligatures: none;
  }
  .enc-panel output {
    flex: 1;
    display: block;
    margin: 0;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow-y: auto;
    color: var(--color-text);
    font-variant-ligatures: none;
  }
  .enc-panel output[data-empty] {
    color: var(--color-text-subtle);
  }
  .enc-panel output[data-error] {
    color: var(--color-danger);
  }
  .enc-extra-actions {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-encoding][data-slug]');
    if (!root) return;
    var eid = root.getAttribute('data-encoding');
    var slug = root.getAttribute('data-slug');
    var sample = root.getAttribute('data-sample') || '';
    var input = document.getElementById(slug + '-input');
    var modeEl = document.getElementById(slug + '-mode');
    var output = document.getElementById(slug + '-output');
    if (!input || !modeEl || !output) return;

    function setOutput(text, empty, error) {
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else output.removeAttribute('data-empty');
      if (error) output.setAttribute('data-error', text);
      else output.removeAttribute('data-error');
    }

    function run() {
      if (!input.value) { setOutput('Output will appear here', true, false); return; }
      if (!(window.ToyTools && ToyTools.runEncoding)) { setOutput(input.value, false, false); return; }
      var res = ToyTools.runEncoding(eid, modeEl.value, input.value);
      setOutput(res.ok ? res.output : (res.error || 'Error'), false, !res.ok);
    }

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save(slug, { input: input.value, mode: modeEl.value });
    }

    // Restore prior state; fall back to the legacy base64 key once for that tool.
    try {
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load(slug);
      if (saved && typeof saved.input === 'string') {
        input.value = saved.input;
        if (saved.mode === 'encode' || saved.mode === 'decode') modeEl.value = saved.mode;
      } else if (slug === 'base64-encoder-decoder' && window.ToyTools && ToyTools.storage) {
        var legacy = ToyTools.storage.get('toytools.base64.input');
        if (legacy) input.value = legacy;
      }
    } catch (_) {}

    input.addEventListener('input', function () { run(); persist(); });
    modeEl.addEventListener('change', function () { run(); persist(); });

    var swapBtn = document.querySelector('[data-enc-swap]');
    if (swapBtn) swapBtn.addEventListener('click', function () {
      if (output.hasAttribute('data-empty') || output.hasAttribute('data-error')) return;
      input.value = output.textContent || '';
      modeEl.value = modeEl.value === 'encode' ? 'decode' : 'encode';
      run(); persist();
    });

    var sampleBtn = document.querySelector('[data-enc-sample]');
    if (sampleBtn) sampleBtn.addEventListener('click', function () {
      input.value = sample;
      modeEl.value = 'encode';
      run(); persist();
    });

    run();
  })();
</script>
