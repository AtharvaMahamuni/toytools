---
// SimulationWidget — the ONE widget every physics simulation wraps. It renders the whole
// universal layout (canvas → playback → parameter sliders + presets → live measurement
// cards → live formula → animated graph → observations → explanation → real-world examples)
// AT BUILD TIME from the tool's SimulationDef, then ships a single bundled script that
// lazy-loads exactly that one simulation and wires the interactions in boot.ts.
//
// It is simulation-agnostic: everything specific to a tool lives in its SimulationDef
// (src/lib/simulation/simulations/<id>.ts) and the examples prop. If a new physics tool
// ever needs to edit this file, the engine has failed — add a SimulationDef instead.
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import { SIMULATIONS } from '@lib/simulation/simulations/registry';
import type { ToolConfig } from '@data/types';

interface Example {
  title: string;
  body: string;
}

interface Props {
  config: ToolConfig;
  simulationId: string;
  examples?: Example[];
}

const { config, simulationId, examples = [] } = Astro.props;
const sim = SIMULATIONS[simulationId];
if (!sim) throw new Error(`[SimulationWidget] Unknown simulation id "${simulationId}"`);

const slug = config.slug;
const cards = sim.measurements.filter((m) => !m.hidden);
const canvasLabel = `${config.name} interactive simulation canvas`;
const speeds = [0.25, 0.5, 1, 2];
// Formula-panel lookup: a term bound to a paramId becomes an editable number box (an input the
// student types into), so we need that param's range/step/unit at build time.
const paramById = new Map(sim.params.map((p) => [p.id, p]));
// A formula is "calculable" when at least one of its terms is an editable input (a paramId term).
const formulaCalculable = !!sim.formula?.terms.some((t) => t.paramId && paramById.has(t.paramId));
---

<section class="phys" data-physics-sim data-simulation-id={simulationId} data-slug={slug}>
  <!-- Cockpit: on desktop the simulation (left) and its controls + live numbers (right) sit
       side by side, so adjusting a slider and seeing the effect never needs a scroll. It stacks
       back to a single column below 1024px. -->
  <div class="phys-cockpit">
  <!-- Stage: the simulation canvas + playback controls -->
  <div class="tool-panel phys-stage">
    <div class="phys-canvas-wrap">
      <canvas class="phys-canvas" data-sim-canvas role="img" aria-label={canvasLabel}></canvas>
      {sim.pointer && (
        <p class="phys-hint" data-sim-hint>{sim.pointer.hint}</p>
      )}
      <p class="phys-fallback" data-sim-fallback hidden>
        This simulation needs a modern browser with canvas support. The measurements and
        formula below still describe the physics.
      </p>
    </div>

    <div class="phys-playback" role="group" aria-label="Playback controls">
      <button type="button" class="phys-btn phys-btn--primary" data-sim-play aria-pressed="false">Play</button>
      <button type="button" class="phys-btn" data-sim-reset>Reset</button>
      <div class="phys-speeds" role="group" aria-label="Simulation speed">
        <span class="phys-speeds-label" aria-hidden="true">Speed</span>
        {speeds.map((sp) => (
          <button
            type="button"
            class="phys-btn phys-speed"
            data-sim-speed={sp}
            aria-pressed={sp === 1 ? 'true' : 'false'}
            aria-label={`${sp}× speed`}
          >{sp}×</button>
        ))}
      </div>
    </div>
  </div>

  <!-- Console: everything the user tweaks (sliders, presets) and reads (live measurements). -->
  <div class="phys-console">
  <!-- Controls: parameter sliders + scenario presets -->
  <div class="phys-block">
    <h2 class="phys-h">Controls</h2>
    <div class="phys-controls">
      {sim.params.map((p) => (
        <div class="phys-control">
          <div class="phys-control-head">
            <label for={`${slug}-${p.id}`}>{p.label}</label>
            <output class="phys-value" for={`${slug}-${p.id}`} data-param-value={p.id}></output>
          </div>
          <input
            type="range"
            id={`${slug}-${p.id}`}
            data-param={p.id}
            min={p.min}
            max={p.max}
            step={p.step}
            value={p.default}
            aria-label={`${p.label} in ${p.unit || 'units'}`}
          />
          <div class="phys-range-caption" aria-hidden="true">
            <span>{p.min}{p.unit && ` ${p.unit}`}</span>
            <span>{p.max}{p.unit && ` ${p.unit}`}</span>
          </div>
        </div>
      ))}
    </div>
    {sim.presets.length > 0 && (
      <div class="smart-presets phys-presets" role="group" aria-label="Preset scenarios">
        {sim.presets.map((preset) => (
          <button
            type="button"
            class="smart-preset"
            data-sim-preset
            data-values={JSON.stringify(preset.values)}
          >{preset.label}</button>
        ))}
      </div>
    )}
  </div>

  <!-- Live measurement cards -->
  <div class="phys-block">
    <h2 class="phys-h">Live measurements</h2>
    <div class="phys-cards">
      {cards.map((m) => (
        <div class="phys-card">
          <span class="phys-card-label">{m.label}</span>
          <span class="phys-card-value" data-measurement={m.id}>—</span>
        </div>
      ))}
    </div>
    <p class="visually-hidden" data-sim-live aria-live="polite" aria-atomic="true"></p>
  </div>
  </div><!-- /phys-console -->
  </div><!-- /phys-cockpit -->

  <!-- Live formula. When the formula has editable inputs (paramId terms) it doubles as a calculator:
       type your own numbers to solve it, and the simulation follows. Read-only terms (measurements)
       show the computed answer live. -->
  {sim.formula && (
    <div class="phys-block">
      <h2 class="phys-h">Formula</h2>
      <div class="phys-formula">
        <p class="phys-formula-expr">{sim.formula.expression}</p>
        {formulaCalculable && (
          <p class="phys-formula-hint">Type your own values to solve the formula. The simulation follows along.</p>
        )}
        <dl class="phys-formula-terms">
          {sim.formula.terms.map((term) => {
            const p = term.paramId ? paramById.get(term.paramId) : undefined;
            return p ? (
              <div class="phys-term phys-term--input">
                <dt><label for={`${slug}-fx-${term.paramId}`}><span class="phys-term-sym">{term.symbol}</span> {term.label}</label></dt>
                <dd>
                  <span class="phys-formula-inputwrap">
                    <input
                      type="number"
                      id={`${slug}-fx-${term.paramId}`}
                      class="phys-formula-input"
                      data-formula-input={term.paramId}
                      min={p.min}
                      max={p.max}
                      step={p.step ?? 'any'}
                      value={p.default}
                      inputmode="decimal"
                      aria-label={`${term.label} value${p.unit ? ` in ${p.unit}` : ''}`}
                    />
                    {p.unit && <span class="phys-formula-unit" aria-hidden="true">{p.unit}</span>}
                  </span>
                </dd>
              </div>
            ) : (
              <div class="phys-term phys-term--output">
                <dt><span class="phys-term-sym">{term.symbol}</span> {term.label}</dt>
                <dd class="phys-formula-answer" data-term-value={term.symbol}>—</dd>
              </div>
            );
          })}
        </dl>
        {formulaCalculable && sim.formula.substitution && (
          <p class="phys-formula-worked" data-formula-worked aria-live="polite"></p>
        )}
      </div>
    </div>
  )}

  <!-- Animated graph -->
  {sim.graph && (
    <div class="phys-block">
      <h2 class="phys-h">Graph</h2>
      <canvas class="phys-graph" data-sim-graph role="img" aria-label={`${config.name} graph`}></canvas>
    </div>
  )}

  <!-- Observations + explanation (regenerated as the state changes) -->
  <div class="phys-block phys-narrative">
    <div>
      <h2 class="phys-h">Observations</h2>
      <ul class="phys-observations" data-sim-observations></ul>
    </div>
    <div>
      <h2 class="phys-h">What's happening</h2>
      <p class="phys-explanation" data-sim-explanation></p>
    </div>
  </div>

  <!-- Real-world examples (authored per tool) -->
  {examples.length > 0 && (
    <div class="phys-block content-section">
      <h2 class="phys-h">Real-world examples</h2>
      <div class="phys-examples">
        {examples.map((ex) => (
          <div class="phys-example">
            <h3>{ex.title}</h3>
            <p>{ex.body}</p>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<CategoryDiscovery toolSlug={slug} />

<script>
  import { initSimulations } from '@lib/simulation/boot';
  initSimulations();
</script>

<style>
  .phys {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Stage + console stack on mobile (default) and go side by side on desktop so the whole
     interactive loop (canvas, controls, live numbers) fits in one viewport. */
  .phys-cockpit,
  .phys-console {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .phys-cockpit {
      display: grid;
      /* minmax(0, …) lets the canvas track shrink instead of overflowing the grid. */
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  .phys-stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .phys-canvas-wrap {
    position: relative;
    width: 100%;
  }

  .phys-canvas {
    display: block;
    width: 100%;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    /* Prevent mobile drags on the canvas from scrolling the page. */
    touch-action: none;
    cursor: grab;
  }

  .phys-canvas:active { cursor: grabbing; }

  .phys-hint {
    position: absolute;
    top: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    background: var(--color-overlay-bg);
    color: var(--color-overlay-text);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    pointer-events: none;
    white-space: nowrap;
    max-width: calc(100% - var(--space-6));
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .phys-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: var(--space-6);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* The [hidden] attribute must win over the display:flex above (it only shows on boot error). */
  .phys-fallback[hidden] { display: none; }

  .phys-playback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .phys-btn {
    min-height: var(--touch-target);
    padding-inline: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-color);
  }

  .phys-btn:hover { background: var(--color-surface-hover); }

  .phys-btn--primary[aria-pressed='false'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .phys-speeds {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  .phys-speeds-label {
    margin-right: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .phys-speed { padding-inline: var(--space-3); }

  .phys-speed[aria-pressed='true'] {
    background: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .phys-block { display: flex; flex-direction: column; gap: var(--space-3); }

  .phys-h {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .phys-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  .phys-control { display: flex; flex-direction: column; gap: var(--space-1); }

  .phys-control-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .phys-control-head label { font-size: var(--text-sm); font-weight: 500; }

  .phys-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
  }

  .phys-control input[type='range'] {
    width: 100%;
    min-height: var(--touch-target);
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .phys-range-caption {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .phys-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
  }

  .phys-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .phys-card-label { color: var(--color-text-muted); font-size: var(--text-sm); }

  .phys-card-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .phys-formula {
    padding: var(--space-4) var(--space-5);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .phys-formula-expr {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
    text-align: center;
  }

  .phys-formula-terms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }

  .phys-term { display: flex; justify-content: space-between; gap: var(--space-3); align-items: baseline; }
  .phys-term dt { color: var(--color-text-muted); font-size: var(--text-sm); }

  .phys-term dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .phys-term-sym {
    display: inline-block;
    min-width: 1.4em;
    color: var(--color-accent-strong);
    font-weight: 700;
    font-style: italic;
  }

  /* Formula-as-calculator */
  .phys-formula-hint {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .phys-term--input,
  .phys-term--output { align-items: center; }

  .phys-term--input dt { font-weight: 500; }
  .phys-term--input dt label { cursor: pointer; }

  .phys-formula-inputwrap {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .phys-formula-input {
    width: 6.5ch;
    min-height: var(--touch-target);
    padding: var(--space-1) var(--space-2);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-base);
    font-weight: 600;
    text-align: right;
  }

  .phys-formula-unit { color: var(--color-text-muted); font-size: var(--text-sm); }

  /* The computed answer stands out from the editable inputs. */
  .phys-formula-answer { color: var(--color-accent-strong); }

  .phys-formula-worked {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: var(--border);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-lg);
    font-weight: 600;
    text-align: center;
  }

  .phys-graph {
    display: block;
    width: 100%;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .phys-narrative {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }

  .phys-observations {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text);
  }

  .phys-observations:empty::after {
    content: 'Press Play or adjust a control to see observations.';
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .phys-explanation { margin: 0; color: var(--color-text); line-height: 1.6; }

  .phys-examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .phys-example { display: flex; flex-direction: column; gap: var(--space-1); }
  .phys-example h3 { margin: 0; font-size: var(--text-base); font-weight: 600; }
  .phys-example p { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }

  /* Respect reduced motion: the sim starts paused (boot.ts). The hint gets a gentle fade
     otherwise, but never any motion under the reduce preference. */
  @media (prefers-reduced-motion: no-preference) {
    .phys-hint { transition: opacity var(--duration-normal) ease; }
  }
</style>
