---
// Canonical two-column tool layout. Desktop (≥1024px): input slot left, output slot right
// with the output column sticky so the answer stays in view as the input grows. Below 1024px
// it stacks to one column; `stackOrder` controls whether the answer or the input comes first.
// Named slots: "input" and "output".
interface Props {
  ratio?: '1-1' | '3-2' | '2-1' | '3-1';
  stackOrder?: 'input-first' | 'output-first';
  stickyOutput?: boolean;
  /**
   * Stretch both columns to the taller one's height (default). Correct when the two panels hold
   * comparable content, e.g. an encoder's input and output textareas: symmetric boxes read as one
   * unit. WRONG when a short form faces a long result, where it inflates the form into a tall empty
   * box. Form-driven widgets pass false.
   */
  equalHeight?: boolean;
}

const {
  ratio = '1-1',
  stackOrder = 'input-first',
  stickyOutput = true,
  equalHeight = true,
} = Astro.props;
const classes = [
  'tool-split',
  `ratio-${ratio}`,
  `stack-${stackOrder}`,
  stickyOutput ? 'sticky-output' : '',
  equalHeight ? 'equal-height' : 'natural-height',
].filter(Boolean).join(' ');
---

<div class={classes}>
  <div class="ts-input"><slot name="input" /></div>
  <div class="ts-output"><slot name="output" /></div>
</div>

<style>
  .tool-split {
    display: grid;
    gap: var(--space-6);
  }

  /* Mobile/tablet only: optionally lead with the answer. Scoped to <1024px so it can
     never leak onto desktop, where DOM order (input-left / output-right) must win. */
  @media (max-width: 1023px) {
    .tool-split.stack-output-first .ts-output {
      order: -1;
    }
  }

  @media (min-width: 1024px) {
    .tool-split {
      gap: var(--space-8);
      align-items: start;
    }

    .tool-split.ratio-1-1 { grid-template-columns: 1fr 1fr; }
    .tool-split.ratio-3-2 { grid-template-columns: 3fr 2fr; }
    .tool-split.ratio-2-1 { grid-template-columns: 2fr 1fr; }
    .tool-split.ratio-3-1 { grid-template-columns: 3fr 1fr; }

    .tool-split.sticky-output .ts-output {
      position: sticky;
      top: var(--space-6);
    }
  }
</style>
