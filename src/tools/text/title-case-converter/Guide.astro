---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from './config';
import { withBase } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = withBase(`/tool/${category.segment}/${config.slug}/`);
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={config.name}
  toolCategorySlug={config.categorySlug}
>
  <section id="quick-answer">
    <h2>Quick Answer <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Title Case capitalizes the first letter of each word: "the quick brown fox" becomes
      "The Quick Brown Fox". It is the standard style for headings, article titles, book
      titles, and film titles.
    </p>
    <a href={toolHref} class="cta-link">Try The Title Case Converter →</a>
  </section>

  <section id="capitalization-rules">
    <h2>Which Words To Capitalize <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      The traditional rule is to capitalize the important words — nouns, verbs, adjectives,
      and adverbs — and to leave the small connecting words lowercase: articles
      (a, an, the), short prepositions (in, on, at, of), and coordinating conjunctions
      (and, but, or). The exception is the first word of the title, which is always capitalized.
    </p>
    <p>
      Style guides such as AP, Chicago, and APA disagree on edge cases, particularly the length
      at which a preposition gets capitalized. This converter capitalizes the first letter of
      every word — the most common and predictable convention — giving you a clean starting
      point you can lightly edit to match a specific style guide.
    </p>
    <ReferenceBlock type="key-idea" heading="Title Case vs. sentence case">
      <p>
        Title Case capitalizes each word ("The Quick Brown Fox"); sentence case capitalizes only
        the first word and proper nouns ("The quick brown fox"). Use Title Case for headings and
        sentence case for body text and UI copy.
      </p>
    </ReferenceBlock>
  </section>

  <section id="how-it-works">
    <h2>How The Title Case Converter Works <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      The converter capitalises the first letter of every word and lowercases the rest —
      for example, "the art of war" becomes "The Art Of War". This is a simple every-word
      rule rather than the grammar-aware rule used by AP and Chicago style guides (which
      leave short prepositions and articles lowercase). It gives you a clean starting point
      you can lightly edit for any specific style guide.
    </p>
    <p>
      This tool is free and runs online entirely in your browser. Your text stays on your device, protecting your privacy — nothing is uploaded to a server, and results appear instantly.
    </p>
  </section>

  <section id="common-mistakes">
    <h2>Common Mistakes <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Using Title Case for body text">
      <p>
        Title Case in full paragraphs looks formal to the point of being hard to read. It is
        designed for short titles and headings. For sentences, UI labels, and button text,
        sentence case almost always reads better.
      </p>
    </ReferenceBlock>
    <ReferenceBlock type="common-mistake" heading="Assuming every-word capitalisation matches your style guide">
      <p>
        AP Style keeps prepositions under four letters lowercase ("The Art of War"), while this
        converter capitalises them ("The Art Of War"). Always do a final check against the specific
        style guide your publication or client requires.
      </p>
    </ReferenceBlock>
  </section>

  <section id="title-case-vs-alternatives">
    <h2>Title Case vs Other Capitalisation Styles <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Title Case is one of several alternatives for capitalization. <strong>Sentence case</strong>
      capitalises only the first word — the default for body copy and most UI. <strong>Uppercase</strong>
      (ALL CAPS) is for acronyms, constants, and short labels. <strong>Lowercase</strong> is used
      for URL slugs and normalisation. Title Case sits between sentence case and uppercase: it adds
      more visual weight than sentence case but is more readable than all-caps for multi-word titles.
      Most major publications use Title Case for article headlines and book titles.
    </p>
  </section>

  <section id="related-tools">
    <p>
      <strong>Related tools:</strong> explore all text case and cleanup utilities in the
      <a href={withBase(`/category/${category.slug}/`)}>Text Utilities</a> collection.
    </p>
  </section>

</GuideLayout>

<style>
  .cta-link {
    display: inline-flex;
    align-items: center;
    height: var(--touch-target);
    padding-inline: var(--space-5);
    margin-top: var(--space-5);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: var(--transition-color);
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
