---
import TextMetricWidget from '@tools/_shared/TextMetricWidget.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
---

<TextMetricWidget
  slug="sentence-counter"
  emptyMessage="Paste or type text to count sentences."
  stats={[
    { metric: 'sentences',            label: 'Sentences',       formatter: 'integer' },
    { metric: 'words',                label: 'Words',           formatter: 'integer' },
    { metric: 'paragraphs',           label: 'Paragraphs',      formatter: 'integer' },
    { metric: 'averageSentenceLength',label: 'Avg Sentence',    formatter: 'decimal' },
  ]}
/>

<ToolSection heading="How it works">
  <p>Sentences are detected by counting groups of sentence-ending punctuation (., !, ?). A sequence like "..." counts as one sentence boundary. If no punctuation is found, the text is treated as one sentence.</p>
</ToolSection>
