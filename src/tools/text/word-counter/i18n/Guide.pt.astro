---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="pt"
>
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Um contador de palavras separa o texto em unidades pelos espaços e quebras de linha visíveis para informar quantas palavras, caracteres, frases e parágrafos existem nele. Nosso Contador de Palavras exibe tudo em tempo real direto no seu navegador, sem enviar rascunhos a nenhum servidor.
    </p>
    <a href={toolHref} class="cta-link">Abrir Contador de Palavras →</a>
  </section>

  <section id="por-que-importa">
    <h2>Por que controlar o total de palavras <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>Trabalhos acadêmicos e editais:</strong> vestibulares, bolsas e artigos científicos aplicam tetos rígidos onde exceder o limite prejudica a avaliação.</li>
      <li><strong>Edição e SEO:</strong> definir uma meta visual ajuda a equilibrar clareza e profundidade.</li>
      <li><strong>Tradução e freelas:</strong> muitos contratos são calculados pelo total exato de palavras.</li>
    </ul>
  </section>

  <section id="como-conta">
    <h2>Como as palavras são contadas (e por que há pequenas diferenças) <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>Palavras com hífen:</strong> alguns editores contam "guarda-chuva" como 1 palavra e outros como 2.</li>
      <li><strong>Travessões colados:</strong> editores simples podem unir duas palavras separadas apenas por travessão sem espaços; este contador separa travessões corretamente.</li>
      <li><strong>Números e links:</strong> números como "2026" e URLs contam como uma palavra.</li>
    </ul>
    <ReferenceBlock type="note" heading="Citações e bibliografia">
      <p>Em trabalhos acadêmicos, confira antes no regulamento se título, notas de rodapé e referências entram na contagem final.</p>
    </ReferenceBlock>
  </section>

  <section id="caracteres-palavras">
    <h2>Caracteres, palavras e tempo de leitura <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Formulários, SMS e meta descrições limitam <strong>caracteres</strong> (veja também nosso <a href={toolPathBySlug('character-counter', 'pt')}>Contador de Caracteres</a>), enquanto ensaios limitam <strong>palavras</strong>. O tempo estimado de leitura usa a taxa padrão de 200 palavras por minuto.
    </p>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para comparar duas versões do mesmo texto após cortar excessos, experimente o <a href={toolPathBySlug('text-compare', 'pt')}>Comparador de Textos</a> ou a <a href={toolPathBySlug('reading-time-calculator', 'pt')}>Calculadora de Tempo de Leitura</a>.
    </p>
  </section>
</GuideLayout>
