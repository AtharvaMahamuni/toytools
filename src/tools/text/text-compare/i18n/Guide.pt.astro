---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath, categoryPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="pt"
>
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      O Comparador de Textos confronta duas versões lado a lado e aponta exatamente o que mudou linha por linha: adições em verde (<strong>+</strong>), remoções em vermelho (<strong>-</strong>) e o percentual exato de semelhança, sem enviar seu texto a nenhum servidor.
    </p>
    <a href={toolHref} class="cta-link">Abrir Comparador de Textos →</a>
  </section>

  <section id="como-ler">
    <h2>Como ler o resultado do Diff <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>+ (verde):</strong> linha presente apenas no texto novo.</li>
      <li><strong>- (vermelho):</strong> linha que estava no texto original e saiu no novo.</li>
      <li><strong>neutro:</strong> linha idêntica nos dois documentos.</li>
    </ul>
    <ReferenceBlock type="note" heading="Ignorar espaços extras com um clique">
      <p>Quando o único desacordo for quebra de linha Windows/Unix ou espaço sobrando no final da linha, um botão contextual permite filtrar só as diferenças reais de conteúdo.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Explore também a categoria <a href={categoryPath(category, 'pt')}>Texto</a>, com <a href={toolPathBySlug('word-counter', 'pt')}>Contador de Palavras</a> e <a href={toolPathBySlug('character-counter', 'pt')}>Contador de Caracteres</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
