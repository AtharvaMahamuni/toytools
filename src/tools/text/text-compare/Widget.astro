---
import IoPanel from '@tools/_shared/IoPanel.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { WIDGET_CHROME, uiStr } from '@lib/i18n/widget-utils';

interface Props {
  lang?: LocaleCode;
  pack?: LocalizedToolPack | null;
}

const { lang = 'en', pack = null } = Astro.props;
const c = WIDGET_CHROME[lang];
const u = (k: string, fb: string) => uiStr(pack, k, fb);
---

<div class="tc-widget">
  <div class="tc-toolbar">
    <button class="action-btn action-btn--sample" id="tc-sample-btn" aria-label={u('btnSampleAria', 'Load a sample comparison')}>{c.sample}</button>
  </div>

  <div class="tc-inputs">
    <IoPanel label={u('panelOriginal', 'Original')} labelFor="tc-original" variant="prose">
      <textarea
        id="tc-original"
        class="tc-textarea"
        placeholder={u('phOriginal', 'Paste original text…')}
        spellcheck="false"
        aria-label={u('ariaOriginal', 'Original text')}
      ></textarea>
    </IoPanel>
    <ToolActions pasteTarget="tc-original" clearTarget="tc-original" lang={lang} />

    <IoPanel label={u('panelNew', 'New Text')} labelFor="tc-new" variant="prose">
      <textarea
        id="tc-new"
        class="tc-textarea"
        placeholder={u('phNew', 'Paste new text…')}
        spellcheck="false"
        aria-label={u('ariaNew', 'New text')}
      ></textarea>
    </IoPanel>
    <ToolActions pasteTarget="tc-new" clearTarget="tc-new" lang={lang} />
  </div>

  <div class="tc-result-section" id="tc-result-section" hidden>
    <p class="tc-summary" id="tc-summary" aria-live="polite"></p>
    <CraftNote id="tc-note" craftId="tc-whitespace" action />
    <div class="tc-stats-bar" id="tc-stats-bar" aria-live="polite"></div>
    <div class="tc-diff" id="tc-diff" role="region" aria-label={u('ariaDiffResult', 'Diff result')}></div>
    <!-- Plain-text mirror of the diff, used by the copy/download actions below. -->
    <textarea id="tc-diff-text" class="tc-diff-text" hidden readonly aria-hidden="true"></textarea>
    <ToolActions copyTarget="tc-diff-text" downloadFilename="text-compare-diff.txt" downloadTarget="tc-diff-text" lang={lang} />
  </div>

</div>

<style is:global>
  .tc-widget .tc-inputs {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .tc-widget .tc-inputs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .tc-widget .tc-textarea {
    width: 100%;
    min-height: 220px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    padding: var(--space-3);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    box-sizing: border-box;
  }
  .tc-widget .tc-textarea:focus { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .tc-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
  }
  .tc-widget .action-btn--sample {
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
  .tc-widget .action-btn--sample:hover { background: var(--color-surface-elevated); color: var(--color-text); }
  .tc-result-section {
    margin-top: var(--space-6);
  }
  .tc-summary {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .tc-stats-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt, var(--color-surface));
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }
  .tc-stat { display: flex; align-items: center; gap: var(--space-2); }
  .tc-stat-label { color: var(--color-text-muted); }
  .tc-stat-value { font-weight: var(--font-weight-semibold); font-variant-numeric: tabular-nums; }
  .tc-stat-value.added   { color: var(--color-success, #2a7d4f); }
  .tc-stat-value.removed { color: var(--color-danger); }
  .tc-stat-value.similarity { color: var(--color-accent-strong); }
  .tc-diff {
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    background: var(--color-surface);
  }
  .tc-line {
    display: flex;
    align-items: baseline;
    padding: 2px var(--space-3);
    white-space: pre-wrap;
    word-break: break-all;
  }
  .tc-line-marker {
    min-width: 1.5ch;
    margin-right: var(--space-3);
    color: var(--color-text-muted);
    user-select: none;
    font-weight: var(--font-weight-semibold);
  }
  .tc-line.tc-added   { background: color-mix(in srgb, var(--color-success, #2a7d4f) 12%, transparent); }
  .tc-line.tc-removed { background: color-mix(in srgb, var(--color-danger) 12%, transparent); }
  .tc-line.tc-unchanged { color: var(--color-text-muted); }
  .tc-line.tc-added   .tc-line-marker { color: var(--color-success, #2a7d4f); }
  .tc-line.tc-removed .tc-line-marker { color: var(--color-danger); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tc-line.tc-added   { background: color-mix(in srgb, var(--color-success, #84C2A3) 15%, transparent); }
    :root:not([data-theme="light"]) .tc-line.tc-removed { background: color-mix(in srgb, var(--color-danger) 15%, transparent); }
  }
  .tc-collapse-btn {
    display: block;
    width: 100%;
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface-raised);
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .tc-collapse-btn:hover { background: var(--color-surface-elevated, var(--color-surface-raised)); color: var(--color-text); }
  .tc-collapse-btn:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>

<script is:inline>
(function () {
  var origEl    = document.getElementById('tc-original');
  var newEl     = document.getElementById('tc-new');
  var section   = document.getElementById('tc-result-section');
  var summaryEl = document.getElementById('tc-summary');
  var statsBar  = document.getElementById('tc-stats-bar');
  var diffEl    = document.getElementById('tc-diff');
  var diffTextEl = document.getElementById('tc-diff-text');
  var sampleBtn = document.getElementById('tc-sample-btn');
  var noteEl    = document.getElementById('tc-note');
  var noteTxt   = document.getElementById('tc-note-text');
  var noteBtn   = document.getElementById('tc-note-action');

  if (!origEl || !newEl || !section) return;

  var I = {};
  try {
    var i18nEl = document.getElementById('tt-i18n');
    if (i18nEl && i18nEl.textContent) I = JSON.parse(i18nEl.textContent);
  } catch (_) {}
  function s(k, fb) { return (typeof I[k] === 'string' && I[k]) ? I[k] : fb; }

  var SAMPLE_A = s('sampleA', 'Roses are red\nViolets are blue\nSugar is sweet\nAnd so are you');
  var SAMPLE_B = s('sampleB', 'Roses are red\nViolets are blue\nHoney is sweet\nAnd so are you\nThe end');

  var CONTEXT = 3;      // lines of context shown around each change
  var MIN_COLLAPSE = 5; // minimum unchanged-run length to collapse

  var TT = window.ToyTools;

  // Whether the comparison is currently normalized. Off by default: the raw diff is the honest one,
  // and this only turns on when the reader asks for it.
  var ignoring = null;

  // Expand collapsed hunk on click or keyboard
  diffEl.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.tc-collapse-btn');
    if (!btn) return;
    var gid = btn.getAttribute('data-group');
    var items = diffEl.querySelectorAll('[data-group="' + gid + '"]');
    for (var k = 0; k < items.length; k++) items[k].hidden = false;
    btn.remove();
  });
  diffEl.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var btn = e.target.closest && e.target.closest('.tc-collapse-btn');
    if (!btn) return;
    e.preventDefault();
    btn.click();
  });

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function summarySentence(stats) {
    if (stats.added === 0 && stats.removed === 0) return s('msgIdentical', 'The two texts are identical.');
    return s('msgSummaryTpl', 'Texts are {sim}% similar: {added} added, {removed} removed.')
      .replace('{sim}', String(stats.similarity))
      .replace('{added}', String(stats.added))
      .replace('{removed}', String(stats.removed));
  }

  function note(a, b) {
    if (!noteEl || !noteTxt) return null;
    var n = TT && TT.whitespaceNoise ? TT.whitespaceNoise(a, b) : null;
    if (!n) {
      ignoring = null;
      noteEl.hidden = true; noteTxt.textContent = '';
      if (noteBtn) noteBtn.hidden = true;
      return null;
    }
    noteTxt.textContent = ignoring
      ? s('wsIgnoringTpl', 'Ignoring {level}. ').replace('{level}', n.level) + (n.identical
          ? s('wsOtherwiseIdentical', 'The two texts are otherwise identical.')
          : s('wsNormChangedTpl', '{norm} of {raw} changed lines differ by something you can see.').replace('{norm}', String(n.normalizedChanged)).replace('{raw}', String(n.rawChanged)))
      : (n.identical
          ? s('wsOnlyDiffTpl', 'These differ only in {level}. All {raw} changed lines are identical to read.').replace('{level}', n.level).replace('{raw}', String(n.rawChanged))
          : s('wsSomeDiffTpl', '{diff} of {raw} changed lines differ only in {level}.').replace('{diff}', String(n.rawChanged - n.normalizedChanged)).replace('{raw}', String(n.rawChanged)).replace('{level}', n.level));
    if (noteBtn) {
      noteBtn.textContent = ignoring ? s('btnShowRaw', 'Show raw diff') : s('btnIgnorePrefix', 'Ignore ') + n.level;
      noteBtn.hidden = false;
    }
    noteEl.hidden = false;
    return n;
  }

  function run() {
    var a = origEl.value;
    var b = newEl.value;

    if (!a && !b) { section.hidden = true; note('', ''); return; }

    section.hidden = false;

    if (!TT || !TT.diff) {
      setTimeout(run, 100);
      return;
    }

    var n = note(a, b);
    if (n && ignoring) { a = n.a; b = n.b; }

    var result = TT.diff(a, b);
    var stats  = TT.diffStats(result);

    summaryEl.textContent = summarySentence(stats);

    statsBar.innerHTML =
      '<span class="tc-stat"><span class="tc-stat-label">' + s('lblAdded', 'Added') + '</span><span class="tc-stat-value added">+' + stats.added + '</span></span>' +
      '<span class="tc-stat"><span class="tc-stat-label">' + s('lblRemoved', 'Removed') + '</span><span class="tc-stat-value removed">-' + stats.removed + '</span></span>' +
      '<span class="tc-stat"><span class="tc-stat-label">' + s('lblUnchanged', 'Unchanged') + '</span><span class="tc-stat-value">' + stats.unchanged + '</span></span>' +
      '<span class="tc-stat"><span class="tc-stat-label">' + s('lblSimilarity', 'Similarity') + '</span><span class="tc-stat-value similarity">' + stats.similarity + '%</span></span>';

    var html = '';
    var plain = '';
    var groupId = 0;

    var isChange = [];
    for (var ci = 0; ci < result.length; ci++) {
      isChange[ci] = result[ci].type !== 'unchanged';
    }

    var isVisible = [];
    for (var vi = 0; vi < result.length; vi++) {
      if (isChange[vi]) { isVisible[vi] = true; continue; }
      var near = false;
      for (var dd = 1; dd <= CONTEXT && !near; dd++) {
        if ((vi - dd >= 0 && isChange[vi - dd]) || (vi + dd < result.length && isChange[vi + dd])) near = true;
      }
      isVisible[vi] = near;
    }

    var ri = 0;
    while (ri < result.length) {
      if (isVisible[ri]) {
        var r = result[ri];
        var marker = r.type === 'added' ? '+' : r.type === 'removed' ? '-' : ' ';
        var cls = r.type === 'added' ? 'tc-added' : r.type === 'removed' ? 'tc-removed' : 'tc-unchanged';
        html += '<div class="tc-line ' + cls + '" aria-label="' + r.type + '">' +
          '<span class="tc-line-marker" aria-hidden="true">' + marker + '</span>' +
          '<span>' + escapeHtml(r.line) + '</span></div>';
        plain += marker + ' ' + r.line + '\n';
        ri++;
      } else {
        var runStart = ri;
        while (ri < result.length && !isVisible[ri]) ri++;
        var runLen = ri - runStart;

        if (runLen < MIN_COLLAPSE) {
          for (var rj = runStart; rj < runStart + runLen; rj++) {
            html += '<div class="tc-line tc-unchanged" aria-label="unchanged">' +
              '<span class="tc-line-marker" aria-hidden="true"> </span>' +
              '<span>' + escapeHtml(result[rj].line) + '</span></div>';
            plain += '  ' + result[rj].line + '\n';
          }
        } else {
          var gid = 'tcg' + (groupId++);
          var expLbl = s('unchangedRunTpl', '… {n} unchanged lines').replace('{n}', String(runLen));
          html += '<button class="tc-collapse-btn" data-group="' + gid + '" ' +
            'aria-label="' + expLbl + '">' + expLbl + '</button>';
          for (var rj = runStart; rj < runStart + runLen; rj++) {
            html += '<div class="tc-line tc-unchanged" data-group="' + gid + '" hidden aria-label="unchanged">' +
              '<span class="tc-line-marker" aria-hidden="true"> </span>' +
              '<span>' + escapeHtml(result[rj].line) + '</span></div>';
            plain += '  ' + result[rj].line + '\n';
          }
        }
      }
    }

    diffEl.innerHTML = html;
    if (diffTextEl) diffTextEl.value = plain;

    TT.state.save('text-compare', { a: a, b: b });
  }

  if (noteBtn) noteBtn.addEventListener('click', function () {
    ignoring = ignoring ? null : true;
    run();
  });

  origEl.addEventListener('input', run);
  newEl.addEventListener('input', run);

  if (sampleBtn) {
    sampleBtn.addEventListener('click', function () {
      origEl.value = SAMPLE_A;
      newEl.value  = SAMPLE_B;
      run();
    });
  }

  // Restore state
  if (TT && TT.state) {
    var saved = TT.state.load('text-compare');
    if (saved) {
      if (saved.a) origEl.value = saved.a;
      if (saved.b) newEl.value  = saved.b;
      run();
    }
  }
})();
</script>
