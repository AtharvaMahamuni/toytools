---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { guidePathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Slugify convierte cualquier título en un identificador web limpio: pasa a minúsculas, elimina tildes como explicamos en <a href={guidePathBySlug('remove-accents')}>quitar acentos</a>, reemplaza espacios y símbolos por guiones simples y recorta guiones extremos.</p>
    <a href={toolHref} class="cta-link">Abrir Generador de Slugs →</a>
  </section>
  <section id="seo-y-errores">
    <h2>Slugs SEO y errores frecuentes <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Confundir slugify con kebab-case o pegar idiomas sin ASCII">
      <p>Kebab-case conserva letras acentuadas mientras que slugify las pliega a ASCII. Además, una línea sin caracteres latinos o dígitos quedará vacía en la salida.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
