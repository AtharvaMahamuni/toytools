---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { guidePathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="kurzantwort">
    <h2>Kurzantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Der URL-Slug-Generator wandelt Überschriften in kleingeschriebene Web-Slugs ohne Akzente (siehe auch <a href={guidePathBySlug('remove-accents')}>Akzente entfernen</a>) und verbindet Wörter mit genau einem Bindestrich.</p>
    <a href={toolHref} class="cta-link">Zum Slug-Generator →</a>
  </section>
  <section id="seo-und-fehler">
    <h2>SEO-Slugs und typische Fehler <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Verwechslung mit Kebab-Case oder nicht-lateinischen Zeilen">
      <p>Anders als Kebab-Case faltet Slugify Sonderzeichen nach ASCII („ß“ → „ss“). Zeilen ohne lateinische Buchstaben oder Ziffern ergeben einen leeren Slug.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
