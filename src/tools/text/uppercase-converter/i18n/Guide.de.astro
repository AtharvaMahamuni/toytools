---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="kurzantwort">
    <h2>Kurzantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Wandle Text zeichengetreu in GROSSBUCHSTABEN um – Ziffern, Satzzeichen, Umbrüche und Umlaute bleiben sauber erhalten.</p>
    <a href={toolHref} class="cta-link">Zum Großbuchstaben-Konverter →</a>
  </section>
  <section id="css-vergleich">
    <h2>CSS text-transform versus echte Zeichen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>CSS verändert nur die Darstellung im Browser, nicht den kopierten String. Für Code-Konstanten und Datenexporte ist die echte Konvertierung nötig.</p>
  </section>
  <section id="unicode">
    <h2>Unicode-Regeln und Lesbarkeit <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Lange Absätze komplett groß schreiben">
      <p>Durchgängige Großschrift eignet sich für Kürzel und kurze Labels, bremst aber bei ganzen Absätzen das Lesetempo.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
