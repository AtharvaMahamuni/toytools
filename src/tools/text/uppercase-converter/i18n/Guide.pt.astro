---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Converta qualquer bloco de texto para MAIÚSCULAS preservando números, pontuações, quebras de linha e acentos no dispositivo.</p>
    <a href={toolHref} class="cta-link">Abrir Conversor de Maiúsculas →</a>
  </section>
  <section id="css-vs-real">
    <h2>CSS text-transform versus texto real <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>CSS altera só a aparência visual; ao copiar, o dado segue como antes. Use o conversor para transformar os caracteres reais.</p>
  </section>
  <section id="boas-praticas">
    <h2>Boas práticas <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Parágrafos inteiros em caixa alta">
      <p>Reserve caixa alta para siglas, constantes e etiquetas curtas para manter a leitura fluida.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
