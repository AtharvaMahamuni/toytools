---
import TextMetricWidget from '@tools/_shared/TextMetricWidget.astro';
---

<TextMetricWidget
  slug="reading-time-calculator"
  emptyMessage="Paste or type text to estimate reading time."
  stats={[
    { metric: 'readingTime',          label: 'Reading Time',   formatter: 'duration' },
    { metric: 'speakingTime',         label: 'Speaking Time',  formatter: 'duration' },
    { metric: 'words',                label: 'Words',          formatter: 'integer' },
    { metric: 'averageSentenceLength',label: 'Avg Sentence',   formatter: 'decimal' },
  ]}
/>
