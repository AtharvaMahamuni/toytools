---
import TextMetricWidget from '@tools/_shared/TextMetricWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { uiStr } from '@lib/i18n/widget-utils';

interface Props {
  lang?: LocaleCode;
  pack?: LocalizedToolPack | null;
}

const { lang = 'en', pack = null } = Astro.props;
const u = (k: string, fb: string) => uiStr(pack, k, fb);
const defaultSample = 'The quick brown fox jumps over the lazy dog near the old farmhouse. A gentle breeze rustled the leaves in the tall oak tree, carrying the sweet scent of wildflowers across the meadow. Birds called from hidden branches above the sunlit path. Below, a narrow stream wound between mossy stones, its quiet murmur blending with the hum of bees gathering pollen from summer blooms. The fox paused, ears perked, watching the distant hills turn gold in the afternoon sun.';
---

<TextMetricWidget
  slug="reading-time-calculator"
  toolGroup={config.toolGroup}
  noticeId="reading-time-calculator"
  craftId={config.craft?.id}
  lang={lang}
  emptyMessage={u('emptyMessage', 'Paste or type text to estimate reading time.')}
  sampleText={u('sampleText', defaultSample)}
  stats={[
    { metric: 'readingTime',           label: u('statReadingTime', 'Reading Time'),   formatter: 'duration' },
    { metric: 'speakingTime',          label: u('statSpeakingTime', 'Speaking Time'), formatter: 'duration' },
    { metric: 'words',                 label: u('statWords', 'Words'),                formatter: 'integer' },
    { metric: 'averageSentenceLength', label: u('statAvgSentence', 'Avg Sentence'),   formatter: 'decimal' },
  ]}
/>
