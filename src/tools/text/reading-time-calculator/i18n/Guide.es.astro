---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      El tiempo estimado de lectura se obtiene dividiendo el total de palabras entre 200 palabras por minuto (la media habitual de lectura silenciosa en adultos). Para calcular cuánto tardarás en exponer el mismo texto en voz alta se aplica una cadencia más pausada de unas 130 a 150 palabras por minuto.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Tiempo de Lectura →</a>
  </section>

  <section id="referencia-palabras">
    <h2>Tabla rápida de duración según palabras <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      En artículos divulgativos de blog, 400 palabras equivalen a unos 2 minutos de lectura, 1.000 palabras a 5 minutos y 2.000 palabras a 10 minutos. Sin embargo, tutoriales con fragmentos de código, tablas densas o fórmulas técnicas suelen exigir entre un 30 % y un 50 % más de tiempo real.
    </p>
    <ReferenceBlock type="key-idea" heading="Lectura silenciosa vs. guion de charla">
      <p>Si estás redactando un discurso o guion de vídeo, fíjate en el tiempo de habla (130–150 ppm) para dejar margen a pausas e inflexiones sin acelerar el ritmo al final.</p>
    </ReferenceBlock>
  </section>

  <section id="ajustar-extension">
    <h2>Herramientas para ajustar la extensión <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para revisar estadísticas detalladas por párrafo o frase abre el <a href={toolPathBySlug('word-counter', 'es')}>Contador de Palabras</a>, controla límites de extractos en el <a href={toolPathBySlug('character-counter', 'es')}>Contador de Caracteres</a> o compara dos versiones editadas en <a href={toolPathBySlug('text-compare', 'es')}>Comparador de Textos</a>.
    </p>
  </section>
</GuideLayout>
