---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      O tempo estimado de leitura divide a contagem total de palavras por 200 palavras por minuto (ritmo médio adulto em leitura silenciosa). Para apresentações faladas ou vídeos, a taxa cai para cerca de 130 a 150 palavras por minuto.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Tempo de Leitura →</a>
  </section>

  <section id="referencia-pratica">
    <h2>Referência de palavras por minuto e densidade <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Em textos informativos comuns, 400 palavras equivalem a 2 minutos, 1.000 palavras a 5 minutos e 2.000 palavras a 10 minutos. Artigos técnicos com tabelas ou blocos de código costumam exigir 30% a 50% a mais na prática.
    </p>
    <ReferenceBlock type="key-idea" heading="Leitura mental vs. roteiro falado">
      <p>Ao cronometrar palestras, aulas ou narrações, use sempre o tempo de fala como referência para manter ritmo confortável e pausas naturais.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas para ajustar seu texto <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Analise frases e parágrafos no <a href={toolPathBySlug('word-counter', 'pt')}>Contador de Palavras</a>, confira resumos no <a href={toolPathBySlug('character-counter', 'pt')}>Contador de Caracteres</a> ou compare revisões de rascunhos com o <a href={toolPathBySlug('text-compare', 'pt')}>Comparador de Texto</a>.
    </p>
  </section>
</GuideLayout>
