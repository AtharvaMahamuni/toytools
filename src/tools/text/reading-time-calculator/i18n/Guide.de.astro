---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Die geschätzte Lesezeit ergibt sich aus der Wortzahl geteilt durch 200 Wörter pro Minute (der solide Durchschnitt für stilles Lesen). Für einen freien Vortrag oder ein Video-Skript gilt mit rund 130 bis 150 Wörtern pro Minute ein spürbar ruhigeres Tempo.
    </p>
    <a href={toolHref} class="cta-link">Lesezeit-Rechner öffnen →</a>
  </section>

  <section id="richtwerte">
    <h2>Orientierung nach Wortanzahl und Textdichte <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Bei lockerem Fließtext entsprechen 400 Wörter etwa 2 Minuten, 1.000 Wörter rund 5 Minuten und 2.000 Wörter etwa 10 Minuten Lesezeit. Enthält dein Beitrag komplexe Fachbegriffe, Code-Snippets oder Tabellen, plane in der Praxis 30 bis 50 Prozent mehr Zeit ein.
    </p>
    <ReferenceBlock type="key-idea" heading="Still lesen vs. laut vortragen">
      <p>Orientiere dich bei Moderationen und Präsentationen an der Sprechzeit statt an der Lesezeit, damit am Ende genug Raum für Pausen bleibt.</p>
    </ReferenceBlock>
  </section>

  <section id="passende-tools">
    <h2>Verwandte Textwerkzeuge <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Detaillierte Wort- und Satzstatistiken liefert der <a href={toolPathBySlug('word-counter', 'de')}>Wörterzähler</a>, exakte Snippet-Grenzen prüft der <a href={toolPathBySlug('character-counter', 'de')}>Zeichenzähler</a>, und zwei Manuskriptfassungen vergleichst du im <a href={toolPathBySlug('text-compare', 'de')}>Textvergleich</a>.
    </p>
  </section>
</GuideLayout>
