---
import TextMetricWidget from '@tools/_shared/TextMetricWidget.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
---

<TextMetricWidget
  slug="character-counter"
  emptyMessage="Paste or type text to count characters."
  stats={[
    { metric: 'characters',         label: 'Characters',           formatter: 'integer' },
    { metric: 'charactersNoSpaces', label: 'Without Spaces',       formatter: 'integer' },
    { metric: 'words',              label: 'Words',                formatter: 'integer' },
    { metric: 'sentences',          label: 'Sentences',            formatter: 'integer' },
    { metric: 'paragraphs',         label: 'Paragraphs',           formatter: 'integer' },
    { metric: 'averageWordLength',  label: 'Avg Word Length',      formatter: 'decimal' },
  ]}
/>

<ToolSection heading="How it works">
  <p>Characters counts every character in your text including spaces and punctuation. Characters without spaces excludes all whitespace. Both counts run locally in your browser.</p>
</ToolSection>
