---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import ToolActions from '@components/tool/ToolActions.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
import TrustNotice from '@components/tool/TrustNotice.astro';
import ResultPanel from '@components/tool/ResultPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { config } from './config';
import { items as faqItems } from './faq';
import { withBase } from '@lib/paths';

const guideHref = config.guide
  ? withBase(`/guide/${config.guide.categorySlug}/${config.guide.slug}/`)
  : null;
const faqHref = config.faq
  ? withBase(`/faq/${config.faq.categorySlug}/${config.faq.slug}/`)
  : null;
---

<TrustNotice variant="private" />

<ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={true}>
  <div slot="input" data-tool="case-converter">
    <label class="widget-label" for="case-input">Text</label>
    <textarea id="case-input" class="widget-textarea" rows="8" placeholder="Paste or type text — try: hello world"></textarea>
    <label class="widget-label" for="case-mode">Conversion</label>
    <select id="case-mode" class="widget-select">
      <option value="lower">lowercase</option>
      <option value="upper">UPPERCASE</option>
      <option value="title">Title Case</option>
      <option value="sentence">Sentence case</option>
    </select>
    <ToolActions clearTarget="case-input" pasteTarget="case-input" />
  </div>

  <div slot="output">
    <ResultPanel label="Result">
      <ToolActions slot="actions" copyTarget="case-output" />
      <textarea id="case-output" class="widget-textarea" rows="8" readonly placeholder="Result appears here" aria-label="Result"></textarea>
    </ResultPanel>
  </div>
</ToolSplit>

<CategoryDiscovery toolSlug="case-converter" />

<ToolSection heading="How it works">
  <p>The converter transforms the provided text locally using the selected casing rule.</p>
  {guideHref && (
    <p class="guide-callout">
      <a href={guideHref}>Learn more → How To Change Text Case</a>
    </p>
  )}
</ToolSection>

{faqHref && (
  <section class="content-section">
    <h2>FAQ</h2>
    <FAQPreview items={faqItems.slice(0, 3)} faqHref={faqHref} />
  </section>
)}

<script is:inline>
  (function () {
    function titleCase(text) {
      return text.toLowerCase().replace(/\b\w/g, function (m) { return m.toUpperCase(); });
    }
    function sentenceCase(text) {
      return text.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, function (m) { return m.toUpperCase(); });
    }

    var input = document.getElementById('case-input');
    var mode = document.getElementById('case-mode');
    var out = document.getElementById('case-output');
    if (!input || !mode || !out) return;

    function convert() {
      var text = input.value;
      var m = mode.value;
      out.value = m === 'upper'    ? text.toUpperCase()  :
                  m === 'title'    ? titleCase(text)      :
                  m === 'sentence' ? sentenceCase(text)   :
                                     text.toLowerCase();
    }

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save('case-converter', { input: input.value, mode: mode.value });
    }

    // Restore
    try {
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load('case-converter');
      if (saved) {
        if (typeof saved.input === 'string') input.value = saved.input;
        if (saved.mode) mode.value = saved.mode;
      }
    } catch (_) {}

    input.addEventListener('input', function () { convert(); persist(); });
    mode.addEventListener('change', function () { convert(); persist(); });
    convert();
  })();
</script>
