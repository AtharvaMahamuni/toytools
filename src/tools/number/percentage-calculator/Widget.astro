---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { WIDGET_CHROME, uiStr } from '@lib/i18n/widget-utils';

interface Props {
  lang?: LocaleCode;
  pack?: LocalizedToolPack | null;
}

const { lang = 'en', pack = null } = Astro.props;
const c = WIDGET_CHROME[lang];
const u = (k: string, fb: string) => uiStr(pack, k, fb);
---

<div class="calc-ledger">
<ToolSplit ratio="3-2" stackOrder="output-first" stickyOutput={false} equalHeight={false}>
  <IoPanel slot="input" label={u('panelValues', 'Values')} variant="prose" bare data-tool="percentage-calculator">
    <div class="io-body">
      <label class="widget-label" for="percentage-mode">{u('lblMode', 'Calculation')}</label>
      <select id="percentage-mode" class="widget-select">
        <option value="of">{u('optOf', 'What is A% of B?')}</option>
        <option value="change">{u('optChange', 'Percentage change from A to B')}</option>
        <option value="is">{u('optIs', 'A is what percent of B?')}</option>
      </select>
      <label class="widget-label" for="percentage-a">{u('lblA', 'A')}</label>
      <input id="percentage-a" class="widget-input" type="number" inputmode="decimal" placeholder={u('phA', 'Example: 20')} />
      <label class="widget-label" for="percentage-b">{u('lblB', 'B')}</label>
      <input id="percentage-b" class="widget-input" type="number" inputmode="decimal" placeholder={u('phB', 'Example: 150')} />
    </div>
  </IoPanel>

  <IoPanel slot="output" label={c.result} variant="prose" result bare>
    <div class="tm-hero" role="status" aria-live="polite" aria-atomic="true">
      <span class="hero-value" id="pct-value">0</span>
      <span class="hero-label">{c.result}</span>
      <p class="empty-hint" id="pct-hint">{u('emptyHint', 'Enter values to calculate.')}</p>
      <p class="pct-formula" id="pct-formula" hidden></p>
      <CraftNote id="pct-note" craftId="pct-points" />
    </div>
  </IoPanel>
</ToolSplit>
</div>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id="pct-copy" data-label={c.copy} type="button">{c.copy}</button>
  <button class="action-btn action-btn--clear" id="pct-clear" data-label={c.clear} type="button">{c.clear}</button>
</div>


<script is:inline>
  (function () {
    var I = {};
    try {
      var i18nEl = document.getElementById('tt-i18n');
      if (i18nEl && i18nEl.textContent) I = JSON.parse(i18nEl.textContent);
    } catch (_) {}
    function s(k, fb) { return (typeof I[k] === 'string' && I[k]) ? I[k] : fb; }

    var modeEl = document.getElementById('percentage-mode');
    var aEl = document.getElementById('percentage-a');
    var bEl = document.getElementById('percentage-b');
    var valueEl = document.getElementById('pct-value');
    var hintEl = document.getElementById('pct-hint');
    var formulaEl = document.getElementById('pct-formula');
    var copyBtn = document.getElementById('pct-copy');
    var clearBtn = document.getElementById('pct-clear');
    var noteEl = document.getElementById('pct-note');
    var noteTxt = document.getElementById('pct-note-text');
    if (!modeEl || !aEl || !bEl || !valueEl) return;

    var TT = window.ToyTools;
    var lastResult = '';

    // The craft line: percentage points, when both values are themselves rates. Silent outside
    // 0 to 100, in the other two modes, and from a base of 100 where the readings coincide.
    function note(input) {
      if (!noteEl || !noteTxt) return;
      var p = TT && TT.pitfall ? TT.pitfall('percentage-calculator', input) : null;
      if (!p) { noteEl.hidden = true; noteTxt.textContent = ''; return; }
      noteTxt.textContent = p.text;
      noteEl.hidden = false;
    }

    function show(value, formula) {
      lastResult = value;
      valueEl.textContent = value;
      if (hintEl) hintEl.hidden = true;
      if (formulaEl) {
        formulaEl.textContent = formula || '';
        formulaEl.hidden = !formula;
      }
    }

    function showEmpty(message) {
      lastResult = '';
      note({});
      valueEl.textContent = '0';
      if (hintEl) { hintEl.textContent = message || s('emptyHint', 'Enter values to calculate.'); hintEl.hidden = false; }
      if (formulaEl) formulaEl.hidden = true;
    }

    function calc() {
      var mode = modeEl.value;
      var aRaw = aEl.value, bRaw = bEl.value;
      if (aRaw === '' || bRaw === '') { showEmpty(s('emptyHint', 'Enter values to calculate.')); return; }
      var a = Number(aRaw), b = Number(bRaw);
      if (!Number.isFinite(a) || !Number.isFinite(b)) { showEmpty(s('errInvalid', 'Enter valid numbers.')); return; }
      if (mode === 'change' && a === 0) { showEmpty(s('errFirstZero', 'First value cannot be zero.')); return; }
      if (mode === 'is' && b === 0) { showEmpty(s('errSecondZero', 'Second value cannot be zero.')); return; }

      note({ mode: mode, a: a, b: b });

      var result, formula;
      if (mode === 'of') {
        result = (a / 100) * b;
        formula = s('fmlOf', '{a}% of {b}').replace('{a}', String(a)).replace('{b}', String(b));
      } else if (mode === 'change') {
        result = ((b - a) / Math.abs(a)) * 100;
        var dir = result > 0 ? s('dirIncrease', 'Increase') : result < 0 ? s('dirDecrease', 'Decrease') : s('dirNone', 'No change');
        formula = s('fmlChange', '{dir} from {a} to {b}').replace('{dir}', dir).replace('{a}', String(a)).replace('{b}', String(b));
      } else {
        result = (a / b) * 100;
        formula = s('fmlIs', '{a} is this % of {b}').replace('{a}', String(a)).replace('{b}', String(b));
      }
      var shown = Number(result.toFixed(6));
      show((mode === 'change' && shown > 0 ? '+' : '') + shown.toString() + (mode === 'of' ? '' : '%'), formula);
    }

    function persist() {
      if (window.ToyTools && ToyTools.state) ToyTools.state.save('percentage-calculator', { mode: modeEl.value, values: { a: aEl.value, b: bEl.value } }, ['mode']);
    }

    // Restore
    try {
      var saved = window.ToyTools && ToyTools.state && ToyTools.state.load('percentage-calculator', ['mode']);
      if (saved) {
        if (saved.mode) modeEl.value = saved.mode;
        if (saved.values) { if (saved.values.a != null) aEl.value = saved.values.a; if (saved.values.b != null) bEl.value = saved.values.b; }
      }
    } catch (_) {}

    modeEl.addEventListener('change', function () { calc(); persist(); });
    aEl.addEventListener('input', function () { calc(); persist(); });
    bEl.addEventListener('input', function () { calc(); persist(); });

    // Copy with success state
    var copyTimer;
    if (copyBtn) copyBtn.addEventListener('click', function () {
      if (!lastResult) { TT && TT.toast(s('toastEmptyCopy', 'Nothing to copy!')); return; }
      TT && TT.copy(lastResult);
      copyBtn.classList.add('is-success');
      copyBtn.textContent = s('btnCopied', '✓ Copied');
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () {
        copyBtn.classList.remove('is-success');
        copyBtn.textContent = s('btnCopy', 'Copy');
      }, 2000);
    });

    // Two-click confirm clear (both fields)
    var clearTimer;
    function resetClear() {
      clearTimeout(clearTimer);
      if (clearBtn) { clearBtn.classList.remove('is-confirming'); clearBtn.textContent = s('btnClear', 'Clear'); }
    }
    if (clearBtn) clearBtn.addEventListener('click', function () {
      if (!clearBtn.classList.contains('is-confirming')) {
        clearBtn.classList.add('is-confirming');
        clearBtn.textContent = s('btnConfirmClear', 'Confirm Clear');
        clearTimeout(clearTimer);
        clearTimer = setTimeout(resetClear, 3000);
        return;
      }
      resetClear();
      aEl.value = ''; bEl.value = '';
      calc(); persist();
      aEl.focus();
    });
    document.addEventListener('click', function (e) {
      if (clearBtn && clearBtn.classList.contains('is-confirming') && !e.target.closest('#pct-clear')) resetClear();
    });

    calc();
    // The pitfall line comes from the lazily-loaded calculator chunk, which does not exist yet when
    // this script first runs. Recompute once it lands so a restored session shows it too.
    if (TT && TT.onReady) TT.onReady(calc);
  })();
</script>

<style>
  .pct-formula {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-top: var(--space-3);
    max-width: unset;
  }
</style>
