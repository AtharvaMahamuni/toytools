---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
---

<div class="calc-ledger">
<ToolSplit ratio="3-2" stackOrder="output-first" stickyOutput={false} equalHeight={false}>
  <IoPanel slot="input" label="Bill Details" variant="prose" bare data-tool="tip-calculator">
    <div class="io-body">
      <label class="widget-label" for="tip-bill">Bill Amount</label>
      <input id="tip-bill" class="widget-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Example: 85.00" />

      <span class="widget-label" id="tip-pct-label">Tip Percentage</span>
      <div class="tip-presets" role="group" aria-labelledby="tip-pct-label">
        <button type="button" class="tip-preset" data-pct="15">15%</button>
        <button type="button" class="tip-preset" data-pct="18">18%</button>
        <button type="button" class="tip-preset" data-pct="20">20%</button>
        <button type="button" class="tip-preset" data-pct="25">25%</button>
      </div>
      <input id="tip-pct" class="widget-input" type="number" inputmode="decimal" min="0" step="1" placeholder="Custom %" aria-label="Custom tip percentage" aria-describedby="tip-pct-error" />
      <p class="tip-field-error" id="tip-pct-error" role="alert" hidden></p>

      <label class="widget-label" for="tip-split">Split Between (people)</label>
      <input id="tip-split" class="widget-input" type="number" inputmode="numeric" min="1" step="1" placeholder="1" value="1" aria-describedby="tip-split-error" />
      <p class="tip-field-error" id="tip-split-error" role="alert" hidden></p>
    </div>
  </IoPanel>

  <IoPanel slot="output" label="Result" variant="prose" result bare>
    <div class="tm-hero">
      <span class="hero-value" id="tip-amount">$0.00</span>
      <span class="hero-label">Tip Amount</span>
      <p class="empty-hint" id="tip-hint">Enter a bill amount to calculate.</p>
    </div>
    <dl class="tm-stats tm-secondary" aria-live="polite" hidden>
      <div class="tm-stat-row">
        <dt class="tm-stat-label">Total Bill</dt>
        <dd class="tm-stat-value" id="tip-total">$0.00</dd>
      </div>
      <div class="tm-stat-row" id="tip-row-pp-tip" hidden>
        <dt class="tm-stat-label">Tip Per Person</dt>
        <dd class="tm-stat-value" id="tip-pp-tip">$0.00</dd>
      </div>
      <div class="tm-stat-row" id="tip-row-pp-total" hidden>
        <dt class="tm-stat-label">Total Per Person</dt>
        <dd class="tm-stat-value" id="tip-pp-total">$0.00</dd>
      </div>
    </dl>
    <CraftNote id="tip-note" craftId="tip-round-up" />
  </IoPanel>
</ToolSplit>
</div>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id="tip-copy" data-label="Copy" type="button">Copy</button>
  <button class="action-btn action-btn--clear" id="tip-clear" data-label="Clear" type="button">Clear</button>
</div>


<script is:inline>
  (function () {
    var billEl   = document.getElementById('tip-bill');
    var pctEl    = document.getElementById('tip-pct');
    var splitEl  = document.getElementById('tip-split');
    var presets  = document.querySelectorAll('.tip-preset');
    var amountEl = document.getElementById('tip-amount');
    var hintEl   = document.getElementById('tip-hint');
    var secondary = document.querySelector('.tm-secondary');
    var totalEl  = document.getElementById('tip-total');
    var ppTipRow = document.getElementById('tip-row-pp-tip');
    var ppTipEl  = document.getElementById('tip-pp-tip');
    var ppTotRow = document.getElementById('tip-row-pp-total');
    var ppTotEl  = document.getElementById('tip-pp-total');
    var copyBtn  = document.getElementById('tip-copy');
    var clearBtn = document.getElementById('tip-clear');
    var noteEl   = document.getElementById('tip-note');
    var noteTxt  = document.getElementById('tip-note-text');
    var pctErr   = document.getElementById('tip-pct-error');
    var splitErr = document.getElementById('tip-split-error');
    if (!billEl || !pctEl || !splitEl || !amountEl) return;

    var TT = window.ToyTools;
    var lastResult = '';

    // The craft line: the move the output stops one step short of. A total of $100.30 gets rounded
    // up on the slip, and this says what that actually tipped. Silent when it already lands whole.
    function note(input) {
      if (!noteEl || !noteTxt) return;
      var p = TT && TT.pitfall ? TT.pitfall('tip-calculator', input) : null;
      if (!p) { noteEl.hidden = true; noteTxt.textContent = ''; return; }
      noteTxt.textContent = p.text;
      noteEl.hidden = false;
    }

    function money(n) {
      return '$' + (Math.round(n * 100) / 100).toFixed(2);
    }

    function syncPresets(pct) {
      for (var i = 0; i < presets.length; i++) {
        var on = presets[i].getAttribute('data-pct') === String(pct);
        presets[i].classList.toggle('is-active', on);
      }
    }

    // Inline field message: set it to explain what is wrong, or null to clear it.
    function fieldError(input, el, message) {
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      if (!el) return;
      el.textContent = message || '';
      el.hidden = !message;
    }

    // Split: blank means 1 (the default). Anything else must be a whole number of people, 1 or more.
    // Returns the count, or null when it is invalid, so no per-person figure is ever computed from a
    // guess (2.5 used to become 2, and 0 or -2 kept the old values on screen).
    function readSplit() {
      var raw = splitEl.value;
      if (raw === '') {
        // A typed but unparseable value (e.g. "-") reads as '' with badInput set.
        if (splitEl.validity && splitEl.validity.badInput) return null;
        return 1;
      }
      var n = Number(raw);
      if (!Number.isFinite(n) || n < 1 || Math.floor(n) !== n) return null;
      return n;
    }

    function hidePerPerson() {
      if (ppTipRow) ppTipRow.hidden = true;
      if (ppTotRow) ppTotRow.hidden = true;
      if (ppTipEl) ppTipEl.textContent = '';
      if (ppTotEl) ppTotEl.textContent = '';
    }

    function showEmpty(message) {
      lastResult = '';
      note({});
      amountEl.textContent = '$0.00';
      if (hintEl) { hintEl.textContent = message || 'Enter a bill amount to calculate.'; hintEl.hidden = false; }
      if (secondary) secondary.hidden = true;
      hidePerPerson();
    }

    function calc() {
      var billRaw = billEl.value, pctRaw = pctEl.value;
      syncPresets(pctRaw === '' ? null : Number(pctRaw));

      // Field messages first, so they show even before a bill is entered.
      var pct = pctRaw === '' ? 0 : Number(pctRaw);
      var pctBad = (pctRaw === '' && pctEl.validity && pctEl.validity.badInput) || !Number.isFinite(pct) || pct < 0;
      fieldError(pctEl, pctErr, pctBad ? 'Enter a tip of 0% or more.' : null);
      var split = readSplit();
      fieldError(splitEl, splitErr, split === null ? 'Split between a whole number of people, 1 or more.' : null);

      if (billRaw === '') { showEmpty('Enter a bill amount to calculate.'); return; }
      var bill = Number(billRaw);
      if (!Number.isFinite(bill) || bill < 0) { showEmpty('Enter a valid bill amount.'); return; }
      if (pctBad) { showEmpty('Enter a tip of 0% or more.'); return; }

      note({ bill: bill, tipPct: pct });

      var tip = bill * pct / 100;
      var total = bill + tip;

      lastResult = money(tip);
      amountEl.textContent = lastResult;
      if (hintEl) hintEl.hidden = true;
      if (secondary) secondary.hidden = false;
      if (totalEl) totalEl.textContent = money(total);

      // Per-person rows only for a valid split of 2 or more. An invalid split clears them (with the
      // message beside the field) rather than leaving the last valid split's figures on screen.
      if (split === null || split < 2) { hidePerPerson(); return; }
      if (ppTipEl) ppTipEl.textContent = money(tip / split);
      if (ppTotEl) ppTotEl.textContent = money(total / split);
      if (ppTipRow) ppTipRow.hidden = false;
      if (ppTotRow) ppTotRow.hidden = false;
    }

    function persist() {
      if (TT && TT.state) TT.state.save('tip-calculator', { bill: billEl.value, pct: pctEl.value, split: splitEl.value });
    }

    // Restore
    try {
      var saved = TT && TT.state && TT.state.load('tip-calculator');
      if (saved) {
        if (saved.bill != null) billEl.value = saved.bill;
        if (saved.pct != null) pctEl.value = saved.pct;
        if (saved.split != null) splitEl.value = saved.split;
      }
    } catch (_) {}

    for (var i = 0; i < presets.length; i++) {
      presets[i].addEventListener('click', function () {
        pctEl.value = this.getAttribute('data-pct');
        calc(); persist();
      });
    }
    billEl.addEventListener('input', function () { calc(); persist(); });
    pctEl.addEventListener('input', function () { calc(); persist(); });
    splitEl.addEventListener('input', function () { calc(); persist(); });

    // Copy with success state
    var copyTimer;
    if (copyBtn) copyBtn.addEventListener('click', function () {
      if (!lastResult) { TT && TT.toast('Nothing to copy!'); return; }
      TT && TT.copy(lastResult);
      copyBtn.classList.add('is-success');
      copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () {
        copyBtn.classList.remove('is-success');
        copyBtn.textContent = 'Copy';
      }, 2000);
    });

    // Two-click confirm clear
    var clearTimer;
    function resetClear() {
      clearTimeout(clearTimer);
      if (clearBtn) { clearBtn.classList.remove('is-confirming'); clearBtn.textContent = 'Clear'; }
    }
    if (clearBtn) clearBtn.addEventListener('click', function () {
      if (!clearBtn.classList.contains('is-confirming')) {
        clearBtn.classList.add('is-confirming');
        clearBtn.textContent = 'Confirm Clear';
        clearTimeout(clearTimer);
        clearTimer = setTimeout(resetClear, 3000);
        return;
      }
      resetClear();
      billEl.value = ''; pctEl.value = ''; splitEl.value = '1';
      calc(); persist();
      billEl.focus();
    });
    document.addEventListener('click', function (e) {
      if (clearBtn && clearBtn.classList.contains('is-confirming') && !e.target.closest('#tip-clear')) resetClear();
    });

    calc();
    // The pitfall line comes from the lazily-loaded calculator chunk, which does not exist yet when
    // this script first runs. Recompute once it lands so a restored session shows it too.
    if (TT && TT.onReady) TT.onReady(calc);
  })();
</script>

<style>
  /* .tm-stat-row sets display:flex, which beat the hidden attribute, so the per-person rows used to
     stay visible (showing $0.00 or stale figures) when the script hid them. */
  .tm-stat-row[hidden],
  .tip-field-error[hidden] {
    display: none;
  }

  .tip-field-error {
    margin: var(--space-1) 0 0;
    color: var(--color-danger);
    font-size: var(--text-sm);
  }

  .tip-presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tip-preset {
    flex: 1;
    min-width: 64px;
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: var(--border);
    border-color: transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: var(--transition-color);
  }

  .tip-preset:hover,
  .tip-preset:active {
    border-color: transparent;
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }

  .tip-preset.is-active,
  .tip-preset.is-active:hover {
    border-color: transparent;
    background: transparent;
    color: var(--color-accent-strong);
    font-weight: var(--font-weight-semibold);
  }
</style>
