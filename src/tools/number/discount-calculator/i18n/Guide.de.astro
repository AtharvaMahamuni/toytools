---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Einen Prozentrabatt ermittelst du durch Multiplikation des Ursprungspreises mit <code>1 − Rabatt/100</code>. Kommt an der Kasse ein zweiter Extra-Rabatt hinzu, greift dieser stets auf dem bereits reduzierten Zwischenpreis statt auf dem Ausgangspreis.
    </p>
    <a href={toolHref} class="cta-link">Rabattrechner öffnen →</a>
  </section>

  <section id="doppelrabatt">
    <h2>Doppelrabatt und Rückrechnung auf den Listenpreis <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      „30 % plus 20 % extra“ sind nicht 50 %, sondern 44 % Ersparnis: Von 100 bleiben nach 30 % noch 70, davon 20 % weniger ergeben 56. Umgekehrt gewinnst du den Ursprungspreis zurück durch Teilen des Endpreises durch <code>1 − Rabattsatz</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Gutschein-Vergleich: Prozent vs. Eurobetrag">
      <p>Bei kleinen Beträgen schlägt oft ein fester Euro-Gutschein (z. B. 15 € ab 50 € = 30 %), während bei teureren Artikeln Prozentgutscheine deutlich lukrativer werden.</p>
    </ReferenceBlock>
  </section>

  <section id="verwandte-tools">
    <h2>Verwandte Rechenhilfen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Für allgemeine Prozentaufgaben, Trinkgeld oder Aufschläge öffne den <a href={toolPathBySlug('percentage-calculator', 'de')}>Prozentrechner</a> oder prüfe Kaufkraftveränderungen mit dem <a href={toolPathBySlug('inflation-calculator')}>Inflation Calculator</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
