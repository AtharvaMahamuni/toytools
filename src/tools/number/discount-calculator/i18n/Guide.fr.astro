---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './fr';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'fr');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="fr">
  <section id="reponse-rapide">
    <h2>Réponse rapide <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Pour obtenir un prix après réduction en pourcentage, multipliez le prix initial par <code>1 − taux</code> (ou calculez l’économie puis soustrayez-la). Si une seconde remise s’applique en caisse, elle porte sur le sous-total déjà réduit et non sur le prix de départ.
    </p>
    <a href={toolHref} class="cta-link">Ouvrir le Calculateur de Remise →</a>
  </section>

  <section id="remises-en-cascade">
    <h2>Remises successives et prix avant réduction <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Deux démarques de 30 % puis 20 % ne font pas 50 %, mais 44 % : sur 100 €, on passe à 70 € puis 56 €. À l’inverse, pour retrouver le tarif avant solde, divisez le prix payé par <code>1 − taux</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Bon en pourcentage ou montant fixe">
      <p>Un bon fixe de 15 € l’emporte sur les petits paniers (30 % sur 50 €), alors qu’un bon de 20 % devient plus avantageux au-delà d’un certain seuil d’achat.</p>
    </ReferenceBlock>
  </section>

  <section id="outils-lies">
    <h2>Calculatrices complémentaires <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Pour d’autres calculs de taux, TVA ou pourboires consultez le <a href={toolPathBySlug('percentage-calculator', 'fr')}>Calculateur de Pourcentage</a>, ou évaluez l’évolution des prix avec <a href={toolPathBySlug('inflation-calculator')}>Inflation Calculator</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
