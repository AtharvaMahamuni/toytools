---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para calcular un descuento porcentual multiplica el precio original por el tanto por ciento entre 100 para obtener el ahorro y réstalo al precio inicial (o multiplica directamente por <code>1 − tasa</code>). Si recibes una rebaja adicional posterior, recuerda que se aplica sobre el nuevo precio ya descontado.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Descuentos →</a>
  </section>

  <section id="descuentos-encadenados">
    <h2>Descuentos encadenados y cálculo del precio original <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Un «30 % más 20 % adicional» no equivale al 50 %, sino al 44 % efectivo: tras bajar de 100 a 70, el 20 % adicional recorta 14 y deja el precio en 56. A la inversa, para conocer el precio antes de rebaja divide el precio pagado entre <code>1 − tasa</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Porcentaje vs. importe fijo">
      <p>Un cupón fijo de 15 € ahorra proporcionalmente más en compras pequeñas (30 % sobre 50 €), mientras un 20 % rinde más en compras de mayor importe.</p>
    </ReferenceBlock>
  </section>

  <section id="herramientas-relacionadas">
    <h2>Otras calculadoras prácticas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Si quieres calcular propinas, impuestos o variaciones porcentuales generales visita la <a href={toolPathBySlug('percentage-calculator', 'es')}>Calculadora de Porcentajes</a>, o consulta pérdida de poder adquisitivo con <a href={toolPathBySlug('inflation-calculator')}>Inflation Calculator</a>.
    </p>
  </section>
</GuideLayout>
