---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para encontrar o preço promocional após desconto percentual, multiplique o valor original por <code>1 − taxa</code> (ou calcule o abatimento e subtraia do preço inicial). Em descontos aplicados no caixa em duas etapas, o segundo incide sobre o valor já reduzido.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Desconto →</a>
  </section>

  <section id="descontos-em-cascata">
    <h2>Desconto em cascata e retorno ao preço original <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      "30% + 20% extra" não dá 50%, mas sim 44%: de 100 cai para 70 e depois para 56. Para descobrir o preço antigo antes da liquidação basta dividir o valor pago por <code>1 − taxa</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Cupom percentual vs. valor fixo">
      <p>Vales de valor fixo rendem percentualmente mais em compras pequenas, enquanto cupons de porcentagem compensam muito mais nos itens de ticket alto.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Calculadoras relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para cálculos gerais de acréscimo, taxas ou gorjetas acesse a <a href={toolPathBySlug('percentage-calculator', 'pt')}>Calculadora de Porcentagem</a>, ou simule perda do poder de compra na <a href={toolPathBySlug('inflation-calculator')}>Inflation Calculator</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
