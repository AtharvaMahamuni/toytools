---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>結論とポイント <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      ％割引後の価格は「元の価格 × (1 − 割引率)」で計算できます（例：25%オフなら 0.75 を掛ける）。レジでさらに追加割引が適用される場合は、最初の値引き後金額に対して次の割引率が掛かる点に注意してください。
    </p>
    <a href={toolHref} class="cta-link">割引計算ツールを開く →</a>
  </section>

  <section id="stacked-discounts">
    <h2>重複割引と定価の逆算方法 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      「30%オフからさらに20%オフ」は50%引きではなく実質44%引き（100 → 70 → 56）になります。逆に割引後価格から元の定価を知りたいときは「割引後価格 ÷ (1 − 割引率)」で逆算できます。
    </p>
    <ReferenceBlock type="key-idea" heading="％割引と定額クーポンの損益分岐">
      <p>少額の買い物では定額引きクーポン（例：500円引き）が有利になりやすく、高額商品では割合割引（20%オフなど）の方が節約額が大きくなります。</p>
    </ReferenceBlock>
  </section>

  <section id="related-tools">
    <h2>関連する数値計算ツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      税金・増減率など汎用的な割合計算には <a href={toolPathBySlug('percentage-calculator', 'ja')}>パーセント計算ツール</a>、長期的な物価変動の確認には <a href={toolPathBySlug('inflation-calculator')}>Inflation Calculator</a> もお役立てください。
    </p>
  </section>
</GuideLayout>
