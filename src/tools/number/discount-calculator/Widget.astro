---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
---

<ToolSplit ratio="3-2" stackOrder="input-first" stickyOutput={false}>
  <IoPanel slot="input" label="Discount Details" variant="prose" data-tool="discount-calculator">
    <div class="io-body">
      <label class="widget-label" for="disc-mode">Discount Type</label>
      <select id="disc-mode" class="widget-select">
        <option value="percent">Percentage off</option>
        <option value="fixed">Fixed amount off</option>
      </select>

      <label class="widget-label" for="disc-price">Original Price</label>
      <input id="disc-price" class="widget-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Example: 120.00" />

      <label class="widget-label" for="disc-amount" id="disc-amount-label">Discount (%)</label>
      <div class="disc-presets" id="disc-presets" role="group" aria-labelledby="disc-amount-label">
        <button type="button" class="disc-preset" data-pct="10">10%</button>
        <button type="button" class="disc-preset" data-pct="20">20%</button>
        <button type="button" class="disc-preset" data-pct="25">25%</button>
        <button type="button" class="disc-preset" data-pct="50">50%</button>
      </div>
      <input id="disc-amount" class="widget-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Example: 25" />
    </div>
  </IoPanel>

  <IoPanel slot="output" label="Result" variant="prose" result>
    <div class="tm-hero">
      <span class="hero-value" id="disc-final">$0.00</span>
      <span class="hero-label">Final Price</span>
      <p class="empty-hint" id="disc-hint">Enter a price to calculate.</p>
    </div>
    <dl class="tm-stats tm-secondary" aria-live="polite" hidden>
      <div class="tm-stat-row">
        <dt class="tm-stat-label">You Save</dt>
        <dd class="tm-stat-value" id="disc-saved">$0.00</dd>
      </div>
      <div class="tm-stat-row">
        <dt class="tm-stat-label">Discount Rate</dt>
        <dd class="tm-stat-value" id="disc-rate">0%</dd>
      </div>
    </dl>
    <CraftNote id="disc-note" craftId="disc-stack" action />
  </IoPanel>
</ToolSplit>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id="disc-copy" data-label="Copy" type="button">Copy</button>
  <button class="action-btn action-btn--clear" id="disc-clear" data-label="Clear" type="button">Clear</button>
</div>


<script is:inline>
  (function () {
    var modeEl   = document.getElementById('disc-mode');
    var priceEl  = document.getElementById('disc-price');
    var amountEl = document.getElementById('disc-amount');
    var amtLabel = document.getElementById('disc-amount-label');
    var presetsWrap = document.getElementById('disc-presets');
    var presets = document.querySelectorAll('.disc-preset');
    var finalEl  = document.getElementById('disc-final');
    var hintEl   = document.getElementById('disc-hint');
    var secondary = document.querySelector('.tm-secondary');
    var savedEl  = document.getElementById('disc-saved');
    var rateEl   = document.getElementById('disc-rate');
    var copyBtn  = document.getElementById('disc-copy');
    var clearBtn = document.getElementById('disc-clear');
    var noteEl   = document.getElementById('disc-note');
    var noteTxt  = document.getElementById('disc-note-text');
    var noteBtn  = document.getElementById('disc-note-action');
    if (!modeEl || !priceEl || !amountEl || !finalEl) return;

    var TT = window.ToyTools;
    var lastResult = '';
    // The price the running chain started from, once the user has stacked at least one discount.
    // Null means no chain, which is the ordinary single-discount case.
    var basePrice = null;

    function money(n) {
      return '$' + (Math.round(n * 100) / 100).toFixed(2);
    }

    function pct(n) {
      var rounded = Math.round(n * 100) / 100;
      return (Number.isInteger(rounded) ? rounded.toString() : rounded.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')) + '%';
    }

    // The craft line: "30% off, extra 20% at the till" is 44% off, not 50%, and the tool computes
    // one discount at a time. The button feeds the result back in so the second discount lands on
    // the right base by construction, and the line then reports the combined rate.
    function note(input) {
      if (!noteEl || !noteTxt) return;
      var p = TT && TT.pitfall ? TT.pitfall('discount-calculator', input) : null;
      if (!p) { noteEl.hidden = true; noteTxt.textContent = ''; if (noteBtn) noteBtn.hidden = true; return; }
      noteTxt.textContent = p.text;
      if (noteBtn) {
        noteBtn.textContent = p.action ? p.action.label : '';
        noteBtn.setAttribute('data-value', p.action ? String(p.action.value) : '');
        noteBtn.hidden = !p.action;
      }
      noteEl.hidden = false;
    }

    function syncPresets(pct) {
      for (var i = 0; i < presets.length; i++) {
        var on = presets[i].getAttribute('data-pct') === String(pct);
        presets[i].classList.toggle('is-active', on);
      }
    }

    function applyMode() {
      if (modeEl.value === 'fixed') {
        if (amtLabel) amtLabel.textContent = 'Amount Off ($)';
        amountEl.setAttribute('placeholder', 'Example: 30.00');
        if (presetsWrap) presetsWrap.hidden = true;
      } else {
        if (amtLabel) amtLabel.textContent = 'Discount (%)';
        amountEl.setAttribute('placeholder', 'Example: 25');
        if (presetsWrap) presetsWrap.hidden = false;
        syncPresets(amountEl.value === '' ? null : Number(amountEl.value));
      }
    }

    function showEmpty(message) {
      lastResult = '';
      note({});
      finalEl.textContent = '$0.00';
      if (hintEl) { hintEl.textContent = message || 'Enter a price to calculate.'; hintEl.hidden = false; }
      if (secondary) secondary.hidden = true;
    }

    function calc() {
      var priceRaw = priceEl.value;
      if (priceRaw === '') { showEmpty('Enter a price to calculate.'); return; }
      var price = Number(priceRaw);
      if (!Number.isFinite(price) || price < 0) { showEmpty('Enter a valid price.'); return; }

      var amtRaw = amountEl.value;
      var amt = amtRaw === '' ? 0 : Number(amtRaw);
      if (!Number.isFinite(amt) || amt < 0) amt = 0;

      var saved, rate;
      if (modeEl.value === 'fixed') {
        saved = Math.min(amt, price);          // can't discount below zero
        rate = price > 0 ? (saved / price) * 100 : 0;
      } else {
        rate = Math.min(amt, 100);             // cap at 100% off
        saved = price * rate / 100;
      }
      var final = price - saved;

      note({ price: price, final: final, basePrice: basePrice == null ? undefined : basePrice });

      lastResult = money(final);
      finalEl.textContent = lastResult;
      if (hintEl) hintEl.hidden = true;
      if (secondary) secondary.hidden = false;
      if (savedEl) savedEl.textContent = money(saved);
      if (rateEl) rateEl.textContent = pct(rate);
    }

    function persist() {
      if (TT && TT.state) TT.state.save('discount-calculator', { mode: modeEl.value, price: priceEl.value, amount: amountEl.value, basePrice: basePrice });
    }

    if (noteBtn) noteBtn.addEventListener('click', function () {
      var next = Number(noteBtn.getAttribute('data-value'));
      if (!Number.isFinite(next)) return;
      // Remember where the chain began the first time only, so the combined rate stays measured
      // against the price the user actually started from.
      if (basePrice == null) basePrice = Number(priceEl.value);
      priceEl.value = (Math.round(next * 100) / 100).toFixed(2);
      amountEl.value = '';
      calc(); persist();
      amountEl.focus();
    });

    // Restore
    try {
      var saved = TT && TT.state && TT.state.load('discount-calculator');
      if (saved) {
        if (saved.mode) modeEl.value = saved.mode;
        if (saved.price != null) priceEl.value = saved.price;
        if (saved.amount != null) amountEl.value = saved.amount;
        if (typeof saved.basePrice === 'number') basePrice = saved.basePrice;
      }
    } catch (_) {}

    applyMode();

    modeEl.addEventListener('change', function () { applyMode(); calc(); persist(); });
    priceEl.addEventListener('input', function () { calc(); persist(); });
    amountEl.addEventListener('input', function () {
      if (modeEl.value !== 'fixed') syncPresets(amountEl.value === '' ? null : Number(amountEl.value));
      calc(); persist();
    });

    for (var pi = 0; pi < presets.length; pi++) {
      presets[pi].addEventListener('click', function () {
        amountEl.value = this.getAttribute('data-pct');
        syncPresets(Number(amountEl.value));
        calc(); persist();
      });
    }

    // Copy with success state
    var copyTimer;
    if (copyBtn) copyBtn.addEventListener('click', function () {
      if (!lastResult) { TT && TT.toast('Nothing to copy!'); return; }
      TT && TT.copy(lastResult);
      copyBtn.classList.add('is-success');
      copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () {
        copyBtn.classList.remove('is-success');
        copyBtn.textContent = 'Copy';
      }, 2000);
    });

    // Two-click confirm clear
    var clearTimer;
    function resetClear() {
      clearTimeout(clearTimer);
      if (clearBtn) { clearBtn.classList.remove('is-confirming'); clearBtn.textContent = 'Clear'; }
    }
    if (clearBtn) clearBtn.addEventListener('click', function () {
      if (!clearBtn.classList.contains('is-confirming')) {
        clearBtn.classList.add('is-confirming');
        clearBtn.textContent = 'Confirm Clear';
        clearTimeout(clearTimer);
        clearTimer = setTimeout(resetClear, 3000);
        return;
      }
      resetClear();
      priceEl.value = ''; amountEl.value = ''; basePrice = null;
      syncPresets(null);
      calc(); persist();
      priceEl.focus();
    });
    document.addEventListener('click', function (e) {
      if (clearBtn && clearBtn.classList.contains('is-confirming') && !e.target.closest('#disc-clear')) resetClear();
    });

    calc();
    // The pitfall line comes from the lazily-loaded calculator chunk, which does not exist yet when
    // this script first runs. Recompute once it lands so a restored session shows it too.
    if (TT && TT.onReady) TT.onReady(calc);
  })();
</script>

<style>
  .disc-presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .disc-presets[hidden] { display: none; }

  .disc-preset {
    flex: 1;
    min-width: 64px;
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: var(--transition-color);
  }

  .disc-preset:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
  }

  .disc-preset.is-active,
  .disc-preset.is-active:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
  }
</style>
