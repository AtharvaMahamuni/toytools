---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import CopyButton from '@components/CopyButton.astro';
import ToolSection from '@tools/_shared/ToolSection.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import FAQPreview from '@components/FAQPreview.astro';
import { config } from './config';
import { items as faqItems } from './faq';
import { withBase } from '@lib/paths';

const guideHref = config.guide
  ? withBase(`/guide/${config.guide.categorySlug}/${config.guide.slug}/`)
  : null;
const faqHref = config.faq
  ? withBase(`/faq/${config.faq.categorySlug}/${config.faq.slug}/`)
  : null;
---

<div class="b64-container">
  <ToolSplit ratio="1-1" stackOrder="input-first" stickyOutput={false}>
    <div slot="input" class="b64-panel">
      <div class="b64-header">
        <label class="b64-label" for="base64-input">
          Input <span id="b64-input-type" class="b64-type">Text</span>
        </label>
        <select id="base64-mode" aria-label="Conversion mode">
          <option value="encode">Encode → Base64</option>
          <option value="decode">Decode ← Base64</option>
        </select>
      </div>
      <textarea
        id="base64-input"
        placeholder="Enter text or Base64 — try: Hello World"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
      ></textarea>
    </div>

    <div slot="output" class="b64-panel">
      <div class="b64-header" data-copy-bar>
        <span class="b64-label">
          Output <span id="b64-output-type" class="b64-type">Base64</span>
        </span>
        <CopyButton targetId="base64-output" />
      </div>
      <output id="base64-output" aria-live="polite" data-empty>Output will appear here</output>
    </div>
  </ToolSplit>
</div>

<CategoryDiscovery toolSlug="base64-encoder-decoder" />

<ToolSection heading="How it works">
  <p>
    Base64 converts text or binary data into a text-safe format that can be transmitted
    through systems that primarily support text — such as email servers, URLs, and API
    payloads. The encoder and decoder run entirely in your browser. Nothing is sent to a server.
  </p>
  <p>
    Base64 is encoding, not encryption. Anyone who sees the encoded output can decode it
    instantly without a key.
  </p>
  {guideHref && (
    <p class="guide-callout">
      <a href={guideHref}>Learn more → What Is Base64? Complete Reference Guide</a>
    </p>
  )}
</ToolSection>

{faqHref && (
  <section class="content-section">
    <h2>FAQ</h2>
    <FAQPreview items={faqItems.slice(0, 3)} faqHref={faqHref} />
  </section>
)}

<style is:global>
  .b64-container {
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }

  .b64-panel {
    border: var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    min-height: 320px;
    overflow: hidden;
  }

  .b64-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-bottom: var(--border);
    min-height: var(--touch-target);
    flex-shrink: 0;
  }

  .b64-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .b64-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-subtle);
  }

  #base64-mode {
    min-height: unset;
    width: auto;
    border: none;
    border-left: var(--border);
    border-radius: 0;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
    align-self: stretch;
  }

  #base64-input {
    flex: 1;
    resize: none;
    width: 100%;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    background: var(--color-bg);
    color: var(--color-text);
    font-variant-ligatures: none;
  }

  #base64-output {
    flex: 1;
    display: block;
    margin: 0;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow-y: auto;
    color: var(--color-text);
    font-variant-ligatures: none;
  }

  #base64-output[data-empty] {
    color: var(--color-text-subtle);
  }
</style>

<script is:inline>
  (function () {
    var input  = document.getElementById('base64-input');
    var modeEl = document.getElementById('base64-mode');
    var output = document.getElementById('base64-output');
    if (!input || !modeEl || !output) return;

    var STORAGE_KEY = 'toytools.base64.input';

    function setOutput(text, empty, error) {
      output.textContent = text;
      if (empty) output.setAttribute('data-empty', '');
      else       output.removeAttribute('data-empty');
      if (error) output.setAttribute('data-error', text);
      else       output.removeAttribute('data-error');
    }

    function convert() {
      var text = input.value;
      if (!text) { setOutput('Output will appear here', true, false); return; }
      var mode = modeEl.value;
      try {
        var result = mode === 'decode'
          ? decodeURIComponent(escape(atob(text.trim())))
          : btoa(unescape(encodeURIComponent(text)));
        setOutput(result, false, false);
      } catch (_) {
        var msg = mode === 'decode' ? 'Invalid Base64 input.' : 'Unable to encode.';
        setOutput(msg, false, true);
      }
    }

    function updateLabels() {
      var encode = modeEl.value === 'encode';
      var inputType  = document.getElementById('b64-input-type');
      var outputType = document.getElementById('b64-output-type');
      if (inputType)  inputType.textContent  = encode ? 'Text'   : 'Base64';
      if (outputType) outputType.textContent = encode ? 'Base64' : 'Text';
    }

    try {
      var saved = ToyTools.storage.get(STORAGE_KEY);
      if (saved) { input.value = saved; convert(); }
    } catch (_) {}

    updateLabels();

    input.addEventListener('input', function () {
      convert();
      ToyTools.storage.set(STORAGE_KEY, input.value);
    });

    modeEl.addEventListener('change', function () {
      convert(); updateLabels();
    });
  })();
</script>
