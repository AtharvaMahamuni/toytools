---
import ToolSection from '@tools/_shared/ToolSection.astro';
import ToolAction from '@tools/_shared/ToolAction.astro';
---

<section class="tool-panel" data-tool="percentage-calculator">
  <label class="widget-label" for="percentage-mode">Calculation</label>
  <select id="percentage-mode" class="widget-select">
    <option value="of">What is A% of B?</option>
    <option value="change">Percentage change from A to B</option>
    <option value="is">A is what percent of B?</option>
  </select>
  <label class="widget-label" for="percentage-a">A</label>
  <input id="percentage-a" class="widget-input" type="number" inputmode="decimal" placeholder="Example: 20" />
  <label class="widget-label" for="percentage-b">B</label>
  <input id="percentage-b" class="widget-input" type="number" inputmode="decimal" placeholder="Example: 150" />
</section>

<ToolAction label="Calculate" toolSlug="percentage-calculator" />

<section class="result-panel" aria-live="polite">
  <div>
    <h2>Result</h2>
    <output id="tool-output" class="widget-output">Enter values and run the tool.</output>
  </div>
</section>

<ToolSection heading="How it works">
  <p>The calculator applies the selected percentage formula and shows the computed value immediately.</p>
</ToolSection>

<section class="content-section">
  <h2>FAQ</h2>
  <details class="widget-details">
    <summary>Does this tool upload my data?</summary>
    <p>No. Everything runs in your browser.</p>
  </details>
  <details class="widget-details">
    <summary>Can I use it on mobile?</summary>
    <p>Yes. Inputs are stacked and reachable on small screens.</p>
  </details>
</section>

<script is:inline>
  document.querySelector('[data-run-tool="percentage-calculator"]')?.addEventListener('click', function () {
    var mode = document.getElementById('percentage-mode')?.value;
    var a = Number(document.getElementById('percentage-a')?.value);
    var b = Number(document.getElementById('percentage-b')?.value);
    var out = document.getElementById('tool-output');
    if (!out) return;
    if (!Number.isFinite(a) || !Number.isFinite(b)) { out.textContent = 'Enter valid numbers.'; return; }
    if (mode === 'change' && a === 0) { out.textContent = 'First value cannot be zero.'; return; }
    if (mode === 'is'     && b === 0) { out.textContent = 'Second value cannot be zero.'; return; }
    var result = mode === 'of'     ? (a / 100) * b :
                 mode === 'change' ? ((b - a) / a) * 100 :
                                     (a / b) * 100;
    out.textContent = Number(result.toFixed(6)).toString();
  });
</script>
