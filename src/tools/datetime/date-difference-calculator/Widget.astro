---
// Date Difference Calculator — a thin wrapper over the shared DateTimeWidget. Tool logic lives in the
// datetime engine (src/lib/engines/datetime/calculators/date-difference.ts), resolved at runtime via
// ToyTools.runDateTime.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
---

<DateTimeWidget slug={config.slug} dateTimeId="date-difference" config={config} emptyText="Enter a start date and an end date to measure the time between them." />
