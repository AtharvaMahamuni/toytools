---
// Date Difference Calculator — a thin wrapper over the shared DateTimeWidget. Tool logic lives in the
// datetime engine (src/lib/engines/datetime/calculators/date-difference.ts), resolved at runtime via
// ToyTools.runDateTime.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { uiStr } from '@lib/i18n/widget-utils';

interface Props { lang?: LocaleCode; pack?: LocalizedToolPack | null; }
const { lang = 'en', pack = null } = Astro.props;
const emptyText = uiStr(pack, 'emptyText', 'Enter a start date and an end date to measure the time between them.');
---

<DateTimeWidget slug={config.slug} dateTimeId="date-difference" config={config} craftOn="hero-note" emptyText={emptyText} lang={lang} pack={pack} />
