---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Eine exakte Datumsdifferenz folgt dem realen Kalender (28 bis 31 Tage je Monat inklusive Schaltjahre) und trennt sauber zwischen Kalendertagen und reinen Werktagen von Montag bis Freitag. Die Reihenfolge beider Daten beeinflusst den Betrag nicht.
    </p>
    <a href={toolHref} class="cta-link">Datumsdifferenz-Rechner öffnen →</a>
  </section>

  <section id="kalendertage-vs-werktage">
    <h2>Kalendertage im Vergleich zu Werktagen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Liefer- und Projektfristen beziehen sich häufig auf Werktage ohne Wochenende, während Miet-, Urlaubs- und Zinszeiträume in Kalendertagen rechnen. Regionale gesetzliche Feiertage musst du bei Bedarf zusätzlich abziehen.
    </p>
    <ReferenceBlock type="key-idea" heading="Inklusive vs. exklusive Zählung">
      <p>Die Datumsdifferenz zählt die Schritte zwischen Start- und Enddatum. Sollen sowohl erster als auch letzter Tag voll zählen (z. B. Urlaubstage), rechne einen Tag hinzu.</p>
    </ReferenceBlock>
  </section>

  <section id="verwandte-tools">
    <h2>Passende Zeit- und Datumsrechner <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Berechne das genaue Lebensalter im <a href={toolPathBySlug('age-calculator', 'de')}>Altersrechner</a>, konvertiere Timestamps im <a href={toolPathBySlug('unix-timestamp-converter', 'de')}>Unix-Timestamp-Umrechner</a> oder prüfe Zeitzonen im <a href={toolPathBySlug('timezone-converter')}>Timezone Converter</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
