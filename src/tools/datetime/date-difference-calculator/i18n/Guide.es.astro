---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Medir la duración entre dos fechas exige recorrer el calendario real (meses de 28, 29, 30 o 31 días y años bisiestos) y distinguir entre días naturales totales y días laborables de lunes a viernes. Esta calculadora muestra ambos datos al instante sin importar el orden en que introduzcas las fechas.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Diferencia de Fechas →</a>
  </section>

  <section id="naturales-vs-laborables">
    <h2>Días naturales frente a días laborables <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Los plazos contractuales o de entrega suelen expresarse en días laborables, mientras que estancias de viaje y vencimientos legales cuentan días naturales completos. Recuerda descontar manualmente los festivos locales si planificas nóminas o envíos oficiales.
    </p>
    <ReferenceBlock type="key-idea" heading="Límites inclusivos frente a diferencia">
      <p>La diferencia cuenta las noches o saltos entre el día de inicio y el de fin. Si necesitas incluir ambos días completos en una reserva o jornada laboral, suma 1 día al cálculo.</p>
    </ReferenceBlock>
  </section>

  <section id="herramientas-relacionadas">
    <h2>Herramientas relacionadas de calendario <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Si partes de una fecha de nacimiento utiliza la <a href={toolPathBySlug('age-calculator', 'es')}>Calculadora de Edad</a>, convierte marcas de tiempo en el <a href={toolPathBySlug('unix-timestamp-converter', 'es')}>Conversor Unix Timestamp</a> o verifica husos horarios en <a href={toolPathBySlug('timezone-converter')}>Timezone Converter</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
