---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Calcular a distância entre duas datas exige percorrer meses reais (28, 29, 30 ou 31 dias) incluindo anos bissextos e separar dias corridos totais de dias úteis de segunda a sexta. A ferramenta retorna ambas as leituras instantaneamente no navegador.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Diferença entre Datas →</a>
  </section>

  <section id="corridos-vs-uteis">
    <h2>Dias corridos versus dias úteis <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Cronogramas de entrega e projetos usam dias úteis sem fins de semana, enquanto diárias de hospedagem e prazos contratuais contam dias corridos. Feriados municipais ou nacionais variam por região e devem ser descontados à parte.
    </p>
    <ReferenceBlock type="key-idea" heading="Diferença entre datas vs. inclusão dos extremos">
      <p>A diferença conta os intervalos entre a data inicial e a final. Se você precisa incluir tanto o primeiro quanto o último dia completos no prazo, some 1 dia ao resultado.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Outras calculadoras de tempo e calendário <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para calcular idade exata use a <a href={toolPathBySlug('age-calculator', 'pt')}>Calculadora de Idade</a>, converta datas em segundos Epoch no <a href={toolPathBySlug('unix-timestamp-converter', 'pt')}>Conversor Unix Timestamp</a> ou confira fusos no <a href={toolPathBySlug('timezone-converter')}>Timezone Converter</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
