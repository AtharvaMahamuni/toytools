---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './fr';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'fr');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="fr">
  <section id="reponse-rapide">
    <h2>Réponse rapide <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Calculer l’écart entre deux dates demande de suivre le calendrier réel (mois de 28 à 31 jours et années bissextiles) tout en distinguant jours calendaires complets et jours ouvrés du lundi au vendredi.
    </p>
    <a href={toolHref} class="cta-link">Ouvrir le Calculateur d’Écart entre Dates →</a>
  </section>

  <section id="calendaires-vs-ouvres">
    <h2>Jours calendaires vs jours ouvrés <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Les plannings projet raisonnent souvent en jours ouvrés hors week-ends, alors que les séjours ou échéances contractuelles comptent en jours calendaires. Pensez à retrancher manuellement les jours fériés propres à votre pays si nécessaire.
    </p>
    <ReferenceBlock type="key-idea" heading="Bornes inclusives ou différence pure">
      <p>La différence mesure les intervalles entre la date de départ et la date d’arrivée. Pour inclure les deux journées entières (par exemple pour des congés), ajoutez 1 jour.</p>
    </ReferenceBlock>
  </section>

  <section id="outils-lies">
    <h2>Outils horaires et calendaires associés <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Pour mesurer un âge exact consultez le <a href={toolPathBySlug('age-calculator', 'fr')}>Calculateur d’Âge</a>, convertissez vos dates dans le <a href={toolPathBySlug('unix-timestamp-converter', 'fr')}>Convertisseur Timestamp Unix</a> ou vérifiez les décalages horaires avec <a href={toolPathBySlug('timezone-converter')}>Timezone Converter</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
