---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { guidePathBySlug, toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="ja"
>
  <section id="quick-answer">
    <h2>概要（クイック回答） <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Unixタイムスタンプとは1970年1月1日 00:00:00 UTC からの経過時間を秒（またはミリ秒）で表した数値です。「タイムスタンプ → 日時」では <code>1700000000</code> のような数値を人が読めるUTC・日本時間(JST)・ISO 8601表記に変換し、「日時 → タイムスタンプ」では逆の変換を行います。
    </p>
    <a href={toolHref} class="cta-link">Unixタイムスタンプ変換を開く →</a>
  </section>

  <section id="how-it-works">
    <h2>Unix時間とエポックの仕組み <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Unixエポック（0）はUTC 1970年1月1日 00:00:00 に固定されており、タイムゾーンを持たない純粋な物理時刻の尺度です。そのため東京でもロンドンでも同じ瞬間は常に同じUnix時間を指します。<a href={guidePathBySlug('jwt-decoder')}>JWTトークンの exp / iat クレーム</a>でも同じエポック秒が使われます。
    </p>
  </section>

  <section id="seconds-vs-millis">
    <h2>秒（10桁）とミリ秒（13桁）の見分け方 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      1700000000（10桁）は秒単位で 2023年11月14日 22:13:20 UTC になりますが、JavaScript等の13桁数値（1700000000000）を秒として読むと西暦55901年になってしまいます。年号が極端に未来に飛んだときは単位を「ミリ秒」に切り替えてください。
    </p>
  </section>

  <section id="common-mistakes">
    <h2>よくある誤解と関連ツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="タイムスタンプを最初からローカル時間だと思う">
      <p>Unix時間は常にUTC基準です。まずUTCで日時を確認してからローカル時刻に変換すると時差ミスを防げます。</p>
    </ReferenceBlock>
    <p>
      日付同士の日数を数えたい場合は <a href={toolPathBySlug('date-difference-calculator', 'ja')}>日付差分計算ツール</a>、生年月日計算には <a href={toolPathBySlug('age-calculator', 'ja')}>年齢計算ツール</a> も役立ちます。
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
