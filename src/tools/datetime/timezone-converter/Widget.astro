---
// Timezone Converter — a thin wrapper over the shared DateTimeWidget. Tool logic lives in the datetime
// engine (src/lib/engines/datetime/calculators/timezone.ts), resolved at runtime via ToyTools.runDateTime.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
---

<DateTimeWidget slug={config.slug} dateTimeId="timezone" config={config} emptyText="Enter a date and time and pick two timezones to convert between them." />
