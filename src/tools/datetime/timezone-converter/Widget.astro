---
// Timezone Converter — a thin wrapper over the shared DateTimeWidget. Tool logic lives in the datetime
// engine (src/lib/engines/datetime/calculators/timezone.ts), resolved at runtime via ToyTools.runDateTime.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { uiStr } from '@lib/i18n/widget-utils';

interface Props { lang?: LocaleCode; pack?: LocalizedToolPack | null; }
const { lang = 'en', pack = null } = Astro.props;
---

<DateTimeWidget slug={config.slug} dateTimeId="timezone" config={config} craftOn="hero-note" emptyText={uiStr(pack, "emptyText", "Enter a date and time and pick two timezones to convert between them.")} lang={lang} pack={pack} />
