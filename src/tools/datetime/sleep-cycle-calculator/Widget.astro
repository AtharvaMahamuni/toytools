---
// Sleep Cycle Calculator — thin DateTimeWidget wrapper. The cycle arithmetic lives in
// src/lib/engines/datetime/calculators/sleep.ts.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { uiStr } from '@lib/i18n/widget-utils';

interface Props { lang?: LocaleCode; pack?: LocalizedToolPack | null; }
const { lang = 'en', pack = null } = Astro.props;
---

<DateTimeWidget
  slug={config.slug}
  dateTimeId="sleep"
  config={config}
  craftOn="hero-note"
  emptyText={uiStr(pack, "emptyText", "Enter a wake time or a bedtime to see the other end of the night.")} lang={lang} pack={pack}
/>
