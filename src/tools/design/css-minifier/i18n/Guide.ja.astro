---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>概要（クイック回答） <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      CSS 圧縮・整形ツールは、コメントと余白を削って配信サイズを小さくする「Minify」と、1行に圧縮されたスタイルシートを2スペースインデントに展開する「Beautify」をブラウザ内で切り替えて実行し、削減バイト数も表示します。
    </p>
    <a href={toolHref} class="cta-link">CSS 圧縮・整形ツールを開く →</a>
  </section>

  <section id="safety">
    <h2>壊れにくい安全な字句処理 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      文字列中の空白、<code>url()</code>、CSSカスタムプロパティ、<code>calc()</code> 内の演算子はそのまま保護し、セレクタの結合や勝手なルール削除は行いません。
    </p>
    <ReferenceBlock type="key-idea" heading="編集用は整形・公開用は圧縮">
      <p>リポジトリには読みやすい整形済みCSSを保存し、本番配布用のファイルだけを圧縮して運用しましょう。</p>
    </ReferenceBlock>
  </section>

  <section id="related-tools">
    <h2>関連ツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      単位調整には <a href={toolPathBySlug('px-to-rem-converter', 'ja')}>PX・REM変換ツール</a>、データ圧縮には <a href={toolPathBySlug('json-minifier', 'ja')}>JSON 圧縮ツール</a> もご利用いただけます。
    </p>
  </section>
</GuideLayout>
