---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      El Minificador y Embellecedor CSS reduce tus hojas de estilo eliminando comentarios y espacios innecesarios para producción, o expande CSS comprimido en bloques legibles de dos espacios, todo en local y mostrando exactamente cuántos bytes ahorras.
    </p>
    <a href={toolHref} class="cta-link">Abrir Minificador CSS →</a>
  </section>

  <section id="que-es-seguro">
    <h2>Qué elimina y qué mantiene intacto <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      El procesador trabaja por tokens respetando cadenas entre comillas, funciones <code>url()</code>, propiedades personalizadas y fórmulas <code>calc()</code> sin reescribir selectores ni mezclar reglas.
    </p>
    <ReferenceBlock type="key-idea" heading="Embellece para editar, minifica para publicar">
      <p>Conserva siempre la versión con sangría en tu repositorio y minifica solo la copia final de entrega.</p>
    </ReferenceBlock>
  </section>

  <section id="herramientas-relacionadas">
    <h2>Herramientas relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Si ajustas tipografías o espaciado antes de publicar, usa <a href={toolPathBySlug('px-to-rem-converter', 'es')}>Conversor PX a REM</a>, y para datos compactos <a href={toolPathBySlug('json-minifier', 'es')}>Minificador JSON</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
