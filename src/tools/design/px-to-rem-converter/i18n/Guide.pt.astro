---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para converter pixels em <code>rem</code>, divida o valor em <code>px</code> pelo tamanho de fonte da raiz (<code>html</code>), cujo padrão dos navegadores é <code>16 px</code>. Definir fontes e margens em <code>rem</code> faz toda a interface escalar proporcionalmente quando o usuário altera o tamanho de leitura no navegador.
    </p>
    <a href={toolHref} class="cta-link">Abrir Conversor PX para REM →</a>
  </section>

  <section id="rem-vs-em-e-pt">
    <h2>Diferença prática entre REM, EM e PT <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Enquanto <code>rem</code> sempre aponta para a raiz, <code>em</code> acompanha a fonte do elemento atual e pode acumular multiplicadores ao aninhar caixas. Em especificações gráficas, CSS define <code>1 pol = 96 px = 72 pt</code>, logo <code>12 pt</code> correspondem exatamente a <code>16 px</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Atenção à técnica dos 62,5%">
      <p>Caso utilize <code>html &#123; font-size: 62.5%; &#125;</code> para trabalhar com <code>1 rem = 10 px</code>, ajuste a base raiz para 10 neste conversor.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas complementares de CSS e layout <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Calcule proporções de tela na <a href={toolPathBySlug('aspect-ratio-calculator', 'pt')}>Calculadora de Proporção de Tela</a>, reduza seu CSS no <a href={toolPathBySlug('css-minifier', 'pt')}>Minificador CSS</a>, monte escalas de títulos no <a href={toolPathBySlug('type-scale-generator')}>Type Scale Generator</a> ou converta para Android no <a href={toolPathBySlug('px-to-dp-converter')}>PX to DP Converter</a>.
    </p>
  </section>
</GuideLayout>
