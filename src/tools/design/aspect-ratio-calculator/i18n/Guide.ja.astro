---
import GuideLayout from '@layouts/GuideLayout.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="ja"
>
  <section id="overview">
    <h2>概要 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      アスペクト比とは画像の「幅」と「高さ」の相対的な割合（16:9 など）を表します。絶対サイズ（px）とは異なり、1280×720 でも 1920×1080 でも同じ 16:9 の形になります。この計算機は選んだ比率をロックし、片方の数値からもう一方を歪みなく算出します。
    </p>
    <a href={toolHref} class="cta-link">アスペクト比計算機を開く →</a>
  </section>

  <section id="formulas">
    <h2>計算公式と具体例 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      比率 W:H に対して <code>高さ = 幅 × H ÷ W</code>、<code>幅 = 高さ × W ÷ H</code> で計算します。16:9 で幅 1600px なら高さは 900px、21:9 で幅 1400px なら高さは 600px になります。動画出力時は奇数ピクセルだとH.264等のエンコーダがエラーを出すため偶数サイズを選ぶのが安全です。
    </p>
  </section>

  <section id="common-ratios">
    <h2>用途別の代表的な比率 <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>16:9:</strong> YouTube・テレビ・PCモニターの標準</li>
      <li><strong>9:16:</strong> スマホ縦動画（ショート・リール・TikTok）</li>
      <li><strong>3:2 / 4:3:</strong> デジタル一眼カメラ写真・iPad画面</li>
      <li><strong>1:1:</strong> SNSアイコンや正方形カード</li>
    </ul>
    <p>
      Webデザイン用に算出したピクセル値をCSSの相対単位へ変換したい場合は <a href={toolPathBySlug('px-to-rem-converter', 'ja')}>PX・REM変換ツール</a> も併用できます。
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
