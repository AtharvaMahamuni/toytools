---
import GuideLayout from '@layouts/GuideLayout.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="pt"
>
  <section id="resumo">
    <h2>Resumo <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Aspect ratio é a relação proporcional entre largura e altura (como 16:9). Tanto 1280×720 quanto 1920×1080 têm a mesma proporção 16:9. Esta calculadora trava a proporção escolhida e resolve a medida faltante instantaneamente sem deformar imagens ou vídeos.
    </p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Proporção →</a>
  </section>

  <section id="formulas">
    <h2>Como funcionam as fórmulas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para uma razão L:A, <code>altura = largura × A ÷ L</code> e <code>largura = altura × L ÷ A</code>. Por exemplo, em 16:9 com 1600 px de largura, a altura correta é 900 px. Em exportações H.264/MP4, prefira dimensões inteiras pares para evitar falhas de codificação.
    </p>
  </section>

  <section id="usos">
    <h2>Formatos populares e conversão CSS <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>16:9 e 21:9:</strong> vídeos, YouTube e monitores largos.</li>
      <li><strong>9:16 e 1:1:</strong> Reels, Shorts e feeds sociais.</li>
      <li><strong>3:2 e 4:3:</strong> fotografia tradicional e telas clássicas.</li>
    </ul>
    <p>
      Para transformar pixels de layout em unidades escaláveis de CSS, veja o <a href={toolPathBySlug('px-to-rem-converter', 'pt')}>Conversor PX para REM</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
