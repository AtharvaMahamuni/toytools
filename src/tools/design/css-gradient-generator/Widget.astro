---
import ToolSplit from '@tools/_shared/ToolSplit.astro';
import IoPanel from '@tools/_shared/IoPanel.astro';
import CraftNote from '@tools/_shared/CraftNote.astro';
---

<div class="calc-ledger" data-tool="css-gradient-generator">
  <ToolSplit ratio="1-1" stackOrder="output-first" stickyOutput={false} equalHeight={false}>
    <IoPanel slot="input" label="Stops" variant="prose" bare>
      <div class="io-body">
        <div class="grad-field">
          <label class="widget-label" for="css-gradient-generator-from">Start</label>
          <div class="grad-row">
            <input
              id="css-gradient-generator-from"
              class="widget-input"
              type="text"
              inputmode="text"
              enterkeyhint="done"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              autocomplete="off"
              value="#0000ff"
              placeholder="#0000ff"
            />
            <input id="css-gradient-generator-from-picker" class="grad-picker" type="color" value="#0000ff" aria-label="Pick the start color" />
          </div>
        </div>
        <div class="grad-field">
          <label class="widget-label" for="css-gradient-generator-to">End</label>
          <div class="grad-row">
            <input
              id="css-gradient-generator-to"
              class="widget-input"
              type="text"
              inputmode="text"
              enterkeyhint="done"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              autocomplete="off"
              value="#ffff00"
              placeholder="#ffff00"
            />
            <input id="css-gradient-generator-to-picker" class="grad-picker" type="color" value="#ffff00" aria-label="Pick the end color" />
          </div>
        </div>
        <p class="grad-help">HEX, RGB, HSL, or a CSS color name. The blend is in OKLCH.</p>
        <p class="grad-error" id="css-gradient-generator-error" hidden></p>
      </div>
    </IoPanel>

    <IoPanel slot="output" label="Gradient" variant="mono" result bare>
      <div class="io-body">
        <div
          class="grad-strip"
          id="css-gradient-generator-strip"
          role="img"
          aria-label="Sampled OKLCH gradient"
          style="background: linear-gradient(to right, #0000ff, #ffff00)"
        ></div>
        <div class="grad-stops" id="css-gradient-generator-stops"></div>
        <CraftNote id="css-gradient-generator-note" craftId="oklch-srgb-mid" />
        <pre class="grad-css" id="css-gradient-generator-css"></pre>
      </div>
    </IoPanel>
  </ToolSplit>
</div>

<div class="tool-actions">
  <button class="action-btn action-btn--copy" id="css-gradient-generator-copy" data-label="Copy CSS" type="button">Copy CSS</button>
</div>

<script is:inline>
  (function () {
    var fromEl = document.getElementById('css-gradient-generator-from');
    var toEl = document.getElementById('css-gradient-generator-to');
    var fromPicker = document.getElementById('css-gradient-generator-from-picker');
    var toPicker = document.getElementById('css-gradient-generator-to-picker');
    var stripEl = document.getElementById('css-gradient-generator-strip');
    var stopsEl = document.getElementById('css-gradient-generator-stops');
    var cssEl = document.getElementById('css-gradient-generator-css');
    var errEl = document.getElementById('css-gradient-generator-error');
    var noteEl = document.getElementById('css-gradient-generator-note');
    var noteTxt = document.getElementById('css-gradient-generator-note-text');
    var copyBtn = document.getElementById('css-gradient-generator-copy');
    if (!fromEl || !toEl || !stripEl || !stopsEl || !cssEl) return;

    var css = '';

    function showNote(message) {
      if (!noteEl || !noteTxt) return;
      if (!message) { noteEl.hidden = true; noteTxt.textContent = ''; return; }
      noteTxt.textContent = message;
      noteEl.hidden = false;
    }

    function paintPicker(picker, hex) {
      if (picker && /^#[0-9a-f]{6}$/i.test(hex)) picker.value = hex;
    }

    function render() {
      var TT = window.ToyTools;
      if (!TT || !TT.color || !TT.color.perceptualGradient) return;
      var result = TT.color.perceptualGradient(fromEl.value.trim(), toEl.value.trim());
      if (!result.ok) {
        errEl.hidden = false;
        errEl.textContent = result.error || 'Enter two colors.';
        css = '';
        cssEl.textContent = '';
        showNote('');
        stopsEl.replaceChildren();
        return;
      }
      errEl.hidden = true;
      errEl.textContent = '';
      css = result.css;
      cssEl.textContent = css;
      stripEl.style.background = result.fallbackCss;
      showNote(result.note);
      paintPicker(fromPicker, result.fromHex);
      paintPicker(toPicker, result.toHex);
      stopsEl.replaceChildren();
      result.samples.forEach(function (sample) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'grad-stop';
        btn.style.backgroundColor = sample.hex;
        btn.textContent = sample.hex;
        btn.addEventListener('click', function () {
          if (TT.copy) TT.copy(sample.hex);
        });
        stopsEl.appendChild(btn);
      });
    }

    function bindPair(text, picker) {
      text.addEventListener('input', render);
      if (!picker) return;
      picker.addEventListener('input', function () {
        text.value = picker.value;
        render();
      });
    }

    bindPair(fromEl, fromPicker);
    bindPair(toEl, toPicker);
    if (copyBtn) copyBtn.addEventListener('click', function () {
      var TT = window.ToyTools;
      if (css && TT && TT.copy) TT.copy(css);
    });

    function boot() { render(); }
    var TT = window.ToyTools;
    if (TT && TT.onReady) TT.onReady(boot); else boot();
  })();
</script>

<style>
  .grad-field + .grad-field { margin-top: var(--space-3); }
  .grad-row { display: flex; gap: var(--space-2); align-items: stretch; }
  .grad-row .widget-input { flex: 1 1 auto; min-width: 0; }
  .grad-picker {
    flex: 0 0 auto;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
  }
  .grad-picker:active { transform: translateY(1px); }
  .grad-help { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }
  .grad-error { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-danger); }
  .grad-error[hidden] { display: none; }
  .grad-strip {
    aspect-ratio: 8 / 1;
    inline-size: 100%;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .grad-stops {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    overflow-x: auto;
  }
  .grad-stops :global(.grad-stop) {
    flex: 1 0 4.75rem;
    min-block-size: var(--touch-target);
    padding: var(--space-2);
    border: var(--border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    cursor: pointer;
  }
  .grad-stops :global(.grad-stop:active) { transform: translateY(1px); }
  .grad-css {
    margin: var(--space-3) 0 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
    white-space: pre;
  }
</style>
