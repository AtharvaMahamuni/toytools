---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Auch auf UTF-8-Seiten müssen die syntaktischen HTML-Zeichen <code>&lt;</code> (<code>&amp;lt;</code>), <code>&gt;</code> (<code>&amp;gt;</code>), <code>&amp;</code> (<code>&amp;amp;</code>) sowie Anführungszeichen in Attributen (<code>&amp;quot;</code> und <code>&amp;#39;</code>) immer maskiert werden, um falsches Tag-Parsing und XSS-Angriffe zu verhindern.
    </p>
    <a href={toolHref} class="cta-link">HTML-Entitäten Encoder öffnen →</a>
  </section>

  <section id="referenzformen">
    <h2>Benannte vs. numerische Referenzen & Kontextgrenzen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      <code>&amp;amp;</code>, <code>&amp;#38;</code> und <code>&amp;#x26;</code> ergeben identisch das Zeichen <code>&amp;</code>. Beachte zudem: HTML-Entitäten schützen Textknoten und normale Attribute, während <code>&lt;script&gt;</code>-Blöcke, CSS-Styles oder <code>href</code>-Links eigene Schutzregeln brauchen.
    </p>
    <ReferenceBlock type="key-idea" heading="&amp; immer zuerst maskieren">
      <p>Ersetze das kaufmännische Und stets vor spitzen Klammern, um Doppelmaskierung zu vermeiden, und bevorzuge <code>&amp;#39;</code> vor <code>&amp;apos;</code> für ältere HTML-Parser.</p>
    </ReferenceBlock>
  </section>

  <section id="verwandte-tools">
    <h2>Passende Werkzeuge für Entwickler <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Für sichere Link-Parameter nutze den <a href={toolPathBySlug('url-encoder-decoder', 'de')}>URL-Encoder</a>, für Binärdaten den <a href={toolPathBySlug('base64-encoder-decoder', 'de')}>Base64-Encoder</a> und für Strings in JSON-Dateien <a href={toolPathBySlug('json-escape')}>JSON Escape</a>.
    </p>
  </section>
</GuideLayout>
