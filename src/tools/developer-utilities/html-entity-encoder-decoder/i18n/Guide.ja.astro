---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>結論とポイント <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      UTF-8のページであっても、HTML構文上の予約記号である <code>&lt;</code>（<code>&amp;lt;</code>）、<code>&gt;</code>（<code>&amp;gt;</code>）、<code>&amp;</code>（<code>&amp;amp;</code>）、および属性内の引用符（<code>&amp;quot;</code>・<code>&amp;#39;</code>）は必ずエスケープが必要です。これによりユーザー入力がタグやXSSスクリプトとして解釈されるのを防ぎます。
    </p>
    <a href={toolHref} class="cta-link">HTMLエンティティ変換ツールを開く →</a>
  </section>

  <section id="named-vs-numeric">
    <h2>名前付き参照と数値文字参照・XSSの境界 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      <code>&amp;amp;</code>・<code>&amp;#38;</code>・<code>&amp;#x26;</code> はいずれも同じ <code>&amp;</code> を出力します。ただしHTMLエンティティ化が守るのは通常のHTMLテキストと属性値であり、<code>&lt;script&gt;</code> 内・CSS <code>style</code>・<code>href</code> URLには各文脈別の対策が必要です。
    </p>
    <ReferenceBlock type="key-idea" heading="&amp; を最初に変換するのが鉄則">
      <p>自前で置換処理を書く際は必ず <code>&amp;</code> を最初に変換して二重エスケープを防ぎ、古いHTML互換には <code>&amp;apos;</code> より <code>&amp;#39;</code> を選びましょう。</p>
    </ReferenceBlock>
  </section>

  <section id="related-tools">
    <h2>関連する変換・エスケープツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      リンクのクエリ文字列処理には <a href={toolPathBySlug('url-encoder-decoder', 'ja')}>URLエンコードツール</a>、バイナリ表現には <a href={toolPathBySlug('base64-encoder-decoder', 'ja')}>Base64変換ツール</a>、JSON文字列リテラルのエスケープには <a href={toolPathBySlug('json-escape')}>JSON Escape</a> も便利です。
    </p>
  </section>
</GuideLayout>
