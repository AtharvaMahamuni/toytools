---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>結論とポイント <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Base64は任意のバイナリデータを64個の印字可能ASCII文字（<code>A–Z</code>, <code>a–z</code>, <code>0–9</code>, <code>+</code>, <code>/</code>）に変換する方式で、JSONやHTTPヘッダー、メールなどテキスト前提の経路を安全に通すために使われます。鍵不要で誰でも元に戻せるため、暗号化にはなりません。
    </p>
    <a href={toolHref} class="cta-link">Base64変換ツールを開く →</a>
  </section>

  <section id="padding-and-base64url">
    <h2>末尾の「=」、約33%サイズ増、Base64URLの違い <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      3バイトごとに4文字へ変換されるためデータ量は約33%増え、端数が出る場合は末尾に1〜2個の <code>=</code> が付きます。JWTやURLパラメータでは記号衝突を避けるため <code>+</code> を <code>-</code>、<code>/</code> を <code>_</code> に替えたBase64URLが使われます。
    </p>
    <ReferenceBlock type="key-idea" heading="エンコーディングと暗号化を混同しない">
      <p>Base64文字列は誰でも即座にデコードできます。パスワードやトークンの機密保護には必ずHTTPS/TLSやAES暗号化を使用してください。</p>
    </ReferenceBlock>
  </section>

  <section id="related-tools">
    <h2>開発ワークフローで併用されるツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      デコードしたJSONの整形には <a href={toolPathBySlug('json-formatter', 'ja')}>JSON整形ツール</a>、URLパラメータの安全な変換には <a href={toolPathBySlug('url-encoder-decoder', 'ja')}>URLエンコードツール</a>、JWT全体の中身確認には <a href={toolPathBySlug('jwt-decoder')}>JWT Decoder</a>、HTMLエスケープには <a href={toolPathBySlug('html-entity-encoder-decoder', 'ja')}>HTMLエンティティ変換</a> をご利用ください。
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
