---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Base64 transforma cualquier secuencia de bytes en 64 caracteres ASCII imprimibles (<code>A–Z</code>, <code>a–z</code>, <code>0–9</code>, <code>+</code>, <code>/</code>) para viajar por canales diseñados solo para texto como JSON, cabeceras HTTP o correo electrónico. Es completamente reversible sin clave, así que nunca sustituye al cifrado.
    </p>
    <a href={toolHref} class="cta-link">Abrir Codificador Base64 →</a>
  </section>

  <section id="relleno-y-base64url">
    <h2>Signos "=", expansión del 33 % y Base64URL <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Cada grupo de 3 bytes se convierte en 4 caracteres ASCII, lo que aumenta el tamaño un 33 % aproximado y añade uno o dos signos <code>=</code> al final cuando la entrada no es múltiplo de 3. En URLs y tokens JWT se usa Base64URL reemplazando <code>+</code> por <code>-</code> y <code>/</code> por <code>_</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Codificación no es cifrado">
      <p>Cualquier persona o sistema que intercepte una cadena Base64 puede leerla en milisegundos. Protege secretos reales siempre con TLS, AES o HMAC.</p>
    </ReferenceBlock>
  </section>

  <section id="herramientas-relacionadas">
    <h2>Flujo de trabajo habitual con Base64 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Si estás depurando un payload JSON decodificado formatéalo en el <a href={toolPathBySlug('json-formatter', 'es')}>Formateador JSON</a>, escapa valores para direcciones web con el <a href={toolPathBySlug('url-encoder-decoder', 'es')}>Codificador URL</a>, inspecciona tokens completos en <a href={toolPathBySlug('jwt-decoder')}>JWT Decoder</a> o escapa texto HTML en <a href={toolPathBySlug('html-entity-encoder-decoder', 'es')}>Codificador de Entidades HTML</a>.
    </p>
  </section>
</GuideLayout>
