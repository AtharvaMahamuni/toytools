---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Base64 converte qualquer conjunto de bytes em 64 caracteres ASCII seguros (<code>A–Z</code>, <code>a–z</code>, <code>0–9</code>, <code>+</code>, <code>/</code>) para atravessar canais textuais como JSON, cabeçalhos HTTP ou SMTP. Como qualquer pessoa decodifica sem chave, nunca serve para proteger dados.
    </p>
    <a href={toolHref} class="cta-link">Abrir Codificador Base64 →</a>
  </section>

  <section id="padding-e-base64url">
    <h2>Sinais "=", aumento de 33% e Base64URL <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      A cada 3 bytes geram-se 4 caracteres (~33% a mais de espaço), adicionando um ou dois <code>=</code> no final quando não fecha múltiplo de 3. Em URLs e tokens JWT usa-se o Base64URL trocando <code>+</code> por <code>-</code> e <code>/</code> por <code>_</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Codificação não é criptografia">
      <p>Base64 é totalmente reversível sem senha. Para confidencialidade real proteja seus dados com HTTPS/TLS ou algoritmos como AES.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Fluxo comum entre ferramentas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Formate payloads JSON decodificados no <a href={toolPathBySlug('json-formatter', 'pt')}>Formatador JSON</a>, escape parâmetros de links com o <a href={toolPathBySlug('url-encoder-decoder', 'pt')}>Codificador URL</a>, inspecione tokens no <a href={toolPathBySlug('jwt-decoder')}>JWT Decoder</a> ou converta entidades no <a href={toolPathBySlug('html-entity-encoder-decoder', 'pt')}>Codificador de Entidades HTML</a>.
    </p>
  </section>
</GuideLayout>
