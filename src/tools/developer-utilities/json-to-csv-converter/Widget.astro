---
import IoPanel from '@tools/_shared/IoPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import { config } from './config';
---

<div class="jcsv-widget">
  <IoPanel label="JSON Input" labelFor="jcsv-input" variant="mono">
    <textarea
      id="jcsv-input"
      placeholder={'[\n  {\n    "name": "Alice",\n    "age": 30,\n    "city": "New York"\n  },\n  {\n    "name": "Bob",\n    "age": 28,\n    "city": "Los Angeles"\n  }\n]'}
      spellcheck="false"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
    ></textarea>
  </IoPanel>

  <div class="tool-actions">
    <button id="jcsv-convert" class="action-btn jcsv-btn-primary" type="button">Convert</button>
    <button id="jcsv-example" class="action-btn" type="button">Load Example</button>
    <button id="jcsv-clear" class="action-btn action-btn--clear" type="button" data-label="Clear">Clear</button>
  </div>

  <div id="jcsv-error" class="jcsv-error" hidden></div>

  <section id="jcsv-structure" class="jcsv-section" hidden aria-label="Detected Structure">
    <span class="jcsv-section-title">Detected Structure</span>
    <div class="jcsv-stats">
      <div class="jcsv-stat">
        <span class="jcsv-stat-value" id="jcsv-rows">0</span>
        <span class="jcsv-stat-label">Rows</span>
      </div>
      <div class="jcsv-stat">
        <span class="jcsv-stat-value" id="jcsv-col-count">0</span>
        <span class="jcsv-stat-label">Columns</span>
      </div>
      <div class="jcsv-stat">
        <span class="jcsv-stat-value" id="jcsv-size">0 B</span>
        <span class="jcsv-stat-label">Output Size</span>
      </div>
    </div>
    <div id="jcsv-nested-note" class="jcsv-nested-note" hidden>
      <span class="jcsv-tag">Nested fields flattened with dot notation</span>
    </div>
  </section>

  <section id="jcsv-columns" class="jcsv-section" hidden aria-label="Column Selection">
    <div class="jcsv-columns-hdr">
      <span class="jcsv-section-title">Columns</span>
      <div class="jcsv-sort-pills" role="group" aria-label="Column order">
        <button id="jcsv-sort-none" class="jcsv-sort-pill jcsv-sort-pill--active" type="button" data-sort="none" aria-pressed="true">Original</button>
        <button id="jcsv-sort-asc" class="jcsv-sort-pill" type="button" data-sort="asc" aria-pressed="false">A–Z</button>
        <button id="jcsv-sort-desc" class="jcsv-sort-pill" type="button" data-sort="desc" aria-pressed="false">Z–A</button>
      </div>
    </div>
    <div id="jcsv-check-list" class="jcsv-check-list" role="group" aria-label="Select columns to include"></div>
  </section>

  <section id="jcsv-preview" class="jcsv-section" hidden aria-label="CSV Preview">
    <div class="jcsv-preview-hdr">
      <span class="jcsv-section-title">Preview</span>
      <span class="jcsv-section-note">First 5 rows</span>
    </div>
    <div class="jcsv-table-wrap">
      <table id="jcsv-table" class="jcsv-table"></table>
    </div>
  </section>

  <section id="jcsv-output-section" class="jcsv-section jcsv-output-section" hidden aria-label="CSV Output">
    <span class="jcsv-section-title">CSV Output</span>
    <textarea id="jcsv-output" class="jcsv-output" readonly spellcheck="false" aria-label="CSV output"></textarea>
    <div class="tool-actions jcsv-output-actions">
      <button id="jcsv-copy" class="action-btn action-btn--copy" type="button" data-label="Copy CSV">Copy CSV</button>
      <button id="jcsv-download" class="action-btn" type="button">Download CSV</button>
    </div>
  </section>
</div>

<CategoryDiscovery toolSlug={config.slug} />

<style is:global>
  .jcsv-widget {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .jcsv-widget .io-panel {
    min-height: 300px;
  }

  .jcsv-btn-primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
    border-color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  .jcsv-btn-primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-inverse);
  }

  .jcsv-error {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-danger);
    border-radius: var(--radius-md);
    background: var(--color-danger-bg);
    color: var(--color-danger);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-line;
  }
  .jcsv-error[hidden] { display: none; }

  .jcsv-section {
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .jcsv-section[hidden] { display: none; }

  .jcsv-section-title {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .jcsv-section-note {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-normal);
    text-transform: none;
    letter-spacing: 0;
  }

  .jcsv-stats {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .jcsv-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .jcsv-stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .jcsv-stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .jcsv-nested-note[hidden] { display: none; }

  .jcsv-tag {
    display: inline-block;
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
    border: var(--border);
  }

  .jcsv-columns-hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .jcsv-sort-pills {
    display: flex;
    border: var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }
  .jcsv-sort-pill {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: none;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
    min-height: 32px;
  }
  .jcsv-sort-pill:not(:last-child) {
    border-right: var(--border);
  }
  .jcsv-sort-pill--active,
  .jcsv-sort-pill[aria-pressed="true"] {
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
    font-weight: var(--font-weight-semibold);
  }
  .jcsv-sort-pill:hover:not(.jcsv-sort-pill--active):not([aria-pressed="true"]) {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .jcsv-check-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .jcsv-chip {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color 150ms, background-color 150ms;
    user-select: none;
  }
  .jcsv-chip input[type="checkbox"] {
    cursor: pointer;
    accent-color: var(--color-accent);
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .jcsv-chip:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .jcsv-preview-hdr {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .jcsv-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: var(--border);
    border-radius: var(--radius-sm);
  }

  .jcsv-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .jcsv-table th {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    font-weight: var(--font-weight-semibold);
    background: var(--color-surface);
    border-bottom: var(--border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .jcsv-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border);
    color: var(--color-text);
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .jcsv-table tr:last-child td {
    border-bottom: none;
  }

  .jcsv-table td.jcsv-empty-cell {
    color: var(--color-text-subtle);
  }

  .jcsv-output-section {
    gap: var(--space-3);
  }

  .jcsv-output {
    display: block;
    width: 100%;
    min-height: 200px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    resize: vertical;
    font-variant-ligatures: none;
  }

  .jcsv-output-actions {
    padding-block: 0;
  }
</style>

<script is:inline>
(function () {
  var slug = 'json-to-csv-converter';
  var GROUP_KEY = 'group:json-csv';
  var TT = window.ToyTools;

  var inputEl      = document.getElementById('jcsv-input');
  var convertBtn   = document.getElementById('jcsv-convert');
  var exampleBtn   = document.getElementById('jcsv-example');
  var clearBtn     = document.getElementById('jcsv-clear');
  var errorEl      = document.getElementById('jcsv-error');
  var structEl     = document.getElementById('jcsv-structure');
  var rowsEl       = document.getElementById('jcsv-rows');
  var colCountEl   = document.getElementById('jcsv-col-count');
  var sizeEl       = document.getElementById('jcsv-size');
  var nestedNote   = document.getElementById('jcsv-nested-note');
  var columnSect   = document.getElementById('jcsv-columns');
  var checkList    = document.getElementById('jcsv-check-list');
  var sortNoneBtn  = document.getElementById('jcsv-sort-none');
  var sortAscBtn   = document.getElementById('jcsv-sort-asc');
  var sortDescBtn  = document.getElementById('jcsv-sort-desc');
  var previewEl    = document.getElementById('jcsv-preview');
  var tableEl      = document.getElementById('jcsv-table');
  var outputSect   = document.getElementById('jcsv-output-section');
  var outputEl     = document.getElementById('jcsv-output');
  var copyBtn      = document.getElementById('jcsv-copy');
  var downloadBtn  = document.getElementById('jcsv-download');

  if (!inputEl || !convertBtn) return;

  var flatRows = [];
  var allHeaders = [];        // currently displayed header order (respects sortMode)
  var originalHeaders = [];   // union order from the source JSON (the "Original" / undo state)
  var sortMode = 'none';      // 'none' | 'asc' | 'desc'

  // Recursively flatten a plain object using dot-notation keys.
  function flattenObj(obj, prefix) {
    var out = {};
    var keys = Object.keys(obj);
    for (var ki = 0; ki < keys.length; ki++) {
      var k = keys[ki];
      var val = obj[k];
      var key = prefix ? prefix + '.' + k : k;
      if (val !== null && typeof val === 'object' && !Array.isArray(val)) {
        var sub = flattenObj(val, key);
        var subKeys = Object.keys(sub);
        for (var si = 0; si < subKeys.length; si++) out[subKeys[si]] = sub[subKeys[si]];
      } else {
        out[key] = val;
      }
    }
    return out;
  }

  // True if any row in the original (pre-flatten) array has a nested object value.
  function hasNestedObjects(arr) {
    for (var i = 0; i < arr.length; i++) {
      var item = arr[i];
      if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
        var vals = Object.values(item);
        for (var j = 0; j < vals.length; j++) {
          if (vals[j] !== null && typeof vals[j] === 'object' && !Array.isArray(vals[j])) return true;
        }
      }
    }
    return false;
  }

  function escapeCell(value) {
    if (value === null || value === undefined) return '';
    var str = typeof value === 'object' ? JSON.stringify(value) : String(value);
    if (str.indexOf(',') !== -1 || str.indexOf('"') !== -1 || str.indexOf('\n') !== -1 || str.indexOf('\r') !== -1)
      return '"' + str.replace(/"/g, '""') + '"';
    return str;
  }

  function escHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function getSelectedHeaders() {
    if (!checkList) return allHeaders.slice();
    var inputs = checkList.querySelectorAll('input[type="checkbox"]');
    var result = [];
    for (var i = 0; i < inputs.length; i++) {
      if (inputs[i].checked) result.push(inputs[i].value);
    }
    return result;
  }

  function buildCsv(rows, headers) {
    if (!headers.length || !rows.length) return '';
    var lines = [headers.map(escapeCell).join(',')];
    for (var ri = 0; ri < rows.length; ri++) {
      lines.push(headers.map(function (h) { return escapeCell(rows[ri][h]); }).join(','));
    }
    return lines.join('\n');
  }

  function renderTable(rows, headers) {
    if (!tableEl) return;
    if (!headers.length) { tableEl.innerHTML = ''; return; }
    var slice = rows.slice(0, 5);
    var html = '<thead><tr>';
    for (var hi = 0; hi < headers.length; hi++) html += '<th>' + escHtml(headers[hi]) + '</th>';
    html += '</tr></thead><tbody>';
    for (var ri = 0; ri < slice.length; ri++) {
      html += '<tr>';
      for (var ci = 0; ci < headers.length; ci++) {
        var v = slice[ri][headers[ci]];
        var empty = (v === null || v === undefined || v === '');
        html += empty
          ? '<td class="jcsv-empty-cell"></td>'
          : '<td>' + escHtml(String(v)) + '</td>';
      }
      html += '</tr>';
    }
    html += '</tbody>';
    tableEl.innerHTML = html;
  }

  // Render the column checkboxes. `keep` is an optional set of header names to leave
  // checked (used to preserve the user's selection across a re-sort); when omitted all
  // columns start checked.
  function renderCheckboxes(headers, keep) {
    if (!checkList) return;
    checkList.innerHTML = '';
    for (var i = 0; i < headers.length; i++) {
      (function (h) {
        var lbl = document.createElement('label');
        lbl.className = 'jcsv-chip';
        var inp = document.createElement('input');
        inp.type = 'checkbox';
        inp.value = h;
        inp.checked = keep ? keep.indexOf(h) !== -1 : true;
        inp.addEventListener('change', rebuildOutput);
        lbl.appendChild(inp);
        lbl.appendChild(document.createTextNode(h));
        checkList.appendChild(lbl);
      })(headers[i]);
    }
  }

  // Reorder originalHeaders per the active sort mode.
  function orderedHeaders() {
    if (sortMode === 'asc') return originalHeaders.slice().sort();
    if (sortMode === 'desc') return originalHeaders.slice().sort().reverse();
    return originalHeaders.slice();
  }

  function setSort(mode) {
    sortMode = mode;
    var map = { none: sortNoneBtn, asc: sortAscBtn, desc: sortDescBtn };
    Object.keys(map).forEach(function (k) {
      var btn = map[k];
      if (!btn) return;
      var on = (k === mode);
      btn.classList.toggle('jcsv-sort-pill--active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (!originalHeaders.length) { persist(); return; }
    var keep = getSelectedHeaders(); // preserve current selection across the re-sort
    allHeaders = orderedHeaders();
    renderCheckboxes(allHeaders, keep);
    rebuildOutput();
    persist();
  }

  // Carry the current CSV output forward to the sibling (CSV → JSON) page.
  function updateHandoff(csv) {
    if (TT && TT.state && csv && csv.trim()) {
      TT.state.save(GROUP_KEY, { handoff: csv, from: slug });
    }
  }

  function rebuildOutput() {
    var selected = getSelectedHeaders();
    var csv = buildCsv(flatRows, selected);
    if (outputEl) outputEl.value = csv;
    if (sizeEl) sizeEl.textContent = csv ? formatBytes(new TextEncoder().encode(csv).length) : '0 B';
    renderTable(flatRows, selected);
    updateHandoff(csv);
  }

  function showError(msg) {
    if (errorEl) { errorEl.textContent = msg; errorEl.hidden = false; }
    if (structEl) structEl.hidden = true;
    if (columnSect) columnSect.hidden = true;
    if (previewEl) previewEl.hidden = true;
    if (outputSect) outputSect.hidden = true;
  }

  function clearResults() {
    if (errorEl) errorEl.hidden = true;
    if (structEl) structEl.hidden = true;
    if (columnSect) columnSect.hidden = true;
    if (previewEl) previewEl.hidden = true;
    if (outputSect) outputSect.hidden = true;
  }

  function convert() {
    var raw = inputEl.value.trim();
    if (!raw) { clearResults(); return; }

    var parsed;
    try { parsed = JSON.parse(raw); }
    catch (_) {
      showError('Invalid JSON — check for missing commas, quotes, or brackets.');
      return;
    }

    if (!Array.isArray(parsed)) {
      var t = parsed === null ? 'null' : typeof parsed;
      showError('Expected a JSON array. Got: ' + t + '.\n\nExample:\n[\n  { ... },\n  { ... }\n]');
      return;
    }

    if (parsed.length === 0) {
      showError('Array is empty — add at least one item to generate CSV.');
      return;
    }

    if (errorEl) errorEl.hidden = true;

    var hadNested = hasNestedObjects(parsed);

    // Flatten every row; primitives become { value: item }
    var rows = [];
    for (var pi = 0; pi < parsed.length; pi++) {
      var item = parsed[pi];
      if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
        rows.push(flattenObj(item, ''));
      } else {
        rows.push({ value: item });
      }
    }

    // Union of all keys, preserving insertion order
    var headers = [];
    var seen = Object.create(null);
    for (var ri = 0; ri < rows.length; ri++) {
      var rowKeys = Object.keys(rows[ri]);
      for (var ki = 0; ki < rowKeys.length; ki++) {
        if (!seen[rowKeys[ki]]) { seen[rowKeys[ki]] = true; headers.push(rowKeys[ki]); }
      }
    }

    flatRows = rows;
    originalHeaders = headers;
    allHeaders = orderedHeaders(); // apply the active sort mode to the fresh union

    // Structure summary
    if (structEl) structEl.hidden = false;
    if (rowsEl) rowsEl.textContent = String(rows.length);
    if (colCountEl) colCountEl.textContent = String(headers.length);
    if (nestedNote) nestedNote.hidden = !hadNested;

    // Column checkboxes (all selected on a fresh convert)
    if (columnSect) columnSect.hidden = false;
    renderCheckboxes(allHeaders);

    // Build initial CSV (all columns)
    var csv = buildCsv(rows, allHeaders);
    if (sizeEl) sizeEl.textContent = formatBytes(new TextEncoder().encode(csv).length);

    // Preview table (first 5 rows)
    if (previewEl) previewEl.hidden = false;
    renderTable(rows, allHeaders);

    // Output
    if (outputSect) outputSect.hidden = false;
    if (outputEl) outputEl.value = csv;
    updateHandoff(csv);
  }

  var EXAMPLE = '[\n  { "name": "Alice", "age": 30, "city": "New York" },\n  { "name": "Bob", "city": "Los Angeles" },\n  { "name": "Charlie", "note": "Contains, commas" },\n  { "name": "David", "quote": "He said \\"Hello\\"" },\n  { "name": "Emma", "address": { "city": "Chicago" } }\n]';

  convertBtn.addEventListener('click', function () { convert(); persist(); });

  exampleBtn.addEventListener('click', function () {
    inputEl.value = EXAMPLE;
    convert();
    persist();
  });

  if (sortNoneBtn) sortNoneBtn.addEventListener('click', function () { setSort('none'); });
  if (sortAscBtn) sortAscBtn.addEventListener('click', function () { setSort('asc'); });
  if (sortDescBtn) sortDescBtn.addEventListener('click', function () { setSort('desc'); });

  // Two-click confirm clear
  var clearTimer;
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      if (!clearBtn.classList.contains('is-confirming')) {
        clearBtn.classList.add('is-confirming');
        clearBtn.textContent = 'Confirm Clear';
        clearTimer = setTimeout(function () {
          clearBtn.classList.remove('is-confirming');
          clearBtn.textContent = 'Clear';
        }, 3000);
        return;
      }
      clearTimeout(clearTimer);
      clearBtn.classList.remove('is-confirming');
      clearBtn.textContent = 'Clear';
      inputEl.value = '';
      flatRows = [];
      allHeaders = [];
      originalHeaders = [];
      clearResults();
      if (outputEl) outputEl.value = '';
      persist();
      inputEl.focus();
    });
    document.addEventListener('click', function (e) {
      if (clearBtn.classList.contains('is-confirming') && !e.target.closest('#jcsv-clear')) {
        clearTimeout(clearTimer);
        clearBtn.classList.remove('is-confirming');
        clearBtn.textContent = 'Clear';
      }
    });
  }

  // Copy CSV
  var copyTimer;
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (!outputEl || !outputEl.value.trim()) { TT && TT.toast('Nothing to copy!'); return; }
      TT && TT.copy(outputEl.value);
      copyBtn.classList.add('is-success');
      copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () {
        copyBtn.classList.remove('is-success');
        copyBtn.textContent = 'Copy CSV';
      }, 2000);
    });
  }

  // Download CSV
  if (downloadBtn) {
    downloadBtn.addEventListener('click', function () {
      if (!outputEl || !outputEl.value.trim()) { TT && TT.toast('Nothing to download!'); return; }
      var blob = new Blob([outputEl.value], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'data.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  function persist() {
    TT && TT.state && TT.state.save(slug, { input: inputEl.value, sortMode: sortMode });
  }

  // Restore state. A fresh handoff from the sibling page wins over saved input and is
  // auto-converted so the carried-over result is immediately visible.
  try {
    var consumedHandoff = false;
    var group = TT && TT.state && TT.state.load(GROUP_KEY);
