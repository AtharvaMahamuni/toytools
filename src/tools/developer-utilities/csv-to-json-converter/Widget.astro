---
import IoPanel from '@tools/_shared/IoPanel.astro';
import CategoryDiscovery from '@components/tool/CategoryDiscovery.astro';
import { config } from './config';
---

<div class="c2j-widget">
  <IoPanel label="CSV Input" labelFor="c2j-input" variant="mono">
    <textarea
      id="c2j-input"
      placeholder={'name,age,city\nAlice,30,New York\nBob,28,Los Angeles'}
      spellcheck="false"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
    ></textarea>
  </IoPanel>

  <div class="tool-actions c2j-controls">
    <button id="c2j-convert" class="action-btn c2j-btn-primary" type="button">Convert</button>
    <button id="c2j-example" class="action-btn" type="button">Load Example</button>
    <button id="c2j-clear" class="action-btn action-btn--clear" type="button" data-label="Clear">Clear</button>
  </div>

  <div id="c2j-options" class="c2j-options" aria-label="Conversion options">
    <div class="c2j-opt-group">
      <span class="c2j-opt-label">Delimiter</span>
      <div class="c2j-delim-pills" role="group" aria-label="Field delimiter">
        <button class="c2j-small-pill c2j-small-pill--active" type="button" data-delim="," aria-pressed="true">Comma</button>
        <button class="c2j-small-pill" type="button" data-delim=";" aria-pressed="false">Semicolon</button>
        <button class="c2j-small-pill" type="button" data-delim="&#9;" aria-pressed="false">Tab</button>
        <button class="c2j-small-pill" type="button" data-delim="|" aria-pressed="false">Pipe</button>
      </div>
    </div>
    <label class="c2j-check">
      <input type="checkbox" id="c2j-smart-types" checked />
      <span>Detect types (numbers, booleans, null)</span>
    </label>
  </div>

  <div id="c2j-error" class="c2j-error" hidden></div>

  <section id="c2j-stats-section" class="c2j-stats-section" hidden aria-label="Output statistics">
    <span class="c2j-stat-item">Rows: <strong id="c2j-rows">0</strong></span>
    <span class="c2j-stat-sep" aria-hidden="true">·</span>
    <span class="c2j-stat-item">Columns: <strong id="c2j-cols">0</strong></span>
    <span class="c2j-stat-sep" aria-hidden="true">·</span>
    <span class="c2j-stat-item">Size: <strong id="c2j-size">0 B</strong></span>
  </section>

  <section id="c2j-output-section" class="c2j-section" hidden aria-label="Output">
    <span class="c2j-section-title">JSON Output</span>
    <textarea id="c2j-output" class="c2j-output" readonly spellcheck="false" aria-label="JSON output"></textarea>
    <div class="tool-actions c2j-output-actions">
      <button id="c2j-copy" class="action-btn action-btn--copy" type="button">Copy JSON</button>
      <button id="c2j-download" class="action-btn" type="button">Download .json</button>
    </div>
  </section>
</div>

<CategoryDiscovery toolSlug={config.slug} />

<style is:global>
  .c2j-widget {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .c2j-widget .io-panel {
    min-height: 260px;
  }

  .c2j-controls {
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .c2j-btn-primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
    border-color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
  .c2j-btn-primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-inverse);
  }

  .c2j-options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .c2j-opt-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .c2j-opt-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .c2j-delim-pills {
    display: flex;
    border: var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .c2j-small-pill {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: none;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
    min-height: 32px;
  }
  .c2j-delim-pills .c2j-small-pill:not(:last-child) {
    border-right: var(--border);
  }
  .c2j-small-pill--active,
  .c2j-small-pill[aria-pressed="true"] {
    background: var(--color-accent-subtle);
    color: var(--color-accent-strong);
    font-weight: var(--font-weight-semibold);
  }
  .c2j-small-pill:hover:not(.c2j-small-pill--active):not([aria-pressed="true"]) {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .c2j-check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text);
    user-select: none;
    min-height: 32px;
  }
  .c2j-check input[type="checkbox"] {
    width: 15px;
    height: 15px;
    cursor: pointer;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .c2j-error {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-danger);
    border-radius: var(--radius-md);
    background: var(--color-danger-bg);
    color: var(--color-danger);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
  }
  .c2j-error[hidden] { display: none; }

  .c2j-stats-section {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }
  .c2j-stats-section[hidden] { display: none; }
  .c2j-stats-section strong {
    font-weight: var(--font-weight-semibold);
    font-family: var(--font-mono);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .c2j-stat-sep {
    color: var(--color-text-subtle);
  }

  .c2j-section {
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .c2j-section[hidden] { display: none; }

  .c2j-section-title {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .c2j-output {
    display: block;
    width: 100%;
    min-height: 200px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    resize: vertical;
    font-variant-ligatures: none;
  }

  .c2j-output-actions {
    padding-block: 0;
  }

  .action-btn.is-success {
    background: var(--color-success);
    border-color: var(--color-success);
    color: #fff;
  }
</style>

<script is:inline>
(function () {
  var slug = 'csv-to-json-converter';
  var GROUP_KEY = 'group:json-csv';
  var TT = window.ToyTools;

  var inputEl       = document.getElementById('c2j-input');
  var convertBtn    = document.getElementById('c2j-convert');
  var exampleBtn    = document.getElementById('c2j-example');
  var clearBtn      = document.getElementById('c2j-clear');
  var delimPills    = document.querySelectorAll('.c2j-delim-pills .c2j-small-pill');
  var smartTypesEl  = document.getElementById('c2j-smart-types');
  var errorEl       = document.getElementById('c2j-error');
  var statsSection  = document.getElementById('c2j-stats-section');
  var rowsEl        = document.getElementById('c2j-rows');
  var colsEl        = document.getElementById('c2j-cols');
  var sizeEl        = document.getElementById('c2j-size');
  var outputSection = document.getElementById('c2j-output-section');
  var outputEl      = document.getElementById('c2j-output');
  var copyBtn       = document.getElementById('c2j-copy');
  var downloadBtn   = document.getElementById('c2j-download');

  if (!inputEl || !convertBtn) return;

  var delimiter = ',';

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function showError(msg) {
    if (errorEl) { errorEl.textContent = msg; errorEl.hidden = false; }
    if (statsSection) statsSection.hidden = true;
    if (outputSection) outputSection.hidden = true;
  }

  function clearResults() {
    if (errorEl) errorEl.hidden = true;
    if (statsSection) statsSection.hidden = true;
    if (outputSection) outputSection.hidden = true;
  }

  function showOutput(text, rowCount, colCount) {
    if (errorEl) errorEl.hidden = true;

    var bytes = new TextEncoder().encode(text).length;
    if (rowsEl) rowsEl.textContent = String(rowCount);
    if (colsEl) colsEl.textContent = String(colCount);
    if (sizeEl) sizeEl.textContent = formatBytes(bytes);
    if (statsSection) statsSection.hidden = false;

    if (outputEl) outputEl.value = text;
    if (outputSection) outputSection.hidden = false;

    // Carry result forward to the sibling (JSON → CSV) page.
    if (TT && TT.state && text.trim()) {
      TT.state.save(GROUP_KEY, { handoff: text, from: slug });
    }
  }

  function convert() {
    var raw = inputEl.value;
    if (!raw.trim()) { clearResults(); return; }
    if (!(window.ToyTools && ToyTools.csv && ToyTools.csv.parse)) return;

    var res = ToyTools.csv.parse(raw, {
      delimiter: delimiter,
      smartTypes: smartTypesEl ? smartTypesEl.checked : true,
    });
    if (!res.ok) { showError('Invalid CSV — ' + (res.error || 'check the structure.')); return; }
    if (res.headers.length === 0) {
      showError('No header row found — the first line must list the column names.');
      return;
    }
    if (res.rows.length === 0) {
      showError('No data rows found — add at least one row beneath the header.');
      return;
    }
    var json;
    try { json = JSON.stringify(res.rows, null, 2); }
    catch (e) { showError('Serialization error: ' + e.message); return; }
    showOutput(json, res.rows.length, res.headers.length);
  }

  function setDelimiter(val) {
    delimiter = val;
    for (var i = 0; i < delimPills.length; i++) {
      var on = delimPills[i].getAttribute('data-delim') === val;
      delimPills[i].classList.toggle('c2j-small-pill--active', on);
      delimPills[i].setAttribute('aria-pressed', on ? 'true' : 'false');
    }
    convert();
    persist();
  }

  function persist() {
    TT && TT.state && TT.state.save(slug, {
      input: inputEl.value,
      delimiter: delimiter,
      smartTypes: smartTypesEl ? smartTypesEl.checked : true,
    });
  }

  // Restore state. A fresh handoff from the sibling page wins over saved input.
  try {
    var consumedHandoff = false;
    var group = TT && TT.state && TT.state.load(GROUP_KEY);
    if (group && group.from && group.from !== slug && typeof group.handoff === 'string' && group.handoff.trim()) {
      inputEl.value = group.handoff;
      consumedHandoff = true;
      TT.state.save(GROUP_KEY, { handoff: '', from: '' }); // consume once
    }
    var saved = TT && TT.state && TT.state.load(slug);
    if (saved) {
      if (!consumedHandoff && typeof saved.input === 'string') inputEl.value = saved.input;
      if (typeof saved.delimiter === 'string') setDelimiter(saved.delimiter);
      if (smartTypesEl && saved.smartTypes === false) smartTypesEl.checked = false;
    }
  } catch (_) {}

  // Events
  for (var d = 0; d < delimPills.length; d++) {
    (function (pill) {
      pill.addEventListener('click', function () { setDelimiter(pill.getAttribute('data-delim')); });
    })(delimPills[d]);
  }
  if (smartTypesEl) smartTypesEl.addEventListener('change', function () { convert(); persist(); });

  inputEl.addEventListener('input', function () { convert(); persist(); });
  convertBtn.addEventListener('click', function () { convert(); persist(); });

  var CSV_EXAMPLE = 'name,age,active,city\nAlice,30,true,New York\nBob,28,false,Los Angeles\nCharlie,35,true,Chicago';

  if (exampleBtn) {
    exampleBtn.addEventListener('click', function () {
      inputEl.value = CSV_EXAMPLE;
      convert();
      persist();
    });
  }

  // Clear (2-click confirm)
  var clearTimer;
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      if (!clearBtn.classList.contains('is-confirming')) {
        clearBtn.classList.add('is-confirming');
        clearBtn.textContent = 'Confirm Clear';
        clearTimer = setTimeout(function () {
          clearBtn.classList.remove('is-confirming');
          clearBtn.textContent = 'Clear';
        }, 3000);
        return;
      }
      clearTimeout(clearTimer);
      clearBtn.classList.remove('is-confirming');
      clearBtn.textContent = 'Clear';
      inputEl.value = '';
      clearResults();
      persist();
      inputEl.focus();
    });
    document.addEventListener('click', function (e) {
      if (clearBtn.classList.contains('is-confirming') && !e.target.closest('#c2j-clear')) {
        clearTimeout(clearTimer);
        clearBtn.classList.remove('is-confirming');
        clearBtn.textContent = 'Clear';
      }
    });
  }

  // Copy
  var copyTimer;
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (!outputEl || !outputEl.value.trim()) { TT && TT.toast('Nothing to copy!'); return; }
      TT && TT.copy(outputEl.value);
      copyBtn.classList.add('is-success');
      copyBtn.textContent = '✓ Copied';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(function () {
        copyBtn.classList.remove('is-success');
        copyBtn.textContent = 'Copy JSON';
      }, 2000);
    });
  }

  // Download
  if (downloadBtn) {
    downloadBtn.addEventListener('click', function () {
      if (!outputEl || !outputEl.value.trim()) { TT && TT.toast('Nothing to download!'); return; }
      var blob = new Blob([outputEl.value], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'data.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(convert); else convert();
})();
</script>
