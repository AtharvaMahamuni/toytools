---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      A codificação URL (percent-encoding segundo a RFC 3986) troca espaços, acentos e símbolos reservados (<code>&amp;</code>, <code>=</code>, <code>?</code>, <code>/</code>) por códigos <code>%XX</code> em UTF-8. Isso impede que parâmetros de busca sejam divididos ou truncados no servidor.
    </p>
    <a href={toolHref} class="cta-link">Abrir Codificador URL →</a>
  </section>

  <section id="encodeuricomponent">
    <h2>encodeURIComponent vs. encodeURI e dupla codificação <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Use <code>encodeURIComponent</code> para valores individuais (pois também escapa <code>&amp;</code> e <code>/</code>) e <code>encodeURI</code> apenas para URLs completas. Evite codificar duas vezes a mesma string para não gerar bugs silenciosos como <code>%2520</code>.
    </p>
    <ReferenceBlock type="key-idea" heading="Quando usar %20 ou +">
      <p>Use <code>%20</code> em URLs e rotas padrão; o sinal <code>+</code> para espaços só vale no formato de formulários <code>application/x-www-form-urlencoded</code>.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Outras ferramentas de codificação web <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Precisa preparar payloads Base64 antes de enviar por link? Use o <a href={toolPathBySlug('base64-encoder-decoder', 'pt')}>Codificador Base64</a>, ou escape textos para páginas web no <a href={toolPathBySlug('html-entity-encoder-decoder', 'pt')}>Codificador de Entidades HTML</a>.
    </p>
  </section>
</GuideLayout>
