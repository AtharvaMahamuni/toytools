---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      URL-Kodierung (Percent-Encoding nach RFC 3986) wandelt Leerzeichen, Umlaute und reservierte Steuerzeichen (<code>&amp;</code>, <code>=</code>, <code>?</code>, <code>/</code>) in <code>%XX</code>-Hexwerte um. Dadurch bleiben Query-Parameter und Pfadsegmente beim Übertragen unbeschädigt.
    </p>
    <a href={toolHref} class="cta-link">URL Encoder und Decoder öffnen →</a>
  </section>

  <section id="encodeuricomponent">
    <h2>encodeURIComponent vs. encodeURI und typische Fallen <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      <code>encodeURIComponent</code> maskiert auch <code>&amp;</code>, <code>=</code> und <code>/</code> für einzelne Parameterwerte, während <code>encodeURI</code> eine komplette URL intakt lässt. Mehrfaches Kodieren führt schnell zum bekannten <code>%2520</code>-Fehler.
    </p>
    <ReferenceBlock type="key-idea" heading="Wann %20 und wann + richtig ist">
      <p>Nutze <code>%20</code> in Pfaden und Standard-URIs; <code>+</code> für Leerzeichen gilt ausschließlich in Formulardaten mit <code>application/x-www-form-urlencoded</code>.</p>
    </ReferenceBlock>
  </section>

  <section id="verwandte-tools">
    <h2>Verwandte Web-Encoder <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Zum sicheren Kodieren von Binärdaten oder JWT-Teilen nutze den <a href={toolPathBySlug('base64-encoder-decoder', 'de')}>Base64 Encoder</a>, und für sichere HTML-Ausgaben den <a href={toolPathBySlug('html-entity-encoder-decoder', 'de')}>HTML-Entitäten-Encoder</a>.
    </p>
  </section>
</GuideLayout>
