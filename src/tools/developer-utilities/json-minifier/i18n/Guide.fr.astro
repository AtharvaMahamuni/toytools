---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './fr';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'fr');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="fr">
  <section id="reponse-rapide">
    <h2>Réponse rapide <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Minifier du JSON consiste à supprimer tous les espaces, tabulations et retours à la ligne inutiles entre les jetons tout en laissant les données strictement identiques. Cela permet d’obtenir le JSON valide le plus léger possible pour la production.
    </p>
    <a href={toolHref} class="cta-link">Ouvrir le Minificateur JSON →</a>
  </section>

  <section id="gains-et-gzip">
    <h2>Gains de taille et complémentarité avec gzip <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Sur un JSON bien indenté, le retrait des blancs réduit généralement le poids de 20 à 40 %. Associé à gzip ou Brotli, le transfert réseau est optimal et le navigateur a moins d’octets à analyser.
    </p>
    <ReferenceBlock type="key-idea" heading="Totalement réversible et sans arrondi">
      <p>Nos jetons sont copiés tels quels sans passer par un aller-retour destructif, préservant les grands identifiants et <code>19.90</code>.</p>
    </ReferenceBlock>
  </section>

  <section id="outils-lies">
    <h2>Outils associés <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Pour relire ou comparer dans Git, passez par le <a href={toolPathBySlug('json-formatter', 'fr')}>Formateur JSON</a>, et vérifiez la syntaxe avec le <a href={toolPathBySlug('json-validator', 'fr')}>Validateur JSON</a>.
    </p>
  </section>
</GuideLayout>
