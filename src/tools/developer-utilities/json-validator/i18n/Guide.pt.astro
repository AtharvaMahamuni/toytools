---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Validar JSON significa confirmar que o texto obedece rigorosamente à gramática RFC 8259: aspas duplas retas, sem vírgulas finais, sem comentários e com chaves e colchetes fechados. O processo roda no navegador com correção automática para aspas curvas e vírgulas finais.
    </p>
    <a href={toolHref} class="cta-link">Abrir Validador de JSON →</a>
  </section>

  <section id="erros-comuns">
    <h2>Erros de sintaxe mais frequentes <span class="gold-dot" aria-hidden="true"></span></h2>
    <ul>
      <li><strong>Vírgula final:</strong> <code>{"{\"a\": 1,}"}</code> funciona em JS, mas quebra em JSON.</li>
      <li><strong>Aspas simples ou curvas:</strong> JSON aceita somente aspas duplas retas <code>"</code>.</li>
      <li><strong>Comentários:</strong> <code>//</code> ou <code>/* ... */</code> invalidam o documento.</li>
    </ul>
    <ReferenceBlock type="common-mistake" heading="Sintaxe válida vs. JSON Schema">
      <p>Estar válido na RFC 8259 não garante os campos esperados por uma API; isso depende de um contrato JSON Schema.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Depois de validar, organize com o <a href={toolPathBySlug('json-formatter', 'pt')}>Formatador de JSON</a> ou compacte com o <a href={toolPathBySlug('json-minifier', 'pt')}>Minificador de JSON</a>.
    </p>
  </section>
</GuideLayout>
