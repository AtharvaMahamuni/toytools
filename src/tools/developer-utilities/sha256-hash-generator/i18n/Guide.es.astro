---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      SHA-256 es la función hash criptográfica estándar actual: convierte cualquier texto o archivo en una huella determinista de 256 bits (64 caracteres hexadecimales). Sirve para verificar integridad en TLS, paquetes de software y bloques de Bitcoin, pero no es reversible ni apta por sí sola para almacenar contraseñas.
    </p>
    <a href={toolHref} class="cta-link">Abrir Generador SHA-256 →</a>
  </section>

  <section id="verificar-en-terminal">
    <h2>Cómo comprobar un checksum SHA-256 en tu sistema <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      En Linux ejecuta <code>sha256sum archivo.zip</code>, en macOS usa <code>shasum -a 256 archivo.zip</code> y en Windows PowerShell escribe <code>Get-FileHash archivo.zip -Algorithm SHA256</code>. Si cambia un solo byte en la descarga, el hash resultante cambia por completo gracias al efecto avalancha.
    </p>
    <ReferenceBlock type="key-idea" heading="Por qué no usar SHA-256 directo para contraseñas">
      <p>Al diseñarse para ser muy rápido en hardware moderno, resulta vulnerable a fuerza bruta en GPU. Protege contraseñas con funciones adaptativas con sal como Argon2 o bcrypt.</p>
    </ReferenceBlock>
  </section>

  <section id="herramientas-relacionadas">
    <h2>Otras herramientas de digest y codificación <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Para verificar archivos descargados locales usa <a href={toolPathBySlug('file-hash-verifier')}>File Hash Verifier</a>, codifica resúmenes para cabeceras HTTP con el <a href={toolPathBySlug('base64-encoder-decoder', 'es')}>Codificador Base64</a> o compara algoritmos heredados en <a href={toolPathBySlug('md5-hash-generator')}>MD5 Generator</a> y <a href={toolPathBySlug('sha1-hash-generator')}>SHA-1 Generator</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
