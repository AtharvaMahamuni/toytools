---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      O Formatador e Validador XML usa o <code>DOMParser</code> embutido do seu navegador para indentar em dois espaços ou minificar documentos XML, apontando a primeira falha estrutural com linha sempre que o navegador informar.
    </p>
    <a href={toolHref} class="cta-link">Abrir Formatador XML →</a>
  </section>

  <section id="regras">
    <h2>Boa formação, maiúsculas e CDATA <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      XML diferencia maiúsculas de minúsculas e exige fechamento exato das tags. Comentários, seções CDATA e namespaces <code>xmlns</code> são preservados sem alterações.
    </p>
    <ReferenceBlock type="note" heading="Boa formação vs. schema XSD">
      <p>A checagem local garante boa formação sintática sem buscar esquemas externos XSD ou DTD na rede.</p>
    </ReferenceBlock>
  </section>

  <section id="ferramentas-relacionadas">
    <h2>Ferramentas relacionadas <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Confira também <a href={toolPathBySlug('html-entity-encoder-decoder', 'pt')}>Entidades HTML</a> e o <a href={toolPathBySlug('json-formatter', 'pt')}>Formatador de JSON</a>.
    </p>
  </section>
</GuideLayout>
