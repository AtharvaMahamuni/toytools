---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Der XML Formatter nutzt direkt den integrierten <code>DOMParser</code> deines Browsers, um verschachteltes XML lesbar einzurücken oder zu minifizieren und den ersten Wohlgeformtheitsfehler samt Zeile sichtbar zu machen.
    </p>
    <a href={toolHref} class="cta-link">XML Formatter öffnen →</a>
  </section>

  <section id="regeln">
    <h2>Wohlgeformtheit und Namespaces <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      XML unterscheidet strikt zwischen Groß- und Kleinschreibung und verlangt exakt schließende Tags. Kommentare, CDATA-Abschnitte und <code>xmlns</code>-Attribute bleiben unverändert erhalten.
    </p>
    <ReferenceBlock type="note" heading="Wohlgeformtheit vs. XSD-Schema">
      <p>Die Browserprüfung testet syntaktische Wohlgeformtheit; fachliche Datentypen und XSD-Schemas werden bewusst nicht abgerufen oder validiert.</p>
    </ReferenceBlock>
  </section>

  <section id="verwandte-tools">
    <h2>Verwandte Tools <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Sieh dir auch <a href={toolPathBySlug('html-entity-encoder-decoder', 'de')}>HTML-Entities</a> und den <a href={toolPathBySlug('json-formatter', 'de')}>JSON Formatter</a> an.
    </p>
  </section>
</GuideLayout>
