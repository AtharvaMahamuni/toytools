---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './fr';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'fr');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="fr">
  <section id="reponse-rapide">
    <h2>Réponse rapide <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Le Formateur et Validateur XML utilise le <code>DOMParser</code> natif de votre navigateur pour indenter à deux espaces ou minifier votre document XML tout en indiquant la première faute syntaxique avec sa ligne lorsque disponible.
    </p>
    <a href={toolHref} class="cta-link">Ouvrir le Formateur XML →</a>
  </section>

  <section id="regles">
    <h2>Bonne formation, casse et CDATA <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      XML est sensible à la casse et impose des balises fermantes strictes. Les commentaires, sections CDATA et espaces de noms <code>xmlns</code> sont conservés intacts.
    </p>
    <ReferenceBlock type="note" heading="Bonne formation vs validation XSD">
      <p>Ce contrôle vérifie la syntaxe XML de base et non les règles d’un schéma XSD ou DTD externe.</p>
    </ReferenceBlock>
  </section>

  <section id="outils-associes">
    <h2>Outils associés <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Consultez aussi <a href={toolPathBySlug('html-entity-encoder-decoder', 'fr')}>Encodeur d’entités HTML</a> et le <a href={toolPathBySlug('json-formatter', 'fr')}>Formateur JSON</a>.
    </p>
  </section>
</GuideLayout>
