---
import FinanceWidget from '@tools/_shared/FinanceWidget.astro';
import { config } from './config';
---

<div class="upi-split">
<div class="upi-caution" data-craft="upi-split-meme" role="note">
  <p>For fun only. ToyTools does not support splitting payments to dodge a fee, a tax, or a reporting rule. This is not tax, legal, or payments advice.</p>
  <p>We do not know whether NPCI, a bank, or a UPI app treats several payments as one total. Do not use this for that.</p>
</div>

<section class="upi-next" aria-label="Next chunk">
  <p class="upi-next-kicker">Pay this chunk</p>
  <label class="upi-vpa" for="upi-1999-split-vpa">
    <span class="widget-label">Payee UPI ID</span>
    <input
      id="upi-1999-split-vpa"
      class="widget-input"
      type="text"
      inputmode="email"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="done"
      placeholder="name@upi"
    />
  </label>
  <p id="upi-1999-split-vpa-msg" class="upi-msg" role="status" hidden></p>
  <div id="upi-1999-split-chunk" hidden>
    <p id="upi-1999-split-next" class="upi-next-line" aria-live="polite"></p>
    <div id="upi-1999-split-link-wrap" class="upi-link-wrap" hidden>
      <a id="upi-1999-split-link" class="action-btn upi-open">Open UPI app</a>
      <p id="upi-1999-split-phone" class="upi-phone">Opens a UPI app on a phone.</p>
    </div>
    <button type="button" id="upi-1999-split-copy-chunk" class="action-btn upi-copy" hidden>Copy chunk</button>
    <label class="upi-tick" for="upi-1999-split-done">
      <input id="upi-1999-split-done" type="checkbox" />
      <span>Marked done. This is your own tick, not a receipt from the bank or UPI app.</span>
    </label>
    <p id="upi-1999-split-all" class="upi-msg" hidden>You marked every chunk. This is your tick, not a receipt.</p>
  </div>
</section>

<FinanceWidget
  slug={config.slug}
  financeId="upi-1999-split"
  config={config}
  emptyText="Enter a total in whole rupees."
/>
</div>

<script is:inline>
  (function () {
    var vpaEl = document.getElementById('upi-1999-split-vpa');
    var msgEl = document.getElementById('upi-1999-split-vpa-msg');
    var chunkEl = document.getElementById('upi-1999-split-chunk');
    var nextEl = document.getElementById('upi-1999-split-next');
    var wrapEl = document.getElementById('upi-1999-split-link-wrap');
    var linkEl = document.getElementById('upi-1999-split-link');
    var copyEl = document.getElementById('upi-1999-split-copy-chunk');
    var boxEl = document.getElementById('upi-1999-split-done');
    var allEl = document.getElementById('upi-1999-split-all');
    var amountEl = document.getElementById('upi-1999-split-f-amount');
    var done = 0;
    var amountKey = null;
    var lock = false;

    function readAmount() {
      if (!amountEl) return NaN;
      var raw = amountEl.getAttribute('data-raw');
      if (raw == null || raw === '') return NaN;
      return Number(String(raw).replace(/,/g, '').replace(/\s/g, ''));
    }

    function rupeeLabel(amount) {
      return '₹' + Number(amount).toLocaleString('en-IN');
    }

    function clearLink() {
      if (linkEl) linkEl.removeAttribute('href');
      if (wrapEl) wrapEl.hidden = true;
    }

    function paintCopy(view) {
      if (!copyEl) return;
      if (!view || view.allMarked) {
        copyEl.hidden = true;
        copyEl.removeAttribute('data-amount');
        return;
      }
      var label = rupeeLabel(view.amount);
      copyEl.hidden = false;
      copyEl.setAttribute('data-amount', label);
      copyEl.textContent = 'Copy ' + label;
    }

    function setChecked(value) {
      if (!boxEl) return;
      lock = true;
      boxEl.checked = value;
      lock = false;
    }

    function paint() {
      if (!(window.ToyTools && ToyTools.upiNextPay && chunkEl && vpaEl)) return;
      var amount = readAmount();
      var key = String(amount);
      if (key !== amountKey) {
        amountKey = key;
        done = 0;
      }
      var view = ToyTools.upiNextPay.describe(amount, vpaEl.value, done);
      if (!view) {
        chunkEl.hidden = true;
        if (msgEl) {
          msgEl.hidden = true;
          msgEl.textContent = '';
        }
        clearLink();
        paintCopy(null);
        if (vpaEl) vpaEl.removeAttribute('aria-invalid');
        return;
      }
      chunkEl.hidden = false;
      if (nextEl) nextEl.textContent = view.label;
      if (msgEl) {
        if (view.vpaMessage) {
          msgEl.hidden = false;
          msgEl.textContent = view.vpaMessage;
          vpaEl.setAttribute('aria-invalid', 'true');
        } else {
          msgEl.hidden = true;
          msgEl.textContent = '';
          vpaEl.removeAttribute('aria-invalid');
        }
      }
      if (view.href && String(view.href).indexOf('upi://pay?') === 0 && linkEl && wrapEl) {
        linkEl.setAttribute('href', view.href);
        wrapEl.hidden = false;
      } else {
        clearLink();
      }
      paintCopy(view);
      if (allEl) allEl.hidden = !view.allMarked;
      setChecked(!!view.allMarked);
    }

    function onToggle() {
      if (lock) return;
      if (!(window.ToyTools && ToyTools.upiNextPay && vpaEl && boxEl)) return;
      var base = ToyTools.upiNextPay.describe(readAmount(), vpaEl.value, 0);
      if (!base) return;
      done = ToyTools.upiNextPay.step(done, base.total, boxEl.checked);
      paint();
    }

    function boot() {
      if (!amountEl || !vpaEl || !boxEl) return;
      vpaEl.addEventListener('input', paint);
      amountEl.addEventListener('input', paint);
      amountEl.addEventListener('change', paint);
      if (window.MutationObserver) {
        new MutationObserver(paint).observe(amountEl, { attributes: true, attributeFilter: ['data-raw'] });
      }
      boxEl.addEventListener('change', onToggle);
      if (copyEl) {
        copyEl.addEventListener('click', function () {
          var amt = copyEl.getAttribute('data-amount');
          if (amt && window.ToyTools && ToyTools.copy) ToyTools.copy(amt);
        });
      }
      paint();
    }

    if (window.ToyTools && ToyTools.onReady) ToyTools.onReady(boot);
    else boot();
  })();
</script>

<style>
  /* One stage: caution, split, amount, pay. FinanceWidget's inner wrappers
     dissolve so those pieces share this grid instead of stacking as three pages. */
  .upi-split {
    display: grid;
    gap: var(--space-6);
    grid-template-areas:
      'caution'
      'output'
      'input'
      'next'
      'actions';
    align-items: start;
  }

  .upi-caution { grid-area: caution; }
  .upi-next { grid-area: next; min-width: 0; }
  .upi-split :global(.calc-ledger),
  .upi-split :global(.tool-split) { display: contents; }
  .upi-split :global(.ts-output) { grid-area: output; min-width: 0; }
  .upi-split :global(.ts-input) { grid-area: input; min-width: 0; }
  .upi-split :global(.tool-actions) { grid-area: actions; }

  /* Whole-rupee totals use the chips or the keyboard. ±1 steppers are empty boxes.
     Currency is a display toggle other finance tools need; this page is rupees. */
  .upi-split :global(.smart-step),
  .upi-split :global(.finance-ledger-toolbar) { display: none; }

  .upi-caution {
    margin: 0;
    padding-inline-start: var(--space-3);
    border-left: var(--border);
  }

  .upi-caution p {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }

  .upi-caution p:last-child {
    margin-bottom: 0;
  }

  .upi-next {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .upi-next-kicker {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .upi-vpa {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .upi-vpa input {
    font-size: var(--text-base);
    width: 100%;
  }

  .upi-next-line {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  /* Grouping line is the answer; the 36px money-hero clamp is for a single number. */
  .upi-split :global(.hero-value) {
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    line-height: 1.25;
  }

  .upi-open,
  .upi-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: start;
    text-decoration: none;
  }

  .upi-copy {
    display: none;
  }

  .upi-open:active,
  .upi-copy:active {
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
  }

  .upi-phone {
    display: none;
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .upi-tick {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--color-text);
    cursor: pointer;
  }

  .upi-tick input {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    accent-color: var(--color-accent);
  }

  .upi-msg {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }

  .upi-next [hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    /* Desktop copies the chunk; a upi:// link cannot open here. */
    .upi-link-wrap,
    .upi-open,
    .upi-phone {
      display: none;
    }

    .upi-copy:not([hidden]) {
      display: flex;
      width: 100%;
    }

    #upi-1999-split-chunk {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    #upi-1999-split-chunk[hidden] {
      display: none;
    }

    /* Half and half: bill (amount + split) | pay (payee + chunk). */
    .upi-split {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'caution caution'
        'input   next'
        'output  next'
        'actions next';
      column-gap: var(--space-8);
      row-gap: var(--space-6);
    }

    .upi-next {
      align-self: stretch;
      gap: var(--space-4);
      padding: var(--space-6);
      background: var(--color-surface);
      border-radius: var(--radius-md);
    }

    .upi-next-line {
      font-size: var(--text-2xl);
    }

    .upi-vpa input {
      max-width: none;
    }

    /* Pay pane is the filled half; the split statement stays a ledger, not a second card. */
    .upi-split :global(.ts-output .io-panel) {
      background: transparent;
      padding: 0;
      border-radius: 0;
    }
  }
</style>
