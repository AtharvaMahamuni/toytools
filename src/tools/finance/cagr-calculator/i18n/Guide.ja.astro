---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>概要 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>CAGR（年平均成長率）は複数年の増減を「毎年一定の複利成長率」として表した指標です。単純平均や累計の割り算と異なり、複利の性質を正確に捉えます。</p>
    <a href={toolHref} class="cta-link">CAGR計算ツールを使う →</a>
  </section>
  <section id="formula">
    <h2>計算式とROI・72の法則との比較 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>CAGR = (終了値 / 開始値)^(1 / t) − 1</strong></p>
    <p>通算成績は <a href={toolPathBySlug('roi-calculator', 'ja')}>ROI計算ツール</a>、倍増年数の概算は <a href={toolPathBySlug('rule-of-72-calculator')}>72の法則計算ツール</a> と合わせて確認できます。</p>
  </section>
  <section id="mistakes">
    <h2>注意点 <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="途中の追加投資があるのにCAGRを計算する">
      <p>期中に資金追加や引き出しがある場合は成長率に自己資金が含まれてしまうため、積立時はSIP計算を使う必要があります。</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
