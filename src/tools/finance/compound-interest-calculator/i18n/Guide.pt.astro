---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Os juros compostos incidem sobre o capital inicial e sobre todos os rendimentos acumulados. Com aportes mensais constantes e horizonte longo, os juros passam a responder pela maior parte do saldo final.</p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Juros Compostos →</a>
  </section>
  <section id="frequencia-e-aportes">
    <h2>Capitalização e aportes mensais <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Capitalizar mensalmente rende ligeiramente mais do que anualmente (10.000 a 7% por 20 anos vão de 38.697 para cerca de 40.387), porém o prazo investido e a disciplina dos aportes são os fatores decisivos.</p>
  </section>
  <section id="formula-e-erros">
    <h2>Fórmula e erros comuns <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>FV = P (1 + r/n)^(n · t)</strong></p>
    <ReferenceBlock type="common-mistake" heading="Ignorar inflação e volatilidade">
      <p>O retorno real varia e os preços sobem ao longo dos anos. Use taxas moderadas e confira quanto o montante final realmente compra descontando a inflação.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
