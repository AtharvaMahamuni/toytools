---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="kurzantwort">
    <h2>Kurzantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Beim Zinseszins verzinsen sich sowohl dein Startkapital als auch alle bereits gutgeschriebenen Zinsen. Durch regelmäßige Monatsraten entsteht ein starker Schneeballeffekt, der über lange Zeiträume den Großteil des Endvermögens bildet.</p>
    <a href={toolHref} class="cta-link">Zum Zinseszinsrechner →</a>
  </section>
  <section id="zinsperiode-und-sparrate">
    <h2>Zinsperiode und monatliche Sparraten <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>Monatliche Verzinsung bringt bei gleichen 7% auf 10.000 über 20 Jahre rund 40.387 statt 38.697 bei jährlicher Gutschrift. Deutlich stärker wirken allerdings die Anlagedauer und fortlaufende Sparraten.</p>
  </section>
  <section id="formel-und-fehler">
    <h2>Formel und häufige Fehler <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>FV = P (1 + r/n)^(n · t)</strong></p>
    <ReferenceBlock type="common-mistake" heading="Inflation und Marktschwankungen ausblenden">
      <p>Die Formel rechnet mit konstanter Rendite, während reale Kurse schwanken und Inflation Kaufkraft mindert. Nutze vorsichtige Annahmen und prüfe anschließend den realen Gegenwert.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
