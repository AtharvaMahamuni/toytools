---
import FinanceWidget from '@tools/_shared/FinanceWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';

interface Props { lang?: LocaleCode; pack?: LocalizedToolPack | null; }
const { lang = 'en', pack = null } = Astro.props;
---

<FinanceWidget slug={config.slug} financeId="compound-interest" config={config} craftOn="hero-note" lang={lang} pack={pack} />
