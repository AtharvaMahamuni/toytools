---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './pt';
import { toolPath } from '@lib/paths';
import { guidePathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'pt');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="pt">
  <section id="resposta-rapida">
    <h2>Resposta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>O ROI mostra o percentual de lucro líquido sobre o capital investido. Informando o prazo mantido, você obtém também a taxa anualizada para comparar aplicações de durações distintas.</p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de ROI →</a>
  </section>
  <section id="formula">
    <h2>Fórmula e anualização <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>ROI% = (V − C) / C × 100</strong></p>
    <p>A variação percentual segue o método detalhado no <a href={guidePathBySlug('percentage-calculator', 'pt')}>guia de porcentagem</a>, e o prazo t gera a taxa anual ((V / C)^(1/t) − 1) × 100.</p>
  </section>
  <section id="erros">
    <h2>Erros comuns <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Comparar ROIs sem olhar o tempo nem taxas">
      <p>Considere taxas de corretagem nos custos e proventos no valor final, comparando investimentos sempre pela taxa anualizada.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
