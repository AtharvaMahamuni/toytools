---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './hi';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'hi');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="hi">
  <section id="quick-answer">
    <h2>त्वरित उत्तर <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>महंगाई लगातार रुपये की क्रय शक्ति घटाती है। भविष्य की राशि को (1 + महंगाई दर)^वर्ष से भाग देकर आप आज के मूल्य के बराबर वास्तविक कीमत जान सकते हैं।</p>
    <a href={toolHref} class="cta-link">महंगाई कैलकुलेटर खोलें →</a>
  </section>
  <section id="formula">
    <h2>सूत्र और वास्तविक रिटर्न <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>वास्तविक मूल्य = राशि / (1 + i)^t</strong></p>
    <p>इसके साथ <a href={toolPathBySlug('rule-of-72-calculator')}>72 का नियम कैलकुलेटर</a> और <a href={toolPathBySlug('compound-interest-calculator', 'hi')}>चक्रवृद्धि ब्याज कैलकुलेटर</a> उपयोग करके महंगाई से आगे निकलने की योजना बनाएँ।</p>
  </section>
  <section id="mistakes">
    <h2>आम गलतियाँ <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="20 साल बाद के लक्ष्य को आज की कीमत पर मान लेना">
      <p>बचत लक्ष्य तय करने से पहले हमेशा महंगाई जोड़कर भविष्य की वास्तविक लागत निकालें।</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
