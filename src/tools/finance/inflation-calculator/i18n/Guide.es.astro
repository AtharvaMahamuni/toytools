---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './es';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'es');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="es">
  <section id="respuesta-rapida">
    <h2>Respuesta rápida <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>La inflación reduce progresivamente cuántos bienes compra una misma cantidad de dinero. Dividir el monto futuro por (1 + inflación)^años te devuelve su valor equivalente en poder adquisitivo actual.</p>
    <a href={toolHref} class="cta-link">Abrir Calculadora de Inflación →</a>
  </section>
  <section id="formula-y-ejemplos">
    <h2>Fórmula y retorno real frente al nominal <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>Valor real = Importe / (1 + i)^t</strong></p>
    <p>Si tu inversión rinde 7% nominal pero la inflación corre al 3%, tu ganancia real ronda el 3,9% anual. Puedes usar también la <a href={toolPathBySlug('rule-of-72-calculator')}>Regla del 72</a> o nuestra <a href={toolPathBySlug('compound-interest-calculator', 'es')}>Calculadora de Interés Compuesto</a>.</p>
  </section>
  <section id="errores">
    <h2>Errores frecuentes <span class="gold-dot" aria-hidden="true"></span></h2>
    <ReferenceBlock type="common-mistake" heading="Planificar metas a 20 años con precios de hoy">
      <p>Multiplica primero el costo objetivo de hoy por el factor inflacionario antes de calcular cuánto ahorrar cada mes.</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
