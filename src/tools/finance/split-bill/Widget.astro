---
import FinanceWidget from '@tools/_shared/FinanceWidget.astro';
import { config } from './config';
---

<div class="bill-note" data-craft="bill-split-fair" role="note">
  <p>If the total does not divide evenly, the last person takes the leftover paise so the shares still add up.</p>
  <p>This is a dinner split. It is not a payment-fee tool, and it keeps no accounts. Runs entirely on your device. Nothing is uploaded.</p>
</div>

<FinanceWidget
  slug={config.slug}
  financeId="split-bill"
  config={config}
  emptyText="Enter the bill, how many people, and an optional tip."
  splitScreens
/>

<style>
  .bill-note {
    margin: 0 0 var(--space-4);
    padding-inline-start: var(--space-3);
    border-left: var(--border);
  }

  .bill-note p {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }

  .bill-note p:last-child {
    margin-bottom: 0;
  }
</style>
