---
// Bespoke widget. The estimate lives in src/lib/text/contextFit.ts.
// Model rows are the sourced table in src/lib/text/contextModels.ts.
//
// Phone-first layout (beta-v12.1): the result is one line ("~1,234 tokens · 1% of 128,000 ·
// Fits") with the estimate label inline beside it. The window's source and checked date move
// to Zone C's "More about" row (MoreAbout.astro), still in the HTML under #cf-source.
import '@styles/prep-slim.css';
import IoPanel from '@tools/_shared/IoPanel.astro';
import MoreAbout from '@tools/_shared/MoreAbout.astro';
import { CONTEXT_MODELS } from '@lib/text/contextModels';
---

<div class="cf">
  <IoPanel label="Text" labelFor="cf-text" variant="prose">
    <textarea id="cf-text" rows="5" spellcheck="true" aria-label="Text to estimate" placeholder="Paste your prompt or text here."></textarea>
  </IoPanel>

  <label class="cf-model" for="cf-model">
    Model
    <select id="cf-model">
      {CONTEXT_MODELS.map(model => (
        <option value={model.id}>{model.name} · {model.provider}</option>
      ))}
    </select>
  </label>

  <p class="cf-line">
    <span class="cf-result" aria-live="polite"><span id="cf-tokens">0</span> tokens · <span id="cf-percent">0%</span> of <span id="cf-window">0</span> · <span class="cf-status" id="cf-status">Fits</span></span>
    <span class="cf-warn" id="cf-warn" data-craft="context-estimate-only">An estimate from <span id="cf-chars">0</span> characters, not a tokenizer count.</span>
  </p>
  <p class="cf-over" id="cf-over" hidden>This text may exceed the selected context window.</p>

  <MoreAbout id="cf-about" heading="Where the context windows come from">
    <p class="cf-source" id="cf-source">Window checked {CONTEXT_MODELS[0]?.lastUpdated}. {CONTEXT_MODELS[0]?.sourceNote}</p>
  </MoreAbout>
</div>

<style>
  /* Input about five prose rows (5 x 26px + padding). */
  .cf { min-width: 0; max-width: 100%; --io-pane-h: 9.5rem; }
  .cf [hidden] { display: none !important; }

  .cf-model {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cf-model select {
    min-height: var(--touch-target);
    font-size: var(--text-base);
    text-transform: none;
    letter-spacing: 0;
    font-weight: var(--font-weight-normal);
    color: var(--color-text);
  }

  .cf-line {
    margin: var(--space-5) 0 0;
    max-width: none;
    line-height: 1.5;
  }

  .cf-result {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    margin-right: var(--space-2);
  }

  .cf-warn,
  .cf-over {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .cf-over {
    margin: var(--space-2) 0 0;
    max-width: none;
  }

  .cf textarea {
    font-size: var(--text-base);
  }
</style>

<script is:inline define:vars={{ models: CONTEXT_MODELS }}>
  ToyTools.onReady(function () {
    var text = document.getElementById('cf-text');
    var select = document.getElementById('cf-model');
    var chars = document.getElementById('cf-chars');
    var tokens = document.getElementById('cf-tokens');
    var windowEl = document.getElementById('cf-window');
    var percent = document.getElementById('cf-percent');
    var status = document.getElementById('cf-status');
    var over = document.getElementById('cf-over');
    var source = document.getElementById('cf-source');
    if (!text || !select || !chars || !tokens || !windowEl || !percent || !status || !over || !source) return;

    var byId = {};
    for (var i = 0; i < models.length; i++) byId[models[i].id] = models[i];

    function fmt(n) { return Number(n).toLocaleString('en-US'); }

    function paint() {
      if (!(window.ToyTools && ToyTools.estimateContextFit)) return;
      var model = byId[select.value];
      var fit = ToyTools.estimateContextFit(text.value, select.value);
      if (!fit || !model) {
        status.textContent = 'Unknown model.';
        return;
      }
      chars.textContent = fmt(fit.characters);
      tokens.textContent = '~' + fmt(fit.estimatedTokens);
      windowEl.textContent = fmt(fit.contextWindow);
      percent.textContent = fit.percent + '%';
      status.textContent = fit.fits ? 'Fits' : 'May exceed';
      over.hidden = fit.fits;
      source.textContent = 'Window checked ' + model.lastUpdated + '. ' + model.sourceNote;
    }

    text.addEventListener('input', paint);
    select.addEventListener('change', paint);
    paint();
  });
</script>
