---
// Bespoke widget. TextProcessorWidget reads one string. This page joins five fields.
// The assembly lives in src/lib/text/promptPack.ts. This file only renders it.
//
// Phone-first layout (beta-v12.1): Role and Task open, the other three behind a counted
// disclosure that opens itself when any of them holds text, the Markdown/Tags switch in the
// output's own header, and a sticky Copy row on phones.
import IoPanel from '@tools/_shared/IoPanel.astro';
import Disclosure from '@tools/_shared/Disclosure.astro';
import ToolActions from '@components/tool/ToolActions.astro';
---

<div class="pp">
  <div class="pp-fields">
    <IoPanel label="Role" labelFor="pp-role" variant="prose">
      <textarea id="pp-role" rows="3" placeholder="You are a senior Android engineer." spellcheck="true" aria-label="Role"></textarea>
    </IoPanel>
    <IoPanel label="Task" labelFor="pp-task" variant="prose">
      <textarea id="pp-task" rows="3" placeholder="Explain how Binder IPC works." spellcheck="true" aria-label="Task"></textarea>
    </IoPanel>
  </div>

  <Disclosure id="pp-more" label="More fields" count={3}>
    <button slot="actions" class="action-btn action-btn--sample" id="pp-sample" type="button">Sample</button>
    <button slot="actions" class="action-btn pp-clear" id="pp-clear" type="button">Clear</button>
    <IoPanel label="Context" labelFor="pp-context" variant="prose">
      <textarea id="pp-context" rows="3" placeholder="The audience understands Kotlin but is new to Android internals." spellcheck="true" aria-label="Context"></textarea>
    </IoPanel>
    <IoPanel label="Constraints" labelFor="pp-constraints" variant="prose">
      <textarea id="pp-constraints" rows="3" placeholder="Use simple language. Include a concrete example." spellcheck="true" aria-label="Constraints"></textarea>
    </IoPanel>
    <IoPanel label="Output format" labelFor="pp-format-field" variant="prose">
      <textarea id="pp-format-field" rows="3" placeholder="Use headings and bullet points." spellcheck="true" aria-label="Output format"></textarea>
    </IoPanel>
  </Disclosure>

  <p class="pp-omit" id="pp-omit" data-craft="prompt-omit-empty" role="status" hidden></p>
  <p class="pp-counts"><span id="pp-counts" aria-live="polite">0 characters · 0 words</span>. <span class="pp-note">Assembles the prompt. Does not write it.</span></p>

  <div class="pp-output">
    <IoPanel label="Assembled prompt" labelFor="pp-out" variant="prose">
      <div slot="header-end" class="pp-format" role="group" aria-label="Prompt layout">
        <button class="action-btn" id="pp-md" type="button" aria-pressed="true">Markdown</button>
        <button class="action-btn" id="pp-xml" type="button" aria-pressed="false">Tags</button>
      </div>
      <textarea id="pp-out" readonly aria-label="Assembled prompt" placeholder="The assembled prompt appears here."></textarea>
    </IoPanel>
  </div>
  <ToolActions copyTarget="pp-out" sticky />
</div>

<style>
  /* Inputs open at three prose rows (3 x 26px + padding); the result at 12rem on a phone and
     16rem on desktop, both still draggable (PR #232). */
  .pp { min-width: 0; max-width: 100%; --io-pane-h: 6.5rem; }
  .pp-output { --io-pane-h: 12rem; margin-top: var(--space-4); }
  @media (min-width: 1024px) {
    .pp-output { --io-pane-h: 16rem; }
  }
  .pp [hidden] { display: none !important; }

  .pp-fields {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    margin-bottom: var(--space-2);
  }

  .pp-format {
    display: flex;
    gap: var(--space-2);
  }

  .action-btn {
    min-height: var(--touch-target);
  }

  .pp-format .action-btn {
    padding-inline: var(--space-3);
  }

  .pp-clear:active,
  .pp-format .action-btn:active,
  .pp-format .action-btn[aria-pressed="true"] {
    background: var(--color-accent-subtle);
  }

  .pp-omit,
  .pp-counts {
    margin: var(--space-3) 0 0;
    max-width: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .pp-counts {
    font-variant-numeric: tabular-nums;
  }

  .pp textarea {
    font-size: var(--text-base);
  }
</style>

<script is:inline>
  ToyTools.onReady(function () {
    var role = document.getElementById('pp-role');
    var task = document.getElementById('pp-task');
    var context = document.getElementById('pp-context');
    var constraints = document.getElementById('pp-constraints');
    var outputFormat = document.getElementById('pp-format-field');
    var out = document.getElementById('pp-out');
    var omit = document.getElementById('pp-omit');
    var counts = document.getElementById('pp-counts');
    var md = document.getElementById('pp-md');
    var xml = document.getElementById('pp-xml');
    var sample = document.getElementById('pp-sample');
    var clearBtn = document.getElementById('pp-clear');
    if (!role || !task || !context || !constraints || !outputFormat || !out || !omit || !counts || !md || !xml || !sample || !clearBtn) return;

    var format = 'markdown';
    var clearArmed = false;
    var clearTimer = 0;

    function fields() {
      return {
        role: role.value,
        task: task.value,
        context: context.value,
        constraints: constraints.value,
        outputFormat: outputFormat.value,
      };
    }

    function paint() {
      if (!(window.ToyTools && ToyTools.packPrompt)) return;
      var packed = ToyTools.packPrompt(fields(), format);
      out.value = packed.text;
      counts.textContent = packed.characters + ' characters · ' + packed.words + (packed.words === 1 ? ' word' : ' words');
      var filled = packed.omitted.length < 5;
      var dropped = packed.omitted.length > 0 && filled;
      omit.hidden = !dropped;
      omit.textContent = dropped ? 'Left out: ' + packed.omitted.join(', ') + '.' : '';
    }

    function setFormat(next) {
      format = next;
      md.setAttribute('aria-pressed', next === 'markdown' ? 'true' : 'false');
      xml.setAttribute('aria-pressed', next === 'xml' ? 'true' : 'false');
      paint();
    }

    function disarm() {
      clearArmed = false;
      clearBtn.textContent = 'Clear';
      if (clearTimer) window.clearTimeout(clearTimer);
    }

    [role, task, context, constraints, outputFormat].forEach(function (el) {
      el.addEventListener('input', paint);
    });
    md.addEventListener('click', function () { setFormat('markdown'); });
    xml.addEventListener('click', function () { setFormat('xml'); });
    sample.addEventListener('click', function () {
      role.value = 'You are a senior Android engineer.';
      task.value = 'Explain how Binder IPC works.';
      context.value = 'The audience understands Kotlin but is new to Android internals.';
      constraints.value = 'Use simple language.\nInclude a concrete example.';
      outputFormat.value = 'Use headings and bullet points.';
      disarm();
      paint();
      if (ToyTools.disclosure) ToyTools.disclosure.openIfFilled('pp-more');
    });
    clearBtn.addEventListener('click', function () {
      if (!clearArmed) {
        clearArmed = true;
        clearBtn.textContent = 'Confirm clear';
        clearTimer = window.setTimeout(disarm, 3000);
        return;
      }
      role.value = '';
      task.value = '';
      context.value = '';
      constraints.value = '';
      outputFormat.value = '';
      disarm();
      paint();
    });
    // A browser that restores form values (back/forward) can refill a hidden field.
    if (ToyTools.disclosure) ToyTools.disclosure.openIfFilled('pp-more');
    paint();
  });
</script>
