---
// Bespoke widget. The layout lives in src/lib/text/llmsDraft.ts.
//
// Phone-first layout (beta-v12.1): Name, URL, Purpose and Tools open; Contact, Usage and
// Crawler policy behind "Optional (3)", which opens itself when any of them holds text; the
// file directly under the fields; Copy and Download sticky on phones.
import '@styles/prep-slim.css';
import IoPanel from '@tools/_shared/IoPanel.astro';
import Disclosure from '@tools/_shared/Disclosure.astro';
import ToolActions from '@components/tool/ToolActions.astro';
---

<div class="lg">
  <div class="lg-fields">
    <label for="lg-name">Site name<input id="lg-name" type="text" autocomplete="organization" /></label>
    <label for="lg-url">Site URL<input id="lg-url" type="url" inputmode="url" placeholder="https://example.com/" autocomplete="url" /></label>
    <label for="lg-purpose">One-line purpose<input id="lg-purpose" type="text" /></label>
    <IoPanel label="Tools" labelFor="lg-pages" variant="prose">
      <textarea id="lg-pages" rows="4" spellcheck="false" aria-label="Tools, one per line as Name | URL" placeholder="Formatter | /format/"></textarea>
    </IoPanel>
  </div>

  <div class="lg-optional">
    <Disclosure id="lg-more" label="Optional" count={3}>
      <button slot="actions" class="action-btn action-btn--sample" id="lg-sample" type="button">Sample</button>
      <button slot="actions" class="action-btn lg-clear" id="lg-clear" type="button">Clear</button>
      <div class="lg-fields">
        <label for="lg-contact">Contact<input id="lg-contact" type="text" placeholder="Optional URL or email" /></label>
        <label for="lg-usage">Usage<input id="lg-usage" type="text" placeholder="Optional" /></label>
        <label for="lg-policy">Crawler policy<input id="lg-policy" type="text" placeholder="Optional" /></label>
      </div>
    </Disclosure>
  </div>

  <p class="lg-line"><span class="lg-omit" id="lg-omit" data-craft="llms-omit-empty" role="status" hidden></span> <span class="lg-note">Generates the description. Does not publish it.</span></p>

  <div class="lg-output">
    <IoPanel label="llms.txt" labelFor="lg-out" variant="prose">
      <textarea id="lg-out" readonly aria-label="Generated llms.txt"></textarea>
    </IoPanel>
  </div>
  <ToolActions copyTarget="lg-out" downloadTarget="lg-out" downloadFilename="llms.txt" sticky />
</div>

<style>
  /* Tools about four prose rows; the file 12rem on a phone, 16rem on desktop. */
  .lg { min-width: 0; max-width: 100%; --io-pane-h: 8rem; }
  .lg-output { --io-pane-h: 12rem; margin-top: var(--space-3); }
  @media (min-width: 1024px) {
    .lg-output { --io-pane-h: 16rem; }
  }
  .lg [hidden] { display: none !important; }

  .lg-fields {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .lg-optional { margin-top: var(--space-2); }

  .lg-fields label {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .lg-fields input {
    min-height: var(--touch-target);
    font-size: var(--text-base);
    text-transform: none;
    letter-spacing: 0;
    font-weight: var(--font-weight-normal);
    color: var(--color-text);
  }

  .lg-line {
    margin: var(--space-2) 0 0;
    max-width: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .lg-omit { color: var(--color-text); }

  .action-btn {
    min-height: var(--touch-target);
  }

  .lg-clear:active {
    background: var(--color-accent-subtle);
  }

  .lg textarea {
    font-size: var(--text-base);
  }
</style>

<script is:inline>
  ToyTools.onReady(function () {
    var name = document.getElementById('lg-name');
    var url = document.getElementById('lg-url');
    var purpose = document.getElementById('lg-purpose');
    var contact = document.getElementById('lg-contact');
    var pages = document.getElementById('lg-pages');
    var usage = document.getElementById('lg-usage');
    var policy = document.getElementById('lg-policy');
    var out = document.getElementById('lg-out');
    var omit = document.getElementById('lg-omit');
    var sample = document.getElementById('lg-sample');
    var clearBtn = document.getElementById('lg-clear');
    if (!name || !url || !purpose || !contact || !pages || !usage || !policy || !out || !omit || !sample || !clearBtn) return;

    var fields = [name, url, purpose, contact, pages, usage, policy];
    var clearArmed = false;
    var clearTimer = 0;
    var more = document.getElementById('lg-more');
    function syncMore() {
      if (more) more.dispatchEvent(new CustomEvent('tt:disclosure-sync', { bubbles: true }));
    }

    function paint() {
      if (!(window.ToyTools && ToyTools.buildLlmsTxt)) return;
      var draft = ToyTools.buildLlmsTxt({
        siteName: name.value,
        siteUrl: url.value,
        purpose: purpose.value,
        contact: contact.value,
        pagesText: pages.value,
        usage: usage.value,
        crawlerPolicy: policy.value,
      });
      out.value = draft.text;
      var dropped = draft.omitted || [];
      omit.hidden = dropped.length === 0;
      omit.textContent = dropped.length ? 'Left out: ' + dropped.join(', ') + '.' : '';
    }

    function disarm() {
      clearArmed = false;
      clearBtn.textContent = 'Clear';
      if (clearTimer) window.clearTimeout(clearTimer);
    }

    fields.forEach(function (el) { el.addEventListener('input', paint); });
    sample.addEventListener('click', function () {
      name.value = 'Ada Tools';
      url.value = 'https://ada.example/';
      purpose.value = 'Small browser tools.';
      contact.value = '';
      pages.value = 'Formatter | /format/\nCounter | /count/';
      usage.value = '';
      policy.value = 'Public pages may be crawled.';
      disarm();
      paint();
      syncMore();
    });
    clearBtn.addEventListener('click', function () {
      if (!clearArmed) {
        clearArmed = true;
        clearBtn.textContent = 'Confirm clear';
        clearTimer = window.setTimeout(disarm, 3000);
        return;
      }
      fields.forEach(function (el) { el.value = ''; });
      disarm();
      paint();
    });
    // A browser that restores form values (back/forward) can refill a hidden field.
    syncMore();
    paint();
  });
</script>
