---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props {
  title: string;
  description: string;
  readMinutes: number;
  updatedAt: string;
  entry: EcosystemEntry;
}

const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout
  {...props}
  toolSlug={config.slug}
  toolName={pack.name}
  toolCategorySlug={config.categorySlug}
  lang="ja"
>
  <section id="quick-answer">
    <h2>概要（クイック回答） <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      BMI（Body Mass Index）は体重(kg)を身長(m)の2乗で割って算出する体格指数です。たとえば体重70kg・身長175cmの場合は 70 ÷ (1.75 × 1.75) = 約22.9 となります。WHOの国際成人基準では 18.5未満が低体重、18.5〜24.9が標準、25〜29.9が過体重、30以上が肥満に区分されます。
    </p>
    <a href={toolHref} class="cta-link">BMI計算ツールを開く →</a>
  </section>

  <section id="how-bmi-works">
    <h2>BMIの計算式と標準体重の出し方 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      体重だけでは身長差による自然な重さの違いを補正できないため、身長を2乗して割ることで異なる身長の人を比較しやすくしています。日本肥満学会の基準では「25以上を肥満」とする点など地域・医学会により一部細分が異なりますが、本ツールはWHO標準区分をベースに身長ごとの健康範囲（kg/lb）をあわせて表示します。
    </p>
  </section>

  <section id="examples">
    <h2>計算例 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p><strong>70kg・175cm:</strong> BMIは 22.9 で標準範囲です。175cmの健康範囲は 56.7kg〜76.3kg となります。</p>
    <p><strong>90kg・170cm:</strong> BMIは 31.1 となり、健康範囲上限までの差も表示されます。</p>
  </section>

  <section id="limitations">
    <h2>BMIで測れないもの・注意点 <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      BMIは筋肉量と体脂肪量を見分けられないため、アスリートは高めに、筋肉が落ちた高齢者は標準でも体脂肪が多めに出ることがあります。食事量の設計には <a href={toolPathBySlug('tdee-calculator', 'ja')}>TDEE計算ツール</a> や <a href={toolPathBySlug('bmr-calculator', 'ja')}>基礎代謝量（BMR）計算ツール</a> も併せて確認してください。
    </p>
    <ReferenceBlock type="common-mistake" heading="単位の混在と診断への過信に注意">
      <p>ポンドのままセンチを入力するミスや、BMI単体を医師の診断と同じものとして受け止めることは避けてください。入力値は一切サーバーへ送信されません。</p>
    </ReferenceBlock>
  </section>
</GuideLayout>
