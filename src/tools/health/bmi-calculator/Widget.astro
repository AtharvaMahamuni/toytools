---
import WellnessWidget from '@tools/_shared/WellnessWidget.astro';
import { config } from './config';
const { lang = 'en', pack = null } = Astro.props;
---

<WellnessWidget slug={config.slug} wellnessId={config.processorId!} config={config} emptyText="Enter your height and weight to see your BMI, category, and healthy weight range." lang={lang} pack={pack} />
