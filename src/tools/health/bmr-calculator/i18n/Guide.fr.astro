---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './fr';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'fr');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="fr">
  <section id="reponse-rapide">
    <h2>Réponse rapide <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Votre BMR (métabolisme de base) mesure l’énergie minimale consommée au repos absolu pour respirer, réguler la température et maintenir vos organes en vie. Ce chiffre ne représente pas votre ration alimentaire quotidienne, mais le socle sur lequel s’ajoutent vos mouvements.
    </p>
    <a href={toolHref} class="cta-link">Ouvrir le Calculateur BMR →</a>
  </section>

  <section id="ne-pas-manger-bmr">
    <h2>Pourquoi ne pas limiter votre alimentation au BMR <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Même avec un travail de bureau, se lever, marcher et digérer augmente votre dépense d’au moins 20 %. Manger exactement au niveau du BMR crée souvent un déficit trop brutal et intenable.
    </p>
    <ReferenceBlock type="key-idea" heading="Lire le BMR par kilogramme de poids">
      <p>Un métabolisme de repos sous 1 400 kcal reflète généralement un petit gabarit, pas un dysfonctionnement : rapporté par kilo, il reste autour de 22 à 25 kcal/kg.</p>
    </ReferenceBlock>
  </section>

  <section id="outils-suite">
    <h2>Passer du repos à l’objectif quotidien <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Multipliez votre valeur basale par votre activité dans le <a href={toolPathBySlug('tdee-calculator', 'fr')}>Calculateur TDEE</a> ou consultez le <a href={toolPathBySlug('bmi-calculator', 'fr')}>Calculateur IMC</a>. Pour répartir vos protéines et glucides utilisez <a href={toolPathBySlug('macro-calculator')}>Macro Calculator</a> ou <a href={toolPathBySlug('calorie-deficit-calculator')}>Calorie Deficit Calculator</a>.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
