---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './de';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'de');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="de">
  <section id="schnellantwort">
    <h2>Schnellantwort <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Dein BMR (Grundumsatz) zeigt die Energiemenge, die dein Körper bei völliger Ruhe benötigt, um Atmung, Kreislauf, Körpertemperatur und Organfunktionen aufrechtzuerhalten. Er markiert nicht dein empfohlenes Diätziel, sondern das unverzichtbare Fundament vor Alltagsbewegung und Sport.
    </p>
    <a href={toolHref} class="cta-link">BMR-Rechner öffnen →</a>
  </section>

  <section id="warum-nicht-bmr-essen">
    <h2>Warum der BMR nicht als Diätziel taugt <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Schon normale Alltagsschritte, Stehen und Verdauung erhöhen deinen echten Tagesverbrauch mindestens um Faktor 1,2. Dauerhaft nur den Grundumsatz zu essen führt oft zu starker Erschöpfung und unnötigem Muskelverlust.
    </p>
    <ReferenceBlock type="key-idea" heading="Wert pro Kilogramm vergleichen">
      <p>Ein Grundumsatz unter 1.400 kcal deutet bei kleinerer Körpergröße keineswegs auf einen gestörten Stoffwechsel hin: Geteilt durch das Körpergewicht liegt er meist im typischen Bereich von rund 22–25 kcal/kg.</p>
    </ReferenceBlock>
  </section>

  <section id="naechste-schritte">
    <h2>Vom Grundumsatz zum Tagesziel <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      Skaliere deinen Ruheumsatz im <a href={toolPathBySlug('tdee-calculator', 'de')}>TDEE-Rechner</a> mit deinem Aktivitätslevel oder prüfe deine Statur im <a href={toolPathBySlug('bmi-calculator', 'de')}>BMI-Rechner</a>. Danach kannst du Makronährstoffe mit dem <a href={toolPathBySlug('macro-calculator')}>Macro Calculator</a> aufteilen oder das Defizit im <a href={toolPathBySlug('calorie-deficit-calculator')}>Calorie Deficit Calculator</a> planen.
    </p>
  </section>
</GuideLayout>

<style>
  .cta-link {
    display: inline-flex; align-items: center; height: var(--touch-target);
    padding-inline: var(--space-5); margin-top: var(--space-5);
    background: var(--color-accent); color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold); font-size: var(--text-base);
    border-radius: var(--radius-md); text-decoration: none;
  }
  .cta-link:hover { opacity: 0.9; text-decoration: none; }
</style>
