---
import GuideLayout from '@layouts/GuideLayout.astro';
import ReferenceBlock from '@components/ReferenceBlock.astro';
import { config } from '../config';
import { pack } from './ja';
import { toolPath } from '@lib/paths';
import { toolPathBySlug } from '@lib/tools/tool-link';
import { categories } from '@data/categories';
import type { EcosystemEntry } from '@data/types';

interface Props { title: string; description: string; readMinutes: number; updatedAt: string; entry: EcosystemEntry; }
const props = Astro.props;
const category = categories.find(c => c.slug === config.categorySlug)!;
const toolHref = toolPath({ slug: config.slug, segment: category.segment }, 'ja');
---

<GuideLayout {...props} toolSlug={config.slug} toolName={pack.name} toolCategorySlug={config.categorySlug} lang="ja">
  <section id="quick-answer">
    <h2>結論とポイント <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      TDEE（Total Daily Energy Expenditure）は、完全安静時の基礎代謝（BMR）に日常生活の歩行・消化・トレーニングによる消費を加えた「1日の総消費カロリー」です。この維持カロリーを基準にすることで、減量や増量の現実的な食事目標を立てられます。
    </p>
    <a href={toolHref} class="cta-link">TDEE計算ツールを開く →</a>
  </section>

  <section id="activity-level">
    <h2>活動レベルの選び方で失敗しないコツ <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      推定値がずれる最大の原因は身体活動レベルの過大評価です。デスクワーク中心で週2回程度の運動なら控えめな係数から始めないと、1日300kcal前後も目標が高くなり体重が落ちにくくなります。
    </p>
    <ReferenceBlock type="key-idea" heading="基礎代謝（BMR）を下回らない設計">
      <p>まずは維持カロリーからマイナス300〜500kcal程度に設定し、2〜3週間の体重平均の推移を見て150kcalずつ微調整するのが安全です。</p>
    </ReferenceBlock>
  </section>

  <section id="related-tools">
    <h2>あわせて確認したい健康・栄養ツール <span class="gold-dot" aria-hidden="true"></span></h2>
    <p>
      安静時の基礎消費だけを確認するなら <a href={toolPathBySlug('bmr-calculator', 'ja')}>BMR（基礎代謝）計算ツール</a>、体格指数チェックには <a href={toolPathBySlug('bmi-calculator', 'ja')}>BMI計算ツール</a> をご利用ください。三大栄養素の配分は <a href={toolPathBySlug('macro-calculator')}>Macro Calculator</a>、減量ペース計算には <a href={toolPathBySlug('calorie-deficit-calculator')}>Calorie Deficit Calculator</a> も便利です。
    </p>
  </section>
</GuideLayout>
