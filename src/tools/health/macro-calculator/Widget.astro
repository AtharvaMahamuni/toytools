---
import WellnessWidget from '@tools/_shared/WellnessWidget.astro';
import { config } from './config';
import type { LocaleCode } from '@data/locales';
import type { LocalizedToolPack } from '@lib/i18n/types';
import { uiStr } from '@lib/i18n/widget-utils';

interface Props { lang?: LocaleCode; pack?: LocalizedToolPack | null; }
const { lang = 'en', pack = null } = Astro.props;
---

<WellnessWidget slug={config.slug} wellnessId={config.processorId!} config={config} emptyText={uiStr(pack, "emptyText", "Enter your daily calories and pick a diet style to see your protein, carb, and fat targets.")} lang={lang} pack={pack} />
