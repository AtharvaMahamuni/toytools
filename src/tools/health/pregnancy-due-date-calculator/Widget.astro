// src/lib/engines/datetime/calculators/pregnancy.ts.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
---

<DateTimeWidget
  slug={config.slug}
  dateTimeId="pregnancy"
  config={config}
  craftOn="hero-note"
  emptyText="Enter the first day of the last period."
/>
