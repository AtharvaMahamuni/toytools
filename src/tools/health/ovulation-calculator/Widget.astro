---
// Ovulation Calculator. The date arithmetic lives in
// src/lib/engines/datetime/calculators/ovulation.ts.
import DateTimeWidget from '@tools/_shared/DateTimeWidget.astro';
import { config } from './config';
---

<DateTimeWidget
  slug={config.slug}
  dateTimeId="ovulation"
  config={config}
  craftOn="hero-note"
  resultNote="A calendar estimate, not contraception. Timing varies. Talk to a midwife or doctor about your cycle."
  emptyText="Enter the first day of the last period."
/>
