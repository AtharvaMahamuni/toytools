---
import ToolSection from '@tools/_shared/ToolSection.astro';
import ToolAction from '@tools/_shared/ToolAction.astro';
---

<section class="tool-panel" data-tool="case-converter">
  <label class="widget-label" for="case-input">Text</label>
  <textarea id="case-input" class="widget-textarea" rows="8" placeholder="Paste or type text here"></textarea>
  <label class="widget-label" for="case-mode">Conversion</label>
  <select id="case-mode" class="widget-select">
    <option value="lower">lowercase</option>
    <option value="upper">UPPERCASE</option>
    <option value="title">Title Case</option>
    <option value="sentence">Sentence case</option>
  </select>
</section>

<ToolAction label="Convert" toolSlug="case-converter" />

<section class="result-panel" aria-live="polite">
  <div>
    <h2>Result</h2>
    <output id="tool-output" class="widget-output">Enter text and run the tool.</output>
  </div>
</section>

<ToolSection heading="How it works">
  <p>The converter transforms the provided text locally using the selected casing rule.</p>
</ToolSection>

<section class="content-section">
  <h2>FAQ</h2>
  <details class="widget-details">
    <summary>Does this tool upload my data?</summary>
    <p>No. Everything runs in your browser.</p>
  </details>
  <details class="widget-details">
    <summary>Can I use it on mobile?</summary>
    <p>Yes. Inputs are stacked and reachable on small screens.</p>
  </details>
</section>

<script is:inline>
  function titleCase(text) {
    return text.toLowerCase().replace(/\b\w/g, function (m) { return m.toUpperCase(); });
  }

  function sentenceCase(text) {
    return text.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, function (m) { return m.toUpperCase(); });
  }

  document.querySelector('[data-run-tool="case-converter"]')?.addEventListener('click', function () {
    var text = document.getElementById('case-input')?.value || '';
    var mode = document.getElementById('case-mode')?.value;
    var result = mode === 'upper'    ? text.toUpperCase()  :
                 mode === 'title'    ? titleCase(text)      :
                 mode === 'sentence' ? sentenceCase(text)   :
                                      text.toLowerCase();
    var out = document.getElementById('tool-output');
    if (out) out.textContent = result || 'Enter text to convert.';
  });
</script>
